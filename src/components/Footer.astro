---
import tr from '../i18n/tr.json';
---

<footer class="site-footer">
	<div class="container footer-grid">
		<!-- Brand & Mission Column -->
		<div class="footer-col brand-col">
			<a href="/" class="footer-brand" aria-label="Kriptonik">
				<span class="symbol">◈</span>
				<span class="name">Kriptonik</span>
			</a>
			<p class="brand-slogan">{tr.brand.slogan}</p>
			<p class="brand-desc">
				{tr.brand.privacy_promise}
			</p>
			<div class="lang-selector">
				<span class="lang-item active">🇹🇷 Türkçe</span>
				<span class="lang-item disabled">🇬🇧 English <small class="soon-badge">Yakında</small></span>
			</div>
		</div>

		<!-- Araçlar Column -->
		<div class="footer-col">
			<h4 class="col-title">{tr.footer.tools_title}</h4>
			<ul class="footer-links">
				<li><a href="/araclar/yanlis-aga-gonderdim">Yanlış Ağa Gönderdim Sihirbazı</a></li>
				<li><a href="/araclar/takilan-islem">Takılan İşlem & Gas Teşhisi</a></li>
				<li><a href="/araclar/adres-ag-eslestirici">Adres Ağ Eşleştirici</a></li>
				<li><a href="/araclar/maliyet-karsilastirici">Gerçek Maliyet Karşılaştırıcı</a></li>
				<li><a href="/araclar/dca-simulator">DCA Geri Test Simülatörü</a></li>
				<li><a href="/araclar">Tüm 12 Aracı İncele →</a></li>
			</ul>
		</div>

		<!-- İçerik & Bilgi Column -->
		<div class="footer-col">
			<h4 class="col-title">{tr.footer.knowledge_title}</h4>
			<ul class="footer-links">
				<li><a href="/yardim">Acil Durum Merkezi</a></li>
				<li><a href="/sozluk">Kripto Terimleri Sözlüğü</a></li>
				<li><a href="/rehber">Güvenlik ve Çözüm Rehberleri</a></li>
				<li><a href="/piyasa">Canlı Piyasa & Gas Takibi</a></li>
				<li><a href="/metodoloji">Metodoloji & Hesaplama</a></li>
				<li><a href="/durum">Sistem Durumu (Status)</a></li>
			</ul>
		</div>

		<!-- Yasal & Şeffaflık Column -->
		<div class="footer-col">
			<h4 class="col-title">{tr.footer.legal_title}</h4>
			<ul class="footer-links">
				<li><a href="/gizlilik">Gizlilik Politikası (KVKK/GDPR)</a></li>
				<li><a href="/kullanim-sartlari">Kullanım Şartları</a></li>
				<li><a href="/risk-uyarisi">Risk Uyarısı & Sorumluluk Reddi</a></li>
				<li><a href="/affiliate-aciklamasi">Affiliate & Gelir Politikası</a></li>
				<li><a href="/rapor">Hatalı Bilgi / İtiraz Bildirimi</a></li>
			</ul>
		</div>
	</div>

	<!-- Disclaimer Banner -->
	<div class="container">
		<div class="legal-disclaimer">
			<span class="disclaimer-badge">ÖNEMLİ YASAL UYARI</span>
			<p>{tr.footer.disclaimer}</p>
		</div>
	</div>

	<!-- Bottom Row -->
	<div class="footer-bottom">
		<div class="container bottom-container">
			<div class="cf-badge">
				<span>⚡ Hosted on</span>
				<strong>Cloudflare Workers & Pages</strong>
				<span class="separator">•</span>
				<a href="/durum" class="status-link">Sistemler Aktif</a>
			</div>
			<div class="copyright">
				{tr.footer.rights}
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		background: var(--bg-sunken);
		border-top: 1px solid var(--border);
		padding: 56px 0 0;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1.2fr 1.2fr 1.2fr;
		gap: 36px;
		margin-bottom: 40px;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		color: var(--text);
		margin-bottom: 8px;
	}

	.footer-brand .symbol {
		font-size: 22px;
		color: var(--primary);
	}

	.footer-brand .name {
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 700;
		font-size: 19px;
		letter-spacing: 0.5px;
	}

	.brand-slogan {
		font-size: 14px;
		color: var(--primary);
		font-weight: 600;
		margin-bottom: 8px;
	}

	.brand-desc {
		font-size: 13px;
		line-height: 1.6;
		color: var(--text-muted);
		margin-bottom: 16px;
	}

	.lang-selector {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 12px;
	}

	.lang-item.active {
		color: var(--text);
		font-weight: 600;
	}

	.lang-item.disabled {
		color: var(--text-faint);
		cursor: not-allowed;
	}

	.soon-badge {
		font-size: 10px;
		background: var(--bg-elev);
		border: 1px solid var(--border);
		padding: 1px 4px;
		border-radius: 4px;
	}

	.col-title {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 14px;
		font-weight: 700;
		color: var(--text);
		margin-bottom: 16px;
		letter-spacing: 0.5px;
	}

	.footer-links {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-links a {
		font-size: 13px;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.footer-links a:hover {
		color: var(--primary);
	}

	.legal-disclaimer {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 16px 20px;
		font-size: 12px;
		line-height: 1.6;
		color: var(--text-muted);
		margin-bottom: 28px;
	}

	.disclaimer-badge {
		display: inline-block;
		font-family: var(--font-mono, monospace);
		font-size: 10px;
		font-weight: 700;
		color: var(--warning);
		background: var(--warning-soft);
		border: 1px solid var(--warning);
		padding: 2px 6px;
		border-radius: 4px;
		margin-bottom: 6px;
	}

	.footer-bottom {
		border-top: 1px solid var(--border);
		padding: 18px 0;
		font-size: 12px;
		color: var(--text-faint);
	}

	.bottom-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.cf-badge {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.status-link {
		color: var(--success);
		text-decoration: none;
		font-weight: 500;
	}

	.separator {
		color: var(--border-strong);
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 28px;
		}
		.brand-col {
			grid-column: span 2;
		}
	}

	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.brand-col {
			grid-column: span 1;
		}
		.bottom-container {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
