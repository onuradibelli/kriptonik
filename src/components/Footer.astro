<style>
	.site-footer {
		background: var(--bg-sunken);
		border-top: 1px solid var(--border);
		padding: 64px 0 32px;
		margin-top: auto;
		transition: background 180ms ease, border-color 180ms ease;
	}

	.footer-container {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.footer-top-grid {
		display: grid;
		grid-template-columns: 1.4fr repeat(4, 1fr);
		gap: 32px;
	}

	@media (max-width: 1100px) {
		.footer-top-grid {
			grid-template-columns: repeat(3, 1fr);
		}
		.brand-col {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 680px) {
		.footer-top-grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}

	.brand-col {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.f-logo-icon {
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: var(--primary-soft);
		border: 1px solid rgba(16, 185, 129, 0.2);
		color: var(--primary);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.f-logo-text {
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 800;
		font-size: 18px;
		color: var(--text);
		letter-spacing: -0.02em;
	}

	.footer-desc {
		font-size: 13px;
		color: var(--text-muted);
		line-height: 1.6;
		max-width: 320px;
		margin: 0;
	}

	.system-status-indicator {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		color: var(--text-muted);
		background: var(--bg-elev);
		border: 1px solid var(--border);
		padding: 6px 12px;
		border-radius: 9999px;
		width: fit-content;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--success);
		box-shadow: 0 0 6px var(--success);
	}

	.status-link {
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
	}

	.status-link:hover {
		color: var(--text);
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.col-title {
		font-size: 13px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text);
		margin: 0;
	}

	.footer-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-links a {
		font-size: 13px;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.footer-links a:hover {
		color: var(--primary);
	}

	.footer-disclaimer-box {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 18px 24px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.disclaimer-title {
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--text-faint);
	}

	.footer-disclaimer-box p {
		font-size: 12px;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	.footer-disclaimer-box strong {
		color: var(--text);
	}

	.footer-bottom-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 16px;
		border-top: 1px solid var(--border);
		font-size: 12px;
		color: var(--text-faint);
		flex-wrap: wrap;
		gap: 12px;
	}

	@media (max-width: 900px) {
		.footer-top-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 580px) {
		.footer-top-grid {
			grid-template-columns: 1fr;
		}
		.footer-bottom-row {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
