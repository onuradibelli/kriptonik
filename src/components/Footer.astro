<style>
	.site-footer {
		margin-top: auto;
		background: #070A12;
		border-top: 1px solid var(--surface-border);
		padding: 64px 0 0;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1.2fr 1.2fr 1.2fr;
		gap: 40px;
		margin-bottom: 48px;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		color: var(--text-main);
		margin-bottom: 12px;
	}

	.footer-brand .symbol {
		font-size: 24px;
		color: var(--accent-cyan);
	}

	.footer-brand .name {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 20px;
		letter-spacing: 1.2px;
	}

	.brand-slogan {
		font-size: 14px;
		color: var(--accent-cyan);
		font-weight: 600;
		margin-bottom: 12px;
	}

	.brand-desc {
		font-size: 13px;
		line-height: 1.6;
		color: var(--text-muted);
		margin-bottom: 20px;
	}

	.trust-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.trust-tag {
		font-size: 11px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 4px 10px;
		border-radius: 999px;
		color: #CBD5E1;
	}

	.col-title {
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 700;
		color: #F8FAFC;
		margin-bottom: 18px;
		letter-spacing: 0.5px;
	}

	.footer-links {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-links a {
		font-size: 13px;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s, transform 0.2s;
		display: inline-block;
	}

	.footer-links a:hover {
		color: var(--accent-cyan);
		transform: translateX(2px);
	}

	.legal-disclaimer {
		background: rgba(18, 24, 41, 0.7);
		border: 1px solid rgba(30, 41, 59, 0.8);
		border-radius: 10px;
		padding: 16px 20px;
		font-size: 12px;
		line-height: 1.6;
		color: #94A3B8;
		margin-bottom: 32px;
	}

	.disclaimer-badge {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		color: var(--warning);
		background: rgba(245, 158, 11, 0.12);
		border: 1px solid rgba(245, 158, 11, 0.3);
		padding: 2px 6px;
		border-radius: 4px;
		margin-bottom: 6px;
	}

	.legal-disclaimer strong {
		color: #F8FAFC;
	}

	.legal-disclaimer u {
		text-decoration-color: var(--danger);
		color: #FCA5A5;
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		padding: 20px 0;
		font-size: 13px;
		color: var(--text-dim);
	}

	.bottom-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.cf-badge {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
	}

	.cf-badge strong {
		color: #F38020; /* Cloudflare orange */
	}

	.separator {
		color: #334155;
	}

	.copyright {
		font-size: 12px;
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 32px;
		}
		.brand-col {
			grid-column: span 2;
		}
	}

	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.brand-col {
			grid-column: span 1;
		}
		.bottom-container {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
