---
// src/components/ThemeToggle.astro - 2-state Cockpit Theme Switcher (Grafit / Kâğıt)
---

<button
	type="button"
	id="kriptonik-theme-toggle"
	class="theme-toggle-btn"
	aria-label="Temayı değiştir (Grafit / Kâğıt)"
	title="Görünüm modu: Grafit / Kâğıt"
>
	<span class="theme-icon icon-dark" aria-hidden="true">
		<!-- Moon icon (1.5px stroke) -->
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
		</svg>
	</span>
	<span class="theme-icon icon-light" aria-hidden="true">
		<!-- Sun icon (1.5px stroke) -->
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="4"/>
			<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
		</svg>
	</span>
	<span class="theme-label" id="theme-label-text">Grafit</span>
</button>

<script>
	function setupThemeToggle() {
		const btn = document.getElementById('kriptonik-theme-toggle');
		const label = document.getElementById('theme-label-text');
		const root = document.documentElement;

		function getTheme(): 'dark' | 'light' {
			const saved = localStorage.getItem('kriptonik-theme');
			if (saved === 'light' || saved === 'dark') return saved;
			return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
		}

		function setTheme(theme: 'dark' | 'light') {
			root.setAttribute('data-theme', theme);
			root.style.colorScheme = theme;
			localStorage.setItem('kriptonik-theme', theme);
			if (label) {
				label.textContent = theme === 'dark' ? 'Grafit' : 'Kâğıt';
			}
			const metaTheme = document.querySelector('meta[name="theme-color"]');
			if (metaTheme) {
				metaTheme.setAttribute('content', theme === 'dark' ? '#14110F' : '#F6F1E8');
			}
		}

		// Initial sync
		setTheme(getTheme());

		if (btn) {
			btn.onclick = () => {
				const current = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
				const next = current === 'dark' ? 'light' : 'dark';
				setTheme(next);
			};
		}
	}

	setupThemeToggle();
	document.addEventListener('astro:after-swap', setupThemeToggle);
</script>

<style>
	.theme-toggle-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 12px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--text-subtle);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		cursor: pointer;
		transition: all var(--duration-fast) var(--ease-standard);
		user-select: none;
	}

	.theme-toggle-btn:hover {
		background: var(--surface-hover);
		color: var(--text);
		border-color: var(--line-strong);
	}

	.theme-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
	}

	:global([data-theme="dark"]) .icon-light {
		display: none;
	}
	:global([data-theme="dark"]) .icon-dark {
		display: inline-flex;
		color: var(--signal);
	}

	:global([data-theme="light"]) .icon-dark {
		display: none;
	}
	:global([data-theme="light"]) .icon-light {
		display: inline-flex;
		color: var(--signal);
	}

	@media (max-width: 600px) {
		.theme-label {
			display: none;
		}
		.theme-toggle-btn {
			padding: 0 8px;
			width: 36px;
			justify-content: center;
		}
	}
</style>
