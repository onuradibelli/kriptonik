---
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="container header-container">
		<!-- Brand Logo -->
		<a href="/" class="brand-logo" aria-label="Kriptonik Ana Sayfa">
			<div class="logo-icon-wrap">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none">
					<path d="M12 2L2 7L12 12L22 7L12 2Z" fill="currentColor" opacity="0.9" />
					<path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
					<path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
				</svg>
			</div>
			<span class="logo-name">Kriptonik</span>
		</a>

		<!-- Desktop Navigation -->
		<nav class="nav-links">
			<a href="/" class={currentPath === '/' ? 'nav-item active' : 'nav-item'}>Ana Sayfa</a>
			
			<div class="nav-dropdown-wrapper">
				<a href="/araclar" class={currentPath.startsWith('/araclar') ? 'nav-item active' : 'nav-item'}>
					<span>Araçlar</span>
					<svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
				</a>
				<div class="mega-menu">
					<div class="mega-grid">
						<div class="mega-col">
							<span class="mega-heading">Acil Sorun Çözücüler</span>
							<a href="/araclar/yanlis-aga-gonderdim">
								<strong>Yanlış Ağa Gönderdim</strong>
								<span>BEP20, ERC20, TRC20 kurtarma</span>
							</a>
							<a href="/araclar/takilan-islem">
								<strong>Takılan İşlem Teşhisi</strong>
								<span>RBF, CPFP ve Nonce hızlandırma</span>
							</a>
							<a href="/yardim">
								<strong>Acil Yardım Merkezi</strong>
								<span>Tüm senaryolar için rehber</span>
							</a>
						</div>

						<div class="mega-col">
							<span class="mega-heading">Hesaplama & Kıyas</span>
							<a href="/araclar/maliyet-karsilastirici">
								<strong>Borsa Maliyet Kıyaslayıcı</strong>
								<span>Komisyon ve spread dahil net tutar</span>
							</a>
							<a href="/araclar/dca-simulator">
								<strong>DCA Simülatörü</strong>
								<span>Geçmiş düzenli alım kâr testi</span>
							</a>
							<a href="/araclar/kripto-donusturucu">
								<strong>Kripto Dönüştürücü</strong>
								<span>250+ coin canlı piyasa fiyatları</span>
							</a>
						</div>

						<div class="mega-col">
							<span class="mega-heading">Güvenlik & İzleme</span>
							<a href="/araclar/cuzdan-guvenlik-kontrolu">
								<strong>Cüzdan Güvenlik Check-up</strong>
								<span>24 maddelik interaktif denetim</span>
							</a>
							<a href="/araclar/gas-ucret-takip">
								<strong>Gas & Ağ Ücreti Takip</strong>
								<span>En ucuz işlem saatleri analizi</span>
							</a>
							<a href="/araclar" class="all-tools-link">
								Tüm Araçları İncele →
							</a>
						</div>
					</div>
				</div>
			</div>

			<a href="/piyasa" class={currentPath.startsWith('/piyasa') ? 'nav-item active' : 'nav-item'}>Piyasa</a>
			<a href="/sozluk" class={currentPath.startsWith('/sozluk') ? 'nav-item active' : 'nav-item'}>Sözlük</a>
			<a href="/rehber" class={currentPath.startsWith('/rehber') ? 'nav-item active' : 'nav-item'}>Rehberler</a>
		</nav>

		<!-- Header Right Controls -->
		<div class="header-right">
			<!-- Command Search Trigger Pill -->
			<button type="button" class="search-trigger-btn" data-open-cmd aria-label="Hızlı Arama (Ctrl+K)">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<span class="search-label">Ara...</span>
				<kbd class="search-kbd">⌘K</kbd>
			</button>

			<!-- 3-State Theme Toggle -->
			<ThemeToggle />

			<!-- Mobile Menu Button -->
			<button class="mobile-toggle" id="mobile-toggle" aria-label="Menüyü Aç">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>

	<!-- Mobile Nav Drawer -->
	<div class="mobile-nav" id="mobile-nav">
		<button type="button" class="mobile-search-btn" data-open-cmd>
			🔍 Hızlı Arama Yap (Ctrl+K)
		</button>
		<a href="/" class="mobile-nav-item">Ana Sayfa</a>
		<a href="/araclar" class="mobile-nav-item">Tüm Araçlar</a>
		<a href="/yardim" class="mobile-nav-item">Acil Yardım</a>
		<a href="/piyasa" class="mobile-nav-item">Canlı Piyasa</a>
		<a href="/sozluk" class="mobile-nav-item">Kripto Sözlüğü</a>
		<a href="/rehber" class="mobile-nav-item">Rehberler</a>
	</div>
</header>

<CommandPalette />

<script>
	function setupHeader() {
		const toggle = document.getElementById('mobile-toggle');
		const nav = document.getElementById('mobile-nav');
		toggle?.addEventListener('click', () => {
			nav?.classList.toggle('open');
			toggle.classList.toggle('active');
		});
	}

	setupHeader();
	document.addEventListener('astro:after-swap', setupHeader);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--bg-glass);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		border-bottom: 1px solid var(--border);
		transition: background 180ms ease, border-color 180ms ease;
	}

	.header-container {
		height: 68px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	/* Logo */
	.brand-logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--text);
		font-weight: 800;
		font-size: 19px;
		letter-spacing: -0.03em;
		transition: opacity 150ms ease;
	}

	.brand-logo:hover {
		opacity: 0.9;
	}

	.logo-icon-wrap {
		width: 34px;
		height: 34px;
		border-radius: 10px;
		background: var(--primary-soft);
		border: 1px solid rgba(16, 185, 129, 0.2);
		color: var(--primary);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.logo-name {
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 800;
	}

	/* Nav items */
	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-item {
		padding: 8px 14px;
		font-size: 14px;
		font-weight: 600;
		color: var(--text-muted);
		border-radius: 8px;
		text-decoration: none;
		transition: all 150ms ease;
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-item:hover {
		color: var(--text);
		background: var(--bg-sunken);
	}

	.nav-item.active {
		color: var(--text);
		background: var(--bg-sunken);
	}

	.chevron-icon {
		transition: transform 180ms ease;
	}

	.nav-dropdown-wrapper:hover .chevron-icon {
		transform: rotate(180deg);
	}

	/* Mega Menu */
	.nav-dropdown-wrapper {
		position: relative;
	}

	.mega-menu {
		position: absolute;
		top: calc(100% + 8px);
		left: -120px;
		width: 720px;
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 24px;
		box-shadow: var(--shadow-lg);
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
		pointer-events: none;
		z-index: 1000;
	}

	.nav-dropdown-wrapper:hover .mega-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
	}

	.mega-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.mega-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.mega-heading {
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-faint);
		margin-bottom: 4px;
	}

	.mega-col a {
		padding: 8px 10px;
		border-radius: 8px;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 2px;
		transition: background 150ms ease;
	}

	.mega-col a:hover {
		background: var(--bg-sunken);
	}

	.mega-col a strong {
		font-size: 13px;
		color: var(--text);
		font-weight: 600;
	}

	.mega-col a span {
		font-size: 11px;
		color: var(--text-muted);
	}

	.all-tools-link {
		font-size: 12px;
		font-weight: 700;
		color: var(--primary) !important;
		margin-top: 8px;
	}

	/* Header Right */
	.header-right {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.search-trigger-btn {
		display: flex;
		align-items: center;
		gap: 8px;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		padding: 6px 12px;
		border-radius: 9999px;
		color: var(--text-muted);
		font-size: 13px;
		cursor: pointer;
		transition: all 150ms ease;
	}

	.search-trigger-btn:hover {
		border-color: var(--border-hover);
		color: var(--text);
	}

	.search-kbd {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		padding: 1px 6px;
		border-radius: 4px;
		font-size: 10px;
		font-family: inherit;
		color: var(--text-faint);
	}

	/* Mobile Toggle */
	.mobile-toggle {
		display: none;
		width: 36px;
		height: 36px;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		border-radius: 8px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		cursor: pointer;
	}

	.mobile-toggle span {
		width: 18px;
		height: 2px;
		background: var(--text);
		border-radius: 2px;
		transition: all 180ms ease;
	}

	.mobile-toggle.active span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.mobile-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-toggle.active span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.mobile-nav {
		display: none;
		position: absolute;
		top: 68px;
		left: 0;
		right: 0;
		background: var(--bg-elev);
		border-bottom: 1px solid var(--border);
		padding: 20px 24px;
		flex-direction: column;
		gap: 12px;
		box-shadow: var(--shadow-lg);
	}

	.mobile-nav.open {
		display: flex;
	}

	.mobile-search-btn {
		width: 100%;
		padding: 12px;
		border-radius: 8px;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		color: var(--text);
		font-weight: 600;
		font-size: 14px;
		text-align: left;
		cursor: pointer;
	}

	.mobile-nav-item {
		padding: 10px 0;
		font-size: 15px;
		font-weight: 600;
		color: var(--text);
		border-bottom: 1px solid var(--border);
		text-decoration: none;
	}

	@media (max-width: 960px) {
		.nav-links, .search-trigger-btn {
			display: none;
		}
		.mobile-toggle {
			display: flex;
		}
	}
</style>
