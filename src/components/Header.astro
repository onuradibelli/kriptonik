---
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="container header-container">
		<a href="/" class="brand-logo" aria-label="Kriptonik Ana Sayfa">
			<span class="logo-symbol">◈</span>
			<span class="logo-name">Kriptonik</span>
		</a>

		<nav class="nav-links">
			<a href="/" class={currentPath === '/' ? 'nav-item active' : 'nav-item'}>Ana Sayfa</a>
			<div class="nav-dropdown-wrapper">
				<a href="/araclar" class={currentPath.startsWith('/araclar') ? 'nav-item active' : 'nav-item'}>
					Araçlar <span class="arrow-down">▾</span>
				</a>
				<div class="mega-menu">
					<div class="mega-grid">
						<div class="mega-col">
							<span class="mega-heading">Acil Sorun Çözücüler</span>
							<a href="/araclar/yanlis-aga-gonderdim">🧭 Yanlış Ağa Gönderdim</a>
							<a href="/araclar/takilan-islem">⏱️ Takılan İşlem (Pending)</a>
							<a href="/yardim">⚡ Acil Durum Merkezi</a>
						</div>
						<div class="mega-col">
							<span class="mega-heading">Hesaplayıcılar</span>
							<a href="/araclar/maliyet-karsilastirici">⚖️ Gerçek Maliyet Karşılaştırıcı</a>
							<a href="/araclar/dca-simulator">📈 DCA Geri Test Simülatörü</a>
							<a href="/araclar/kripto-donusturucu">🔄 Kripto Dönüştürücü</a>
						</div>
						<div class="mega-col">
							<span class="mega-heading">Güvenlik & Doğrulama</span>
							<a href="/araclar/adres-ag-eslestirici">🔍 Adres Ağ Eşleştirici</a>
							<a href="/piyasa">⚡ Stablecoin Depeg Monitörü</a>
							<a href="/araclar">Tüm 12 Aracı Gör →</a>
						</div>
					</div>
				</div>
			</div>
			<a href="/yardim" class={currentPath.startsWith('/yardim') ? 'nav-item active' : 'nav-item'}>Acil Yardım</a>
			<a href="/piyasa" class={currentPath.startsWith('/piyasa') ? 'nav-item active' : 'nav-item'}>Piyasa</a>
			<a href="/sozluk" class={currentPath.startsWith('/sozluk') ? 'nav-item active' : 'nav-item'}>Sözlük</a>
			<a href="/rehber" class={currentPath.startsWith('/rehber') ? 'nav-item active' : 'nav-item'}>Rehberler</a>
		</nav>

		<div class="header-right">
			<button type="button" class="search-trigger-btn" data-open-cmd aria-label="Arama Yap (Ctrl+K)">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<span class="search-label">Ara...</span>
				<kbd class="search-kbd">⌘K</kbd>
			</button>

			<ThemeToggle />

			<a href="/yardim" class="btn btn-primary btn-sm mobile-hide">
				<span>⚡ Sorunum Var</span>
			</a>

			<button class="mobile-toggle" id="mobile-toggle" aria-label="Menüyü Aç">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>

	<!-- Mobile Menu Dropdown -->
	<div class="mobile-nav" id="mobile-nav">
		<button type="button" class="mobile-search-btn" data-open-cmd>
			🔍 Hızlı Arama (Ctrl+K)
		</button>
		<a href="/" class="mobile-nav-item">Ana Sayfa</a>
		<a href="/araclar" class="mobile-nav-item">Tüm Araçlar Dizini</a>
		<a href="/yardim" class="mobile-nav-item">Acil Durum Merkezi</a>
		<a href="/piyasa" class="mobile-nav-item">Canlı Piyasa & Gas</a>
		<a href="/sozluk" class="mobile-nav-item">Kripto Terimleri Sözlüğü</a>
		<a href="/rehber" class="mobile-nav-item">Rehberler</a>
		<div class="mobile-menu-cta">
			<a href="/yardim" class="btn btn-primary" style="width: 100%;">⚡ Acil Sorun Çözücü</a>
		</div>
	</div>
</header>

<CommandPalette />

<script>
	function setupHeader() {
		const toggle = document.getElementById('mobile-toggle');
		const nav = document.getElementById('mobile-nav');
		toggle?.addEventListener('click', () => {
			nav?.classList.toggle('open');
		});
	}

	setupHeader();
	document.addEventListener('astro:after-swap', setupHeader);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--bg-elev);
		border-bottom: 1px solid var(--border);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.header-container {
		height: 68px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand-logo {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		color: var(--text);
	}

	.logo-symbol {
		font-size: 22px;
		color: var(--primary);
	}

	.logo-name {
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 700;
		font-size: 20px;
		letter-spacing: 0.5px;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.nav-item {
		font-size: 14px;
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: none;
		padding: 6px 0;
		position: relative;
		transition: color 150ms ease;
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.arrow-down {
		font-size: 10px;
		opacity: 0.6;
	}

	.nav-item:hover {
		color: var(--text);
	}

	.nav-item.active {
		color: var(--primary);
		font-weight: 600;
	}

	.nav-dropdown-wrapper {
		position: relative;
	}

	.mega-menu {
		display: none;
		position: absolute;
		top: 100%;
		left: -20px;
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 20px;
		width: 580px;
		box-shadow: var(--shadow-md);
		z-index: 50;
	}

	.nav-dropdown-wrapper:hover .mega-menu {
		display: block;
	}

	.mega-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.mega-heading {
		display: block;
		font-size: 11px;
		font-weight: 700;
		color: var(--text-faint);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-bottom: 10px;
	}

	.mega-col {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.mega-col a {
		font-size: 13px;
		color: var(--text);
		text-decoration: none;
		padding: 4px 0;
		transition: color 150ms ease;
	}

	.mega-col a:hover {
		color: var(--primary);
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.search-trigger-btn {
		display: flex;
		align-items: center;
		gap: 8px;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 6px 10px;
		font-size: 13px;
		color: var(--text-muted);
		cursor: pointer;
		transition: border-color 150ms ease;
	}

	.search-trigger-btn:hover {
		border-color: var(--border-strong);
		color: var(--text);
	}

	.search-kbd {
		font-family: var(--font-mono, monospace);
		font-size: 10px;
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 2px 5px;
	}

	.mobile-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 6px;
	}

	.mobile-toggle span {
		width: 22px;
		height: 2px;
		background-color: var(--text);
		border-radius: 2px;
	}

	.mobile-nav {
		display: none;
		background: var(--bg-elev);
		border-bottom: 1px solid var(--border);
		padding: 16px 24px 24px;
	}

	.mobile-nav.open {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.mobile-search-btn {
		width: 100%;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		padding: 12px;
		border-radius: 8px;
		color: var(--text-muted);
		font-size: 14px;
		text-align: left;
		cursor: pointer;
	}

	.mobile-nav-item {
		color: var(--text);
		font-size: 15px;
		font-weight: 500;
		text-decoration: none;
		padding: 8px 0;
		border-bottom: 1px solid var(--border);
	}

	.mobile-menu-cta {
		margin-top: 10px;
	}

	@media (max-width: 900px) {
		.nav-links, .mobile-hide, .search-trigger-btn {
			display: none;
		}
		.mobile-toggle {
			display: flex;
		}
	}
</style>
