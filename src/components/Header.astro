---
// src/components/Header.astro - Cockpit Header (Strict tokens, zero emojis)
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
import Icon from './ui/Icon.astro';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
---

<header class="cockpit-header">
	<div class="cockpit-header-inner">
		<!-- Brand Logo -->
		<a href="/" class="brand-logo" aria-label="kriptonik ana sayfa">
			<div class="brand-mark" aria-hidden="true">
				<!-- Cockpit telemetry crosshair icon -->
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="9"/>
					<path d="M12 3v4M12 17v4M3 12h4M17 12h4"/>
					<circle cx="12" cy="12" r="2" fill="currentColor"/>
				</svg>
			</div>
			<div class="brand-title">
				<span class="brand-name">kriptonik</span>
				<span class="brand-tag">saha kılavuzu</span>
			</div>
		</a>

		<!-- Desktop Navigation -->
		<nav class="cockpit-nav" aria-label="Ana Gezinti">
			<a href="/araclar" class={currentPath.startsWith('/araclar') ? 'nav-link active' : 'nav-link'}>
				Araçlar
			</a>
			<a href="/rehber" class={currentPath.startsWith('/rehber') ? 'nav-link active' : 'nav-link'}>
				Rehberler
			</a>
			<a href="/sozluk" class={currentPath.startsWith('/sozluk') ? 'nav-link active' : 'nav-link'}>
				Sözlük
			</a>
			<a href="/piyasa" class={currentPath.startsWith('/piyasa') ? 'nav-link active' : 'nav-link'}>
				Piyasa
			</a>
			<a href="/turkiye" class={currentPath.startsWith('/turkiye') ? 'nav-link active' : 'nav-link'}>
				Türkiye
			</a>
			<a href="/kac-tl" class={currentPath.startsWith('/kac-tl') ? 'nav-link active' : 'nav-link'}>
				Kaç TL?
			</a>
		</nav>

		<!-- Right Controls -->
		<div class="header-actions">
			<!-- Quick Search Trigger -->
			<button type="button" class="search-pill-btn" data-open-cmd aria-label="Arama Yap (Ctrl+K)">
				<Icon name="search" size={14} />
				<span class="search-text">Ara...</span>
				<kbd class="search-shortcut">⌘K</kbd>
			</button>

			<!-- Theme Toggle (Grafit / Kâğıt) -->
			<ThemeToggle />

			<!-- Signal Action Button -->
			<a href={isHome ? '#sorunum-var' : '/araclar/yanlis-aga-gonderdim'} class="emergency-action-btn">
				<Icon name="alert-triangle" size={14} />
				<span>Sorunum Var</span>
			</a>

			<!-- Mobile Drawer Toggle -->
			<button type="button" class="mobile-menu-trigger" id="mobile-menu-toggle" aria-label="Menüyü aç/kapat" aria-expanded="false">
				<span class="menu-bar"></span>
				<span class="menu-bar"></span>
			</button>
		</div>
	</div>

	<!-- Mobile Navigation Drawer -->
	<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
		<div class="drawer-search">
			<button type="button" class="drawer-search-btn" data-open-cmd>
				<Icon name="search" size={16} />
				<span>Araç, sorun veya terim ara... (⌘K)</span>
			</button>
		</div>

		<nav class="drawer-nav">
			<a href="/araclar" class="drawer-link">
				<div class="drawer-link-content">
					<strong>Araçlar</strong>
					<span>Hata çözücü, maliyet ve adres denetimi</span>
				</div>
				<Icon name="chevron-right" size={16} />
			</a>
			<a href="/rehber" class="drawer-link">
				<div class="drawer-link-content">
					<strong>Rehberler</strong>
					<span>Adım adım doğrulanmış çözüm adımları</span>
				</div>
				<Icon name="chevron-right" size={16} />
			</a>
			<a href="/sozluk" class="drawer-link">
				<div class="drawer-link-content">
					<strong>Kripto Sözlüğü</strong>
					<span>Mempool, Gwei, Slippage ve teknik terimler</span>
				</div>
				<Icon name="chevron-right" size={16} />
			</a>
			<a href="/piyasa" class="drawer-link">
				<div class="drawer-link-content">
					<strong>Piyasa & Veri</strong>
					<span>Canlı fiyatlar, ETF akışları ve endeksler</span>
				</div>
				<Icon name="chevron-right" size={16} />
			</a>
			<a href="/turkiye" class="drawer-link">
				<div class="drawer-link-content">
					<strong>Türkiye Veri Merkezi</strong>
					<span>USDT primi, yerel borsalar ve derinlik</span>
				</div>
				<Icon name="chevron-right" size={16} />
			</a>
			<a href="/kac-tl" class="drawer-link">
				<div class="drawer-link-content">
					<strong>Kaç TL?</strong>
					<span>Canlı döviz ve kripto anlık çevirici</span>
				</div>
				<Icon name="chevron-right" size={16} />
			</a>
		</nav>

		<div class="drawer-footer">
			<a href="/araclar/yanlis-aga-gonderdim" class="drawer-emergency-btn">
				<Icon name="alert-triangle" size={16} />
				<span>Sorun Teşhisini Başlat</span>
			</a>
		</div>
	</div>
</header>

<CommandPalette />

<!-- Sticky Mobile Thumb Action Bar -->
<div class="mobile-thumb-bar" aria-label="Hızlı Erişim">
	<a href="/#sorunum-var" class="mobile-thumb-btn">
		<Icon name="alert-triangle" size={16} />
		<span>Sorunum Var — Teşhis Et</span>
	</a>
</div>

<script>
	function setupCockpitHeader() {
		const toggleBtn = document.getElementById('mobile-menu-toggle');
		const drawer = document.getElementById('mobile-drawer');

		if (toggleBtn && drawer) {
			toggleBtn.onclick = () => {
				const isOpen = drawer.classList.toggle('open');
				toggleBtn.classList.toggle('active', isOpen);
				toggleBtn.setAttribute('aria-expanded', String(isOpen));
				drawer.setAttribute('aria-hidden', String(!isOpen));
				document.body.style.overflow = isOpen ? 'hidden' : '';
			};

			drawer.querySelectorAll('a').forEach(a => {
				a.addEventListener('click', () => {
					drawer.classList.remove('open');
					toggleBtn.classList.remove('active');
					toggleBtn.setAttribute('aria-expanded', 'false');
					drawer.setAttribute('aria-hidden', 'true');
					document.body.style.overflow = '';
				});
			});
		}
	}

	setupCockpitHeader();
	document.addEventListener('astro:after-swap', setupCockpitHeader);
</script>

<style>
	.cockpit-header {
		position: sticky;
		top: 0;
		z-index: 90;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
		transition: background var(--duration-fast) var(--ease-standard);
	}

	.cockpit-header-inner {
		max-width: var(--max-w);
		margin: 0 auto;
		height: 56px;
		padding: 0 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	/* Brand */
	.brand-logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--text);
		flex-shrink: 0;
	}

	.brand-mark {
		width: 32px;
		height: 32px;
		border-radius: var(--radius-sm);
		background: var(--surface);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--signal);
	}

	.brand-title {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}

	.brand-name {
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.brand-tag {
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-subtle);
	}

	/* Nav */
	.cockpit-nav {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-link {
		padding: 6px 12px;
		font-size: 13px;
		font-weight: 500;
		color: var(--text-subtle);
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: all var(--duration-fast) var(--ease-standard);
	}

	.nav-link:hover {
		color: var(--text);
		background: var(--surface);
	}

	.nav-link.active {
		color: var(--signal);
		background: var(--surface);
		font-weight: 600;
	}

	/* Actions */
	.header-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.search-pill-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 36px;
		padding: 0 12px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--text-subtle);
		font-size: 13px;
		cursor: pointer;
		transition: all var(--duration-fast) var(--ease-standard);
	}

	.search-pill-btn:hover {
		background: var(--surface-hover);
		color: var(--text);
		border-color: var(--line-strong);
	}

	.search-shortcut {
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		padding: 1px 5px;
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--text-subtle);
	}

	.emergency-action-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 14px;
		background: var(--signal);
		color: #14110F;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		border-radius: var(--radius-sm);
		box-shadow: 0 1px 3px rgba(255, 106, 61, 0.25);
		transition: all var(--duration-fast) var(--ease-standard);
		white-space: nowrap;
	}

	.emergency-action-btn:hover {
		background: var(--signal-hover);
		transform: translateY(-1px);
	}

	/* Mobile Toggle */
	.mobile-menu-trigger {
		display: none;
		width: 36px;
		height: 36px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		cursor: pointer;
		padding: 0;
	}

	.menu-bar {
		width: 16px;
		height: 1.5px;
		background: var(--text);
		transition: transform var(--duration-fast) var(--ease-standard);
	}

	.mobile-menu-trigger.active .menu-bar:first-child {
		transform: translateY(3.25px) rotate(45deg);
	}

	.mobile-menu-trigger.active .menu-bar:last-child {
		transform: translateY(-3.25px) rotate(-45deg);
	}

	/* Mobile Drawer */
	.mobile-drawer {
		position: fixed;
		top: 56px;
		left: 0;
		right: 0;
		bottom: 0;
		background: var(--bg);
		border-top: 1px solid var(--line);
		padding: 16px;
		display: none;
		flex-direction: column;
		gap: 16px;
		overflow-y: auto;
		z-index: 89;
	}

	.mobile-drawer.open {
		display: flex;
	}

	.drawer-search-btn {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 14px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--text-subtle);
		font-size: 13px;
		text-align: left;
		cursor: pointer;
	}

	.drawer-nav {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.drawer-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px 14px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--text);
		text-decoration: none;
	}

	.drawer-link-content {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.drawer-link-content strong {
		font-size: 14px;
		font-weight: 600;
	}

	.drawer-link-content span {
		font-size: 12px;
		color: var(--text-muted);
	}

	.drawer-footer {
		margin-top: auto;
		padding-top: 12px;
	}

	.drawer-emergency-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		padding: 14px;
		background: var(--signal);
		color: #14110F;
		font-size: 14px;
		font-weight: 600;
		border-radius: var(--radius-sm);
		text-decoration: none;
	}

	/* Sticky Thumb Bar on Mobile */
	.mobile-thumb-bar {
		display: none;
		position: fixed;
		bottom: 12px;
		left: 16px;
		right: 16px;
		z-index: 85;
	}

	.mobile-thumb-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		height: 48px;
		background: var(--signal);
		color: #14110F;
		font-size: 14px;
		font-weight: 700;
		text-decoration: none;
		border-radius: var(--radius-md);
		box-shadow: 0 4px 16px rgba(255, 106, 61, 0.4);
	}

	@media (max-width: 900px) {
		.cockpit-nav {
			display: none;
		}
		.mobile-menu-trigger {
			display: flex;
		}
		.search-text,
		.search-shortcut {
			display: none;
		}
		.search-pill-btn {
			padding: 0 8px;
			width: 36px;
			justify-content: center;
		}
		.emergency-action-btn {
			display: none;
		}
		.mobile-thumb-bar {
			display: block;
		}
	}
</style>
