---
// src/components/CommandPalette.astro - Cockpit Command Palette (Zero emojis, 1.5px icons)
import Icon from './ui/Icon.astro';
---

<div class="cmd-palette-backdrop" id="cmd-backdrop" style="display: none;" aria-hidden="true">
	<div class="cmd-palette-modal" role="dialog" aria-modal="true" aria-label="Hızlı Arama ve Komut Paleti">
		<div class="cmd-search-header">
			<Icon name="search" size={18} class="cmd-icon" />
			<input
				type="text"
				id="cmd-input"
				class="cmd-input"
				placeholder="Araç, sorun veya rehber ara... (ESC ile kapat)"
				autocomplete="off"
			/>
			<kbd class="cmd-kbd">ESC</kbd>
		</div>

		<div class="cmd-results" id="cmd-results">
			<div class="cmd-group-title">Popüler Çözüm Araçları</div>

			<a href="/araclar/yanlis-aga-gonderdim" class="cmd-item" data-search="yanlış ağa gönderdim bep20 erc20 trc20 kurtarma fon para metamask">
				<div class="cmd-item-icon">
					<Icon name="alert-triangle" size={16} />
				</div>
				<div class="cmd-item-text">
					<strong>Yanlış Ağa Gönderdim Teşhisi</strong>
					<span>Ağ uyumsuzlukları, borsa yatırma hatası ve kurtarma yolları</span>
				</div>
				<Icon name="chevron-right" size={14} class="cmd-arrow" />
			</a>

			<a href="/araclar/takilan-islem" class="cmd-item" data-search="takılan işlem pending rbf nonce hızlandırma mempool onaylanmıyor">
				<div class="cmd-item-icon">
					<Icon name="activity" size={16} />
				</div>
				<div class="cmd-item-text">
					<strong>Takılan İşlem Teşhisi (Pending)</strong>
					<span>Mempool kuyruğu analizi, RBF ve Nonce hızlandırma şablonu</span>
				</div>
				<Icon name="chevron-right" size={14} class="cmd-arrow" />
			</a>

			<a href="/araclar/adres-ag-eslestirici" class="cmd-item" data-search="adres doğrulama kontrol ağ eşleştirici evm btc tron solana checksum">
				<div class="cmd-item-icon">
					<Icon name="shield-check" size={16} />
				</div>
				<div class="cmd-item-text">
					<strong>Adres ve Ağ Format Denetimi</strong>
					<span>Gönderim öncesi format, checksum ve ağ uyumluluk kontrolü</span>
				</div>
				<Icon name="chevron-right" size={14} class="cmd-arrow" />
			</a>

			<a href="/araclar/maliyet-karsilastirici" class="cmd-item" data-search="maliyet karşılaştırıcı komisyon spread ağ çekim ücreti en ucuz borsa">
				<div class="cmd-item-icon">
					<Icon name="layers" size={16} />
				</div>
				<div class="cmd-item-text">
					<strong>Gerçek Transfer Maliyeti Kıyaslayıcı</strong>
					<span>Komisyon, spread ve ağ çekim ücreti dahil net rota analizi</span>
				</div>
				<Icon name="chevron-right" size={14} class="cmd-arrow" />
			</a>

			<div class="cmd-group-title">Rehberler ve Sözlük</div>

			<a href="/rehber/usdt-yanlis-ag" class="cmd-item" data-search="rehber usdt yanlış ağ kurtarma">
				<div class="cmd-item-icon">
					<Icon name="file-text" size={16} />
				</div>
				<div class="cmd-item-text">
					<strong>Rehber: USDT'yi Yanlış Ağa Gönderdim</strong>
					<span>BEP-20 / ERC-20 / TRC-20 adımları ve borsa talep formu</span>
				</div>
				<Icon name="chevron-right" size={14} class="cmd-arrow" />
			</a>

			<a href="/rehber/metamask-takilan-islem" class="cmd-item" data-search="rehber metamask takılan işlem iptal hızlandırma nonce">
				<div class="cmd-item-icon">
					<Icon name="file-text" size={16} />
				</div>
				<div class="cmd-item-text">
					<strong>Rehber: MetaMask'ta Takılan İşlemi İptal Etme</strong>
					<span>Aynı nonce ile 0 ETH gönderme yöntemi</span>
				</div>
				<Icon name="chevron-right" size={14} class="cmd-arrow" />
			</a>

			<a href="/sozluk" class="cmd-item" data-search="sözlük terimler mempool slippage gas nonce seed">
				<div class="cmd-item-icon">
					<Icon name="help" size={16} />
				</div>
				<div class="cmd-item-text">
					<strong>Kripto Teknik Sözlüğü</strong>
					<span>Slippage, Mempool, Gwei, Nonce ve temel kavramlar</span>
				</div>
				<Icon name="chevron-right" size={14} class="cmd-arrow" />
			</a>
		</div>
	</div>
</div>

<script>
	function initCmdPalette() {
		const backdrop = document.getElementById('cmd-backdrop');
		const input = document.getElementById('cmd-input') as HTMLInputElement | null;
		const results = document.getElementById('cmd-results');
		const triggers = document.querySelectorAll('[data-open-cmd]');

		function openPalette() {
			if (!backdrop) return;
			backdrop.style.display = 'flex';
			backdrop.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
			setTimeout(() => input?.focus(), 50);
		}

		function closePalette() {
			if (!backdrop) return;
			backdrop.style.display = 'none';
			backdrop.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			if (input) input.value = '';
			filterItems('');
		}

		function filterItems(query: string) {
			if (!results) return;
			const q = query.trim().toLowerCase();
			const items = results.querySelectorAll<HTMLAnchorElement>('.cmd-item');
			const groups = results.querySelectorAll<HTMLElement>('.cmd-group-title');

			items.forEach(item => {
				const searchData = (item.getAttribute('data-search') || '') + ' ' + (item.textContent || '');
				const matches = !q || searchData.toLowerCase().includes(q);
				item.style.display = matches ? 'flex' : 'none';
			});

			groups.forEach(group => {
				group.style.display = q ? 'none' : 'block';
			});
		}

		triggers.forEach(t => t.addEventListener('click', (e) => {
			e.preventDefault();
			openPalette();
		}));

		backdrop?.addEventListener('click', (e) => {
			if (e.target === backdrop) closePalette();
		});

		window.addEventListener('keydown', (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
				e.preventDefault();
				if (backdrop?.style.display === 'none') {
					openPalette();
				} else {
					closePalette();
				}
			}
			if (e.key === 'Escape' && backdrop?.style.display !== 'none') {
				closePalette();
			}
		});

		input?.addEventListener('input', () => {
			filterItems(input.value);
		});
	}

	initCmdPalette();
	document.addEventListener('astro:after-swap', initCmdPalette);
</script>

<style>
	.cmd-palette-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(10, 8, 7, 0.75);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		z-index: 1000;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 80px 16px 24px;
	}

	.cmd-palette-modal {
		width: 100%;
		max-width: 580px;
		background: var(--surface);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-modal);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		max-height: 80vh;
	}

	.cmd-search-header {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px 18px;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
		color: var(--text-subtle);
	}

	.cmd-input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 14px;
	}

	.cmd-input::placeholder {
		color: var(--text-subtle);
	}

	.cmd-kbd {
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		padding: 2px 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.cmd-results {
		overflow-y: auto;
		padding: 10px 8px;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.cmd-group-title {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-subtle);
		padding: 10px 10px 4px;
	}

	.cmd-item {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 12px;
		border-radius: var(--radius-sm);
		color: var(--text);
		text-decoration: none;
		transition: background var(--duration-fast) var(--ease-standard);
	}

	.cmd-item:hover,
	.cmd-item:focus-visible {
		background: var(--surface-hover);
		outline: none;
	}

	.cmd-item-icon {
		width: 32px;
		height: 32px;
		border-radius: var(--radius-sm);
		background: var(--surface-hover);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--signal);
		flex-shrink: 0;
	}

	.cmd-item-text {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.cmd-item-text strong {
		font-size: 13px;
		font-weight: 600;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.cmd-item-text span {
		font-size: 12px;
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.cmd-arrow {
		color: var(--text-subtle);
		flex-shrink: 0;
	}

	.cmd-item:hover .cmd-arrow {
		color: var(--text);
	}
</style>
