---
// src/components/ui/StatusPill.astro - Cockpit Status & Data Flow Pill
import Icon from './Icon.astro';

interface Props {
	type?: 'live' | 'beta' | 'soon' | 'client' | 'server';
	status?: 'live' | 'beta' | 'soon';
	dataFlow?: 'client' | 'server';
	label?: string;
	class?: string;
}

const { type, status, dataFlow, label, class: className = '' } = Astro.props;

const resolvedType: 'live' | 'beta' | 'soon' | 'client' | 'server' =
	type || status || dataFlow || 'live';

const map = {
	live: {
		text: label || 'CANLI',
		icon: 'check' as const,
		cls: 'pill-live'
	},
	beta: {
		text: label || 'BETA',
		icon: 'activity' as const,
		cls: 'pill-beta'
	},
	soon: {
		text: label || 'YAKINDA',
		icon: 'clock' as const,
		cls: 'pill-soon'
	},
	client: {
		text: label || 'TAMAMEN TARAYICIDA',
		icon: 'shield-check' as const,
		cls: 'pill-client'
	},
	server: {
		text: label || 'SUNUCUYA İSTEK ATAR',
		icon: 'cpu' as const,
		cls: 'pill-server'
	}
};

const config = map[resolvedType] || map.live;
---

<span class={`status-pill ${config.cls} ${className}`}>
	<Icon name={config.icon} size={12} strokeWidth={2} />
	<span>{config.text}</span>
</span>

<style>
	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		height: 22px;
		padding: 0 8px;
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		white-space: nowrap;
		line-height: 1;
	}

	.pill-live {
		background: rgba(127, 214, 160, 0.12);
		color: var(--ok);
		border: 1px solid rgba(127, 214, 160, 0.3);
	}

	.pill-beta {
		background: rgba(242, 193, 78, 0.12);
		color: var(--warn);
		border: 1px solid rgba(242, 193, 78, 0.3);
	}

	.pill-soon {
		background: var(--surface);
		color: var(--text-subtle);
		border: 1px solid var(--line);
	}

	.pill-client {
		background: rgba(255, 106, 61, 0.1);
		color: var(--signal);
		border: 1px solid rgba(255, 106, 61, 0.25);
	}

	.pill-server {
		background: rgba(143, 184, 255, 0.12);
		color: var(--info);
		border: 1px solid rgba(143, 184, 255, 0.3);
	}
</style>
