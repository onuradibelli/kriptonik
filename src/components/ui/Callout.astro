---
import Icon from './Icon.astro';

interface Props {
	variant?: 'danger' | 'warn' | 'info' | 'ok';
	title?: string;
	class?: string;
}

const {
	variant = 'info',
	title,
	class: className = ''
} = Astro.props;

const iconMap = {
	danger: 'alert-triangle' as const,
	warn: 'alert-circle' as const,
	info: 'info' as const,
	ok: 'check-circle' as const
};
---

<div class={`ui-callout callout-${variant} ${className}`} role="alert">
	<div class="callout-icon-col">
		<Icon name={iconMap[variant]} size={18} strokeWidth={2} />
	</div>
	<div class="callout-body">
		{title && <strong class="callout-title">{title}</strong>}
		<div class="callout-text">
			<slot />
		</div>
	</div>
</div>

<style>
	.ui-callout {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding: 14px 16px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--line);
		background: var(--surface-2);
		margin: var(--space-4) 0;
	}

	.callout-icon-col {
		flex-shrink: 0;
		margin-top: 1px;
	}

	.callout-body {
		flex: 1;
		font-size: 13.5px;
		line-height: 1.55;
	}

	.callout-title {
		display: block;
		font-size: 13.5px;
		font-weight: 700;
		margin-bottom: 3px;
	}

	.callout-text :global(p) {
		margin: 0 0 6px;
		font-size: 13.5px;
	}

	.callout-text :global(p:last-child) {
		margin-bottom: 0;
	}

	/* Variants */
	.callout-danger {
		background: var(--danger-soft);
		border-color: rgba(255, 77, 94, 0.4);
		color: var(--text);
	}
	.callout-danger .callout-icon-col,
	.callout-danger .callout-title {
		color: var(--danger);
	}

	.callout-warn {
		background: var(--warn-soft);
		border-color: rgba(242, 193, 78, 0.4);
		color: var(--text);
	}
	.callout-warn .callout-icon-col,
	.callout-warn .callout-title {
		color: var(--warn);
	}

	.callout-info {
		background: var(--info-soft);
		border-color: rgba(143, 184, 255, 0.4);
		color: var(--text);
	}
	.callout-info .callout-icon-col,
	.callout-info .callout-title {
		color: var(--info);
	}

	.callout-ok {
		background: var(--ok-soft);
		border-color: rgba(127, 214, 160, 0.4);
		color: var(--text);
	}
	.callout-ok .callout-icon-col,
	.callout-ok .callout-title {
		color: var(--ok);
	}
</style>
