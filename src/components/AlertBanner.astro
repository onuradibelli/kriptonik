---
interface Props {
	id?: string;
	message?: string;
	level?: 'info' | 'warning' | 'danger';
}

const {
	id = 'kriptonik-alert',
	message = '',
	level = 'info',
} = Astro.props;
---

{message && (
	<div class={`alert-banner alert-${level}`} id={`banner-${id}`}>
		<div class="container banner-inner">
			<span class="banner-msg">{message}</span>
			<button type="button" class="banner-close" aria-label="Duyuruyu kapat" data-close-banner={`banner-${id}`}>
				✕
			</button>
		</div>
	</div>
)}

<script>
	function setupBanners() {
		const closeButtons = document.querySelectorAll('[data-close-banner]');
		closeButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				const targetId = btn.getAttribute('data-close-banner');
				if (targetId) {
					const el = document.getElementById(targetId);
					if (el) el.style.display = 'none';
				}
			});
		});
	}

	setupBanners();
	document.addEventListener('astro:after-swap', setupBanners);
</script>

<style>
	.alert-banner {
		padding: 8px 0;
		font-size: 13px;
		font-weight: 500;
		border-bottom: 1px solid var(--border);
	}

	.alert-info {
		background: var(--info-soft);
		color: var(--info);
	}

	.alert-warning {
		background: var(--warning-soft);
		color: var(--warning);
	}

	.alert-danger {
		background: var(--danger-soft);
		color: var(--danger);
	}

	.banner-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.banner-close {
		background: transparent;
		border: none;
		color: inherit;
		cursor: pointer;
		font-size: 14px;
		padding: 4px;
		opacity: 0.7;
	}

	.banner-close:hover {
		opacity: 1;
	}
</style>
