---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sistem Hatası (500) | Kriptonik" description="Geçici bir sistem aksaklığı meydana geldi.">
	<div class="container error-container">
		<div class="error-box card">
			<span class="error-badge">500</span>
			<h1 class="error-title">Geçici Bir Sorun Oluştu</h1>
			<p class="error-desc">
				İşleminiz gerçekleştirilirken beklenmeyen bir aksaklık yaşandı. Lütfen sayfayı yenilemeyi deneyin veya sistem durumunu kontrol edin.
			</p>

			<div class="quick-links">
				<a href="/" class="btn btn-primary btn-sm">Ana Sayfaya Dön</a>
				<a href="/durum" class="btn btn-secondary btn-sm">Sistem Durumu (Status)</a>
			</div>
		</div>
	</div>
</Layout>

<style>
	.error-container {
		padding: 80px 20px;
		display: flex;
		justify-content: center;
		text-align: center;
	}

	.error-box {
		max-width: 540px;
		padding: 48px 32px;
	}

	.error-badge {
		font-family: 'JetBrains Mono', monospace;
		font-size: 64px;
		font-weight: 800;
		color: var(--danger);
		line-height: 1;
		display: block;
		margin-bottom: 16px;
	}

	.error-title {
		font-size: 26px;
		margin-bottom: 12px;
	}

	.error-desc {
		color: var(--text-muted);
		font-size: 14px;
		line-height: 1.6;
		margin-bottom: 28px;
	}

	.quick-links {
		display: flex;
		gap: 12px;
		justify-content: center;
	}
</style>
