---
import BaseLayout from '../layouts/BaseLayout.astro';

// Spec v3: Bölüm 2.4 Veri İndirme Merkezi (CC BY 4.0 Açık Veri Portalı)
const datasets = [
  {
    id: 'ttp',
    title: 'USDT/TL Tether Primi Tarihsel Serisi',
    category: 'Türkiye Verisi',
    updateFrequency: '30 saniye (Günlük özet serisi)',
    period: '2024 - Günümüz',
    format: 'CSV / JSON',
    size: '1.2 MB',
    description: 'BtcTurk, Paribu ve Binance TR hacim ağırlıklı medyan USDT fiyatının TCMB gösterge kuruna göre sapma yüzdeleri.',
    citation: 'Kriptonik (kriptonik.com) - USDT/TL Primi Veri Seti (CC BY 4.0)',
    downloadCsv: '/data/usdt-tl-primi-history.csv',
    downloadJson: '/api/v1/market/ticker'
  },
  {
    id: 'tls',
    title: 'TL Likidite ve Kayma (Slippage) Skoru',
    category: 'Türkiye Verisi',
    updateFrequency: 'Saatlik',
    period: '2024 - Günümüz',
    format: 'CSV / JSON',
    size: '850 KB',
    description: '10k, 100k ve 1M TL hacimli emir simülasyonları ve borsa bazında likidite derinlik metrikleri.',
    citation: 'Kriptonik (kriptonik.com) - TL Likidite Skoru Veri Seti (CC BY 4.0)',
    downloadCsv: '/data/tl-likidite-skoru.csv',
    downloadJson: '/api/v1/market/ticker'
  },
  {
    id: 'eam',
    title: 'ABD Spot Bitcoin ETF Günlük Net Akışları',
    category: 'ETF Verisi',
    updateFrequency: 'Her İşlem Günü',
    period: '11 Ocak 2024 - Günümüz',
    format: 'CSV / JSON',
    size: '420 KB',
    description: '11 ABD spot Bitcoin ETF fonunun resmi ihraççı NAV ve hisse değişimlerinden derlenmiş günlük net giriş/çıkış ve AUM rakamları.',
    citation: 'Kriptonik (kriptonik.com) - Spot Bitcoin ETF Akış Veri Seti (CC BY 4.0)',
    downloadCsv: '/data/spot-btc-etf-flows.csv',
    downloadJson: '/api/v1/market/ticker'
  },
  {
    id: 'fi',
    title: 'Perpetual Fonlama Oranları ve Fonlama Isısı',
    category: 'Türev Verisi',
    updateFrequency: '8 saatlik periyotlar',
    period: '2024 - Günümüz',
    format: 'CSV / JSON',
    size: '2.4 MB',
    description: 'Bybit, OKX ve Binance borsalarındaki BTC ve ETH vadeli işlem fonlama oranları ve açık pozisyon (OI) serileri.',
    citation: 'Kriptonik (kriptonik.com) - Kripto Fonlama Isısı Veri Seti (CC BY 4.0)',
    downloadCsv: '/data/funding-rates-history.csv',
    downloadJson: '/api/v1/market/ticker'
  },
  {
    id: 'snb',
    title: 'Stablecoin Net Basım / Yakım (Mint & Burn) Serisi',
    category: 'Stablecoin Verisi',
    updateFrequency: 'Günlük',
    period: '2023 - Günümüz',
    format: 'CSV / JSON',
    size: '680 KB',
    description: 'USDT ve USDC akıllı sözleşmelerindeki net hazine basım ve yakım olaylarının günlük agregasyonu.',
    citation: 'Kriptonik (kriptonik.com) - Stablecoin Net Basım Veri Seti (CC BY 4.0)',
    downloadCsv: '/data/stablecoin-mint-burn.csv',
    downloadJson: '/api/v1/market/ticker'
  }
];

const title = "Açık Veri Portalı & Veri İndirme (CSV / JSON) | Kriptonik";
const description = "Kriptonik tarafından hesaplanan Türkiye Tether primi, TL likidite skoru, ETF akışları ve türev piyasa veri serilerini CC BY 4.0 lisansıyla ücretsiz indirin.";
---

<BaseLayout title={title} description={description}>
  <div class="data-hub-page">
    <div class="container">
      
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Navigasyon">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <span class="current">Açık Veri Portalı</span>
      </nav>

      <!-- Header -->
      <div class="page-header">
        <div class="header-badges">
          <span class="open-data-badge">Creative Commons (CC BY 4.0)</span>
          <span class="academic-badge">Akademik & Gazetecilik Kullanımına Uygun</span>
        </div>
        <h1>Kriptonik Açık Veri Portalı</h1>
        <p class="lead">
          Kriptonik tarafından üretilen ve formüle edilen özgün endeksleri, Türkiye piyasası likidite serilerini 
          ve kurumsal ETF akışlarını araştırma, analiz ve haberlerinizde kullanmak üzere CSV ve JSON formatlarında indirebilirsiniz.
        </p>
      </div>

      <!-- License & Attribution Card -->
      <div class="license-banner">
        <div class="license-icon">⚖️</div>
        <div class="license-text">
          <h3>Kullanım ve Atıf Şartları (CC BY 4.0)</h3>
          <p>
            Bu sayfada sunulan tüm özgün veri setleri <strong>Creative Commons Attribution 4.0 International (CC BY 4.0)</strong> lisansı altındadır.
            Verileri ticari veya akademik amaçlarla serbestçe kullanabilir, uyarlayabilir ve yayımlayabilirsiniz. 
            Tek zorunluluk <strong>"Kaynak: Kriptonik (kriptonik.com)"</strong> şeklinde görünür bir atıf ve bağlantı bırakmaktır.
          </p>
        </div>
      </div>

      <!-- Dataset List -->
      <div class="dataset-list">
        {datasets.map((d) => (
          <div class="dataset-card" id={d.id}>
            <div class="dataset-header">
              <div>
                <span class="category-pill">{d.category}</span>
                <h2 class="dataset-title">{d.title}</h2>
              </div>
              <div class="dataset-meta-top">
                <span class="format-badge">{d.format}</span>
                <span class="size-badge">{d.size}</span>
              </div>
            </div>

            <p class="dataset-desc">{d.description}</p>

            <div class="dataset-specs">
              <div class="spec-item">
                <span class="spec-label">Güncelleme:</span>
                <span class="spec-val">{d.updateFrequency}</span>
              </div>
              <div class="spec-item">
                <span class="spec-label">Zaman Aralığı:</span>
                <span class="spec-val">{d.period}</span>
              </div>
              <div class="spec-item">
                <span class="spec-label">Zorunlu Atıf:</span>
                <span class="spec-val font-mono">{d.citation}</span>
              </div>
            </div>

            <div class="dataset-actions">
              <a href={d.downloadCsv} class="btn-download csv" download>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                CSV İndir
              </a>
              <a href={d.downloadJson} class="btn-download json" target="_blank">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                JSON API Uç Noktası
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .data-hub-page {
    padding: 32px 0 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb .current {
    color: var(--text);
    font-weight: 600;
  }

  .page-header {
    margin-bottom: 32px;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .open-data-badge {
    padding: 4px 10px;
    background: var(--primary-soft);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--primary);
  }

  .academic-badge {
    padding: 4px 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--text-muted);
  }

  h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }

  .lead {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 820px;
    margin: 0;
  }

  /* License Banner */
  .license-banner {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 36px;
  }

  .license-icon {
    font-size: 28px;
  }

  .license-text h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .license-text p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Dataset List */
  .dataset-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .dataset-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    transition: border-color 150ms ease;
  }

  .dataset-card:hover {
    border-color: rgba(16, 185, 129, 0.4);
  }

  .dataset-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
    gap: 16px;
  }

  .category-pill {
    display: inline-block;
    padding: 2px 8px;
    background: var(--surface-2);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .dataset-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
  }

  .dataset-meta-top {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .format-badge, .size-badge {
    padding: 4px 8px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .dataset-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 18px;
  }

  .dataset-specs {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spec-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 13px;
  }

  .spec-label {
    width: 120px;
    font-weight: 600;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .spec-val {
    color: var(--text);
  }

  .font-mono {
    font-family: var(--font-mono);
  }

  .dataset-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .btn-download.csv {
    background: var(--primary);
    color: #fff;
    border: 1px solid var(--primary);
  }

  .btn-download.csv:hover {
    background: #059669;
  }

  .btn-download.json {
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-download.json:hover {
    background: var(--surface-hover);
    border-color: var(--text-muted);
  }

  @media (max-width: 680px) {
    .dataset-header {
      flex-direction: column;
    }
    .spec-item {
      flex-direction: column;
      gap: 2px;
    }
    .spec-label {
      width: auto;
    }
  }
</style>
