// Kapsamlı Coin Listesi (Piyasa Değerine Göre İlk 20)
const marketCoins = [
	{ rank: 1, symbol: "BTC", name: "Bitcoin", priceUsd: 76160, priceTry: 3811800, change1h: 0.12, change24h: 2.14, change7d: 8.42, volume24h: 38500000000, marketCap: 1502000000000, category: "l1", sparkline: "M0,20 Q15,18 30,12 T60,8 T90,14 T120,4", trend: "up" },
	{ rank: 2, symbol: "ETH", name: "Ethereum", priceUsd: 2243, priceTry: 112260, change1h: -0.05, change24h: 1.45, change7d: 5.12, volume24h: 18200000000, marketCap: 270400000000, category: "l1", sparkline: "M0,18 Q15,22 30,15 T60,10 T90,8 T120,6", trend: "up" },
	{ rank: 3, symbol: "USDT", name: "Tether", priceUsd: 1.0001, priceTry: 50.12, change1h: 0.01, change24h: 0.08, change7d: 0.14, volume24h: 58400000000, marketCap: 120500000000, category: "stable", sparkline: "M0,12 L30,12 L60,11 L90,12 L120,12", trend: "neutral" },
	{ rank: 4, symbol: "SOL", name: "Solana", priceUsd: 90.50, priceTry: 4529, change1h: 0.45, change24h: 5.82, change7d: 14.60, volume24h: 6850000000, marketCap: 42600000000, category: "l1", sparkline: "M0,22 Q15,19 30,12 T60,6 T90,4 T120,2", trend: "up" },
