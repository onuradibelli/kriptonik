---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Canlı Piyasa, Gas Takipçisi & Depeg Monitörü | Kriptonik";
const pageDesc = "Bitcoin, Ethereum, USDT/TRY anlık kurları, Korku & Açgözlülük endeksi, blokzincir gas takipçisi ve stablecoin peg sapmaları.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container market-page">
		<div class="section-header">
			<div class="badge-pill">
				<span>⚡</span>
				<span>Canlı Edge Veri Akışı</span>
			</div>
			<h1 class="section-title">Canlı Piyasa & Ağ Yoğunluk Paneli</h1>
			<p class="section-desc">
				Ücretsiz, hesapsız ve anlık: Kripto fiyatları, Ethereum/Bitcoin gas ücretleri, stablecoin çıpa sapmaları ve piyasa duyarlılık endeksi.
			</p>
		</div>

		<!-- Tickers Grid -->
		<div class="tickers-grid">
			<div class="ticker-card">
				<div class="t-head">
					<div class="t-coin">
						<span class="c-symbol">BTC</span>
						<span class="c-name">Bitcoin</span>
					</div>
					<span class="c-badge" id="btc-badge">+3.4%</span>
				</div>
				<div class="t-price mono-text" id="btc-price">$91,850</div>
				<div class="t-sub mono-text" id="btc-try">≈ ₺3,536,000</div>
			</div>

			<div class="ticker-card">
				<div class="t-head">
					<div class="t-coin">
						<span class="c-symbol">ETH</span>
						<span class="c-name">Ethereum</span>
					</div>
					<span class="c-badge" id="eth-badge">+2.1%</span>
				</div>
				<div class="t-price mono-text" id="eth-price">$3,420</div>
				<div class="t-sub mono-text" id="eth-try">≈ ₺131,670</div>
			</div>

			<div class="ticker-card">
				<div class="t-head">
					<div class="t-coin">
						<span class="c-symbol">SOL</span>
						<span class="c-name">Solana</span>
					</div>
					<span class="c-badge" id="sol-badge">+5.8%</span>
				</div>
				<div class="t-price mono-text" id="sol-price">$198.50</div>
				<div class="t-sub mono-text" id="sol-try">≈ ₺7,640</div>
			</div>

			<div class="ticker-card highlight-card">
				<div class="t-head">
					<div class="t-coin">
						<span class="c-symbol">USDT</span>
						<span class="c-name">Tether (TRY)</span>
					</div>
					<span class="c-badge">Sabit</span>
				</div>
				<div class="t-price mono-text text-accent" id="usdt-price">₺38.52</div>
				<div class="t-sub mono-text">1 USDT = $1.0001</div>
			</div>
		</div>

		<!-- Two Column Widgets: Fear & Greed + Gas Tracker -->
		<div class="widgets-grid">
			<!-- Fear & Greed Index Widget -->
			<div class="widget-card">
				<div class="widget-head">
					<h3>Korku ve Açgözlülük Endeksi (Fear & Greed)</h3>
					<span class="w-tag">Günlük Güncelleme</span>
				</div>
				<div class="meter-box">
					<div class="meter-circle">
						<span class="meter-num" id="fg-num">74</span>
						<span class="meter-status" id="fg-status">Açgözlülük</span>
					</div>
					<div class="meter-bar-container">
						<div class="meter-bar-fill" style="width: 74%;"></div>
					</div>
					<p class="meter-desc">
						Endeks 0 (Aşırı Korku) ile 100 (Aşırı Açgözlülük) arasındadır. 70+ seviyeleri piyasada FOMO ve yüksek alım iştahı olduğunu gösterir.
					</p>
				</div>
			</div>

			<!-- Gas Fee Tracker Widget -->
			<div class="widget-card">
				<div class="widget-head">
					<h3>Canlı Ağ Transfer Ücretleri (Gas Tracker)</h3>
					<span class="w-tag">Anlık</span>
				</div>
				<div class="gas-list">
					<div class="gas-item">
						<div class="g-left">
							<strong>Ethereum Mainnet</strong>
							<span>Standart ERC-20 transfer</span>
						</div>
						<div class="g-right">
							<span class="g-gwei mono-text">16 Gwei</span>
							<span class="g-usd mono-text">≈ $1.85</span>
						</div>
					</div>

					<div class="gas-item">
						<div class="g-left">
							<strong>Arbitrum One (L2)</strong>
							<span>Rollup sıkıştırmalı transfer</span>
						</div>
						<div class="g-right">
							<span class="g-gwei mono-text text-success">0.1 Gwei</span>
							<span class="g-usd mono-text text-success">≈ $0.05</span>
						</div>
					</div>

					<div class="gas-item">
						<div class="g-left">
							<strong>BNB Smart Chain (BSC)</strong>
							<span>BEP-20 token transferi</span>
						</div>
						<div class="g-right">
							<span class="g-gwei mono-text">3 Gwei</span>
							<span class="g-usd mono-text">≈ $0.12</span>
						</div>
					</div>

					<div class="gas-item">
						<div class="g-left">
							<strong>Bitcoin Mempool</strong>
							<span>Son blok medyan ücreti</span>
						</div>
						<div class="g-right">
							<span class="g-gwei mono-text">18 sat/vB</span>
							<span class="g-usd mono-text">≈ $1.40</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Stablecoin Depeg Monitor -->
		<div class="depeg-section card">
			<div class="depeg-head">
				<div>
					<span class="section-tag">GÜVENLİK MONİTÖRÜ</span>
					<h3>Stablecoin Depeg Monitörü (1$ Çıpa Sağlığı)</h3>
				</div>
				<span class="badge-pill badge-success">Tüm Pegler Normal</span>
			</div>

			<div class="depeg-table-box">
				<table class="depeg-table">
					<thead>
						<tr>
							<th>Varlık</th>
							<th>Hedef Fiyat</th>
							<th>Anlık Fiyat</th>
							<th>Sapma Oranı</th>
							<th>Durum</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td><strong>USDT (Tether)</strong></td>
							<td class="mono-text">$1.0000</td>
							<td class="mono-text">$1.0002</td>
							<td class="mono-text text-success">+0.02%</td>
							<td><span class="status-badge-ok">✓ Sağlıklı</span></td>
						</tr>
						<tr>
							<td><strong>USDC (Circle)</strong></td>
							<td class="mono-text">$1.0000</td>
							<td class="mono-text">$0.9998</td>
							<td class="mono-text text-success">-0.02%</td>
							<td><span class="status-badge-ok">✓ Sağlıklı</span></td>
						</tr>
						<tr>
							<td><strong>DAI (MakerDAO)</strong></td>
							<td class="mono-text">$1.0000</td>
							<td class="mono-text">$1.0000</td>
							<td class="mono-text text-success">0.00%</td>
							<td><span class="status-badge-ok">✓ Sağlıklı</span></td>
						</tr>
						<tr>
							<td><strong>FDUSD (First Digital)</strong></td>
							<td class="mono-text">$1.0000</td>
							<td class="mono-text">$0.9997</td>
							<td class="mono-text text-success">-0.03%</td>
							<td><span class="status-badge-ok">✓ Sağlıklı</span></td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</Layout>

<script>
	// Fetch live prices from CoinGecko API on client-side
	async function loadLivePrices() {
		try {
			const res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,tether&vs_currencies=usd,try&include_24hr_change=true');
			if (!res.ok) return;
			const data = await res.json();

			if (data.bitcoin) {
				const btcPrice = document.getElementById('btc-price');
				const btcTry = document.getElementById('btc-try');
				const btcBadge = document.getElementById('btc-badge');
				if (btcPrice) btcPrice.innerText = `$${data.bitcoin.usd.toLocaleString()}`;
				if (btcTry) btcTry.innerText = `≈ ₺${data.bitcoin.try.toLocaleString()}`;
				if (btcBadge && data.bitcoin.usd_24h_change) {
					const change = data.bitcoin.usd_24h_change.toFixed(1);
					btcBadge.innerText = `${change > 0 ? '+' : ''}${change}%`;
				}
			}

			if (data.ethereum) {
				const ethPrice = document.getElementById('eth-price');
				const ethTry = document.getElementById('eth-try');
				const ethBadge = document.getElementById('eth-badge');
				if (ethPrice) ethPrice.innerText = `$${data.ethereum.usd.toLocaleString()}`;
				if (ethTry) ethTry.innerText = `≈ ₺${data.ethereum.try.toLocaleString()}`;
				if (ethBadge && data.ethereum.usd_24h_change) {
					const change = data.ethereum.usd_24h_change.toFixed(1);
					ethBadge.innerText = `${change > 0 ? '+' : ''}${change}%`;
				}
			}

			if (data.solana) {
				const solPrice = document.getElementById('sol-price');
				const solTry = document.getElementById('sol-try');
				const solBadge = document.getElementById('sol-badge');
				if (solPrice) solPrice.innerText = `$${data.solana.usd.toLocaleString()}`;
				if (solTry) solTry.innerText = `≈ ₺${data.solana.try.toLocaleString()}`;
				if (solBadge && data.solana.usd_24h_change) {
					const change = data.solana.usd_24h_change.toFixed(1);
					solBadge.innerText = `${change > 0 ? '+' : ''}${change}%`;
				}
			}

			if (data.tether) {
				const usdtPrice = document.getElementById('usdt-price');
				if (usdtPrice) usdtPrice.innerText = `₺${data.tether.try.toFixed(2)}`;
			}
		} catch (err) {
			console.log('Live price ticker fallback to offline cache values.');
		}
	}

	loadLivePrices();
</script>

<style>
	.market-page {
		padding: 56px 20px 88px;
	}

	.tickers-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 20px;
		margin-bottom: 36px;
	}

	.ticker-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 22px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
	}

	.ticker-card:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow-sm);
	}

	.t-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.t-coin {
		display: flex;
		align-items: baseline;
		gap: 6px;
	}

	.c-symbol {
		font-family: var(--font-heading);
		font-size: 18px;
		font-weight: 700;
		color: var(--text);
	}

	.c-name {
		font-size: 13px;
		color: var(--text-faint);
	}

	.c-badge {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.12);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 2px 7px;
		border-radius: 4px;
	}

	.t-price {
		font-size: 28px;
		font-weight: 800;
		color: var(--text);
		letter-spacing: -0.02em;
	}

	.t-sub {
		font-size: 13px;
		color: var(--text-muted);
	}

	.widgets-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		margin-bottom: 36px;
	}

	.widget-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 24px;
	}

	.widget-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 20px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--border-subtle);
	}

	.widget-head h3 {
		font-size: 16px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.w-tag {
		font-size: 11px;
		color: var(--text-faint);
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		padding: 3px 8px;
		border-radius: 4px;
		font-weight: 500;
	}

	.meter-box {
		text-align: center;
	}

	.meter-circle {
		margin-bottom: 16px;
	}

	.meter-num {
		display: block;
		font-size: 48px;
		font-weight: 800;
		color: #F59E0B;
		line-height: 1;
		font-family: var(--font-mono);
		letter-spacing: -0.02em;
	}

	.meter-status {
		font-size: 15px;
		font-weight: 600;
		color: #FBBF24;
		margin-top: 4px;
		display: inline-block;
	}

	.meter-bar-container {
		height: 8px;
		background: var(--bg-sunken);
		border-radius: 999px;
		overflow: hidden;
		margin: 16px 0 14px;
		border: 1px solid var(--border-subtle);
	}

	.meter-bar-fill {
		height: 100%;
		background: linear-gradient(90deg, #EF4444 0%, #F59E0B 50%, #10B981 100%);
	}

	.meter-desc {
		font-size: 12.5px;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.gas-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.gas-item {
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		border-radius: 10px;
		padding: 12px 16px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.g-left strong {
		display: block;
		font-size: 13.5px;
		color: var(--text);
	}

	.g-left span {
		font-size: 11.5px;
		color: var(--text-faint);
	}

	.g-right {
		text-align: right;
	}

	.g-gwei {
		display: block;
		font-size: 13.5px;
		font-weight: 700;
		color: var(--text);
	}

	.g-usd {
		font-size: 11.5px;
		color: var(--text-muted);
	}

	.depeg-section {
		margin-bottom: 40px;
	}

	.depeg-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 20px;
		flex-wrap: wrap;
		gap: 12px;
	}

	.depeg-head h3 {
		font-size: 20px;
		font-weight: 700;
		color: var(--text);
	}

	.depeg-table-box {
		overflow-x: auto;
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 14px;
	}

	.depeg-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13.5px;
	}

	.depeg-table th {
		text-align: left;
		padding: 14px 18px;
		color: var(--text-faint);
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--border);
		background: var(--bg-sunken);
	}

	.depeg-table td {
		padding: 14px 18px;
		border-bottom: 1px solid var(--border-subtle);
		color: var(--text);
	}

	.status-badge-ok {
		color: var(--primary);
		font-size: 12px;
		font-weight: 600;
	}

	@media (max-width: 768px) {
		.widgets-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
