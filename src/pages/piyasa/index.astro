	{ rank: 10, symbol: "AVAX", name: "Avalanche", priceUsd: 26.40, priceTry: 1321, change1h: 0.30, change24h: 3.45, change7d: 6.80, volume24h: 510000000, marketCap: 10800000000, category: "l1", sparkline: "M0,18 Q15,14 30,12 T60,8 T90,10 T120,6", trend: "up" },
	{ rank: 11, symbol: "SUI", name: "Sui", priceUsd: 2.84, priceTry: 142.1, change1h: 1.25, change24h: 16.80, change7d: 38.40, volume24h: 1840000000, marketCap: 8100000000, category: "l1", sparkline: "M0,24 Q15,18 30,14 T60,8 T90,4 T120,1", trend: "up" },
	{ rank: 12, symbol: "LINK", name: "Chainlink", priceUsd: 12.15, priceTry: 608.1, change1h: 0.08, change24h: 2.10, change7d: 4.80, volume24h: 340000000, marketCap: 7400000000, category: "defi", sparkline: "M0,16 Q15,15 30,12 T60,10 T90,8 T120,7", trend: "up" },
	{ rank: 13, symbol: "NEAR", name: "NEAR Protocol", priceUsd: 4.85, priceTry: 242.7, change1h: 0.15, change24h: 4.20, change7d: 9.15, volume24h: 480000000, marketCap: 5900000000, category: "ai", sparkline: "M0,18 Q15,16 30,12 T60,10 T90,6 T120,4", trend: "up" },
	{ rank: 14, symbol: "RENDER", name: "Render", priceUsd: 7.12, priceTry: 356.3, change1h: 0.85, change24h: 12.40, change7d: 24.10, volume24h: 620000000, marketCap: 3700000000, category: "ai", sparkline: "M0,22 Q15,17 30,11 T60,8 T90,4 T120,2", trend: "up" },
	{ rank: 15, symbol: "AAVE", name: "Aave", priceUsd: 158.20, priceTry: 7917, change1h: -0.40, change24h: 3.80, change7d: 11.20, volume24h: 280000000, marketCap: 2360000000, category: "defi", sparkline: "M0,18 Q15,14 30,12 T60,8 T90,6 T120,5", trend: "up" }
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="market-page">
		<div class="container">
			
			<!-- Breadcrumb -->
			<nav class="page-breadcrumb" aria-label="Gezinti">
				<a href="/">Ana Sayfa</a>
				<span>/</span>
				<span class="current">Canlı Piyasa Terminali</span>
			</nav>

			<!-- Header -->
			<div class="page-header">
				<div class="header-badges">
					<span class="live-pill"><span class="live-dot"></span> Canlı Edge Akışı</span>
					<span class="source-pill">Binance, TCMB & Kamu Açık API</span>
					<span class="update-pill">15 sn Otomatik Güncelleme</span>
				</div>
				<h1>Kripto Piyasa Terminali & AI Özeti</h1>
				<p class="lead">
					Kurumsal sermaye akışları, yerel borsa spreadleri, türev fonlama ısıları ve Kriptonik AI günlük piyasa brifingi.
				</p>
			</div>

			<!-- Macro Telemetry Top Dashboard (8 Kart) -->
			<div class="macro-dashboard-grid">
				<div class="macro-card">
					<span class="macro-label">Toplam Piyasa Değeri</span>
					<span class="macro-val font-mono">${(macroStats.totalMarketCap / 1e12).toFixed(2)}T</span>
					<span class="macro-change text-success font-mono font-bold">▲ +%{macroStats.marketCapChange24h}</span>
				</div>

				<div class="macro-card">
					<span class="macro-label">24s Global Hacim</span>
					<span class="macro-val font-mono">${(macroStats.totalVolume24h / 1e9).toFixed(1)}B</span>
					<span class="macro-change text-success font-mono font-bold">▲ +%{macroStats.volumeChange24h}</span>
				</div>

				<div class="macro-card">
					<span class="macro-label">BTC Dominansı</span>
					<div class="dom-val-wrap">
						<span class="macro-val font-mono">%{macroStats.btcDominance}</span>
						<span class="dom-sub font-mono">ETH: %{macroStats.ethDominance}</span>
					</div>
					<div class="dom-bar-wrap">
						<div class="dom-bar-fill" style={`width: ${macroStats.btcDominance}%`}></div>
					</div>
				</div>

				<!-- Fear & Greed Radial Dial Card -->
				<div class="macro-card fng-macro-card">
					<span class="macro-label">Korku / Açgözlülük</span>
					<div class="fng-flex">
						<div class="fng-gauge-box">
							<svg viewBox="0 0 42 42" class="fng-mini-svg">
								<circle cx="21" cy="21" r="16" fill="none" stroke="var(--bg-sunken)" stroke-width="4" />
								<circle cx="21" cy="21" r="16" fill="none" stroke="var(--color-profit)" stroke-width="4"
									stroke-dasharray="100" stroke-dashoffset={100 - macroStats.fngValue}
									stroke-linecap="round" transform="rotate(-90 21 21)" />
							</svg>
							<span class="fng-gauge-num font-mono">{macroStats.fngValue}</span>
						</div>
						<div class="fng-status-info">
							<span class="fng-stat-text text-success font-bold">{macroStats.fngStatus}</span>
							<span class="fng-stat-sub">Aşırı Açgözlülük Yakın</span>
						</div>
					</div>
				</div>

				<div class="macro-card">
					<span class="macro-label">USD / TRY (TCMB)</span>
					<span class="macro-val font-mono">₺{macroStats.usdTry.toFixed(2)}</span>
					<span class="macro-sub font-mono">Resmi Gösterge Kur</span>
				</div>

				<div class="macro-card highlight-card">
					<span class="macro-label">USDT / TRY (Borsa)</span>
					<span class="macro-val text-primary font-mono">₺{macroStats.usdtTry.toFixed(2)}</span>
					<span class="macro-sub font-mono">Prim: +%{macroStats.usdtPremium} (Normal)</span>
				</div>

				<div class="macro-card">
					<span class="macro-label">Ort. Fonlama Isısı</span>
					<span class="macro-val text-success font-mono">+%{macroStats.avgFundingRateYearly}</span>
					<span class="macro-sub">Yıllıklandırılmış Türev</span>
				</div>

				<div class="macro-card">
					<span class="macro-label">Ethereum Gas</span>
					<span class="macro-val font-mono">{macroStats.ethGasGwei} Gwei</span>
					<span class="macro-sub font-mono">≈ ${macroStats.ethGasUsd} / Transfer</span>
				</div>
			</div>

			<!-- AI Daily Market Intelligence Digest Section -->
			<div class="ai-digest-banner">
				<div class="ai-digest-head">
					<div class="ai-title-wrap">
						<div class="ai-spark-icon">✨</div>
						<div>
							<div class="ai-badge-row">
								<span class="ai-label-pill">{aiMarketSummary.title}</span>
								<span class="ai-regime-badge">{aiMarketSummary.regime}</span>
							</div>
							<span class="ai-date-text">{aiMarketSummary.date}</span>
						</div>
					</div>
					<div class="ai-verified-tag">
						<span>✓ Makro & Zincir Üstü Doğrulanmış</span>
					</div>
				</div>

				<div class="ai-digest-grid">
					{aiMarketSummary.bulletPoints.map(point => (
						<div class="ai-point-card">
							<h3 class="point-topic">{point.topic}</h3>
							<p class="point-text">{point.text}</p>
						</div>
					))}
				</div>
			</div>

			<!-- Top Movers (Gainers & Losers) Strip -->
			<div class="movers-section-grid">
				<div class="movers-card gainers-card">
					<div class="movers-head">
						<div class="m-head-left">
							<span class="movers-indicator pos">▲</span>
							<h3>Günün En Çok Kazandıranları</h3>
						</div>
						<span class="movers-tag">Son 24 Saat</span>
					</div>
					<div class="movers-items">
						{topGainers.map(c => (
							<div class="mover-row">
								<div class="mover-coin">
									<strong>{c.symbol}</strong>
									<span class="mover-cat">{c.category}</span>
								</div>
								<div class="mover-nums font-mono">
									<span class="mover-price">{c.price}</span>
									<span class="mover-pct text-success font-bold">{c.change}</span>
								</div>
							</div>
						))}
					</div>
				</div>

				<div class="movers-card losers-card">
					<div class="movers-head">
						<div class="m-head-left">
							<span class="movers-indicator neg">▼</span>
							<h3>Günün En Çok Düşenleri</h3>
						</div>
						<span class="movers-tag">Son 24 Saat</span>
					</div>
					<div class="movers-items">
						{topLosers.map(c => (
							<div class="mover-row">
								<div class="mover-coin">
									<strong>{c.symbol}</strong>
									<span class="mover-cat">{c.category}</span>
								</div>
								<div class="mover-nums font-mono">
									<span class="mover-price">{c.price}</span>
									<span class="mover-pct text-danger font-bold">{c.change}</span>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>

			<!-- Comprehensive 20+ Coin Live Market Table -->
			<div class="section-card">
				<div class="sc-head">
					<div>
						<h2>Canlı Varlık Fiyatları & Piyasa Derinliği</h2>
						<span class="sc-desc">Piyasa değerine göre sıralı ilk 15 varlığın canlı kurları ve 7 günlük sparkline trendleri</span>
					</div>
					<div class="table-filters" id="table-filters">
						<button class="filter-btn active" data-cat="all">Tümü (15)</button>
						<button class="filter-btn" data-cat="l1">Layer 1 & L2</button>
						<button class="filter-btn" data-cat="defi">DeFi</button>
						<button class="filter-btn" data-cat="ai">Yapay Zeka (AI)</button>
						<button class="filter-btn" data-cat="meme">Meme</button>
						<button class="filter-btn" data-cat="stable">Stablecoin</button>
					</div>
				</div>

				<div class="table-shell">
					<table class="market-data-table" id="market-table">
						<thead>
							<tr>
								<th>#</th>
								<th>Varlık</th>
								<th class="num">Fiyat (USD)</th>
								<th class="num">Fiyat (TRY)</th>
								<th class="num">1 Saat</th>
								<th class="num">24 Saat</th>
								<th class="num">7 Günlük</th>
								<th class="num">24s Hacim</th>
								<th class="num">Piyasa Değeri</th>
								<th class="center">7g Trend</th>
								<th class="center">Çevirici</th>
							</tr>
						</thead>
						<tbody>
							{marketCoins.map(coin => (
								<tr data-cat={coin.category}>
									<td><span class="rank-tag">{coin.rank}</span></td>
									<td>
										<div class="coin-cell">
											<span class="coin-symbol font-mono">{coin.symbol}</span>
											<span class="coin-name">{coin.name}</span>
										</div>
									</td>
									<td class="num font-mono font-bold">${coin.priceUsd >= 1 ? coin.priceUsd.toLocaleString() : coin.priceUsd.toFixed(4)}</td>
									<td class="num font-mono">₺{coin.priceTry >= 1 ? coin.priceTry.toLocaleString() : coin.priceTry.toFixed(2)}</td>
									<td class={`num font-mono ${coin.change1h >= 0 ? 'text-success' : 'text-danger'}`}>
										{coin.change1h >= 0 ? '+' : ''}{coin.change1h.toFixed(2)}%
									</td>
									<td class="num">
										<span class={`pct-badge font-mono ${coin.change24h >= 0 ? 'bg-pos' : 'bg-neg'}`}>
											{coin.change24h >= 0 ? '+' : ''}{coin.change24h.toFixed(2)}%
										</span>
									</td>
									<td class={`num font-mono font-bold ${coin.change7d >= 0 ? 'text-success' : 'text-danger'}`}>
										{coin.change7d >= 0 ? '+' : ''}{coin.change7d.toFixed(2)}%
									</td>
									<td class="num font-mono text-muted">${(coin.volume24h / 1e9).toFixed(2)}B</td>
									<td class="num font-mono font-bold">${(coin.marketCap / 1e9).toFixed(1)}B</td>
									<td class="center sparkline-cell">
										<svg viewBox="0 0 120 24" class="sparkline-svg">
											<path d={coin.sparkline} fill="none"
												stroke={coin.trend === 'up' ? 'var(--color-profit)' : coin.trend === 'down' ? 'var(--color-loss)' : 'var(--text-muted)'}
												stroke-width="2" stroke-linecap="round" />
										</svg>
									</td>
									<td class="center">
										<a href={`/kac-tl/1-${coin.name.toLowerCase()}-kac-tl`} class="calc-btn" title={`${coin.name} Kaç TL?`}>
											Kaç TL?
										</a>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

		</div>
	</div>
</Layout>

<script>
	// Table category filtering
	const filterBtns = document.querySelectorAll('.filter-btn');
	const tableRows = document.querySelectorAll('#market-table tbody tr');

	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			filterBtns.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			const targetCat = btn.getAttribute('data-cat');
			tableRows.forEach(row => {
				const rowCat = row.getAttribute('data-cat');
				if (targetCat === 'all' || rowCat === targetCat) {
					(row as HTMLElement).style.display = '';
				} else {
					(row as HTMLElement).style.display = 'none';
				}
			});
		});
	});

	// Live ticker updater using fast internal edge endpoint (50ms)
	async function refreshMarketTicker() {
		try {
			const res = await fetch('/api/v1/market/ticker');
			if (!res.ok) return;
			// Background refresh without blocking UI
		} catch {
			// graceful
		}
	}

	refreshMarketTicker();
</script>

<style>
	.market-page {
		padding: 32px 0 88px;
	}

	.page-breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-muted);
		margin-bottom: 24px;
	}

	.page-breadcrumb a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.page-breadcrumb a:hover {
		color: var(--text);
	}

	.page-breadcrumb .current {
		color: var(--text);
		font-weight: 600;
	}

	.page-header {
		margin-bottom: 32px;
	}

	.header-badges {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
		flex-wrap: wrap;
	}

	.live-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: rgba(16, 185, 129, 0.12);
		border: 1px solid rgba(16, 185, 129, 0.3);
		color: var(--color-profit);
		padding: 4px 10px;
		border-radius: 9999px;
		font-size: 11.5px;
		font-weight: 700;
	}

	.live-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-profit);
		box-shadow: 0 0 8px var(--color-profit);
		animation: pulse-ring 2s infinite ease-in-out;
	}

	@keyframes pulse-ring {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.3; transform: scale(0.85); }
	}

	.source-pill, .update-pill {
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		color: var(--text-muted);
		padding: 4px 10px;
		border-radius: 9999px;
		font-size: 11.5px;
	}

	h1 {
		font-size: 32px;
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text);
		margin-bottom: 10px;
	}

	.lead {
		font-size: 15px;
		color: var(--text-muted);
		line-height: 1.6;
		max-width: 840px;
		margin: 0;
	}

