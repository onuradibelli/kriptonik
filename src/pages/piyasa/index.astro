	{ rank: 7, symbol: "XRP", name: "Ripple", priceUsd: 0.528, priceTry: 26.42, change1h: -0.22, change24h: -1.80, change7d: -0.45, volume24h: 1150000000, marketCap: 29800000000, category: "payment", sparkline: "M0,8 Q15,10 30,14 T60,16 T90,18 T120,20", trend: "down" },
