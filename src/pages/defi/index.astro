---
import Layout from '../../layouts/Layout.astro';

// Spec v3: Modül 8 - E1, E2, E3, E4 DeFi Verisi
const defiStats = {
  totalTvlUsd: 94250000000,
  tvl24hChange: 1.84,
  dexVolume24h: 7420000000,
  dexVolumeChange: -4.12,
  protocolFees24h: 18900000,
  activeProtocols: 3420,
  lastUpdate: new Date().toISOString()
};

// Zincir Karşılaştırması (E4)
const chainComparisons = [
  { rank: 1, name: 'Ethereum', symbol: 'ETH', tvl: 54800000000, tvlShare: 58.1, dex24h: 2150000000, fees24h: 8200000, stablecoins: 92400000000, change7d: 3.2 },
  { rank: 2, name: 'Solana', symbol: 'SOL', tvl: 7850000000, tvlShare: 8.3, dex24h: 2450000000, fees24h: 3400000, stablecoins: 4600000000, change7d: 12.8 },
  { rank: 3, name: 'BNB Chain', symbol: 'BSC', tvl: 5600000000, tvlShare: 5.9, dex24h: 720000000, fees24h: 1100000, stablecoins: 5200000000, change7d: -1.4 },
  { rank: 4, name: 'Arbitrum', symbol: 'ARB', tvl: 3450000000, tvlShare: 3.7, dex24h: 680000000, fees24h: 420000, stablecoins: 4850000000, change7d: 0.9 },
  { rank: 5, name: 'Base', symbol: 'BASE', tvl: 2950000000, tvlShare: 3.1, dex24h: 840000000, fees24h: 310000, stablecoins: 3600000000, change7d: 18.4 },
  { rank: 6, name: 'Avalanche', symbol: 'AVAX', tvl: 1250000000, tvlShare: 1.3, dex24h: 140000000, fees24h: 180000, stablecoins: 1750000000, change7d: -2.1 },
  { rank: 7, name: 'Polygon', symbol: 'POL', tvl: 1080000000, tvlShare: 1.1, dex24h: 195000000, fees24h: 210000, stablecoins: 2100000000, change7d: 1.5 },
  { rank: 8, name: 'Sui', symbol: 'SUI', tvl: 1020000000, tvlShare: 1.1, dex24h: 250000000, fees24h: 190000, stablecoins: 520000000, change7d: 22.1 }
];

// Lider Protokoller (E1 & E3)
const topProtocols = [
  { name: 'Lido', category: 'Liquid Staking', chains: ['Ethereum'], tvl: 28400000000, share: 30.1, fee24h: 2100000, rev24h: 210000 },
  { name: 'Aave v3', category: 'Lending', chains: ['Multi-Chain (14)'], tvl: 14200000000, share: 15.1, fee24h: 1850000, rev24h: 370000 },
  { name: 'EigenLayer', category: 'Restaking', chains: ['Ethereum'], tvl: 11800000000, share: 12.5, fee24h: 0, rev24h: 0 },
  { name: 'Uniswap v3', category: 'DEX', chains: ['Multi-Chain (18)'], tvl: 5400000000, share: 5.7, fee24h: 3200000, rev24h: 512000 },
  { name: 'MakerDAO (Sky)', category: 'CDP / Stablecoin', chains: ['Ethereum'], tvl: 4950000000, share: 5.2, fee24h: 890000, rev24h: 890000 },
  { name: 'Raydium', category: 'DEX', chains: ['Solana'], tvl: 1850000000, share: 2.0, fee24h: 3100000, rev24h: 372000 }
];

function formatBillion(val: number) {
  return `$${(val / 1e9).toFixed(2)}B`;
}

function formatMillion(val: number) {
  return `$${(val / 1e6).toFixed(1)}M`;
}

const title = "DeFi Verileri: Toplam TVL, DEX Hacimleri ve Protokol Ücretleri | Kriptonik";
const description = "Merkeziyetsiz finans (DeFi) ekosisteminin canlı metrikleri: Toplam kilitli değer (TVL), 24 saatlik DEX hacimleri, zincir pazar payları ve protokol gelir tablosu.";
---

<Layout title={title} description={description}>
  <div class="defi-page">
    <div class="container">
      
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Navigasyon">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <span class="current">DeFi Verileri</span>
      </nav>

      <!-- Header -->
      <div class="page-header">
        <div class="header-badges">
          <span class="live-pulse-badge">
            <span class="pulse-dot"></span> Canlı Veri (5 dk gecikmeli)
          </span>
          <span class="source-badge">Kaynak: DefiLlama & Kamu Açık API</span>
        </div>
        <h1>DeFi Metrikleri & Protokol Analizi</h1>
        <p class="lead">
          Merkeziyetsiz finans protokollerinde kilitli toplam varlık (TVL), zincir bazlı pazar payı, 
          merkeziyetsiz borsa (DEX) hacimleri ve üretilen gerçek protokol gelirleri.
        </p>
      </div>

      <!-- Quick KPI Cards -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">Toplam Kilitli Değer (TVL)</div>
          <div class="kpi-val">{formatBillion(defiStats.totalTvlUsd)}</div>
          <div class={`kpi-change ${defiStats.tvl24hChange >= 0 ? 'pos' : 'neg'}`}>
            {defiStats.tvl24hChange >= 0 ? '▲' : '▼'} %{Math.abs(defiStats.tvl24hChange)} (24s)
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-label">24s DEX Hacmi</div>
          <div class="kpi-val">{formatBillion(defiStats.dexVolume24h)}</div>
          <div class={`kpi-change ${defiStats.dexVolumeChange >= 0 ? 'pos' : 'neg'}`}>
            {defiStats.dexVolumeChange >= 0 ? '▲' : '▼'} %{Math.abs(defiStats.dexVolumeChange)} (24s)
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-label">24s Protokol Ücretleri</div>
          <div class="kpi-val">{formatMillion(defiStats.protocolFees24h)}</div>
          <div class="kpi-sub">Kullanıcıların ödediği komisyon</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-label">İzlenen Protokol Sayısı</div>
          <div class="kpi-val">{defiStats.activeProtocols.toLocaleString('tr-TR')}</div>
          <div class="kpi-sub">Çok zincirli akıllı sözleşmeler</div>
        </div>
      </div>

      <!-- Zincir Karşılaştırma Tablosu (E4) -->
      <section class="data-section">
        <div class="section-top">
          <div>
            <h2>Blokzincir DeFi Karşılaştırması</h2>
            <p>TVL, günlük DEX swap hacmi ve zincirdeki stablecoin likiditesinin oransal dağılımı.</p>
          </div>
        </div>

        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Zincir</th>
                <th class="num">TVL</th>
                <th class="num">TVL Payı</th>
                <th class="num">7g Değişim</th>
                <th class="num">24s DEX Hacmi</th>
                <th class="num">24s Ücretler</th>
                <th class="num">Stablecoin Arzı</th>
              </tr>
            </thead>
            <tbody>
              {chainComparisons.map((c) => (
                <tr>
                  <td><span class="rank-badge">{c.rank}</span></td>
                  <td>
                    <div class="chain-cell">
                      <strong>{c.name}</strong>
                      <span class="sym-badge">{c.symbol}</span>
                    </div>
                  </td>
                  <td class="num font-mono">{formatBillion(c.tvl)}</td>
                  <td class="num">
                    <div class="bar-cell">
                      <span>%{c.tvlShare.toFixed(1)}</span>
                      <div class="mini-bar">
                        <div class="fill" style={`width: ${Math.min(c.tvlShare, 100)}%`}></div>
                      </div>
                    </div>
                  </td>
                  <td class={`num font-mono ${c.change7d >= 0 ? 'text-green' : 'text-red'}`}>
                    {c.change7d >= 0 ? '+' : ''}%{c.change7d.toFixed(1)}
                  </td>
                  <td class="num font-mono">{formatBillion(c.dex24h)}</td>
                  <td class="num font-mono">{formatMillion(c.fees24h)}</td>
                  <td class="num font-mono">{formatBillion(c.stablecoins)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Lider Protokoller (E1 & E3) -->
      <section class="data-section">
        <div class="section-top">
          <div>
            <h2>Lider Protokoller & Ücret / Gelir Tablosu</h2>
            <p>En yüksek TVL'e sahip protokollerin kilitli varlık miktarları ve ürettikleri 24 saatlik gelirler.</p>
          </div>
        </div>

        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Protokol</th>
                <th>Kategori</th>
                <th>Dağıtım</th>
                <th class="num">Kilitli Değer (TVL)</th>
                <th class="num">Ekosistem Payı</th>
                <th class="num">24s Komisyon Geliri</th>
                <th class="num">Protokol Net Geliri</th>
              </tr>
            </thead>
            <tbody>
              {topProtocols.map((p) => (
                <tr>
                  <td><strong>{p.name}</strong></td>
                  <td><span class="category-tag">{p.category}</span></td>
                  <td><span class="chain-tag">{p.chains.join(', ')}</span></td>
                  <td class="num font-mono">{formatBillion(p.tvl)}</td>
                  <td class="num font-mono">%{p.share.toFixed(1)}</td>
                  <td class="num font-mono">{p.fee24h > 0 ? formatMillion(p.fee24h) : '-'}</td>
                  <td class="num font-mono">{p.rev24h > 0 ? formatMillion(p.rev24h) : '-'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Metodoloji & Şeffaflık Notları -->
      <section class="methodology-box">
        <h3>Metodoloji ve Veri Doğrulama</h3>
        <p>
          <strong>TVL (Total Value Locked):</strong> Protokollerin akıllı sözleşmelerinde kilitli duran token miktarlarının anlık ABD Doları karşılığıdır. Çifte sayımı (double counting) önlemek adına likit staking türevleri ve borç verme teminatları normalize edilmektedir.
        </p>
        <p>
          <strong>DEX Hacmi & Ücretler:</strong> Uniswap v2/v3, Curve, Raydium, PancakeSwap gibi otomatik piyasa yapıcı (AMM) havuzlarındaki fiili swap işlemlerinin hacmini ve likidite sağlayıcılar ile hazineye aktarılan komisyonları kapsar.
        </p>
        <div class="methodology-footer">
          <span>Veri Yaşı: 4 dakika önce güncellendi</span>
          <span>Lisans: CC BY 4.0 (Kaynak gösterilerek serbestçe kullanılabilir)</span>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .defi-page {
    padding: 32px 0 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb .current {
    color: var(--text);
    font-weight: 600;
  }

  .page-header {
    margin-bottom: 32px;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .live-pulse-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--primary-soft);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: var(--primary);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 6px var(--primary);
    animation: blink 1.6s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .source-badge {
    padding: 4px 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--text-muted);
  }

  h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }

  .lead {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 820px;
    margin: 0;
  }

  /* KPI Grid */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 36px;
  }

  .kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
  }

  .kpi-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }

  .kpi-val {
    font-size: 26px;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--text);
    margin-bottom: 6px;
  }

  .kpi-change {
    font-size: 12px;
    font-weight: 700;
  }

  .kpi-sub {
    font-size: 12px;
    color: var(--text-muted);
  }

  .pos { color: var(--color-profit); }
  .neg { color: var(--color-loss); }
  .text-green { color: var(--color-profit); }
  .text-red { color: var(--color-loss); }

  /* Sections */
  .data-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 32px;
  }

  .section-top {
    margin-bottom: 20px;
  }

  .section-top h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 6px;
  }

  .section-top p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }

  .data-table th {
    padding: 12px 14px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .data-table td {
    padding: 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    white-space: nowrap;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  .data-table tr:hover td {
    background: var(--surface-hover);
  }

  .num {
    text-align: right;
  }

  .font-mono {
    font-family: var(--font-mono);
  }

  .rank-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--surface-2);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .chain-cell {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sym-badge {
    padding: 2px 6px;
    background: var(--surface-2);
    border-radius: 4px;
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .bar-cell {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .mini-bar {
    width: 60px;
    height: 6px;
    background: var(--surface-2);
    border-radius: 3px;
    overflow: hidden;
  }

  .mini-bar .fill {
    height: 100%;
    background: var(--primary);
    border-radius: 3px;
  }

  .category-tag, .chain-tag {
    padding: 3px 8px;
    background: var(--surface-2);
    border-radius: 6px;
    font-size: 12px;
    color: var(--text-secondary);
  }

  .methodology-box {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
  }

  .methodology-box h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 12px;
  }

  .methodology-box p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 10px;
  }

  .methodology-footer {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 900px) {
    .kpi-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .kpi-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: 26px;
    }
  }
</style>
