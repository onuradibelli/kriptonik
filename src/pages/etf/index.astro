	{ d: "23 Eki", v: -79 }, { d: "24 Eki", v: 188 }, { d: "25 Eki", v: 402 }, { d: "28 Eki", v: 318 },
	{ d: "29 Eki", v: 479 }, { d: "30 Eki", v: 870 }, { d: "31 Eki", v: 893 }, { d: "1 Kas", v: -54 },
	{ d: "4 Kas", v: 394 }, { d: "5 Kas", v: 428 }
];

