	{ ticker: "ETHA", name: "iShares Ethereum Trust", issuer: "BlackRock", flowToday: "+$38.4M", aum: "$3.45 Mr", fee: "%0.25", share: "%36.4" },
	{ ticker: "FETH", name: "Fidelity Ethereum Fund", issuer: "Fidelity", flowToday: "+$18.2M", aum: "$1.82 Mr", fee: "%0.25", share: "%19.2" },
