---
import Layout from '../../layouts/Layout.astro';
import { currencies, conversionRoutes, calculateRate, formatNumberTR } from '../../data/conversions';

const pageTitle = "Canlı Kaç TL? Kripto Para ve Döviz Çevirici (Dolar, BTC, USDT) | Kriptonik";
const pageDesc = "1 Dolar kaç TL? 1 Bitcoin kaç TL? Canlı piyasa kurlarıyla döviz ve kripto para hesaplama, serbest piyasa, banka ve kripto borsa makas farkları.";

// Group routes by category for the directory grid
const categories = [
	{ id: 'dolar-tl', title: 'Dolar ➔ Türk Lirası (USD/TRY)', desc: '1 Dolar, 100 Dolar, 1000 Dolar canlı TL karşılığı ve Kapalıçarşı makası' },
	{ id: 'btc-tl', title: 'Bitcoin ➔ Türk Lirası (BTC/TRY)', desc: '1 BTC, 0.1 BTC canlı TL fiyatı ve Türk borsaları ortalaması' },
	{ id: 'usdt-tl', title: 'Tether (USDT) ➔ Türk Lirası (USDT/TRY)', desc: '1 USDT, 100 USDT karşılığı ve anlık Tether primi farkı' },
	{ id: 'eth-tl', title: 'Ethereum ➔ Türk Lirası (ETH/TRY)', desc: '1 ETH, 0.5 ETH canlı borsa fiyatı ve dönüşüm tablosu' },
	{ id: 'sol-tl', title: 'Solana ➔ Türk Lirası (SOL/TRY)', desc: '1 SOL, 10 SOL kaç TL? Güncel Solana kuru' },
	{ id: 'euro-tl', title: 'Euro ➔ Türk Lirası (EUR/TRY)', desc: '1 Euro, 100 Euro serbest piyasa ve TCMB kuru' },
	{ id: 'tl-dolar', title: 'Türk Lirası ➔ Dolar (TRY/USD)', desc: '1.000 TL, 10.000 TL, 50.000 TL kaç Dolar eder?' },
	{ id: 'tl-btc', title: 'Türk Lirası ➔ Bitcoin (TRY/BTC)', desc: '10.000 TL veya 100.000 TL ile kaç Bitcoin alınır?' },
	{ id: 'crypto-usd', title: 'Kripto ➔ Dolar (BTC/USD, ETH/USD)', desc: 'Bitcoin, Ethereum ve Solana kaç Dolar?' }
];

const faqItems = [
	{
		q: "Dolar ve USDT kuru neden birbirinden farklıdır?",
		a: "USDT (Tether), kripto para borsalarında 7/24 işlem gören ve arz-talep dengesine göre fiyatlanan dijital bir dolardır. Türkiye'deki bankacılık mesai saatleri dışında veya piyasa dalgalanmalarında, yerel borsalardaki USDT/TRY fiyatı serbest piyasa USD/TRY kurundan %0.5 ila %3 arasında primli veya iskontolu işlem görebilir. Bu farka 'Tether Primi' denir."
	},
	{
		q: "Kriptonik'teki kurlar ne sıklıkla güncellenir?",
		a: "Piyasa kurlarımız doğrudan küresel ve yerel borsa veri akışları üzerinden anlık olarak güncellenir. Bitcoin, Ethereum ve USDT fiyatları her 30 saniyede bir Cloudflare Edge Worker ağımız tarafından yenilenir."
	},
	{
		q: "Borsada kripto bozdururken aynı tutarı alabilir miyim?",
		a: "Dönüştürücüde gösterilen rakamlar tahtadaki orta (mid) fiyata dayanır. Gerçek bir borsada işlem yaparken borsa komisyonu (%0.05 - %0.25) ve tahtadaki alış-satış farkı (spread) nedeniyle elinize geçen net tutar küçük farklılıklar gösterebilir."
	},
	{
		q: "Serbest piyasa kuru ile TCMB kuru arasındaki fark nedir?",
		a: "TCMB (Türkiye Cumhuriyet Merkez Bankası) kuru her iş günü saat 15:30'da belirlenen gösterge niteliğinde bir kurdur. Serbest piyasa (Kapalıçarşı) ve bankalar arası piyasa ise anlık döviz talebine göre gün boyu değişkenlik gösterir."
	}
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebPage",
			"@id": "https://kriptonik.com/kac-tl#webpage",
			"url": "https://kriptonik.com/kac-tl",
			"name": pageTitle,
			"description": pageDesc,
			"isPartOf": { "@id": "https://kriptonik.com/#website" },
			"inLanguage": "tr-TR"
		},
		{
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": "https://kriptonik.com" },
				{ "@type": "ListItem", "position": 2, "name": "Kaç TL?", "item": "https://kriptonik.com/kac-tl" }
			]
		},
		{
			"@type": "FAQPage",
			"mainEntity": faqItems.map(item => ({
				"@type": "Question",
				"name": item.q,
				"acceptedAnswer": {
					"@type": "Answer",
					"text": item.a
				}
			}))
		}
	]
};
---

<Layout title={pageTitle} description={pageDesc}>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<div class="container kac-tl-hub-page">
		<!-- Breadcrumb -->
		<nav class="hub-breadcrumb" aria-label="Gezinti">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<span class="current">Kaç TL? (Canlı Çevirici)</span>
		</nav>

		<!-- Hero Section -->
		<div class="hub-hero">
			<div class="hub-badge">
				<span class="live-dot"></span>
				<span>CANLI PİYASA & SERBEST PİYASA HESAPLAYICI</span>
			</div>
			<h1 class="hub-title">Canlı Kaç TL? Kripto & Döviz Çevirici</h1>
			<p class="hub-sub">
				Dolar, Bitcoin, Ethereum ve USDT'nin anlık Türk Lirası karşılığını hesaplayın. Serbest piyasa, TCMB ve kripto borsa makas farklarını tek ekranda görün.
			</p>
		</div>

		<!-- Interactive Universal Converter Card -->
		<div class="converter-interactive-card">
			<div class="converter-box-header">
				<div class="cb-title">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
					<span>Hızlı Canlı Dönüştürücü</span>
				</div>
				<span class="cb-status">Canlı Veri Akışı</span>
			</div>

			<div class="converter-grid">
				<div class="conv-col">
					<label for="hub-amount">Miktar:</label>
					<div class="input-shell">
						<input type="number" id="hub-amount" value="100" min="0" step="any" class="conv-input" />
						<select id="hub-from" class="conv-select">
							<option value="USD" selected>USD - Dolar</option>
							<option value="EUR">EUR - Euro</option>
							<option value="BTC">BTC - Bitcoin</option>
							<option value="ETH">ETH - Ethereum</option>
							<option value="USDT">USDT - Tether</option>
							<option value="SOL">SOL - Solana</option>
							<option value="TRY">TRY - Türk Lirası</option>
						</select>
					</div>
				</div>

				<div class="conv-swap-btn" id="hub-swap" title="Yönü Değiştir">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/></svg>
				</div>

				<div class="conv-col">
					<label for="hub-to">Hedef Para Birimi:</label>
					<div class="input-shell">
						<input type="text" id="hub-result" value="3.852,00" readonly class="conv-input result-input font-mono" />
						<select id="hub-to" class="conv-select">
							<option value="TRY" selected>TRY - Türk Lirası</option>
							<option value="USD">USD - Dolar</option>
							<option value="EUR">EUR - Euro</option>
							<option value="BTC">BTC - Bitcoin</option>
							<option value="ETH">ETH - Ethereum</option>
							<option value="USDT">USDT - Tether</option>
							<option value="SOL">SOL - Solana</option>
						</select>
					</div>
				</div>
			</div>

			<div class="converter-summary-strip">
				<div class="cs-unit">
					<span class="cs-label">Birim Fiyat:</span>
					<span class="cs-val font-mono" id="hub-unit-rate">1 USD = 38.52 TRY</span>
				</div>
				<div class="cs-note">
					<span>TCMB Gösterge: ₺38.48 | Kripto USDT: ₺38.65 (%0.44 Prim)</span>
				</div>
			</div>
		</div>

		<!-- Popular Google Search Clusters (Directories) -->
		<div class="search-clusters-section">
			<div class="section-title-wrap">
				<div class="sub-eyebrow">EN ÇOK ARANAN DÖNÜŞÜMLER</div>
				<h2 class="sub-headline">Popüler Kaç TL Aramaları & Hesaplamaları</h2>
				<p class="sub-p">Google'da en sık aranan döviz ve kripto para tutarlarının anlık canlı hesaplamaları.</p>
			</div>

			<div class="clusters-grid">
				{categories.map(cat => {
					const routes = conversionRoutes.filter(r => r.category === cat.id);
					return (
						<div class="cluster-card">
							<div class="cluster-head">
								<h3 class="cluster-title">{cat.title}</h3>
								<p class="cluster-desc">{cat.desc}</p>
							</div>
							<div class="cluster-links">
								{routes.map(r => {
									const fromCurr = currencies[r.from];
									const toCurr = currencies[r.to];
									const rate = calculateRate(r.from, r.to);
									const total = r.amount * rate;
									return (
										<a href={`/kac-tl/${r.slug}`} class="cluster-link-pill">
											<span class="cl-title">{r.amount} {fromCurr.name} Kaç {toCurr.name}?</span>
											<span class="cl-rate font-mono">≈ {formatNumberTR(total)} {toCurr.symbol}</span>
										</a>
									);
								})}
							</div>
						</div>
					);
				})}
			</div>
		</div>

		<!-- Informational Guide Section (SEO Content & E-E-A-T) -->
		<div class="guide-info-section">
			<div class="info-card">
				<div class="info-eyebrow">BİLGİLENDİRME & PİYASA METODOLOJİSİ</div>
				<h3>Döviz ve Kripto Çevirilerinde Dikkat Edilmesi Gerekenler</h3>

				<div class="info-columns">
					<div class="info-col">
						<h4>1. Serbest Piyasa vs Banka Makasları</h4>
						<p>
							Bankalardan döviz alırken veya satarken uygulanan alış/satış makas farkı (spread) mesai saatleri dışında %3 ila %8 seviyelerine kadar çıkabilir. Kapalıçarşı serbest piyasasında ise bu makas genellikle daha düşüktür.
						</p>
					</div>

					<div class="info-col">
						<h4>2. Kripto Piyasasında Tether (USDT) Primi</h4>
						<p>
							USDT, bankacılık sistemi kapalıyken dahi 7 gün 24 saat Türk Lirası ile takas edilebilir. Bu kesintisiz likidite sebebiyle Türkiye piyasasında USDT/TRY fiyatı çoğu zaman resmi banka kurunun üzerinde primli fiyatlanır.
						</p>
					</div>

					<div class="info-col">
						<h4>3. Borsa Komisyonları ve Ağ Çekim Masrafları</h4>
						<p>
							Kripto para alırken borsa komisyonunun yanı sıra, varlıkları kişisel cüzdanınıza çekerken ödenecek ağ transfer (gas) ücretlerini de hesaba katmanız gerekir. Kriptonik, bu masrafları şeffafça hesaplar.
						</p>
					</div>
				</div>
			</div>
		</div>

		<!-- FAQ Section -->
		<div class="faq-cluster-section">
			<div class="section-title-wrap">
				<div class="sub-eyebrow">SIKÇA SORULAN SORULAR</div>
				<h2 class="sub-headline">Kaç TL Dönüşümleri Hakkında Merak Edilenler</h2>
			</div>

			<div class="faq-accordion-box">
				{faqItems.map(item => (
					<details class="faq-card" open>
						<summary class="faq-card-head">
							<span>{item.q}</span>
							<span class="faq-chevron">▾</span>
						</summary>
						<div class="faq-card-body">
							<p>{item.a}</p>
						</div>
					</details>
				))}
			</div>
		</div>
	</div>
</Layout>

<script>
	const rates: Record<string, { try: number; usd: number }> = {
		USD: { try: 38.52, usd: 1.0 },
		EUR: { try: 41.60, usd: 1.08 },
		BTC: { try: 3538062, usd: 91850 },
		ETH: { try: 131738, usd: 3420 },
		USDT: { try: 38.65, usd: 1.0002 },
		SOL: { try: 7646, usd: 198.5 },
		TRY: { try: 1.0, usd: 1 / 38.52 }
	};

	const amountInput = document.getElementById('hub-amount') as HTMLInputElement;
	const fromSelect = document.getElementById('hub-from') as HTMLSelectElement;
	const toSelect = document.getElementById('hub-to') as HTMLSelectElement;
	const resultInput = document.getElementById('hub-result') as HTMLInputElement;
	const swapBtn = document.getElementById('hub-swap');
	const unitRateEl = document.getElementById('hub-unit-rate');

	function recalculate() {
		const amt = parseFloat(amountInput.value) || 0;
		const from = fromSelect.value;
		const to = toSelect.value;

		const fromInfo = rates[from];
		const toInfo = rates[to];
		if (!fromInfo || !toInfo) return;

		let rate = 1;
		if (to === 'TRY') {
			rate = fromInfo.try;
		} else if (from === 'TRY') {
			rate = 1 / toInfo.try;
		} else if (to === 'USD') {
			rate = fromInfo.usd;
		} else if (from === 'USD') {
			rate = 1 / toInfo.usd;
		} else {
			rate = fromInfo.try / toInfo.try;
		}

		const total = amt * rate;
		resultInput.value = total.toLocaleString('tr-TR', { maximumFractionDigits: rate < 0.01 ? 6 : 2, minimumFractionDigits: 2 });
		if (unitRateEl) {
			unitRateEl.innerText = `1 ${from} = ${rate.toLocaleString('tr-TR', { maximumFractionDigits: rate < 0.01 ? 6 : 4 })} ${to}`;
		}
	}

	amountInput?.addEventListener('input', recalculate);
	fromSelect?.addEventListener('change', recalculate);
	toSelect?.addEventListener('change', recalculate);

	swapBtn?.addEventListener('click', () => {
		const temp = fromSelect.value;
		fromSelect.value = toSelect.value;
		toSelect.value = temp;
		recalculate();
	});

	// Fetch live prices if available
	async function updateLiveRates() {
		try {
			const res = await fetch('/api/v1/market/ticker');
			if (!res.ok) return;
			const json = await res.json() as any;
			if (json.data?.btc?.usd) {
				rates.BTC.usd = json.data.btc.usd;
				rates.BTC.try = json.data.btc.usd * rates.USD.try;
			}
			if (json.data?.eth?.usd) {
				rates.ETH.usd = json.data.eth.usd;
				rates.ETH.try = json.data.eth.usd * rates.USD.try;
			}
			if (json.data?.usdt?.try) {
				rates.USDT.try = json.data.usdt.try;
			}
			recalculate();
		} catch {
			// fallback
		}
	}

	updateLiveRates();
</script>

<style>
	.kac-tl-hub-page {
		padding: 48px 20px 88px;
	}

	.hub-breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-faint);
		margin-bottom: 28px;
	}

	.hub-breadcrumb a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.hub-breadcrumb a:hover {
		color: var(--primary);
	}

	.hub-breadcrumb .current {
		color: var(--text);
		font-weight: 500;
	}

	.hub-hero {
		text-align: center;
		max-width: 800px;
		margin: 0 auto 40px;
	}

	.hub-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.25);
		color: var(--primary);
		padding: 6px 14px;
		border-radius: 9999px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		margin-bottom: 20px;
	}

	.live-dot {
		width: 6px;
		height: 6px;
		background: var(--primary);
		border-radius: 50%;
	}

	.hub-title {
		font-size: 44px;
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text);
		margin: 0 0 16px;
	}

	.hub-sub {
		font-size: 16px;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0;
	}

	/* Interactive Card */
	.converter-interactive-card {
		background: var(--bg-elev);
		border: 1px solid var(--border-strong);
		border-radius: 18px;
		padding: 28px;
		max-width: 860px;
		margin: 0 auto 64px;
		box-shadow: var(--shadow-md), 0 0 30px rgba(16, 185, 129, 0.04);
	}

	.converter-box-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 18px;
		border-bottom: 1px solid var(--border-subtle);
		margin-bottom: 22px;
	}

	.cb-title {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 16px;
		font-weight: 700;
		color: var(--text);
	}

	.cb-title svg {
		color: var(--primary);
	}

	.cb-status {
		font-size: 11px;
		font-weight: 700;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 3px 8px;
		border-radius: 4px;
	}

	.converter-grid {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 16px;
		align-items: flex-end;
		margin-bottom: 22px;
	}

	.conv-col {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.conv-col label {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--text-muted);
	}

	.input-shell {
		display: flex;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		border-radius: 12px;
		overflow: hidden;
		transition: border-color var(--transition-fast);
	}

	.input-shell:focus-within {
		border-color: var(--primary);
	}

	.conv-input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: var(--text);
		padding: 14px 16px;
		font-size: 17px;
		font-weight: 600;
		width: 100%;
	}

	.result-input {
		color: var(--primary);
		font-weight: 700;
	}

	.conv-select {
		background: var(--bg-elev);
		border: none;
		border-left: 1px solid var(--border);
		color: var(--text);
		padding: 0 14px;
		font-size: 13.5px;
		font-weight: 600;
		outline: none;
		cursor: pointer;
	}

	.conv-swap-btn {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		cursor: pointer;
		margin-bottom: 2px;
		transition: all var(--transition-fast);
	}

	.conv-swap-btn:hover {
		background: var(--bg-elev);
		border-color: var(--primary);
		color: var(--primary);
		transform: rotate(180deg);
	}

	.converter-summary-strip {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 18px;
		border-top: 1px solid var(--border-subtle);
		font-size: 12.5px;
	}

	.cs-label {
		color: var(--text-faint);
		margin-right: 6px;
	}

	.cs-val {
		color: var(--text);
		font-weight: 700;
	}

	.cs-note {
		color: var(--text-muted);
	}

	/* Search Clusters */
	.search-clusters-section {
		margin-bottom: 72px;
	}

	.section-title-wrap {
		text-align: center;
		margin-bottom: 36px;
	}

	.sub-eyebrow {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--primary);
		text-transform: uppercase;
		margin-bottom: 8px;
	}

	.sub-headline {
		font-size: 32px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0 0 10px;
	}

	.sub-p {
		font-size: 15px;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto;
	}

	.clusters-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
		gap: 24px;
	}

	.cluster-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 22px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.cluster-head {
		border-bottom: 1px solid var(--border-subtle);
		padding-bottom: 12px;
	}

	.cluster-title {
		font-size: 16px;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 4px;
	}

	.cluster-desc {
