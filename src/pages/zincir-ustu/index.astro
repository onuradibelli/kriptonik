---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Spec v3: Modül 8 - F: Zincir Üstü (On-Chain) Verileri
const btcOnChain = {
  feeLow: 9,
  feeMed: 14,
  feeHigh: 22,
  mempoolVSize: 142.5, // vMB
  mempoolTxCount: 168450,
  hashrate: 685.4, // EH/s
  difficulty: 92.67, // T
  difficultyAdjEst: 1.45, // %
  nextDifficultyDays: 5.2,
  blockHeight: 894520,
  avgBlockTimeMin: 9.8,
  halvingProgress: 24.2, // % 5th cycle
  nextHalvingEst: '2028-04-18',
  lightningBtc: 5640,
  lightningUsd: 382000000,
  lastUpdate: new Date().toISOString()
};

const ethOnChain = {
  gasSlow: 4,
  gasStandard: 7,
  gasFast: 12,
  baseFee: 4.8,
  ethPrice: 2850,
  l2Fees: [
    { name: 'Ethereum L1', transferUsd: 0.85, swapUsd: 4.25, badge: 'Mainnet' },
    { name: 'Arbitrum One', transferUsd: 0.01, swapUsd: 0.08, badge: 'Rollup' },
    { name: 'Base', transferUsd: 0.01, swapUsd: 0.04, badge: 'OP Stack' },
    { name: 'Optimism (OP)', transferUsd: 0.01, swapUsd: 0.07, badge: 'OP Stack' },
    { name: 'Polygon PoS', transferUsd: 0.02, swapUsd: 0.09, badge: 'Sidechain' }
  ]
};

const title = "Zincir Üstü (On-Chain) Veriler: Bitcoin Mempool, Hashrate & Gas Takip | Kriptonik";
const description = "Canlı Bitcoin mempool sat/vB ücretleri, ağ hashrate'i, madencilik zorluğu ayarlaması ve Ethereum ile Layer 2 gerçek zamanlı gas maliyetleri analizi.";
---

<BaseLayout title={title} description={description}>
  <div class="onchain-page">
    <div class="container">
      
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Navigasyon">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <span class="current">Zincir Üstü Veriler</span>
      </nav>

      <!-- Header -->
      <div class="page-header">
        <div class="header-badges">
          <span class="live-pulse-badge">
            <span class="pulse-dot"></span> Canlı Blokzincir Akışı
          </span>
          <span class="source-badge">Kaynak: Mempool.space & RPC Düğümleri</span>
        </div>
        <h1>Zincir Üstü (On-Chain) Ağ Metrikleri</h1>
        <p class="lead">
          Bitcoin ve Ethereum ana ağlarının canlı işlem kuyrukları, transfer komisyonları, 
          madencilik gücü (hashrate), zorluk ayarlaması ve Layer 2 ölçekleme maliyetleri.
        </p>
      </div>

      <!-- Bitcoin Ağı Metrikleri -->
      <section class="network-section">
        <div class="network-header">
          <div class="network-title-wrap">
            <div class="chain-icon btc-icon">₿</div>
            <div>
              <h2>Bitcoin Ağı (Mempool & Hashrate)</h2>
              <span class="sub-label">Blok Yüksekliği: #{btcOnChain.blockHeight.toLocaleString('tr-TR')} · Ortalama Blok Süresi: {btcOnChain.avgBlockTimeMin} dk</span>
            </div>
          </div>
        </div>

        <div class="metric-grid">
          <!-- Fee Card -->
          <div class="metric-card highlight-card">
            <div class="card-head">Önerilen İşlem Ücreti (sat/vB)</div>
            <div class="fee-levels">
              <div class="fee-col">
                <span class="speed-tag">Düşük</span>
                <span class="fee-num font-mono">{btcOnChain.feeLow}</span>
                <span class="fee-time">~1-2 saat</span>
              </div>
              <div class="fee-col primary-col">
                <span class="speed-tag">Standart</span>
                <span class="fee-num font-mono">{btcOnChain.feeMed}</span>
                <span class="fee-time">~10-30 dk</span>
              </div>
              <div class="fee-col">
                <span class="speed-tag">Öncelikli</span>
                <span class="fee-num font-mono">{btcOnChain.feeHigh}</span>
                <span class="fee-time">Sonraki blok</span>
              </div>
            </div>
          </div>

          <!-- Mempool Queue -->
          <div class="metric-card">
            <div class="card-head">Mempool Kuyruğu</div>
            <div class="big-metric font-mono">{btcOnChain.mempoolVSize} <span class="unit">vMB</span></div>
            <div class="sub-info font-mono">{btcOnChain.mempoolTxCount.toLocaleString('tr-TR')} bekleyen transfer</div>
            <div class="progress-bar-wrap">
              <div class="progress-bar-fill" style={`width: ${Math.min((btcOnChain.mempoolVSize / 300) * 100, 100)}%`}></div>
            </div>
          </div>

          <!-- Hashrate & Zorluk -->
          <div class="metric-card">
            <div class="card-head">Hashrate & Zorluk</div>
            <div class="big-metric font-mono">{btcOnChain.hashrate} <span class="unit">EH/s</span></div>
            <div class="sub-info">Zorluk: <strong>{btcOnChain.difficulty} T</strong></div>
            <div class="est-badge">
              Sonraki zorluk: +%{btcOnChain.difficultyAdjEst} (~{btcOnChain.nextDifficultyDays} gün)
            </div>
          </div>

          <!-- Halving & Lightning -->
          <div class="metric-card">
            <div class="card-head">Lightning Network Kapasitesi</div>
            <div class="big-metric font-mono">{btcOnChain.lightningBtc.toLocaleString('tr-TR')} <span class="unit">BTC</span></div>
            <div class="sub-info font-mono">${(btcOnChain.lightningUsd / 1e6).toFixed(1)}M USD kilitli likidite</div>
            <div class="sub-foot">Halving İlerlemesi: %{btcOnChain.halvingProgress}</div>
          </div>
        </div>
      </section>

      <!-- Ethereum & Layer 2 Metrikleri -->
      <section class="network-section">
        <div class="network-header">
          <div class="network-title-wrap">
            <div class="chain-icon eth-icon">Ξ</div>
            <div>
              <h2>Ethereum & Layer 2 Gas Analizi</h2>
              <span class="sub-label">EIP-1559 Taban Ücret: {ethOnChain.baseFee} Gwei · Katman 2 Ölçekleme Kıyası</span>
            </div>
          </div>
        </div>

        <div class="l2-grid">
          <div class="gas-quick-card">
            <h3>Güncel L1 Gas Ücretleri</h3>
            <div class="gas-flex">
              <div class="gas-item">
                <span class="gas-label">Yavaş</span>
                <span class="gas-num font-mono">{ethOnChain.gasSlow} <small>Gwei</small></span>
              </div>
              <div class="gas-item active">
                <span class="gas-label">Standart</span>
                <span class="gas-num font-mono">{ethOnChain.gasStandard} <small>Gwei</small></span>
              </div>
              <div class="gas-item">
                <span class="gas-label">Hızlı</span>
                <span class="gas-num font-mono">{ethOnChain.gasFast} <small>Gwei</small></span>
              </div>
            </div>
            <p class="gas-note">EIP-4844 (Blobs) sayesinde L2 gas maliyetleri %90'ın üzerinde düşürülmüştür.</p>
          </div>

          <div class="l2-table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Ağ</th>
                  <th>Tür</th>
                  <th class="num">ETH Transfer Ücreti</th>
                  <th class="num">DEX Swap Ücreti</th>
                </tr>
              </thead>
              <tbody>
                {ethOnChain.l2Fees.map((l2) => (
                  <tr>
                    <td><strong>{l2.name}</strong></td>
                    <td><span class="category-tag">{l2.badge}</span></td>
                    <td class="num font-mono">${l2.transferUsd.toFixed(2)}</td>
                    <td class="num font-mono">${l2.swapUsd.toFixed(2)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Metodoloji Notu -->
      <section class="methodology-box">
        <h3>Zincir Üstü Veri Metodolojisi</h3>
        <p>
          <strong>Bitcoin Mempool:</strong> Düğümlerin bellek havuzunda onay bekleyen işlemlerin büyüklüğüdür. İşlem ücretleri medyan hesaplamayla anlık dinamik olarak güncellenir.
        </p>
        <p>
          <strong>Layer 2 Hesaplama:</strong> Rollup sözleşmelerinin ana ağa yazdığı blob verileri ve yerel sequencer maliyetleri göz önünde bulundurularak simüle edilmiştir.
        </p>
        <div class="methodology-footer">
          <span>Güncelleme Aralığı: 60 saniye</span>
          <span>Dürüst İfade İlkesi: Ağ yoğunluğuna bağlı olarak anlık sapmalar oluşabilir.</span>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .onchain-page {
    padding: 32px 0 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb .current {
    color: var(--text);
    font-weight: 600;
  }

  .page-header {
    margin-bottom: 36px;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .live-pulse-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--primary-soft);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: var(--primary);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 6px var(--primary);
    animation: blink 1.6s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .source-badge {
    padding: 4px 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--text-muted);
  }

  h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }

  .lead {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 820px;
    margin: 0;
  }

  .network-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 32px;
  }

  .network-header {
    margin-bottom: 24px;
  }

  .network-title-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .chain-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
  }

  .btc-icon {
    background: rgba(247, 147, 26, 0.15);
    color: #F7931A;
    border: 1px solid rgba(247, 147, 26, 0.3);
  }

  .eth-icon {
    background: rgba(98, 126, 234, 0.15);
    color: #627EEA;
    border: 1px solid rgba(98, 126, 234, 0.3);
  }

  .network-title-wrap h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 4px;
  }

  .sub-label {
    font-size: 13px;
    color: var(--text-muted);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .metric-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .highlight-card {
    border-color: rgba(16, 185, 129, 0.3);
    background: linear-gradient(180deg, var(--surface-2) 0%, rgba(16, 185, 129, 0.05) 100%);
  }

  .card-head {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
  }

  .big-metric {
    font-size: 28px;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 6px;
  }

  .big-metric .unit {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .sub-info {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 10px;
  }

  .sub-foot {
    font-size: 12px;
    color: var(--text-muted);
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }

  .fee-levels {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .fee-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 6px;
    flex: 1;
    text-align: center;
  }

  .fee-col.primary-col {
    border-color: var(--primary);
    background: var(--primary-soft);
  }

  .speed-tag {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .fee-num {
    font-size: 20px;
    font-weight: 800;
    color: var(--text);
  }

  .fee-time {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .progress-bar-wrap {
    height: 6px;
    background: var(--surface);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 8px;
  }

  .progress-bar-fill {
    height: 100%;
    background: #F7931A;
    border-radius: 3px;
  }

  .est-badge {
    display: inline-block;
    padding: 4px 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 11px;
    color: var(--primary);
    font-weight: 600;
  }

  /* L2 Section */
  .l2-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 20px;
  }

  .gas-quick-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
  }

  .gas-quick-card h3 {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 16px;
  }

  .gas-flex {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }

  .gas-item {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 8px;
    text-align: center;
  }

  .gas-item.active {
    border-color: #627EEA;
    background: rgba(98, 126, 234, 0.08);
  }

  .gas-label {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .gas-num {
    font-size: 18px;
    font-weight: 800;
    color: var(--text);
  }

  .gas-num small {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .gas-note {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .l2-table-wrap {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }

  .data-table th {
    padding: 12px 14px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border);
  }

  .data-table td {
    padding: 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  .num {
    text-align: right;
  }

  .font-mono {
    font-family: var(--font-mono);
  }

  .category-tag {
    padding: 3px 8px;
    background: var(--surface-2);
    border-radius: 6px;
    font-size: 12px;
    color: var(--text-secondary);
  }

  .methodology-box {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
  }

  .methodology-box h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 12px;
  }

  .methodology-box p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 10px;
  }

  .methodology-footer {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 990px) {
    .metric-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .l2-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .metric-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: 26px;
    }
  }
</style>
