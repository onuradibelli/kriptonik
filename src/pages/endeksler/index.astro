---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Spec v3: Bölüm 2.3 Kriptonik Endeksleri (Özgün, Sürümlü, Metodolojisi Açık)
const indices = [
  {
    slug: 'ttp',
    name: 'Tether Primi Endeksi',
    code: 'TTP',
    value: '+%1.14',
    status: 'Pozitif Prim',
    statusClass: 'pos',
    range: 'Referans: -%0.5 / +%0.5',
    version: 'v1.2',
    description: 'Türk borsalarındaki hacim ağırlıklı USDT/TRY medyanının, TCMB resmi gösterge USD/TRY kuruna göre yüzdesel sapması.',
    inputs: ['BtcTurk, Paribu, Binance TR USDT/TRY', 'TCMB Gösterge USD/TRY'],
    formula: '((USDTTRY_borsa_medyan / USDTTRY_resmi) - 1) * 100',
    link: '/turkiye/usdt-tl-primi'
  },
  {
    slug: 'tls',
    name: 'TL Likidite Skoru',
    code: 'TLS',
    value: '78.4 / 100',
    status: 'Yüksek Likidite',
    statusClass: 'good',
    range: 'Ölçek: 0 - 100',
    version: 'v1.0',
    description: 'Borsa emir defterlerindeki 10.000 TL, 100.000 TL ve 1.000.000 TL kademeli piyasa emirlerinde gerçekleşen fiyat kayma (slippage) maliyetinin ters logaritmik skoru.',
    inputs: ['BTC/TRY, USDT/TRY L2 Emir Defterleri'],
    formula: '100 - (0.5 * Slip_1M + 0.3 * Slip_100k + 0.2 * Slip_10k)',
    link: '/turkiye/likidite-ve-derinlik'
  },
  {
    slug: 'eam',
    name: 'ETF Akış Momentumu',
    code: 'EAM',
    value: '+1.62 σ (%86 Dilim)',
    status: 'Güçlü Kurumsal Giriş',
    statusClass: 'pos',
    range: 'Z-Skoru (-3σ ile +3σ)',
    version: 'v1.1',
    description: 'ABD Spot Bitcoin ETF’lerinin son 7 ve 30 günlük kümülatif net akışının 90 günlük hareketli ortalamaya ve standart sapmaya göre normalize edilmiş z-skor metriği.',
    inputs: ['11 ABD Spot Bitcoin ETF İhraççı Raporları'],
    formula: '(NetAkis_7g - Mean_90g) / StdDev_90g',
    link: '/etf'
  },
  {
    slug: 'fi',
    name: 'Fonlama Isısı Endeksi',
    code: 'FI',
    value: '+%11.8 / yıl',
    status: 'Ilımlı Pozitif (Normal)',
    statusClass: 'neutral',
    range: 'Yıllıklandırılmış %',
    version: 'v1.0',
    description: 'Global türev borsalarındaki (Bybit, OKX, Binance) BTC ve ETH perpetual sözleşmelerinin açık pozisyon (OI) büyüklüğüyle ağırlıklandırılmış yıllıklandırılmış fonlama oranı.',
    inputs: ['Bybit, OKX Sürekli Swap Fonlama & OI'],
    formula: 'Σ (Funding_i * OI_i) / Σ OI_i * 3 * 365',
    link: '/turev'
  },
  {
    slug: 'kas',
    name: 'Kriptonik Altcoin Sezonu',
    code: 'KAS',
    value: '42 / 100',
    status: 'Nötr Piyasa Bölgesi',
    statusClass: 'neutral',
    range: '0 (Bitcoin Sezonu) - 100 (Altcoin Sezonu)',
    version: 'v1.0',
    description: 'Piyasa değerine göre ilk 50 kripto para arasından (stablecoin ve wrapped varlıklar hariç) son 90 günde Bitcoin’den daha yüksek getiri sağlayan varlıkların yüzdesi.',
    inputs: ['Top 50 Kripto Varlık 90 Günlük Performans'],
    formula: '(Count(Altcoin_90g > BTC_90g) / Toplam_Altcoin) * 100',
    link: '/piyasa'
  },
  {
    slug: 'snb',
    name: 'Stablecoin Net Basım',
    code: 'SNB',
    value: '+$1.48B / 30g',
    status: 'Net Likidite Girişi',
    statusClass: 'pos',
    range: 'USD Cinsinden Dolaşım Değişimi',
    version: 'v1.0',
    description: 'USDT, USDC, DAI ve FDUSD toplam dolaşımdaki arzının son 7 ve 30 günlük net basım ve yakım (mint/burn) delta toplamı.',
    inputs: ['On-Chain Smart Contract Mint/Burn Olayları'],
    formula: 'Δ Supply(USDT + USDC + DAI + FDUSD)_30g',
    link: '/stablecoin'
  }
];

const title = "Kriptonik Endeksleri: Metodolojisi Açık Özgün Veri Serileri | Kriptonik";
const description = "Kriptonik tarafından formüle edilen şeffaf ve sürümlü kripto endeksleri: Tether Primi, TL Likidite Skoru, ETF Akış Momentumu, Fonlama Isısı ve Altcoin Sezonu.";
---

<BaseLayout title={title} description={description}>
  <div class="indices-page">
    <div class="container">
      
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Navigasyon">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <span class="current">Kriptonik Endeksleri</span>
      </nav>

      <!-- Header -->
      <div class="page-header">
        <div class="header-badges">
          <span class="proprietary-badge">Kriptonik Özgün Metodoloji</span>
          <span class="license-badge">CC BY 4.0 Lisanslı</span>
        </div>
        <h1>Kriptonik Özgün Endeksleri</h1>
        <p class="lead">
          Piyasa manipülasyonundan arındırılmış, formülü, girdileri ve sürüm geçmişi tamamen kamuya açık, 
          araştırmacı ve piyasa katılımcıları için geliştirilmiş referans göstergeler.
        </p>
      </div>

      <!-- Indices Cards Grid -->
      <div class="indices-grid">
        {indices.map((idx) => (
          <div class="index-card">
            <div class="card-top">
              <div class="code-wrap">
                <span class="index-code">{idx.code}</span>
                <span class="index-version">{idx.version}</span>
              </div>
              <span class={`status-pill ${idx.statusClass}`}>{idx.status}</span>
            </div>

            <h2 class="index-name">{idx.name}</h2>
            <div class="index-value font-mono">{idx.value}</div>
            <div class="index-range">{idx.range}</div>

            <p class="index-desc">{idx.description}</p>

            <div class="formula-box">
              <span class="formula-label">Hesaplama Formülü:</span>
              <code class="font-mono">{idx.formula}</code>
            </div>

            <div class="inputs-list">
              <span class="inputs-label">Veri Girdileri:</span>
              <ul>
                {idx.inputs.map((inp) => (
                  <li>{inp}</li>
                ))}
              </ul>
            </div>

            <div class="card-footer">
              <a href={idx.link} class="btn-detail">Canlı Analiz Sayfası →</a>
              <a href={`/veri#${idx.slug}`} class="btn-csv" title="Geçmiş Veri Serisini İndir">CSV İndir</a>
            </div>
          </div>
        ))}
      </div>

      <!-- Metodoloji İlkeleri -->
      <section class="methodology-banner">
        <div class="banner-content">
          <h3>Kriptonik Endeks İlkeleri</h3>
          <div class="principles-grid">
            <div class="p-item">
              <strong>1. Formül Şeffaflığı</strong>
              <p>Her endeksin matematiksel formülü ve kullanılan parametre ağırlıkları gizlenmeden yayımlanır.</p>
            </div>
            <div class="p-item">
              <strong>2. Sürümlendirme (Versioning)</strong>
              <p>Hesaplama modelinde veya veri kaynaklarında yapılan her değişiklik Semantic Versioning ile duyurulur.</p>
            </div>
            <div class="p-item">
              <strong>3. Tarafsızlık & Tavsiyesizlik</strong>
              <p>Endeksler sadece mevcut durumu sayısallaştırır; kesinlik, kâr garantisi veya al/sat tavsiyesi içermez.</p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .indices-page {
    padding: 32px 0 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb .current {
    color: var(--text);
    font-weight: 600;
  }

  .page-header {
    margin-bottom: 36px;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .proprietary-badge {
    padding: 4px 10px;
    background: var(--primary-soft);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--primary);
  }

  .license-badge {
    padding: 4px 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--text-muted);
  }

  h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }

  .lead {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 820px;
    margin: 0;
  }

  .indices-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .index-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .index-card:hover {
    border-color: rgba(16, 185, 129, 0.4);
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .code-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .index-code {
    padding: 4px 8px;
    background: var(--surface-2);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 14px;
    color: var(--primary);
  }

  .index-version {
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .status-pill {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
  }

  .status-pill.pos {
    background: rgba(16, 185, 129, 0.15);
    color: var(--color-profit);
  }

  .status-pill.good {
    background: rgba(16, 185, 129, 0.15);
    color: var(--color-profit);
  }

  .status-pill.neutral {
    background: rgba(100, 116, 139, 0.15);
    color: var(--text-secondary);
  }

  .index-name {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .index-value {
    font-size: 28px;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 4px;
  }

  .index-range {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .index-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 16px;
  }

  .formula-box {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 16px;
  }

  .formula-label {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .formula-box code {
    font-size: 12px;
    color: var(--primary);
    word-break: break-all;
  }

  .inputs-list {
    margin-bottom: 20px;
  }

  .inputs-label {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  .inputs-list ul {
    margin: 0;
    padding-left: 18px;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .inputs-list li {
    margin-bottom: 4px;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .btn-detail {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: all 150ms ease;
  }

  .btn-detail:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }

  .btn-csv {
    padding: 10px 14px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 150ms ease;
  }

  .btn-csv:hover {
    border-color: var(--text-muted);
    color: var(--text);
  }

  /* Principles Banner */
  .methodology-banner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 28px;
  }

  .methodology-banner h3 {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 20px;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .p-item strong {
    display: block;
    font-size: 14px;
    color: var(--text);
    margin-bottom: 6px;
  }

  .p-item p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 900px) {
    .indices-grid {
      grid-template-columns: 1fr;
    }
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
