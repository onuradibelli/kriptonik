---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Kriptonik Yönetim Paneli (Admin) | Kriptonik";
const pageDesc = "Kriptonik dahili yönetim paneli. Veri kaynakları, araç durumları, borsa komisyonları ve kullanıcı geri bildirimleri.";

// Mock/Default Initial stats for SSR
const stats = {
	dailyViews: 18420,
	activeTools: 21,
	openReports: 3,
	sourcesStatus: 'Tümü Aktif'
};

const managedTools = [
	{ slug: 'adres-ag-eslestirici', title: 'Adres Ağ Eşleştirici', category: 'Guvenlik', status: 'live' },
	{ slug: 'takilan-islem', title: 'Takılan İşlem Teşhisi', category: 'Kurtarma', status: 'live' },
	{ slug: 'yanlis-aga-gonderdim', title: 'Yanlış Ağa Gönderdim', category: 'Kurtarma', status: 'live' },
	{ slug: 'kripto-donusturucu', title: 'Kripto Dönüştürücü', category: 'Veri', status: 'live' },
	{ slug: 'maliyet-karsilastirici', title: 'Borsa Maliyet Kıyaslama', category: 'Finans', status: 'live' },
	{ slug: 'kar-zarar-hesaplama', title: 'Kâr / Zarar Hesaplama', category: 'Finans', status: 'live' },
	{ slug: 'kaldirac-likidasyon', title: 'Kaldıraç & Likidasyon', category: 'Finans', status: 'live' },
	{ slug: 'gas-ucret-takip', title: 'Gas & Ağ Ücreti Takip', category: 'Veri', status: 'live' },
	{ slug: 'depeg-monitoru', title: 'Stablecoin Depeg Monitörü', category: 'Veri', status: 'live' },
	{ slug: 'korku-acgozluluk-endeksi', title: 'Korku & Açgözlülük', category: 'Veri', status: 'live' },
	{ slug: 'birim-cevirici', title: 'Kripto Birim Çevirici', category: 'Veri', status: 'live' },
	{ slug: 'bitcoin-halving', title: 'Bitcoin Halving Sayacı', category: 'Veri', status: 'live' },
	{ slug: 'staking-getiri', title: 'Staking Bileşik Getiri', category: 'Finans', status: 'live' },
	{ slug: 'madencilik-karlilik', title: 'Madencilik Kârlılık', category: 'Finans', status: 'live' },
	{ slug: 'cuzdan-guvenlik-kontrolu', title: 'Cüzdan Güvenlik Check-up', category: 'Guvenlik', status: 'live' }
];

const dataSources = [
	{ name: 'Alternative.me (FNG)', status: 'Çalışıyor', latency: '120ms', lastRun: '10 dk önce' },
	{ name: 'Mempool.space (BTC API)', status: 'Çalışıyor', latency: '45ms', lastRun: '3 dk önce' },
	{ name: 'Cloudflare D1 (SQLite DB)', status: 'Bağlı', latency: '1ms', lastRun: 'Canlı' },
	{ name: 'Cloudflare KV Cache', status: 'Önbellek Aktif', latency: '0.8ms', lastRun: 'Canlı' }
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="admin-wrapper">
		<aside class="admin-sidebar">
			<div class="sidebar-brand">
				<span class="brand-badge">ADMIN</span>
				<span class="brand-text">Kriptonik Panel</span>
			</div>

			<nav class="sidebar-nav">
				<a href="/admin" class="nav-item active">📊 Gösterge Paneli</a>
				<a href="#tools-sec" class="nav-item">🛠️ Araç Yönetimi</a>
				<a href="#sources-sec" class="nav-item">🌐 Veri Kaynakları</a>
				<a href="#reports-sec" class="nav-item">📥 Rapor & İtirazlar <span class="badge-count">3</span></a>
				<a href="#settings-sec" class="nav-item">⚙️ Sistem Ayarları</a>
			</nav>

			<div class="sidebar-footer">
				<span class="auth-role">Rol: <strong>Owner</strong></span>
				<a href="/" class="exit-link">Siteye Dön ➔</a>
			</div>
		</aside>

		<main class="admin-main">
			<div class="admin-header">
				<div>
					<h1 class="page-title">Sistem & Araç Yönetim Paneli</h1>
					<p class="page-subtitle">Canlı sistem sağlığı, araç durumları ve kullanıcı raporları özeti.</p>
				</div>
				<div class="admin-actions">
					<button class="btn btn-secondary btn-sm" id="purge-cache-btn">Önbelleği Temizle (Purge KV)</button>
					<button class="btn btn-primary btn-sm" id="manual-cron-btn">Cron İşlerini Tetikle</button>
				</div>
			</div>

			<!-- Stats KPI Cards -->
			<div class="kpi-grid">
				<div class="kpi-card">
					<span class="kpi-lbl">Günlük Tekil Ziyaret:</span>
					<strong class="kpi-num font-mono">{stats.dailyViews.toLocaleString('tr-TR')}</strong>
					<span class="kpi-trend pos">↑ %14,2 artış</span>
				</div>
				<div class="kpi-card">
					<span class="kpi-lbl">Aktif Araç Sayısı:</span>
					<strong class="kpi-num font-mono">{stats.activeTools} / 21</strong>
					<span class="kpi-sub">Tümü üretimde yayında</span>
				</div>
				<div class="kpi-card">
					<span class="kpi-lbl">Bekleyen Rapor / İtiraz:</span>
					<strong class="kpi-num font-mono" style="color: var(--color-warning);">{stats.openReports}</strong>
					<span class="kpi-sub">İncelenmesi gerekiyor</span>
				</div>
				<div class="kpi-card">
					<span class="kpi-lbl">Veri Sağlayıcı Durumu:</span>
					<strong class="kpi-num" style="color: var(--color-success);">{stats.sourcesStatus}</strong>
					<span class="kpi-sub">Kesinti yaşanmıyor</span>
				</div>
			</div>

			<!-- Tools Management Table Section -->
			<section class="admin-section" id="tools-sec">
				<div class="section-top">
					<h2 class="sec-title">🛠️ Araç Yönetimi ve Acil Devre Kesici (Kill-Switch)</h2>
					<span class="sec-desc">Herhangi bir aracın bakım durumunu veya anlık devre dışı bırakma (kill-switch) ayarını yönetin.</span>
				</div>

				<div class="table-wrap">
					<table class="admin-table">
						<thead>
							<tr>
								<th>Araç Adı</th>
								<th>Kategori</th>
								<th>Yol (Slug)</th>
								<th>Durum</th>
								<th>Eylemler</th>
							</tr>
						</thead>
						<tbody>
							{managedTools.map(tool => (
								<tr>
									<td><strong>{tool.title}</strong></td>
									<td><span class="cat-pill">{tool.category}</span></td>
									<td class="font-mono">/araclar/{tool.slug}</td>
									<td><span class="status-pill live">Canlı (Live)</span></td>
									<td>
										<button class="btn-action toggle-btn" data-slug={tool.slug}>Durumu Değiştir</button>
										<button class="btn-action kill-btn" data-slug={tool.slug}>Kill-Switch</button>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<!-- Data Sources & Health Section -->
			<section class="admin-section" id="sources-sec">
				<div class="section-top">
					<h2 class="sec-title">🌐 Veri Kaynakları & Servis Sağlığı</h2>
				</div>

				<div class="sources-grid">
					{dataSources.map(src => (
						<div class="source-card">
							<div class="src-header">
								<span class="src-name">{src.name}</span>
								<span class="src-status ok">● {src.status}</span>
							</div>
							<div class="src-metrics">
								<span>Gecikme: <strong>{src.latency}</strong></span>
								<span>Son Kontrol: <strong>{src.lastRun}</strong></span>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- Reports & Feedback Section -->
			<section class="admin-section" id="reports-sec">
				<div class="section-top">
					<h2 class="sec-title">📥 Gelen Kullanıcı Geri Bildirimleri & İtirazlar</h2>
				</div>

				<div class="reports-list">
					<div class="report-row">
						<div class="rep-meta">
							<span class="rep-badge bug">HATA BİLDİRİMİ</span>
							<span class="rep-time">Bugün 08:42</span>
						</div>
						<div class="rep-title">Birim Çevirici TRX/Sun basamağı doğrulaması</div>
						<p class="rep-body">"1 TRX = 1.000.000 Sun çevirisinde ondalık gösterim çok başarılı çalışıyor, elinize sağlık."</p>
						<div class="rep-actions">
							<button class="btn-action resolve-btn">Çözüldü Olarak İşaretle</button>
						</div>
					</div>

					<div class="report-row">
						<div class="rep-meta">
							<span class="rep-badge info">ÖNERİ</span>
							<span class="rep-time">Dün 19:15</span>
						</div>
						<div class="rep-title">DCA Simülatörü için haftalık periyot seçeneği</div>
						<p class="rep-body">"DCA simülatörüne aylık dışında haftalık periyot seçeneği de eklenebilir mi?"</p>
						<div class="rep-actions">
							<button class="btn-action resolve-btn">İncelendi</button>
						</div>
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
.admin-wrapper {
	display: flex;
	min-height: calc(100vh - 150px);
}
.admin-sidebar {
	width: 260px;
	background: var(--color-surface);
	border-right: 1px solid var(--color-border);
	padding: var(--space-6);
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}
.sidebar-brand {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	margin-bottom: var(--space-8);
}
.brand-badge {
	font-size: 10px;
	font-weight: 800;
	background: var(--color-primary-500);
	color: white;
	padding: 2px 6px;
	border-radius: var(--radius-sm);
}
.brand-text {
	font-size: var(--text-base);
	font-weight: 800;
}
.sidebar-nav {
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}
.nav-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: var(--space-2) var(--space-3);
	border-radius: var(--radius-md);
	color: var(--color-text-secondary);
	text-decoration: none;
	font-size: var(--text-sm);
	font-weight: 600;
	transition: all var(--transition-fast);
}
.nav-item:hover, .nav-item.active {
	background: var(--color-surface-hover);
	color: var(--color-text-primary);
}
.badge-count {
	font-size: 11px;
	background: var(--color-warning);
	color: black;
	padding: 1px 6px;
	border-radius: var(--radius-full);
	font-weight: 700;
}
.sidebar-footer {
	border-top: 1px solid var(--color-border);
	padding-top: var(--space-4);
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-size: var(--text-xs);
	color: var(--color-text-muted);
}
.exit-link {
	color: var(--color-primary-400);
	text-decoration: none;
	font-weight: 600;
}

.admin-main {
	flex: 1;
	padding: var(--space-8);
	overflow-y: auto;
}
.admin-header {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: var(--space-8);
	flex-wrap: wrap;
	gap: var(--space-4);
}
.page-title {
	font-size: var(--text-2xl);
	font-weight: 800;
	margin-bottom: var(--space-1);
}
.page-subtitle {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
}
.admin-actions {
	display: flex;
	gap: var(--space-2);
}

.kpi-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: var(--space-4);
	margin-bottom: var(--space-8);
}
.kpi-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-4);
	display: flex;
	flex-direction: column;
	gap: 4px;
}
.kpi-lbl {
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	font-weight: 600;
}
.kpi-num {
	font-size: var(--text-2xl);
	font-weight: 900;
	line-height: 1.1;
}
.kpi-trend {
	font-size: 11px;
	font-weight: 700;
}
.kpi-trend.pos { color: var(--color-success); }
.kpi-sub {
	font-size: 11px;
	color: var(--color-text-secondary);
}

.admin-section {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-6);
	margin-bottom: var(--space-8);
}
.section-top {
	margin-bottom: var(--space-4);
}
.sec-title {
	font-size: var(--text-lg);
	font-weight: 700;
	margin-bottom: 4px;
}
.sec-desc {
	font-size: var(--text-xs);
	color: var(--color-text-muted);
}

.table-wrap {
	overflow-x: auto;
}
.admin-table {
	width: 100%;
	border-collapse: collapse;
	font-size: var(--text-sm);
}
.admin-table th, .admin-table td {
	padding: var(--space-3) var(--space-4);
	border-bottom: 1px solid var(--color-border);
	text-align: left;
}
.admin-table th {
	background: var(--color-surface-hover);
	color: var(--color-text-secondary);
	font-size: var(--text-xs);
	font-weight: 600;
}
.cat-pill {
	font-size: 11px;
	background: var(--color-surface-hover);
	padding: 2px 6px;
	border-radius: var(--radius-sm);
}
.status-pill.live {
	font-size: 11px;
	font-weight: 700;
	color: var(--color-success);
	background: rgba(16, 185, 129, 0.12);
	padding: 2px 8px;
	border-radius: var(--radius-full);
}
.btn-action {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	color: var(--color-text-primary);
	padding: 3px 8px;
	border-radius: var(--radius-sm);
	font-size: 11px;
	font-weight: 600;
	cursor: pointer;
	margin-right: 4px;
}
.btn-action.kill-btn {
	color: var(--color-error);
	border-color: rgba(239, 68, 68, 0.3);
}

.sources-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	gap: var(--space-4);
}
.source-card {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: var(--space-4);
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}
.src-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.src-name {
	font-size: var(--text-sm);
	font-weight: 700;
}
.src-status.ok {
	font-size: var(--text-xs);
	color: var(--color-success);
	font-weight: 700;
}
.src-metrics {
	display: flex;
	justify-content: space-between;
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
}

.reports-list {
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
}
.report-row {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: var(--space-4);
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}
.rep-meta {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.rep-badge {
	font-size: 10px;
	font-weight: 800;
	padding: 2px 6px;
	border-radius: var(--radius-sm);
}
.rep-badge.bug { background: rgba(239, 68, 68, 0.15); color: var(--color-error); }
.rep-badge.info { background: rgba(59, 130, 246, 0.15); color: var(--color-primary-400); }
.rep-time {
	font-size: 11px;
	color: var(--color-text-muted);
}
.rep-title {
	font-size: var(--text-sm);
	font-weight: 700;
}
.rep-body {
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
	margin: 0;
	line-height: 1.5;
}

@media (max-width: 900px) {
	.admin-wrapper {
		flex-direction: column;
	}
	.admin-sidebar {
		width: 100%;
		border-right: none;
		border-bottom: 1px solid var(--color-border);
	}
	.kpi-grid {
		grid-template-columns: repeat(2, 1fr);
	}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const purgeBtn = document.getElementById('purge-cache-btn');
	const cronBtn = document.getElementById('manual-cron-btn');

	purgeBtn?.addEventListener('click', () => {
		alert('Cloudflare KV önbelleği başarıyla temizlendi.');
	});

	cronBtn?.addEventListener('click', () => {
		alert('Tüm fiyat ve gas cron görevleri başarıyla tetiklendi.');
	});

	document.querySelectorAll('.kill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const slug = target.dataset.slug;
			if (confirm(`${slug} aracı için acil kill-switch tetiklensin mi?`)) {
				alert(`${slug} aracı geçici olarak devre dışı bırakıldı.`);
			}
		});
	});
});
</script>
