<script>
	function setupAdminCockpit() {
		const tabBtns = document.querySelectorAll<HTMLButtonElement>('.sidebar-btn');
		const tabContents = document.querySelectorAll<HTMLElement>('.tab-content');
		const headline = document.getElementById('active-tab-title');
		const tag = document.getElementById('active-tab-tag');

		const titles: Record<string, { title: string; tag: string }> = {
			dashboard: { title: "Sistem Gösterge Paneli", tag: "PANO" },
			tools: { title: "Saha Araçları Yöneticisi", tag: "ARAÇLAR" },
			guides: { title: "Kılavuz CMS & Kaynak Denetimi", tag: "REHBERLER" },
			glossary: { title: "Kripto Sözlük Terimleri", tag: "SÖZLÜK" },
			affiliate: { title: "Şeffaf Gelir & Ortaklık Yönetimi", tag: "GELİR" },
			datasources: { title: "Veri Kaynakları & Telemetry Sağlığı", tag: "KAYNAKLAR" },
			announcements: { title: "Site Genel Duyuruları (Banner)", tag: "DUYURULAR" },
			settings: { title: "Sistem Ayarları & Özellik Bayrakları", tag: "AYARLAR" },
			audit: { title: "Değiştirilemez Denetim Günlüğü", tag: "DENETİM" }
		};

		function switchTab(tabId: string) {
			tabBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-tab') === tabId));
			tabContents.forEach(c => c.classList.toggle('active', c.id === 'tab-' + tabId));

			const meta = titles[tabId] || titles.dashboard;
			if (headline) headline.textContent = meta.title;
			if (tag) tag.textContent = meta.tag;
		}

		tabBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const tabId = btn.getAttribute('data-tab');
				if (tabId) switchTab(tabId);
			});
		});

		document.querySelectorAll('[data-switch-tab]').forEach(el => {
			el.addEventListener('click', (e) => {
				e.preventDefault();
				const target = el.getAttribute('data-switch-tab');
				if (target) switchTab(target);
			});
		});

		// Cache purge simulation
		const purgeBtn = document.getElementById('btn-purge-kv');
		if (purgeBtn) {
			purgeBtn.addEventListener('click', () => {
				purgeBtn.textContent = 'Temizlendi!';
				setTimeout(() => {
					purgeBtn.innerHTML = `<span>KV Temizle</span>`;
				}, 1500);
			});
		}
	}

	setupAdminCockpit();
	document.addEventListener('astro:after-swap', setupAdminCockpit);
</script>

