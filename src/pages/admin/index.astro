---
// src/pages/admin/index.astro - Cockpit High-Density Admin Panel (Strict tokens, zero emojis, full auditability)
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import StatusPill from '../../components/ui/StatusPill.astro';

const pageTitle = "Kriptonik Saha Kontrol İstasyonu (Admin) | kriptonik";
const pageDesc = "Kriptonik yüksek yoğunluklu yönetim kokpiti: Araç durumları, içerik CMS, şeffaf affiliate kontrolü, veri kaynakları ve denetim günlüğü.";
---

<Layout title={pageTitle} description={pageDesc}>
	<meta name="robots" content="noindex, nofollow" slot="head" />

	<div class="admin-cockpit-layout">
		<!-- Sidebar Navigation (High-density) -->
		<aside class="cockpit-sidebar">
			<div class="sidebar-top">
				<div class="sidebar-brand">
					<div class="sidebar-mark">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="9"/>
							<path d="M12 3v4M12 17v4M3 12h4M17 12h4"/>
							<circle cx="12" cy="12" r="2" fill="currentColor"/>
						</svg>
					</div>
					<div class="brand-text-block">
						<span class="brand-title">kriptonik</span>
						<span class="brand-sub">KONTROL İSTASYONU</span>
					</div>
				</div>
			</div>

			<nav class="sidebar-menu" role="tablist">
				<button type="button" class="sidebar-btn active" data-tab="dashboard">
					<Icon name="activity" size={15} />
					<span>Pano (Dashboard)</span>
				</button>
				<button type="button" class="sidebar-btn" data-tab="tools">
					<Icon name="layers" size={15} />
					<span>Araç Yöneticisi</span>
					<span class="counter-badge">12</span>
				</button>
				<button type="button" class="sidebar-btn" data-tab="guides">
					<Icon name="file-text" size={15} />
					<span>Rehber CMS</span>
					<span class="counter-badge">8</span>
				</button>
				<button type="button" class="sidebar-btn" data-tab="glossary">
					<Icon name="help" size={15} />
					<span>Sözlük Terimleri</span>
					<span class="counter-badge">50+</span>
				</button>
				<button type="button" class="sidebar-btn" data-tab="affiliate">
					<Icon name="shield-check" size={15} />
					<span>Gelir & Affiliate</span>
					<span class="counter-badge ok">Şeffaf</span>
				</button>
				<button type="button" class="sidebar-btn" data-tab="datasources">
					<Icon name="cpu" size={15} />
					<span>Veri Kaynakları</span>
					<span class="dot-online"></span>
				</button>
				<button type="button" class="sidebar-btn" data-tab="announcements">
					<Icon name="alert-triangle" size={15} />
					<span>Duyurular (Banner)</span>
				</button>
				<button type="button" class="sidebar-btn" data-tab="settings">
					<Icon name="lock" size={15} />
					<span>Sistem & Bayraklar</span>
				</button>
				<button type="button" class="sidebar-btn" data-tab="audit">
					<Icon name="clock" size={15} />
					<span>Denetim Günlüğü</span>
				</button>
			</nav>

			<div class="sidebar-bottom">
				<div class="operator-info">
					<span class="op-label">OPERATÖR</span>
					<strong class="op-email">owner@kriptonik.com</strong>
					<span class="op-role">Yetki: Owner (CF Access)</span>
				</div>
				<a href="/" class="site-return-link">
					<Icon name="arrow-left" size={12} />
					<span>Siteye Dön</span>
				</a>
			</div>
		</aside>

		<!-- Main High-Density Workspace -->
		<main class="cockpit-workspace">
			<!-- Top Bar: Global Search & Health Actions -->
			<header class="workspace-topbar">
				<div class="workspace-title-wrap">
					<span class="section-tag" id="active-tab-tag">PANO</span>
					<h1 class="workspace-headline" id="active-tab-title">Sistem Gösterge Paneli</h1>
				</div>

				<div class="workspace-actions">
					<button type="button" class="cockpit-btn outline" id="btn-purge-kv">
						<Icon name="refresh" size={13} />
						<span>KV Temizle</span>
					</button>
					<button type="button" class="cockpit-btn signal" id="btn-sync-telemetry">
						<Icon name="activity" size={13} />
						<span>Piyasayı Yenile</span>
					</button>
				</div>
			</header>

			<!-- TAB 1: Pano (Dashboard) -->
			<section class="tab-content active" id="tab-dashboard">
				<!-- Health Cards Grid -->
				<div class="kpi-cockpit-grid">
					<div class="kpi-panel">
						<div class="kpi-top">
							<span class="kpi-label">GÜNLÜK TEKİL ETKİLEŞİM</span>
							<Icon name="activity" size={14} class="kpi-ico" />
						</div>
						<div class="kpi-value font-mono">24,850</div>
						<div class="kpi-sub info">+%18.4 bu hafta (Cloudflare Analytics)</div>
					</div>

					<div class="kpi-panel">
						<div class="kpi-top">
							<span class="kpi-label">PİYASA VERİ TAZELEME</span>
							<span class="status-indicator-dot live"></span>
						</div>
						<div class="kpi-value font-mono">1.2 sn</div>
						<div class="kpi-sub ok">Binance Public Edge • Gecikme 42ms</div>
					</div>

					<div class="kpi-panel">
						<div class="kpi-top">
							<span class="kpi-label">KV ÖNBELLEK İSABETİ</span>
							<Icon name="cpu" size={14} class="kpi-ico" />
						</div>
						<div class="kpi-value font-mono">%98.6</div>
						<div class="kpi-sub ok">Edge TTL 30s • 0 Soğuk Başlangıç</div>
					</div>

					<div class="kpi-panel">
						<div class="kpi-top">
							<span class="kpi-label">DİKKAT GEREKTİREN DURUM</span>
							<Icon name="alert-triangle" size={14} class="kpi-ico warn" />
						</div>
						<div class="kpi-value font-mono warn">0 Kritik</div>
						<div class="kpi-sub">Tüm API yanıtları ve şemalar operasyonel</div>
					</div>
				</div>

				<!-- Most Used Tools & Recent Audits -->
				<div class="cockpit-split-row">
					<div class="cockpit-card-box">
						<div class="box-head">
							<h3 class="box-title">En Çok Teşhis Alan Saha Araçları (7 Gün)</h3>
							<span class="box-badge">Anonim Sayaç</span>
						</div>
						<div class="table-shell">
							<table class="cockpit-table">
								<thead>
									<tr>
										<th>Araç</th>
										<th>Kategori</th>
										<th>Veri Akışı</th>
										<th>Kullanım</th>
										<th>Durum</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td><strong>Yanlış Ağa Gönderdim</strong></td>
										<td><span class="tbl-tag">Acil</span></td>
										<td><span class="tbl-flow client">Tarayıcı</span></td>
										<td class="font-mono">11,420</td>
										<td><StatusPill status="live" label="Aktif" /></td>
									</tr>
									<tr>
										<td><strong>Takılan İşlem Teşhisi</strong></td>
										<td><span class="tbl-tag">Acil</span></td>
										<td><span class="tbl-flow server">Sunucu</span></td>
										<td class="font-mono">6,840</td>
										<td><StatusPill status="live" label="Aktif" /></td>
									</tr>
									<tr>
										<td><strong>Gerçek Maliyet Karşılaştırıcı</strong></td>
										<td><span class="tbl-tag">Hesap</span></td>
										<td><span class="tbl-flow client">Tarayıcı</span></td>
										<td class="font-mono">4,120</td>
										<td><StatusPill status="live" label="Aktif" /></td>
									</tr>
									<tr>
										<td><strong>Adres ve Ağ Format Denetimi</strong></td>
										<td><span class="tbl-tag">Güvenlik</span></td>
										<td><span class="tbl-flow client">Tarayıcı</span></td>
										<td class="font-mono">2,470</td>
										<td><StatusPill status="live" label="Aktif" /></td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

					<div class="cockpit-card-box">
						<div class="box-head">
							<h3 class="box-title">Son Denetim İşlemleri (Audit Log)</h3>
							<a href="#" class="box-link" data-switch-tab="audit">Tümünü İncele →</a>
						</div>
						<div class="audit-mini-stream">
							<div class="stream-row">
								<div class="stream-dot"></div>
								<div class="stream-body">
									<strong>Araç Düzenlendi: Yanlış Ağa Gönderdim</strong>
									<span>Zorunlu dolandırıcılık uyarısı sabitlendi • 15 dk önce</span>
								</div>
								<span class="stream-user font-mono">owner@</span>
							</div>
							<div class="stream-row">
								<div class="stream-dot"></div>
								<div class="stream-body">
									<strong>Yeni Kılavuz Yayınlandı: Seed Phrase Güvenliği</strong>
									<span>Doğrulanmış 3 teknik kaynak eklendi • 1 saat önce</span>
								</div>
								<span class="stream-user font-mono">editor@</span>
							</div>
							<div class="stream-row">
								<div class="stream-dot"></div>
								<div class="stream-body">
									<strong>Affiliate Açıklama Metni Doğrulandı</strong>
									<span>Zorunlu şeffaflık etiketi onaylandı • 3 saat önce</span>
								</div>
								<span class="stream-user font-mono">owner@</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- TAB 2: Araç Yöneticisi (Tools) -->
			<section class="tab-content" id="tab-tools">
				<div class="section-toolbar">
					<div class="toolbar-search">
						<Icon name="search" size={14} />
						<input type="text" placeholder="Araç adına veya slug'a göre filtrele..." id="tools-search-input" />
					</div>
					<div class="toolbar-actions">
						<span class="tool-count-text">12 Canlı • 4 Yakında</span>
					</div>
				</div>

				<div class="table-shell">
					<table class="cockpit-table">
						<thead>
							<tr>
								<th>Adı & Slug</th>
								<th>Kategori</th>
								<th>Durum</th>
								<th>Veri Akışı</th>
								<th>Ana Sayfa</th>
								<th>Sıra</th>
								<th>Eylem</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>
									<strong>Yanlış Ağa Gönderdim</strong>
									<span class="tbl-sub font-mono">/araclar/yanlis-aga-gonderdim</span>
								</td>
								<td><span class="tbl-tag">Acil Sorun</span></td>
								<td><StatusPill status="live" label="Canlı" /></td>
								<td><span class="tbl-flow client">Tamamen tarayıcıda</span></td>
								<td><span class="toggle-yes">Gösteriliyor</span></td>
								<td class="font-mono">01</td>
								<td><button type="button" class="row-edit-btn">Düzenle</button></td>
							</tr>
							<tr>
								<td>
									<strong>Takılan İşlem Teşhisi</strong>
									<span class="tbl-sub font-mono">/araclar/takilan-islem</span>
								</td>
								<td><span class="tbl-tag">Acil Sorun</span></td>
								<td><StatusPill status="live" label="Canlı" /></td>
								<td><span class="tbl-flow server">Sunucuya istek atar</span></td>
								<td><span class="toggle-yes">Gösteriliyor</span></td>
								<td class="font-mono">02</td>
								<td><button type="button" class="row-edit-btn">Düzenle</button></td>
							</tr>
							<tr>
								<td>
									<strong>Adres ve Ağ Format Denetimi</strong>
									<span class="tbl-sub font-mono">/araclar/adres-ag-eslestirici</span>
								</td>
								<td><span class="tbl-tag">Güvenlik</span></td>
								<td><StatusPill status="live" label="Canlı" /></td>
								<td><span class="tbl-flow client">Tamamen tarayıcıda</span></td>
								<td><span class="toggle-yes">Gösteriliyor</span></td>
								<td class="font-mono">03</td>
								<td><button type="button" class="row-edit-btn">Düzenle</button></td>
							</tr>
							<tr>
								<td>
									<strong>Gerçek Maliyet Karşılaştırıcı</strong>
									<span class="tbl-sub font-mono">/araclar/maliyet-karsilastirici</span>
								</td>
								<td><span class="tbl-tag">Hesaplayıcı</span></td>
								<td><StatusPill status="live" label="Canlı" /></td>
								<td><span class="tbl-flow client">Tamamen tarayıcıda</span></td>
								<td><span class="toggle-yes">Gösteriliyor</span></td>
								<td class="font-mono">04</td>
								<td><button type="button" class="row-edit-btn">Düzenle</button></td>
							</tr>
							<tr>
								<td>
									<strong>Madencilik Kârlılık Hesabı</strong>
									<span class="tbl-sub font-mono">/araclar/madencilik-karlilik</span>
								</td>
								<td><span class="tbl-tag">Hesaplayıcı</span></td>
								<td><StatusPill type="soon" label="Yakında" /></td>
								<td><span class="tbl-flow client">Tamamen tarayıcıda</span></td>
								<td><span class="toggle-no">Gizli (Arşiv)</span></td>
								<td class="font-mono">99</td>
								<td><button type="button" class="row-edit-btn">Düzenle</button></td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- TAB 3: Rehber CMS (Mini CMS with mandatory sources) -->
			<section class="tab-content" id="tab-guides">
				<div class="cms-editor-container">
					<div class="cms-form-panel">
						<div class="box-head">
							<h3 class="box-title">Kılavuz Düzenleyici / Yeni Rehber Ekle</h3>
							<span class="mandatory-badge">* Doğrulanmış Kaynaklar Zorunludur</span>
						</div>

						<div class="cms-form-grid">
							<div class="input-block">
								<label class="cockpit-label">Rehber Başlığı:</label>
								<input type="text" class="cockpit-input" value="USDT'yi Yanlış Ağa Gönderdim: Kurtarma Yolları" />
							</div>
							<div class="input-block">
								<label class="cockpit-label">Slug (URL):</label>
								<input type="text" class="cockpit-input font-mono" value="usdt-yanlis-ag" />
							</div>
							<div class="input-block">
								<label class="cockpit-label">Yazar:</label>
								<input type="text" class="cockpit-input" value="Kriptonik Teknik Saha Ekibi" />
							</div>
							<div class="input-block">
								<label class="cockpit-label">İlgili Araç CTA:</label>
								<select class="cockpit-select">
									<option value="yanlis-aga-gonderdim">Yanlış Ağa Gönderdim Sihirbazı</option>
									<option value="takilan-islem">Takılan İşlem Teşhisi</option>
									<option value="adres-ag-eslestirici">Adres ve Ağ Format Denetimi</option>
								</select>
							</div>

							<div class="input-block full-width">
								<label class="cockpit-label">Teknik Kaynaklar (Her Satıra Bir Kaynak — Zorunlu Alan):</label>
								<textarea class="cockpit-textarea font-mono" rows="3">EIP-55 Mixed-case Checksum Specification (Ethereum Improvement Proposals)
BIP-0044 Multi-Account Hierarchy for Deterministic Wallets
Binance Official Token Recovery Standards & Deposit Memo Guidelines</textarea>
								<span class="field-hint">Kaynak içermeyen rehberler yayın durumuna alınamaz.</span>
							</div>

							<div class="input-block full-width">
								<label class="cockpit-label">Kılavuz İçeriği (Markdown):</label>
								<textarea class="cockpit-textarea font-mono" rows="8">## 1. Panik Yapma ve Dolandırıcılara Karşı Uyanık Ol
Kripto para transferlerinde yanlış ağ seçimi en yaygın kullanıcı hatalarından biridir. Blokzincirde tokenlar buharlaşmaz...</textarea>
							</div>
						</div>

						<div class="form-actions-row">
							<button type="button" class="cockpit-btn signal" id="btn-save-guide">
								<Icon name="check" size={14} />
								<span>Kılavuzu Kaydet & Yayınla</span>
							</button>
							<button type="button" class="cockpit-btn outline">Taslak Olarak Sakla</button>
						</div>
					</div>
				</div>
			</section>

			<!-- TAB 4: Gelir & Affiliate (Mandatory disclosure enforcement) -->
			<section class="tab-content" id="tab-affiliate">
				<div class="affiliate-cockpit-box">
					<div class="box-head">
						<h3 class="box-title">Şeffaf Gelir & Ortaklık Bağlantıları</h3>
						<span class="mandatory-badge">* Reklam Beyanı Olmadan Yayınlanamaz</span>
					</div>

					<div class="disclosure-rule-card">
						<Icon name="shield-check" size={20} />
						<div class="rule-text">
							<strong>Kriptonik Şeffaflık İlkesi:</strong>
							<p>Sitemizdeki maliyet kıyaslamaları hiçbir zaman affiliate gelirlerine göre sıralanamaz. Tanımlanan her harici bağlantının yanında zorunlu reklam/ortaklık beyan metni gösterilmek zorundadır.</p>
						</div>
					</div>

					<div class="table-shell">
						<table class="cockpit-table">
							<thead>
								<tr>
									<th>Bağlantı Adı</th>
									<th>Hedef URL</th>
									<th>Zorunlu Beyan Durumu</th>
									<th>Tıklama (Anonim)</th>
									<th>Durum</th>
									<th>Eylem</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><strong>Binance TR Komisyon İndirimi</strong></td>
									<td class="font-mono tbl-sub">https://trbinance.com/ref/...</td>
									<td><span class="tbl-flow client">✓ Şeffaf Etiket Doğrulandı</span></td>
									<td class="font-mono">1,820</td>
									<td><StatusPill status="live" label="Yayında" /></td>
									<td><button type="button" class="row-edit-btn">Düzenle</button></td>
								</tr>
								<tr>
									<td><strong>Ledger Donanım Cüzdanı</strong></td>
									<td class="font-mono tbl-sub">https://shop.ledger.com/...</td>
									<td><span class="tbl-flow client">✓ Şeffaf Etiket Doğrulandı</span></td>
									<td class="font-mono">640</td>
									<td><StatusPill status="live" label="Yayında" /></td>
									<td><button type="button" class="row-edit-btn">Düzenle</button></td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</section>

			<!-- TAB 5: Veri Kaynakları & Telemetry Sağlığı -->
			<section class="tab-content" id="tab-datasources">
				<div class="sources-cockpit-grid">
					<div class="source-card">
						<div class="source-card-top">
							<strong>Binance Public Market API</strong>
							<StatusPill status="live" label="Çalışıyor" />
						</div>
						<div class="source-metrics font-mono">
							<span>Gecikme: 38ms</span>
							<span>Son Başarılı Çekim: 20 sn önce</span>
							<span>Hata Sayısı: 0</span>
						</div>
						<div class="source-actions">
							<button type="button" class="row-edit-btn">Manuel Yenile</button>
						</div>
					</div>

					<div class="source-card">
						<div class="source-card-top">
							<strong>Mempool.space (Bitcoin Ağ API)</strong>
							<StatusPill status="live" label="Çalışıyor" />
						</div>
						<div class="source-metrics font-mono">
							<span>Gecikme: 110ms</span>
							<span>Son Başarılı Çekim: 1 dk önce</span>
							<span>Hata Sayısı: 0</span>
						</div>
						<div class="source-actions">
							<button type="button" class="row-edit-btn">Manuel Yenile</button>
						</div>
					</div>

					<div class="source-card">
						<div class="source-card-top">
							<strong>Alternative.me (Korku & Açgözlülük)</strong>
							<StatusPill status="live" label="Çalışıyor" />
						</div>
						<div class="source-metrics font-mono">
							<span>Gecikme: 240ms</span>
							<span>Son Başarılı Çekim: 8 dk önce</span>
							<span>Hata Sayısı: 0</span>
						</div>
						<div class="source-actions">
							<button type="button" class="row-edit-btn">Manuel Yenile</button>
						</div>
					</div>

					<div class="source-card">
						<div class="source-card-top">
							<strong>Cloudflare D1 (SQLite SQL)</strong>
							<StatusPill status="live" label="Bağlı" />
						</div>
						<div class="source-metrics font-mono">
							<span>Sorgu Gecikmesi: 1.2ms</span>
							<span>Replika Durumu: Aktif</span>
							<span>Toplam Tablo: 9</span>
						</div>
						<div class="source-actions">
							<button type="button" class="row-edit-btn">Şemayı Doğrula</button>
						</div>
					</div>
				</div>
			</section>

			<!-- TAB 6: Denetim Günlüğü (Audit Log) -->
			<section class="tab-content" id="tab-audit">
				<div class="audit-full-table-box">
					<div class="box-head">
						<h3 class="box-title">Değiştirilemez Denetim Günlüğü (Audit Log)</h3>
						<span class="box-badge font-mono">D1 SQL • Silinemez</span>
