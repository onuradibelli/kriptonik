---
import Layout from '../../layouts/Layout.astro';
import { termsData, type Term } from '../../data/terms';

export function getStaticPaths() {
	return termsData.map((term: Term) => ({
		params: { slug: term.slug },
		props: { term }
	}));
}

const { term } = Astro.props as { term: Term };
const pageTitle = `${term.title} Nedir? Nasıl Çalışır? | Kriptonik Sözlük`;
const pageDesc = `${term.title} teriminin sade Türkçe açıklaması, gerçek hayat örneği, ilgili kavramlar ve pratik kullanım araçları.`;
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container term-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/sozluk">Sözlük</a>
			<span>/</span>
			<span class="current">{term.title}</span>
		</nav>

		<article class="term-article">
			<div class="term-header">
				<div class="badge-pill">
					<span>📖</span>
					<span>{term.category}</span>
				</div>
				<h1 class="term-title">{term.title} Nedir?</h1>
			</div>

			<div class="term-def-card">
				<h2 class="def-heading">Tanım ve Açıklama</h2>
				<p class="def-text">{term.definition}</p>
			</div>

			<div class="term-example-card">
				<h3 class="example-heading">💡 Gerçek Hayat Örneği & Senaryo</h3>
				<p class="example-text">{term.example}</p>
			</div>

			{term.relatedTool && (
				<div class="related-tool-banner">
					<div class="tool-callout">
						<strong>Bu Terimle İlgili Pratik Kriptonik Aracı:</strong>
						<span>Bu kavramı doğrudan hesaplamak veya analiz etmek için ilgili aracımızı kullanabilirsiniz.</span>
					</div>
					<a href={term.relatedTool} class="btn btn-primary">Aracı Aç ➔</a>
				</div>
			)}

			<div class="related-terms-box">
				<h3>🔗 İlgili Diğer Terimler:</h3>
				<div class="related-tags">
					{term.relatedTerms.map(rt => (
						<a href="/sozluk" class="term-tag">{rt}</a>
					))}
				</div>
			</div>
		</article>

		<div class="back-link-wrap">
			<a href="/sozluk" class="btn btn-secondary">← Tüm Sözlük Terimlerine Dön</a>
		</div>
	</div>
</Layout>

<style>
.term-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
	max-width: 800px;
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}

.term-header {
	margin-bottom: var(--space-6);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.term-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	letter-spacing: -0.02em;
}

.term-def-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-6);
	margin-bottom: var(--space-6);
}
.def-heading {
	font-size: var(--text-lg);
	font-weight: 700;
	margin-bottom: var(--space-3);
}
.def-text {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	line-height: 1.7;
	margin: 0;
}

.term-example-card {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-left: 4px solid var(--color-primary-500);
	border-radius: var(--radius-lg);
	padding: var(--space-5);
	margin-bottom: var(--space-6);
}
.example-heading {
	font-size: var(--text-base);
	font-weight: 700;
	margin-bottom: var(--space-2);
}
.example-text {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
	line-height: 1.6;
	margin: 0;
}

.related-tool-banner {
	background: rgba(59, 130, 246, 0.08);
	border: 1px solid rgba(59, 130, 246, 0.25);
	border-radius: var(--radius-lg);
	padding: var(--space-5);
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: var(--space-6);
	flex-wrap: wrap;
	gap: var(--space-4);
}
.tool-callout {
	display: flex;
	flex-direction: column;
	gap: 2px;
}
.tool-callout strong {
	font-size: var(--text-sm);
	color: var(--color-text-primary);
}
.tool-callout span {
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
}

.related-terms-box {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-5);
	margin-bottom: var(--space-8);
}
.related-terms-box h3 {
	font-size: var(--text-sm);
	font-weight: 700;
	margin-bottom: var(--space-3);
}
.related-tags {
	display: flex;
	flex-wrap: wrap;
	gap: var(--space-2);
}
.term-tag {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	padding: var(--space-1) var(--space-3);
	border-radius: var(--radius-md);
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
	text-decoration: none;
	font-weight: 500;
}
.term-tag:hover {
	border-color: var(--color-primary-500);
	color: var(--color-primary-400);
}

.back-link-wrap {
	margin-top: var(--space-6);
}
</style>
