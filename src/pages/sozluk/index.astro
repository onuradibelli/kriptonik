---
import Layout from '../../layouts/Layout.astro';
import { termsData } from '../../data/terms';

const pageTitle = "Kripto Para Terimleri Sözlüğü (100 Temel Kavram) | Kriptonik";
const pageDesc = "Kripto dünyasındaki teknik terimler, blokzincir kavramları, güvenlik ve DeFi terminolojisi sade ve anlaşılır Türkçe ile.";

// Categories list
const categories = Array.from(new Set(termsData.map(t => t.category)));
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container glossary-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<span class="current">Sözlük</span>
		</nav>

		<div class="page-header">
			<div class="badge-pill">
				<span>📚</span>
				<span>100 Kapsamlı Terim</span>
			</div>
			<h1 class="page-title">Kripto Para & Blokzincir Sözlüğü</h1>
			<p class="page-subtitle">
				Karmaşık teknik terimleri herkesin anlayacağı sade bir dille açıklıyoruz. Arama kutusunu kullanarak terim bulun veya kategorilere göre filtreleyin.
			</p>
		</div>

		<!-- Search & Category Filter Controls -->
		<div class="filter-bar">
			<div class="search-wrap">
				<input 
					type="text" 
					id="glossary-search" 
					class="search-input" 
					placeholder="Terim veya açıklama ara (Örn: Nonce, RBF, Likidasyon, Seed...)" 
					autocomplete="off"
				/>
			</div>

			<div class="category-pills" id="category-pills">
				<button class="cat-pill active" data-cat="ALL">Tümü ({termsData.length})</button>
				{categories.map(cat => (
					<button class="cat-pill" data-cat={cat}>{cat}</button>
				))}
			</div>
		</div>

		<!-- Terms Grid -->
		<div class="terms-grid" id="terms-grid">
			{termsData.map(term => (
				<div class="term-card" data-slug={term.slug} data-cat={term.category} data-title={term.title.toLowerCase()} data-desc={term.definition.toLowerCase()}>
					<div class="card-head">
						<span class="term-cat-badge">{term.category}</span>
						<a href={`/sozluk/${term.slug}`} class="term-link-arrow" title="Detaylı İncele">➔</a>
					</div>
					<h3 class="term-card-title">
						<a href={`/sozluk/${term.slug}`}>{term.title}</a>
					</h3>
					<p class="term-card-desc">{term.definition}</p>
					<div class="card-footer">
						<span class="example-preview">💡 {term.example.slice(0, 75)}...</span>
					</div>
				</div>
			))}
		</div>

		<div id="no-results" class="no-results-box" style="display: none;">
			<p>Aradığınız kriterlere uygun terim bulunamadı.</p>
		</div>
	</div>
</Layout>

<style>
.glossary-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}

.page-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.page-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-2);
	letter-spacing: -0.02em;
}
.page-subtitle {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	max-width: 700px;
	line-height: 1.6;
}

.filter-bar {
	display: flex;
	flex-direction: column;
	gap: var(--space-4);
	margin-bottom: var(--space-8);
}
.search-input {
	width: 100%;
	padding: var(--space-3) var(--space-4);
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	font-size: var(--text-sm);
	color: var(--color-text-primary);
	outline: none;
	transition: border-color var(--transition-fast);
}
.search-input:focus {
	border-color: var(--color-primary-500);
}
.category-pills {
	display: flex;
	flex-wrap: wrap;
	gap: var(--space-2);
}
.cat-pill {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	padding: var(--space-1) var(--space-3);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 600;
	color: var(--color-text-secondary);
	cursor: pointer;
	transition: all var(--transition-fast);
}
.cat-pill.active, .cat-pill:hover {
	background: var(--color-primary-500);
	border-color: var(--color-primary-500);
	color: white;
}

.terms-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
	gap: var(--space-4);
}
.term-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-5);
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	transition: all var(--transition-fast);
}
.term-card:hover {
	transform: translateY(-2px);
	border-color: var(--color-primary-500);
}
.card-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: var(--space-2);
}
.term-cat-badge {
	font-size: 10px;
	font-weight: 700;
	background: var(--color-surface-hover);
	padding: 2px 6px;
	border-radius: var(--radius-sm);
	color: var(--color-text-muted);
}
.term-link-arrow {
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	text-decoration: none;
}
.term-link-arrow:hover {
	color: var(--color-primary-400);
}
.term-card-title {
	font-size: var(--text-base);
	font-weight: 700;
	margin-bottom: var(--space-2);
}
.term-card-title a {
	color: var(--color-text-primary);
	text-decoration: none;
}
.term-card-title a:hover {
	color: var(--color-primary-400);
}
.term-card-desc {
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
	line-height: 1.6;
	margin-bottom: var(--space-4);
	display: -webkit-box;
	-webkit-line-clamp: 4;
	-webkit-box-orient: vertical;
	overflow: hidden;
}
.card-footer {
	border-top: 1px solid var(--color-border);
	padding-top: var(--space-2);
}
.example-preview {
	font-size: 11px;
	color: var(--color-text-muted);
	font-style: italic;
}

.no-results-box {
	text-align: center;
	padding: var(--space-12);
	color: var(--color-text-muted);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const searchInput = document.getElementById('glossary-search') as HTMLInputElement;
	const catBtns = document.querySelectorAll<HTMLButtonElement>('.cat-pill');
	const cards = document.querySelectorAll<HTMLElement>('.term-card');
	const noResults = document.getElementById('no-results');

	let activeCat = 'ALL';
	let query = '';

	function filter() {
		let visibleCount = 0;
		cards.forEach(card => {
			const cardCat = card.dataset.cat || '';
			const cardTitle = card.dataset.title || '';
			const cardDesc = card.dataset.desc || '';

			const matchesCat = activeCat === 'ALL' || cardCat === activeCat;
			const matchesQuery = query === '' || cardTitle.includes(query) || cardDesc.includes(query);

			if (matchesCat && matchesQuery) {
				card.style.display = 'flex';
				visibleCount++;
			} else {
				card.style.display = 'none';
			}
		});

		if (noResults) {
			noResults.style.display = visibleCount === 0 ? 'block' : 'none';
		}
	}

	searchInput?.addEventListener('input', (e) => {
		query = (e.target as HTMLInputElement).value.toLowerCase().trim();
		filter();
	});

	catBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			catBtns.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			activeCat = btn.dataset.cat || 'ALL';
			filter();
		});
	});
});
</script>
