---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="container hero-container">
			<div class="badge-pill">
				<span class="pulse-dot-small"></span>
				<span>Hesapsız, Anında, Anlaşılır Kripto Araçları</span>
			</div>

			<h1 class="hero-main-title">
				Kripto'da takıldığın an,<br />
				<span class="gradient-text">çözüm burada.</span>
			</h1>

			<p class="hero-subtext">
				Para yanlış ağa mı gönderildi, işleminiz saatlerdir onaylanmıyor mu, transferin en ucuz yolu hangisi? Kriptonik, hiçbir üyelik istemeden saniyeler içinde probleminizi çözer.
			</p>

			<!-- Hero Problem Resolver Search -->
			<div class="hero-search-box">
				<div class="search-input-wrapper">
					<span class="search-icon-symbol">🔍</span>
					<input 
						type="text" 
						id="hero-problem-input" 
						class="problem-search-input" 
						placeholder="Yaşadığınız sorunu yazın (Örn: USDT yanlış ağa gitti, pending kaldı, adres kontrolü...)" 
						autocomplete="off"
					/>
				</div>

				<!-- Quick Problem Suggestions Dropdown -->
				<div class="search-suggestions" id="search-suggestions">
					<a href="/araclar/yanlis-aga-gonderdim" class="sugg-item">
						<span class="s-icon">🧭</span>
						<div>
							<strong>Yanlış Ağa Gönderdim</strong>
							<span>BEP-20, ERC-20 veya TRC-20 kurtarma kılavuzu ve teşhisi</span>
						</div>
					</a>
					<a href="/araclar/takilan-islem" class="sugg-item">
						<span class="s-icon">⏱️</span>
						<div>
							<strong>İşlemim Onaylanmıyor / Pending Kaldı</strong>
							<span>Mempool kuyruğu, RBF ve Nonce hızlandırma</span>
						</div>
					</a>
					<a href="/araclar/adres-ag-eslestirici" class="sugg-item">
						<span class="s-icon">🔍</span>
						<div>
							<strong>Adres Ağ Eşleştirici</strong>
							<span>Cüzdan adresinin hangi ağları desteklediğini doğrulama</span>
						</div>
					</a>
					<a href="/araclar/maliyet-karsilastirici" class="sugg-item">
						<span class="s-icon">⚖️</span>
						<div>
							<strong>Gerçek Maliyet Karşılaştırıcı</strong>
							<span>TL'den kriptoya en ucuz transfer rotaları</span>
						</div>
					</a>
					<a href="/araclar/dca-simulator" class="sugg-item">
						<span class="s-icon">📈</span>
						<div>
							<strong>DCA Geri Test Simülatörü</strong>
							<span>Düzenli kripto alımı kâr/zarar simülasyonu</span>
						</div>
					</a>
				</div>

				<!-- 4 Quick Action Pills -->
				<div class="quick-pills">
					<span class="quick-title">Hızlı Çözümler:</span>
					<a href="/araclar/yanlis-aga-gonderdim" class="pill-btn">🧭 Yanlış Ağa Gönderdim</a>
					<a href="/araclar/takilan-islem" class="pill-btn">⏱️ Takılan İşlem (Pending)</a>
					<a href="/araclar/adres-ag-eslestirici" class="pill-btn">🔍 Adres Ağ Kontrolü</a>
					<a href="/araclar/maliyet-karsilastirici" class="pill-btn">⚖️ En Ucuz Transfer Yolu</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Live Market & Gas Ticker Strip -->
	<section class="ticker-strip">
		<div class="container strip-container">
			<div class="ticker-item">
				<span class="t-name">BTC:</span>
				<span class="t-val mono-text" id="live-btc">$91,850</span>
				<span class="t-change text-success">+3.2%</span>
			</div>
			<div class="ticker-item">
				<span class="t-name">ETH:</span>
				<span class="t-val mono-text" id="live-eth">$3,420</span>
				<span class="t-change text-success">+2.1%</span>
			</div>
			<div class="ticker-item">
				<span class="t-name">USDT/TRY:</span>
				<span class="t-val mono-text text-accent" id="live-usdt">₺38.52</span>
			</div>
			<div class="ticker-item">
				<span class="t-name">ETH Gas:</span>
				<span class="t-val mono-text">16 Gwei ($1.8)</span>
			</div>
			<div class="ticker-item">
				<span class="t-name">Korku Endeksi:</span>
				<span class="t-val mono-text text-warning">74 (Açgözlülük)</span>
			</div>
			<div class="ticker-item">
				<a href="/piyasa" class="ticker-link">Detaylı Canlı Panel →</a>
			</div>
		</div>
	</section>

	<!-- "Şu An İhtiyacın Olan Şey" Urgent Action Cards -->
	<section class="urgent-section">
		<div class="container">
			<div class="section-header">
				<span class="section-tag">ACİL İLK YARDIM</span>
				<h2 class="section-title">Şu An İhtiyacınız Olan Çözüm</h2>
				<p class="section-desc">Kripto kullanıcılarının en sık yaşadığı 4 kritik senaryo için hazır araçlar:</p>
			</div>

			<div class="urgent-grid">
				<div class="urgent-card">
					<div class="u-icon">🧭</div>
					<h3 class="u-title">Yanlış Ağa Gönderdim</h3>
					<p class="u-desc">Para yanlış ağa gittiğinde kurtarılabilirlik durumunu teşhis edin, cüzdan adımlarını ve borsa destek mesaj şablonunu anında alın.</p>
					<a href="/araclar/yanlis-aga-gonderdim" class="btn btn-primary btn-sm">
						<span>Kurtarma Sihirbazını Aç →</span>
					</a>
				</div>

				<div class="urgent-card">
					<div class="u-icon">⏱️</div>
					<h3 class="u-title">Takılan İşlem Teşhisi</h3>
					<p class="u-desc">Saatlerdir 'Pending' kalan transferlerin mempool durumunu öğrenin. RBF, CPFP veya MetaMask Nonce sıfırlama ile işlemi hemen kurtarın.</p>
					<a href="/araclar/takilan-islem" class="btn btn-primary btn-sm">
						<span>İşlemi Hızlandır / İptal Et →</span>
					</a>
				</div>

				<div class="urgent-card">
					<div class="u-icon">🔍</div>
					<h3 class="u-title">Adres Ağ Eşleştirici</h3>
					<p class="u-desc">Gönderim yapmadan önce hedef adresin hangi ağları desteklediğini saniyeler içinde doğrulayın; çapraz ağ kayıp riskini sıfırlayın.</p>
					<a href="/araclar/adres-ag-eslestirici" class="btn btn-primary btn-sm">
						<span>Adresi Şimdi Doğrula →</span>
					</a>
				</div>

				<div class="urgent-card">
					<div class="u-icon">⚖️</div>
					<h3 class="u-title">Gerçek Maliyet Karşılaştırıcı</h3>
					<p class="u-desc">TL'den kriptoya geçerken komisyon, gizli spread ve ağ çekim ücreti dahil net elinize geçecek tutarı hesaplayıp en ucuz yolu bulun.</p>
					<a href="/araclar/maliyet-karsilastirici" class="btn btn-primary btn-sm">
						<span>Maliyetleri Kıyasla →</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Popular Tools Grid (12 Tools Showcase) -->
