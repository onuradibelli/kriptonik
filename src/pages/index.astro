<script>
	// 1. Live Telemetry Poller
	async function updateTelemetry() {
		try {
			const res = await fetch('/api/v1/market/ticker');
			if (!res.ok) return;
			const json = await res.json();
			if (!json.ok || !json.data) return;

			const d = json.data;
			const btcEl = document.getElementById('ticker-btc');
			const btcChgEl = document.getElementById('ticker-btc-chg');
			const ethEl = document.getElementById('ticker-eth');
			const ethChgEl = document.getElementById('ticker-eth-chg');
			const usdtEl = document.getElementById('ticker-usdt');
			const gasEl = document.getElementById('ticker-gas');
			const fngEl = document.getElementById('ticker-fng');
			const timeEl = document.getElementById('telemetry-timestamp');

			if (btcEl && d.btc) btcEl.textContent = '$' + Number(d.btc.usd).toLocaleString('en-US');
			if (btcChgEl && d.btc) {
				const chg = d.btc.change24h;
				btcChgEl.textContent = (chg >= 0 ? '+' : '') + chg.toFixed(1) + '%';
				btcChgEl.className = 'telemetry-change ' + (chg >= 0 ? 'up' : 'down');
			}

			if (ethEl && d.eth) ethEl.textContent = '$' + Number(d.eth.usd).toLocaleString('en-US');
			if (ethChgEl && d.eth) {
				const chg = d.eth.change24h;
				ethChgEl.textContent = (chg >= 0 ? '+' : '') + chg.toFixed(1) + '%';
				ethChgEl.className = 'telemetry-change ' + (chg >= 0 ? 'up' : 'down');
			}

			if (usdtEl && d.usdt) usdtEl.textContent = d.usdt.try.toFixed(2) + ' ₺';
			if (gasEl && d.gas) gasEl.textContent = d.gas.gwei + ' Gwei';
			if (fngEl && d.fng) fngEl.textContent = String(d.fng.value);

			if (timeEl) {
				const isStale = json.meta?.stale;
				timeEl.textContent = isStale
					? 'Veri gecikmeli • Doğrulanmış taban'
					: 'Canlı Telemetry • Binance & Mempool • Az önce';
			}
		} catch {
			// Fail quietly
		}
	}

	// 2. Client-side Instant Search Index
	const searchIndex = [
		{ title: "Yanlış Ağa Gönderdim", url: "/araclar/yanlis-aga-gonderdim", type: "Araç", desc: "BEP-20, ERC-20 veya TRC-20 aktarım kurtarma teşhisi" },
		{ title: "Takılan İşlem Teşhisi (Pending)", url: "/araclar/takilan-islem", type: "Araç", desc: "Mempool kuyruğu, RBF ve Nonce hızlandırma" },
		{ title: "Adres ve Ağ Format Denetimi", url: "/araclar/adres-ag-eslestirici", type: "Araç", desc: "EVM, Tron, Bitcoin adres checksum kontrolü" },
		{ title: "Gerçek Maliyet Karşılaştırıcı", url: "/araclar/maliyet-karsilastirici", type: "Araç", desc: "Komisyon, spread ve ağ çekim ücreti analizi" },
		{ title: "Cüzdan Güvenlik Denetimi", url: "/araclar/cuzdan-guvenlik-kontrolu", type: "Araç", desc: "Allowance yetkileri ve phishing risk check-up" },
		{ title: "DCA Simülatörü", url: "/araclar/dca-simulator", type: "Araç", desc: "Düzenli alım stratejisi geçmiş kâr/zarar testi" },
		{ title: "USDT'yi Yanlış Ağa Gönderdim Rehberi", url: "/rehber/usdt-yanlis-ag", type: "Rehber", desc: "Adım adım borsa ve cüzdan kurtarma kılavuzu" },
		{ title: "MetaMask'ta Takılan İşlemi İptal Etme", url: "/rehber/metamask-takilan-islem", type: "Rehber", desc: "Aynı nonce ile 0 ETH göndererek işlemi sıfırlama" },
		{ title: "Mempool Nedir?", url: "/sozluk", type: "Sözlük", desc: "Onay bekleyen blokzincir işlemlerinin bellek havuzu" },
		{ title: "Slippage Nedir?", url: "/sozluk", type: "Sözlük", desc: "Beklenen fiyat ile gerçekleşen fiyat arasındaki kayma" },
		{ title: "Gwei & Gas Nedir?", url: "/sozluk", type: "Sözlük", desc: "Ethereum işlem ücreti birimi ve hesaplama kuralları" }
	];

	function setupInstantSearch() {
		const input = document.getElementById('hero-instant-search') as HTMLInputElement | null;
		const dropdown = document.getElementById('hero-search-results');

		if (!input || !dropdown) return;

		input.addEventListener('input', () => {
			const q = input.value.trim().toLowerCase();
			if (!q) {
				dropdown.style.display = 'none';
				dropdown.innerHTML = '';
				return;
			}

			const matches = searchIndex.filter(item => 
				item.title.toLowerCase().includes(q) ||
				item.desc.toLowerCase().includes(q) ||
				item.type.toLowerCase().includes(q)
			).slice(0, 5);

			if (matches.length === 0) {
				dropdown.innerHTML = `<div class="search-empty">Sonuç bulunamadı. <a href="/araclar">Tüm araçlara göz at →</a></div>`;
				dropdown.style.display = 'block';
				return;
			}

			dropdown.innerHTML = matches.map(m => `
				<a href="${m.url}" class="search-result-row">
					<div class="result-info">
						<span class="result-badge">${m.type}</span>
						<strong>${m.title}</strong>
						<p>${m.desc}</p>
					</div>
					<span class="result-arrow">→</span>
				</a>
			`).join('');
			dropdown.style.display = 'block';
		});

		document.addEventListener('click', (e) => {
			if (!input.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
				dropdown.style.display = 'none';
			}
		});
	}

	updateTelemetry();
	setupInstantSearch();
	document.addEventListener('astro:after-swap', () => {
		updateTelemetry();
		setupInstantSearch();
	});
</script>

