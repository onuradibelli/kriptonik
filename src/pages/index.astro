---
// src/pages/index.astro - Kriptonik Saha Kılavuzu Ana Sayfası
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import Card from '../components/ui/Card.astro';
import StatusPill from '../components/ui/StatusPill.astro';
import Callout from '../components/ui/Callout.astro';

// FAQ Schema data
const faqItems = [
	{
		q: "Yanlış ağa giden parayı Kriptonik kurtarabilir mi?",
		a: "Kriptonik paranı doğrudan geri çekemez; çünkü blokzincir üzerinde merkezi bir geri alma mekanizması yoktur. Ancak Kriptonik, transferinin kurtarılabilir olup olmadığını (aynı adrese erişim, özel anahtar türetme veya borsa teknik kurtarma prosedürü) adım adım teşhis eder ve borsa destek ekiplerine iletebileceğin teknik talep taslağını hazırlar."
	},
	{
		q: "Kriptonik'te yaptığım işlemler veya adreslerim kaydediliyor mu?",
		a: "Hayır. Yanlış ağ sihirbazı, adres doğrulama, cüzdan güvenlik kontrolü ve maliyet simülasyonları %100 senin tarayıcında istemci tarafında çalışır. Sunucularımıza hiçbir cüzdan adresi, TX hash veya kişisel veri kaydedilmez. Sunucuya giden tek işlemler canlı piyasa oranlarıdır."
	},
	{
		q: "Sana 'kayıp paranı hemen kurtarırım' diyenlere neden güvenmemelisin?",
		a: "Blokzincir işlemlerinde 'geri alma yetkisine sahip' üçüncü bir kurtarma firması veya şahıs yoktur. Sosyal medyada veya Telegram'da 'fon kurtarma uzmanı' olduğunu iddia edenler, çaresiz kullanıcıları ikinci kez dolandırmayı hedefler. Kurtarma sadece alıcı cüzdanın özel anahtarına sahipsen veya alıcı borsa kuralları dahilinde mümkündür."
	},
	{
		q: "İşlemim neden saatlerdir onaylanmıyor (pending)?",
		a: "Genellikle işlem anında ağın aniden sıkışması ve belirlediğin gas ücretinin (Gwei) madencilerin kabul ettiği taban seviyenin altında kalmasından kaynaklanır. RBF (Replace-by-Fee) veya aynı Nonce numarasıyla daha yüksek gas ücretli iptal işlemi göndererek işlemi hızlandırabilirsin."
	},
	{
		q: "Kriptonik tamamen ücretsiz mi?",
		a: "Evet. Tüm saha araçları ve rehberler açık kaynaklı ve ücretsizdir. Sitemizde pop-up reklamlar yer almaz. Olası gelirler şeffaf bir şekilde etiketlenen borsa referans anlaşmalarından karşılanır ve sıralamalar hiçbir zaman ücrete göre değişmez."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqItems.map(item => ({
		"@type": "Question",
		"name": item.q,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.a
		}
	}))
};

const webSiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Kriptonik",
	"url": "https://kriptonik.com",
	"description": "Kripto işlemlerinde hata payını azaltan, bağımsız ve açık kaynaklı saha kılavuzu.",
	"potentialAction": {
		"@type": "SearchAction",
		"target": "https://kriptonik.com/araclar?q={search_term_string}",
		"query-input": "required name=search_term_string"
	}
};
---

<Layout
	title="Kriptonik — Kripto Saha Kılavuzu | Hata Teşhis ve Güvenlik Araçları"
	description="Yanlış ağa gönderilen transferler, bekleyen onaylar ve adres denetimi için bağımsız saha kılavuzu. Private key asla istenmez, tarayıcı öncelikli teşhis."
>
	<script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- Telemetry Live Ticker Bar (Single line) -->
	<div class="telemetry-bar" id="telemetry-bar" aria-label="Canlı Piyasa ve Ağ Göstergeleri">
		<div class="telemetry-inner">
			<div class="telemetry-track">
				<div class="telemetry-item">
					<span class="telemetry-label">BTC:</span>
					<span class="telemetry-val" id="ticker-btc">$76,160</span>
					<span class="telemetry-change up" id="ticker-btc-chg">+2.1%</span>
				</div>
				<div class="telemetry-sep">/</div>
				<div class="telemetry-item">
					<span class="telemetry-label">ETH:</span>
					<span class="telemetry-val" id="ticker-eth">$2,243</span>
					<span class="telemetry-change up" id="ticker-eth-chg">+1.5%</span>
				</div>
				<div class="telemetry-sep">/</div>
				<div class="telemetry-item">
					<span class="telemetry-label">USDT/TRY:</span>
					<span class="telemetry-val highlight" id="ticker-usdt">50.12 ₺</span>
				</div>
				<div class="telemetry-sep">/</div>
				<div class="telemetry-item">
					<span class="telemetry-label">ETH Gas:</span>
					<span class="telemetry-val" id="ticker-gas">14 Gwei</span>
					<span class="telemetry-tag">Sakin</span>
				</div>
				<div class="telemetry-sep">/</div>
				<div class="telemetry-item">
					<span class="telemetry-label">Korku & Açgözlülük:</span>
					<span class="telemetry-val" id="ticker-fng">74</span>
					<span class="telemetry-tag">Açgözlülük</span>
				</div>
			</div>
			<div class="telemetry-meta">
				<span class="status-indicator-dot live"></span>
				<span id="telemetry-timestamp">Canlı Telemetry • 1 dk önce</span>
			</div>
		</div>
	</div>

	<div class="home-container">
		<!-- HERO: "Ne oldu?" Wizard -->
		<section class="hero-wizard" id="sorunum-var">
			<div class="hero-badge-wrap">
				<span class="hero-chip">
					<Icon name="shield-check" size={13} />
					<span>BAĞIMSIZ SAHA KILAVUZU • SIFIR ÜYELİK</span>
				</span>
			</div>

			<h1 class="hero-headline">
				Kripto'da takıldığın an,<br />
				<span class="hero-signal">çözüm burada.</span>
			</h1>

			<p class="hero-lead">
				Hangi ağdasın, ne oldu? 4 dokunuşla durumu teşhis et ve güvenli adımlarla ilerle.
			</p>

			<!-- 4 Troubleshooter Options (Large, touch-friendly cockpit rows) -->
			<div class="wizard-triage-grid" role="region" aria-label="Acil Sorun Teşhisi">
				<a href="/araclar/yanlis-aga-gonderdim" class="triage-card" data-issue="wrong-network">
					<div class="triage-icon-wrap">
						<Icon name="alert-triangle" size={22} />
					</div>
					<div class="triage-body">
						<span class="triage-step">01 // AĞ UYUMSUZLUĞU</span>
						<strong class="triage-title">Parayı yanlış ağa gönderdim</strong>
						<span class="triage-desc">BEP-20, ERC-20 veya TRC-20 aktarımı; borsa veya özel cüzdan kurtarılabilirlik testi.</span>
					</div>
					<div class="triage-action">
						<span class="action-label">Teşhis Et</span>
						<Icon name="arrow-right" size={18} />
					</div>
				</a>

				<a href="/araclar/takilan-islem" class="triage-card" data-issue="stuck-tx">
					<div class="triage-icon-wrap">
						<Icon name="activity" size={22} />
					</div>
					<div class="triage-body">
						<span class="triage-step">02 // ONAY BEKLEME</span>
						<strong class="triage-title">İşlemim saatlerdir onaylanmıyor</strong>
						<span class="triage-desc">Pending kalan transferler, düşük gas tespiti, Nonce kilitlenmesi ve iptal rotaları.</span>
					</div>
					<div class="triage-action">
						<span class="action-label">Mempool İncele</span>
						<Icon name="arrow-right" size={18} />
					</div>
				</a>

				<a href="/araclar/adres-ag-eslestirici" class="triage-card" data-issue="address-check">
					<div class="triage-icon-wrap">
						<Icon name="shield-check" size={22} />
					</div>
					<div class="triage-body">
						<span class="triage-step">03 // GÖNDERİM ÖNCESİ</span>
						<strong class="triage-title">Göndermeden önce adresi kontrol etmek istiyorum</strong>
						<span class="triage-desc">EVM, Tron, Bitcoin, Solana adres formatı, checksum ve çapraz ağ risk doğrulaması.</span>
					</div>
					<div class="triage-action">
						<span class="action-label">Formatı Denetle</span>
						<Icon name="arrow-right" size={18} />
					</div>
				</a>

				<a href="/araclar/maliyet-karsilastirici" class="triage-card" data-issue="cost-calc">
					<div class="triage-icon-wrap">
						<Icon name="layers" size={22} />
					</div>
					<div class="triage-body">
						<span class="triage-step">04 // MALİYET KIYASI</span>
						<strong class="triage-title">En ucuz transfer yolunu bulmak istiyorum</strong>
						<span class="triage-desc">Komisyon + kur spreadi + ağ çekim ücreti dahil net maliyet hesabı ve borsa kıyası.</span>
					</div>
					<div class="triage-action">
						<span class="action-label">Rotayı Kıyasla</span>
						<Icon name="arrow-right" size={18} />
					</div>
				</a>
			</div>

			<!-- Instant Search & Other link -->
			<div class="hero-tools-nav">
				<div class="hero-search-box">
					<Icon name="search" size={16} class="search-ico" />
					<input
						type="text"
						id="hero-instant-search"
						placeholder="Farklı bir durum mu var? Sorun, araç veya terim ara..."
						autocomplete="off"
					/>
					<div class="search-dropdown" id="hero-search-results" style="display: none;"></div>
				</div>
				<a href="/araclar" class="all-tools-anchor">
					<span>Tüm 16 aracı listele</span>
					<Icon name="arrow-right" size={14} />
				</a>
			</div>
		</section>

		<!-- HONESTY BANNER ("Nasıl çalışıyoruz") -->
		<section class="honesty-banner" aria-label="Kriptonik Çalışma Prensipleri">
			<div class="honesty-header">
				<span class="section-tag">GÜVEN TAAHHÜDÜ</span>
				<h2 class="honesty-title">Nasıl Çalışıyoruz?</h2>
			</div>

			<div class="honesty-grid">
				<div class="honesty-card">
					<div class="honesty-icon-bar">
						<Icon name="lock" size={20} />
						<span class="honesty-num">01</span>
					</div>
					<h3 class="honesty-card-title">Private Key Asla İstenmez</h3>
					<p class="honesty-card-desc">
						Kriptonik hiçbir zaman özel anahtar, seed phrase veya cüzdan şifresi talep etmez. Sana "kayıp paranı hemen kurtarırım" diyenlere karşı dikkatli ol; blokzincirde merkezi bir yetkili yoktur.
					</p>
				</div>

				<div class="honesty-card">
					<div class="honesty-icon-bar">
						<Icon name="cpu" size={20} />
						<span class="honesty-num">02</span>
					</div>
					<h3 class="honesty-card-title">Tarayıcı Öncelikli & Şeffaf Akış</h3>
					<p class="honesty-card-desc">
						Hata teşhis sihirbazları ve hesaplama araçları %100 tarayıcında çalışır. Sunucuya giden işlemler (canlı kurlar vb.) her sayfanın tepesinde <span class="mono-badge">Sunucuya istek atar</span> rozetiyle açıkça gösterilir.
					</p>
				</div>

				<div class="honesty-card">
					<div class="honesty-icon-bar">
						<Icon name="check" size={20} />
						<span class="honesty-num">03</span>
					</div>
					<h3 class="honesty-card-title">Sıfır Gizli Reklam & Dürüst Kıyas</h3>
					<p class="honesty-card-desc">
						Maliyet karşılaştırmalarındaki sıralamalar sponsorlukla veya komisyonla değişmez. Varsa affiliate bağlantıları zorunlu olarak etiketlenir ve gelir politikamız açıkça ilan edilir.
					</p>
				</div>
			</div>
		</section>

		<!-- WORKING TOOLS SECTION (Only active, functional tools) -->
		<section class="tools-section" id="araclar">
			<div class="section-top-row">
				<div>
					<span class="section-tag">SAHA MODÜLLERİ</span>
					<h2 class="section-headline">Gerçekten Çalışan Saha Araçları</h2>
					<p class="section-subtext">Hata payını azaltmak için test edilmiş, doğrulanabilir hesaplama ve teşhis modülleri.</p>
				</div>
				<a href="/araclar" class="view-all-link">
					<span>Tüm Araç Dizini</span>
					<Icon name="arrow-right" size={14} />
				</a>
			</div>

			<div class="tools-cockpit-grid">
				<a href="/araclar/yanlis-aga-gonderdim" class="tool-cockpit-card">
					<div class="tool-card-head">
						<div class="tool-icon">
							<Icon name="alert-triangle" size={18} />
						</div>
						<div class="tool-badges">
							<StatusPill status="live" label="Canlı" />
							<StatusPill dataFlow="client" />
						</div>
					</div>
					<strong class="tool-name">Yanlış Ağa Gönderdim Sihirbazı</strong>
					<p class="tool-summary">Farklı ağa gönderilen token'ların kurtarılabilirlik teşhisi ve borsa destek mesaj şablonu.</p>
					<div class="tool-footer">
						<span class="tool-cta">Sihirbazı Başlat</span>
						<Icon name="chevron-right" size={14} />
					</div>
				</a>

				<a href="/araclar/takilan-islem" class="tool-cockpit-card">
					<div class="tool-card-head">
						<div class="tool-icon">
							<Icon name="activity" size={18} />
						</div>
						<div class="tool-badges">
							<StatusPill status="live" label="Canlı" />
							<StatusPill dataFlow="server" />
						</div>
					</div>
					<strong class="tool-name">Takılan İşlem Teşhisi (Pending)</strong>
					<p class="tool-summary">Mempool kuyruğundaki bekleyen işlemleri sorgula, RBF ve Nonce hızlandırma çözümlerini gör.</p>
					<div class="tool-footer">
						<span class="tool-cta">İşlemi Sorgula</span>
						<Icon name="chevron-right" size={14} />
					</div>
				</a>

				<a href="/araclar/adres-ag-eslestirici" class="tool-cockpit-card">
					<div class="tool-card-head">
						<div class="tool-icon">
							<Icon name="shield-check" size={18} />
						</div>
						<div class="tool-badges">
							<StatusPill status="live" label="Canlı" />
							<StatusPill dataFlow="client" />
						</div>
					</div>
					<strong class="tool-name">Adres ve Ağ Format Denetimi</strong>
					<p class="tool-summary">Gönderim öncesi EVM, Tron, Bitcoin, Solana adres checksum ve ağ uyumluluk kontrolü.</p>
					<div class="tool-footer">
						<span class="tool-cta">Adresi Doğrula</span>
						<Icon name="chevron-right" size={14} />
					</div>
				</a>

				<a href="/araclar/maliyet-karsilastirici" class="tool-cockpit-card">
					<div class="tool-card-head">
						<div class="tool-icon">
							<Icon name="layers" size={18} />
						</div>
						<div class="tool-badges">
							<StatusPill status="live" label="Canlı" />
							<StatusPill dataFlow="client" />
						</div>
					</div>
					<strong class="tool-name">Gerçek Maliyet Karşılaştırıcı</strong>
					<p class="tool-summary">Komisyon, kur makası ve ağ çekim ücretini toplayarak en düşük maliyetli borsa rotasını belirle.</p>
					<div class="tool-footer">
						<span class="tool-cta">Rotayı Hesapla</span>
						<Icon name="chevron-right" size={14} />
					</div>
				</a>

				<a href="/araclar/cuzdan-guvenlik-kontrolu" class="tool-cockpit-card">
					<div class="tool-card-head">
						<div class="tool-icon">
							<Icon name="lock" size={18} />
						</div>
						<div class="tool-badges">
							<StatusPill status="live" label="Canlı" />
							<StatusPill dataFlow="client" />
						</div>
					</div>
					<strong class="tool-name">Cüzdan Güvenlik Denetimi</strong>
					<p class="tool-summary">Yetki onayları (allowance), seed saklama alışkanlıkları ve phishing açıklarını tara.</p>
					<div class="tool-footer">
						<span class="tool-cta">Check-up Başlat</span>
						<Icon name="chevron-right" size={14} />
					</div>
				</a>

				<a href="/araclar/dca-simulator" class="tool-cockpit-card">
					<div class="tool-card-head">
						<div class="tool-icon">
							<Icon name="refresh" size={18} />
						</div>
						<div class="tool-badges">
							<StatusPill status="live" label="Canlı" />
							<StatusPill dataFlow="client" />
						</div>
					</div>
					<strong class="tool-name">DCA Simülatörü</strong>
					<p class="tool-summary">Belirli aralıklarla yapılan düzenli kripto alımlarının geçmiş kâr/zarar ve maliyet performansını test et.</p>
					<div class="tool-footer">
						<span class="tool-cta">Simülasyon Yap</span>
						<Icon name="chevron-right" size={14} />
					</div>
				</a>
			</div>
		</section>

		<!-- TWO COLUMNS: Recent Guides & Dictionary Highlights -->
		<section class="editorial-dual-section">
			<!-- Col 1: Verified Guides -->
			<div class="editorial-col">
				<div class="editorial-header">
					<div>
						<span class="section-tag">REHBERLER</span>
						<h3 class="editorial-title">Saha Çözüm Kılavuzları</h3>
					</div>
					<a href="/rehber" class="editorial-more">Tüm Rehberler →</a>
				</div>

				<div class="editorial-list">
					<a href="/rehber/usdt-yanlis-ag" class="editorial-item">
						<div class="editorial-item-body">
							<span class="item-meta">12 DK OKUMA • GÜNCELLENDİ</span>
							<strong class="item-title">USDT'yi Yanlış Ağa Gönderdim: Kurtarma Yolları</strong>
							<p class="item-desc">BEP-20'den ERC-20 veya TRC-20'ye giden tether transferlerinde izlenecek somut kurtarma prosedürleri.</p>
						</div>
						<Icon name="chevron-right" size={16} class="item-arrow" />
					</a>

					<a href="/rehber/metamask-takilan-islem" class="editorial-item">
						<div class="editorial-item-body">
							<span class="item-meta">8 DK OKUMA • GÜNCELLENDİ</span>
							<strong class="item-title">MetaMask'ta Takılan İşlemi İptal Etme (Aynı Nonce)</strong>
							<p class="item-desc">Düşük gas nedeniyle mempool'da asılı kalan işlemleri özel nonce numarasıyla sıfırlama adımları.</p>
						</div>
						<Icon name="chevron-right" size={16} class="item-arrow" />
					</a>

					<a href="/rehber/trc20-mi-bep20-mi" class="editorial-item">
						<div class="editorial-item-body">
							<span class="item-meta">6 DK OKUMA • GÜNCELLENDİ</span>
							<strong class="item-title">TRC20 mi BEP20 mi? Hangisi Daha Ucuz ve Güvenli?</strong>
							<p class="item-desc">Transfer hızı, borsa desteği ve ağ enerji maliyetleri açısından kapsamlı protokol karşılaştırması.</p>
						</div>
						<Icon name="chevron-right" size={16} class="item-arrow" />
					</a>

					<a href="/rehber/seed-phrase-guvenligi" class="editorial-item">
						<div class="editorial-item-body">
							<span class="item-meta">10 DK OKUMA • GÜNCELLENDİ</span>
							<strong class="item-title">Seed Phrase Güvenliği: 12 Kelimeyi Nasıl Saklamalısın?</strong>
							<p class="item-desc">Fotoğraf çekmek, buluta yüklemek ve dijital not tutmanın ölümcül riskleri; metal plaka ve soğuk saklama prensipleri.</p>
						</div>
						<Icon name="chevron-right" size={16} class="item-arrow" />
					</a>
				</div>
			</div>

			<!-- Col 2: Dictionary Terms -->
			<div class="editorial-col">
				<div class="editorial-header">
					<div>
						<span class="section-tag">TEKNİK SÖZLÜK</span>
						<h3 class="editorial-title">Öne Çıkan Kavramlar</h3>
					</div>
					<a href="/sozluk" class="editorial-more">Tüm Sözlük →</a>
				</div>

				<div class="editorial-list">
					<a href="/sozluk" class="editorial-item">
						<div class="editorial-item-body">
							<div class="term-title-row">
								<strong class="item-title">Mempool (Bellek Havuzu)</strong>
								<span class="term-badge">Zincir Üstü</span>
							</div>
							<p class="item-desc">İşlemlerin blokzincire yazılmadan önce madenciler tarafından seçilmeyi beklediği geçici bekleme odası.</p>
						</div>
						<Icon name="chevron-right" size={16} class="item-arrow" />
					</a>

					<a href="/sozluk" class="editorial-item">
						<div class="editorial-item-body">
							<div class="term-title-row">
								<strong class="item-title">Slippage (Fiyat Kayması)</strong>
								<span class="term-badge">İşlem</span>
							</div>
							<p class="item-desc">Emir verildiği andaki fiyat ile emrin blokzincirde fiilen gerçekleştiği andaki fiyat arasındaki fark.</p>
						</div>
						<Icon name="chevron-right" size={16} class="item-arrow" />
					</a>

