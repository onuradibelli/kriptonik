	<!-- FAQ Section -->
	<section class="faq-section">
		<div class="container container-narrow">
			<div class="section-header">
				<span class="section-tag">MERAK EDİLENLER</span>
				<h2 class="section-title">Sıkça Sorulan Sorular</h2>
			</div>

			<div class="faq-accordion">
				<details class="faq-item-card" open>
					<summary class="faq-question">
						<span>Kriptonik'i kullanmak ücretli mi?</span>
						<span class="faq-arrow">↓</span>
					</summary>
					<div class="faq-answer">
						<p>Hayır, Kriptonik'teki tüm temel problem çözme araçları, hesaplayıcılar ve teşhis motorları tamamen ücretsizdir ve herhangi bir üyelik gerektirmez.</p>
					</div>
				</details>

				<details class="faq-item-card">
					<summary class="faq-question">
						<span>Girdiğim adresler veya işlem kodları saklanıyor mu?</span>
						<span class="faq-arrow">↓</span>
					</summary>
					<div class="faq-answer">
						<p>Kesinlikle hayır. Kriptonik 'Sıfır Veri Saklama' ilkesiyle geliştirilmiştir. Adres doğrulamaları ve hesaplamalar doğrudan tarayıcınızın belleğinde çalışır; hiçbir sunucu veritabanına kaydedilmez.</p>
					</div>
				</details>

				<details class="faq-item-card">
					<summary class="faq-question">
						<span>Kriptonik cüzdanımın özel anahtarını (private key) ister mi?</span>
						<span class="faq-arrow">↓</span>
					</summary>
					<div class="faq-answer">
						<p>ASLA. Kriptonik kullanıcılarından özel anahtar (private key) veya 12-24 kelimelik kurtarma ifadesini (seed phrase) asla talep etmez. Sizden bu bilgileri isteyen herhangi bir web sitesi veya kişi %100 dolandırıcıdır.</p>
					</div>
				</details>

				<details class="faq-item-card">
					<summary class="faq-question">
						<span>Kriptonik yatırım tavsiyesi veriyor mu?</span>
						<span class="faq-arrow">↓</span>
					</summary>
					<div class="faq-answer">
						<p>Hayır. Sitemizdeki tüm içerikler, simülasyonlar ve veriler yalnızca bilgilendirme, teknik teşhis ve genel eğitim amaçlıdır; hiçbir şekilde yatırım tavsiyesi (YTD) niteliği taşımaz.</p>
					</div>
				</details>
			</div>
		</div>
	</section>
</Layout>

<script>
	// Hero smart search filter
	const searchInput = document.getElementById('hero-problem-input') as HTMLInputElement;
	const suggestions = document.getElementById('search-suggestions');

	searchInput?.addEventListener('focus', () => {
		if (suggestions) suggestions.style.display = 'block';
	});

	searchInput?.addEventListener('input', () => {
		const val = searchInput.value.toLowerCase().trim();
		if (!suggestions) return;

		suggestions.style.display = 'block';
		const items = suggestions.querySelectorAll('.sugg-item');

		items.forEach(item => {
			const text = (item as HTMLElement).innerText.toLowerCase();
			if (val === '' || text.includes(val)) {
				(item as HTMLElement).style.display = 'flex';
			} else {
				(item as HTMLElement).style.display = 'none';
			}
		});
	});

	document.addEventListener('click', (e) => {
		if (!searchInput?.contains(e.target as Node) && !suggestions?.contains(e.target as Node)) {
			if (suggestions) suggestions.style.display = 'none';
		}
	});

	// Live ticker price updates
	async function updateLiveTicker() {
		try {
			const res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,tether&vs_currencies=usd,try');
			if (!res.ok) return;
			const data = await res.json();

			const btcEl = document.getElementById('live-btc');
			const ethEl = document.getElementById('live-eth');
			const usdtEl = document.getElementById('live-usdt');

			if (btcEl && data.bitcoin) btcEl.innerText = `$${data.bitcoin.usd.toLocaleString()}`;
			if (ethEl && data.ethereum) ethEl.innerText = `$${data.ethereum.usd.toLocaleString()}`;
			if (usdtEl && data.tether) usdtEl.innerText = `₺${data.tether.try.toFixed(2)}`;
		} catch (e) {
			// graceful fallback to static
		}
	}

	updateLiveTicker();
</script>

<style>
	/* Hero Section */
	.hero-section {
		padding: 72px 0 48px;
		text-align: center;
