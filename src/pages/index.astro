---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="glow-bg"></div>

		<!-- Top Header -->
		<header class="header">
			<div class="container header-inner">
				<a href="/" class="logo">
					<span class="logo-icon">◈</span>
					<span class="logo-text">KRİPTONİK</span>
				</a>
				<div class="system-status">
					<span class="pulse-dot"></span>
					<span class="status-label">Cloudflare Edge: <strong>Aktif</strong></span>
				</div>
			</div>
		</header>

		<!-- Main Hero Content -->
		<main class="container">
			<section class="hero">
				<div class="badge-pill">
					<span class="badge-icon">🚀</span>
					<span>Canlı Yayın & Entegrasyon Testi Başarılı</span>
				</div>
				<h1 class="hero-title">
					Kripto'da takıldığın an,<br />
					<span class="gradient-text">çözüm burada.</span>
				</h1>
				<p class="hero-desc">
					Hesapsız, anında, anlaşılır kripto araçları. Para yanlış ağa mı gitti, işleminiz mi takıldı, en ucuz transfer yolu hangisi? Kriptonik tüm sorularınıza rehberlik eder.
				</p>
			</section>

			<!-- Live Infrastructure Status Card -->
			<section class="status-card">
				<div class="card-header">
					<div class="terminal-dots">
						<span class="dot red"></span>
						<span class="dot yellow"></span>
						<span class="dot green"></span>
					</div>
					<span class="card-tag">SİSTEM BİLGİSİ & ENTEGRASYON RAPORU</span>
				</div>
				<div class="card-body">
					<div class="info-row">
						<span class="label">Alan Adı:</span>
						<span class="val mono highlight">kriptonik.com</span>
					</div>
					<div class="info-row">
						<span class="label">Hosting & Altyapı:</span>
						<span class="val">Cloudflare Workers & Pages (Global Edge Network)</span>
					</div>
					<div class="info-row">
						<span class="label">Kaynak Kod Deposu:</span>
						<span class="val mono">github.com/onuradibelli/kriptonik</span>
					</div>
					<div class="info-row">
						<span class="label">Otomasyon:</span>
						<span class="val text-success">✓ Git Push ile Otomatik Derleme ve Yayınlama Aktif</span>
					</div>
					<div class="info-row">
						<span class="label">Tasarım & Mimari:</span>
						<span class="val">Astro 5 + Edge Framework + Sıfır Veri Saklama Prensibi</span>
					</div>
				</div>
			</section>

			<!-- Quick Interactive Demo Component -->
			<section class="demo-section">
				<div class="section-badge">HIZLI TEST ARAÇ ÖNİZLEMESİ</div>
				<h2 class="section-title">Yanlış Ağa Gönderdim Teşhis Motoru</h2>
				<p class="section-sub">Aşağıdaki seçenekleri değiştirerek anlık tarayıcı içi analiz motorunu test edebilirsiniz:</p>

				<div class="interactive-box">
					<div class="form-grid">
						<div class="form-group">
							<label for="coin-select">Gönderilen Kripto Para:</label>
							<select id="coin-select" class="custom-select">
								<option value="USDT">USDT (Tether)</option>
								<option value="ETH">ETH (Ethereum)</option>
								<option value="BNB">BNB (Binance Coin)</option>
								<option value="BTC">BTC (Bitcoin)</option>
							</select>
						</div>

						<div class="form-group">
							<label for="network-select">Kullanılan Ağ:</label>
							<select id="network-select" class="custom-select">
								<option value="BEP20">BNB Smart Chain (BEP-20)</option>
								<option value="ERC20">Ethereum Mainnet (ERC-20)</option>
								<option value="TRC20">Tron Ağı (TRC-20)</option>
								<option value="ARBITRUM">Arbitrum One</option>
							</select>
						</div>

						<div class="form-group">
							<label for="target-select">Alıcı Cüzdan Türü:</label>
							<select id="target-select" class="custom-select">
								<option value="EXCHANGE">Merkezi Borsa (Binance, BtcTurk, Paribu vb.)</option>
								<option value="PERSONAL">Kişisel Cüzdanım (MetaMask, Trust Wallet, Ledger vb.)</option>
							</select>
						</div>
					</div>

					<div class="result-box" id="result-box">
						<div class="result-header">
							<span class="result-indicator" id="result-badge">TEŞHİS YAPILIYOR...</span>
						</div>
						<div class="result-content" id="result-text">
							Lütfen seçim yapın.
						</div>
					</div>
				</div>
			</section>

			<!-- Phase 1 Tools Overview -->
			<section class="tools-overview">
				<div class="section-badge">YOL HARİTASI (FAZ 1 - MVP)</div>
				<h2 class="section-title">Kriptonik'te Çok Yakında Gelecek 5 Temel Araç</h2>

				<div class="tools-grid">
					<div class="tool-card">
						<div class="tool-icon">🧭</div>
						<div class="tool-title">Yanlış Ağa Gönderdim Sihirbazı</div>
						<p class="tool-desc">Yanlış ağa gönderilen fonların kurtarılabilirlik durumu, özel RPC/token ekleme adımları ve otomatik borsa destek talep şablonu.</p>
					</div>

					<div class="tool-card">
						<div class="tool-icon">⏱️</div>
						<div class="tool-title">Takılan İşlem Teşhisi</div>
						<p class="tool-desc">Onaylanmayan veya pending kalan transferlerin mempool analizi, RBF, CPFP ve Nonce hızlandırma/iptal rehberi.</p>
					</div>

					<div class="tool-card">
						<div class="tool-icon">🔍</div>
						<div class="tool-title">Adres Ağ Eşleştirici</div>
						<p class="tool-desc">Cüzdan adresinin formatından hangi ağları desteklediğini anında tespit edin, yanlış ağ transferi riskini sıfırlayın.</p>
					</div>

					<div class="tool-card">
						<div class="tool-icon">📈</div>
						<div class="tool-title">DCA Geri Test Simülatörü</div>
						<p class="tool-desc">Düzenli alım yapsaydınız bugün ne kadar portföyünüz olurdu? Gerçek piyasa geçmişiyle kâr/zarar simülasyonu.</p>
					</div>

					<div class="tool-card">
						<div class="tool-icon">⚖️</div>
						<div class="tool-title">Gerçek Maliyet Karşılaştırıcı</div>
						<p class="tool-desc">TL'den kriptoya geçişte komisyon, spread ve ağ çekim ücreti dahil en ucuz ve en hızlı transfer yolu karşılaştırması.</p>
					</div>

					<div class="tool-card">
						<div class="tool-icon">🛡️</div>
						<div class="tool-title">Adres & Kontrat Güvenlik Kontrolü</div>
						<p class="tool-desc">Şüpheli siteler, cüzdan onayları ve token risk sinyalleri için anlık kontrol ve risk raporu.</p>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="container footer-content">
				<div class="footer-left">
					<div class="footer-logo">
						<span>◈</span> KRİPTONİK
					</div>
					<p class="footer-tagline">Hesapsız, anında, anlaşılır kripto araçları.</p>
					<p class="footer-note">Bu sitede yer alan içerik ve araçlar yalnızca bilgilendirme amaçlıdır; yatırım tavsiyesi niteliği taşımaz.</p>
				</div>
				<div class="footer-right">
					<div class="footer-meta">
						<span>Sunucu: <strong>Cloudflare Workers / Edge</strong></span>
						<span>Konum: <strong>kriptonik.com</strong></span>
						<span>© 2026 Kriptonik. Tüm hakları saklıdır.</span>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Client-side instant diagnosis calculation
			const coinSelect = document.getElementById('coin-select') as HTMLSelectElement;
			const netSelect = document.getElementById('network-select') as HTMLSelectElement;
			const targetSelect = document.getElementById('target-select') as HTMLSelectElement;
			const resultBadge = document.getElementById('result-badge');
			const resultText = document.getElementById('result-text');

			function updateDiagnosis() {
				if (!coinSelect || !netSelect || !targetSelect || !resultBadge || !resultText) return;

				const coin = coinSelect.value;
				const net = netSelect.value;
				const target = targetSelect.value;

				if (target === 'PERSONAL') {
					resultBadge.className = 'result-indicator badge-success';
					resultBadge.innerText = '✓ %100 KURTARILABİLİR (ÖZEL ANAHTAR SİZDE)';
					resultText.innerHTML = `
						<p><strong>Harika Haber:</strong> Kendi özel cüzdanınıza (MetaMask, Trust Wallet vb.) gönderdiğiniz için özel anahtarlar (private key / seed phrase) sizdedir. Para kaybolmamıştır!</p>
						<p><strong>Çözüm Adımı:</strong> Cüzdanınıza <strong>${net}</strong> ağını ekleyin ve <strong>${coin}</strong> sözleşme adresini "Özel Token İçe Aktar" seçeneğiyle cüzdanınıza tanıtın. Bakiyeniz anında görünecektir.</p>
					`;
				} else {
					if (net === 'TRC20' && coin !== 'USDT') {
						resultBadge.className = 'result-indicator badge-danger';
						resultBadge.innerText = '⚠ YÜKSEK RİSK / DESTEK GEREKLİ';
						resultText.innerHTML = `
							<p>Tron ağında bu coin borsa tarafından otomatik tanınmayabilir. Borsanın teknik destek birimiyle iletişime geçmeniz gerekmektedir.</p>
						`;
					} else {
						resultBadge.className = 'result-indicator badge-warning';
						resultBadge.innerText = '⚡ BORSA İNSİYATİFİNDE (KURTARILABİLİR)';
						resultText.innerHTML = `
							<p><strong>Durum:</strong> Para borsanın adres havuzuna ulaştı ancak borsa bu ağı o coin için desteklemiyor olabilir. Özel anahtar borsada olduğu için manuel kurtarma işlemi yapmaları gerekir.</p>
							<p><strong>Çözüm Adımı:</strong> Borsanın 'Hatalı Yatırma / Yanlış Ağ Kurtarma' sayfasına TXID hash numaranızla başvuru yapabilirsiniz.</p>
						`;
					}
				}
			}

			coinSelect?.addEventListener('change', updateDiagnosis);
			netSelect?.addEventListener('change', updateDiagnosis);
			targetSelect?.addEventListener('change', updateDiagnosis);

			// Initial call
			updateDiagnosis();
		</script>

		<style>
			:root {
				--bg-dark: #0B0F1A;
				--surface-dark: #121829;
				--surface-border: #1E293B;
				--accent-cyan: #22D3EE;
				--accent-blue: #3B82F6;
				--text-main: #F8FAFC;
				--text-muted: #94A3B8;
				--success-color: #10B981;
				--warning-color: #F59E0B;
				--danger-color: #EF4444;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				background-color: var(--bg-dark);
				color: var(--text-main);
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				position: relative;
				overflow-x: hidden;
			}

			.glow-bg {
				position: fixed;
				top: -150px;
				left: 50%;
				transform: translateX(-50%);
				width: 800px;
				height: 450px;
				background: radial-gradient(circle, rgba(34, 211, 238, 0.15) 0%, rgba(59, 130, 246, 0.08) 50%, transparent 70%);
				pointer-events: none;
				z-index: 0;
			}

			.container {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 24px;
				width: 100%;
				position: relative;
				z-index: 1;
			}

			/* Header */
			.header {
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				background: rgba(11, 15, 26, 0.85);
				backdrop-filter: blur(12px);
				position: sticky;
				top: 0;
				z-index: 50;
			}

			.header-inner {
				height: 72px;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.logo {
				display: flex;
				align-items: center;
				gap: 10px;
				text-decoration: none;
				color: var(--text-main);
			}

			.logo-icon {
				font-size: 26px;
				color: var(--accent-cyan);
				text-shadow: 0 0 16px rgba(34, 211, 238, 0.6);
			}

			.logo-text {
				font-family: 'Space Grotesk', sans-serif;
				font-weight: 700;
				font-size: 22px;
				letter-spacing: 1.5px;
			}

			.system-status {
				display: flex;
				align-items: center;
				gap: 8px;
				background: rgba(16, 185, 129, 0.1);
				border: 1px solid rgba(16, 185, 129, 0.3);
				padding: 6px 14px;
				border-radius: 999px;
				font-size: 13px;
				color: #A7F3D0;
			}

			.pulse-dot {
				width: 8px;
				height: 8px;
				background-color: var(--success-color);
				border-radius: 50%;
				box-shadow: 0 0 8px var(--success-color);
				animation: pulse 2s infinite;
			}

			@keyframes pulse {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.5; transform: scale(0.85); }
			}

			/* Hero */
			.hero {
				padding: 64px 0 32px;
				text-align: center;
			}

			.badge-pill {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				background: rgba(34, 211, 238, 0.1);
				border: 1px solid rgba(34, 211, 238, 0.3);
				color: var(--accent-cyan);
				padding: 6px 16px;
				border-radius: 999px;
				font-size: 13px;
				font-weight: 600;
				margin-bottom: 24px;
			}

			.hero-title {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 48px;
				line-height: 1.15;
				font-weight: 700;
				margin-bottom: 20px;
				letter-spacing: -0.5px;
			}

			.gradient-text {
				background: linear-gradient(135deg, #22D3EE 0%, #60A5FA 50%, #C084FC 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.hero-desc {
				font-size: 18px;
				line-height: 1.6;
				color: var(--text-muted);
				max-width: 680px;
				margin: 0 auto;
			}

			/* Status Card */
			.status-card {
				background: var(--surface-dark);
				border: 1px solid var(--surface-border);
				border-radius: 14px;
				overflow: hidden;
				margin: 32px 0 48px;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
			}

			.card-header {
				background: #0E1322;
				border-bottom: 1px solid var(--surface-border);
				padding: 12px 20px;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.terminal-dots {
				display: flex;
				gap: 6px;
			}

			.dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
			}

			.dot.red { background-color: #EF4444; }
			.dot.yellow { background-color: #F59E0B; }
			.dot.green { background-color: #10B981; }

			.card-tag {
				font-family: 'JetBrains Mono', monospace;
				font-size: 12px;
				color: var(--text-muted);
				letter-spacing: 1px;
			}

			.card-body {
				padding: 24px;
				display: flex;
				flex-direction: column;
				gap: 14px;
			}

			.info-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 14px;
				padding-bottom: 12px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}

			.info-row:last-child {
				border-bottom: none;
				padding-bottom: 0;
			}

			.label {
				color: var(--text-muted);
			}

			.val {
				font-weight: 500;
			}

			.mono {
				font-family: 'JetBrains Mono', monospace;
			}

			.highlight {
				color: var(--accent-cyan);
				font-weight: 700;
			}

			.text-success {
				color: #34D399;
			}

			/* Demo Section */
			.demo-section {
				background: linear-gradient(180deg, rgba(18, 24, 41, 0.8) 0%, rgba(14, 19, 34, 0.9) 100%);
				border: 1px solid rgba(34, 211, 238, 0.2);
				border-radius: 16px;
				padding: 36px 32px;
				margin-bottom: 56px;
			}

			.section-badge {
				display: inline-block;
				font-family: 'JetBrains Mono', monospace;
				font-size: 12px;
				font-weight: 700;
				color: var(--accent-cyan);
				letter-spacing: 1.5px;
				margin-bottom: 8px;
			}

			.section-title {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 28px;
				font-weight: 700;
				margin-bottom: 10px;
			}

			.section-sub {
				color: var(--text-muted);
				font-size: 15px;
				margin-bottom: 24px;
			}

			.form-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 18px;
				margin-bottom: 24px;
			}

			.form-group label {
				display: block;
				font-size: 13px;
				font-weight: 600;
				margin-bottom: 8px;
				color: #CBD5E1;
			}

			.custom-select {
				width: 100%;
				background: #0B0F1A;
				border: 1px solid #334155;
				color: var(--text-main);
				padding: 12px 14px;
				border-radius: 8px;
				font-size: 14px;
				outline: none;
				transition: border-color 0.2s;
			}

			.custom-select:focus {
				border-color: var(--accent-cyan);
				box-shadow: 0 0 0 2px rgba(34, 211, 238, 0.2);
			}

			.result-box {
				background: #0B0F1A;
				border: 1px solid #1E293B;
				border-radius: 10px;
				padding: 20px;
			}

			.result-header {
				margin-bottom: 12px;
			}

			.result-indicator {
				display: inline-block;
				font-family: 'JetBrains Mono', monospace;
				font-size: 12px;
				font-weight: 700;
				padding: 4px 12px;
				border-radius: 6px;
				letter-spacing: 0.5px;
			}

			.badge-success {
				background: rgba(16, 185, 129, 0.15);
				border: 1px solid rgba(16, 185, 129, 0.4);
				color: #34D399;
			}

			.badge-warning {
				background: rgba(245, 158, 11, 0.15);
				border: 1px solid rgba(245, 158, 11, 0.4);
				color: #FBBF24;
			}

			.badge-danger {
				background: rgba(239, 68, 68, 0.15);
				border: 1px solid rgba(239, 68, 68, 0.4);
				color: #F87171;
			}

			.result-content {
				font-size: 14px;
				line-height: 1.6;
				color: #E2E8F0;
			}

			.result-content p {
				margin-bottom: 8px;
			}

			.result-content p:last-child {
				margin-bottom: 0;
			}

			/* Tools Overview */
			.tools-overview {
				margin-bottom: 64px;
			}

			.tools-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 20px;
				margin-top: 24px;
			}

			.tool-card {
				background: var(--surface-dark);
				border: 1px solid var(--surface-border);
				border-radius: 12px;
				padding: 24px;
				transition: transform 0.2s, border-color 0.2s;
			}

			.tool-card:hover {
				transform: translateY(-2px);
				border-color: rgba(34, 211, 238, 0.4);
			}

			.tool-icon {
				font-size: 28px;
				margin-bottom: 12px;
			}

			.tool-title {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 17px;
				font-weight: 700;
				margin-bottom: 8px;
				color: #F1F5F9;
			}

			.tool-desc {
				font-size: 14px;
				line-height: 1.5;
				color: var(--text-muted);
			}

			/* Footer */
			.footer {
				margin-top: auto;
				border-top: 1px solid var(--surface-border);
				background: #080B13;
				padding: 40px 0;
			}

			.footer-content {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				flex-wrap: wrap;
				gap: 24px;
			}

			.footer-left {
				max-width: 500px;
			}

			.footer-logo {
				font-family: 'Space Grotesk', sans-serif;
				font-weight: 700;
				font-size: 18px;
				letter-spacing: 1px;
				color: var(--text-main);
				margin-bottom: 8px;
			}

			.footer-logo span {
				color: var(--accent-cyan);
			}

			.footer-tagline {
				font-size: 14px;
