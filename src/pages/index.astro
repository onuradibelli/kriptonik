---
import Layout from '../layouts/Layout.astro';
import tr from '../i18n/tr.json';
---

<Layout title={`${tr.brand.name} | ${tr.brand.slogan}`} description={tr.brand.subtext}>
	<!-- 1. Hero Section (Section 4.3) -->
	<section class="hero-section">
		<div class="container hero-container">
			<div class="badge-pill badge-live">
				<span>⚡</span>
				<span>{tr.brand.subtext}</span>
			</div>

			<h1 class="hero-main-title">
				Kripto'da takıldığın an,<br />
				<span class="gradient-text">çözüm burada.</span>
			</h1>

			<p class="hero-subtext">
				Para yanlış ağa mı gönderildi, işleminiz saatlerdir onaylanmıyor mu, transferin en ucuz yolu hangisi? Kriptonik, üyelik istemeden saniyeler içinde probleminizi çözer.
			</p>

			<!-- Hero Problem Resolver Search Box -->
			<div class="hero-search-box">
				<div class="search-input-wrapper">
					<svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input 
						type="text" 
						id="hero-problem-input" 
						class="problem-search-input" 
						placeholder="Sorunun ne? Örn: USDT yanlış ağa gitti, pending kaldı..." 
						autocomplete="off"
					/>
				</div>

				<!-- Quick Problem Suggestions Dropdown -->
				<div class="search-suggestions" id="search-suggestions">
					<a href="/araclar/yanlis-aga-gonderdim" class="sugg-item">
						<span class="s-icon">🧭</span>
						<div>
							<strong>USDT Yanlış Ağa Gönderdim</strong>
							<span>BEP-20, ERC-20 veya TRC-20 kurtarma kılavuzu ve teşhisi</span>
						</div>
					</a>
					<a href="/araclar/takilan-islem" class="sugg-item">
						<span class="s-icon">⏱️</span>
						<div>
							<strong>İşlemim Onaylanmıyor (Pending)</strong>
							<span>Mempool kuyruğu, RBF ve Nonce hızlandırma</span>
						</div>
					</a>
					<a href="/araclar/adres-ag-eslestirici" class="sugg-item">
						<span class="s-icon">🔍</span>
						<div>
							<strong>Adres Ağ Eşleştirici</strong>
							<span>Cüzdan adresinin hangi ağları desteklediğini doğrulama</span>
						</div>
					</a>
					<a href="/araclar/maliyet-karsilastirici" class="sugg-item">
						<span class="s-icon">⚖️</span>
						<div>
							<strong>Gerçek Maliyet Karşılaştırıcı</strong>
							<span>TL'den kriptoya en ucuz transfer rotaları</span>
						</div>
					</a>
					<a href="/araclar/dca-simulator" class="sugg-item">
						<span class="s-icon">📈</span>
						<div>
							<strong>DCA Geri Test Simülatörü</strong>
							<span>Düzenli alım kâr/zarar ve getiri simülasyonu</span>
						</div>
					</a>
				</div>

				<!-- 4 Quick Action Pills -->
				<div class="quick-pills">
					<span class="quick-title">Hızlı Çözümler:</span>
					<a href="/araclar/yanlis-aga-gonderdim" class="pill-btn">🧭 Yanlış Ağa Gönderdim</a>
					<a href="/araclar/takilan-islem" class="pill-btn">⏱️ Takılan İşlem (Pending)</a>
					<a href="/araclar/adres-ag-eslestirici" class="pill-btn">🔍 Adres Ağ Kontrolü</a>
					<a href="/araclar/maliyet-karsilastirici" class="pill-btn">⚖️ En Ucuz Transfer Yolu</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Canlı Piyasa Özeti Mini Şerit -->
	<section class="ticker-strip">
		<div class="container strip-container">
			<div class="ticker-item">
				<span class="t-name">BTC:</span>
				<span class="t-val mono-text" id="live-btc">$91,850</span>
			</div>
			<div class="ticker-item">
				<span class="t-name">ETH:</span>
				<span class="t-val mono-text" id="live-eth">$3,420</span>
			</div>
			<div class="ticker-item">
				<span class="t-name">USDT/TRY:</span>
				<span class="t-val mono-text text-success" id="live-usdt">₺38.52</span>
			</div>
			<div class="ticker-item">
				<span class="t-name">ETH Gas:</span>
				<span class="t-val mono-text">16 Gwei</span>
			</div>
			<div class="ticker-item">
				<span class="t-name">Korku Endeksi:</span>
				<span class="t-val mono-text text-warning">74 (Açgözlülük)</span>
			</div>
			<div class="ticker-item">
				<a href="/piyasa" class="ticker-link">Canlı Piyasa Paneli →</a>
			</div>
		</div>
	</section>

	<!-- 3. "Şimdi ne yapmak istiyorsun?" 3 Grup Kartı (Section 4.3) -->
	<section class="action-groups-section">
		<div class="container">
			<div class="section-header">
				<span class="badge badge-info">ÇÖZÜM REHBERİ</span>
				<h2 class="section-title">Şimdi Ne Yapmak İstiyorsun?</h2>
			</div>

			<div class="groups-grid">
				<!-- Grup 1: Sorun Çöz -->
				<div class="group-card card">
					<div class="group-header">
						<span class="group-icon">🧭</span>
						<div>
							<h3 class="group-title">Sorun Çöz</h3>
							<p class="group-sub">Para takıldı, yanlış ağa gitti veya onaylanmıyor</p>
						</div>
					</div>
					<div class="group-items">
						<a href="/araclar/yanlis-aga-gonderdim" class="group-link">
							<strong>Yanlış Ağa Gönderdim</strong>
							<span>Kurtarılabilirlik tespiti ve borsa mesaj şablonu</span>
						</a>
						<a href="/araclar/takilan-islem" class="group-link">
							<strong>Takılan İşlem Teşhisi</strong>
							<span>Mempool analizi, RBF ve Nonce ile iptal</span>
						</a>
						<a href="/araclar/adres-ag-eslestirici" class="group-link">
							<strong>Adres Doğrulayıcı & Ağ Eşleştirici</strong>
							<span>Format tespiti ve çapraz ağ risk uyarısı</span>
						</a>
					</div>
				</div>

				<!-- Grup 2: Hesapla -->
				<div class="group-card card">
					<div class="group-header">
						<span class="group-icon">⚖️</span>
						<div>
							<h3 class="group-title">Hesapla</h3>
							<p class="group-sub">Maliyet, kâr/zarar, DCA ve dönüştürme</p>
						</div>
					</div>
					<div class="group-items">
						<a href="/araclar/maliyet-karsilastirici" class="group-link">
							<strong>Gerçek Maliyet Karşılaştırıcı</strong>
							<span>Komisyon, spread ve ağ çekim ücreti dahil net yol</span>
						</a>
						<a href="/araclar/dca-simulator" class="group-link">
							<strong>DCA Geri Test Simülatörü</strong>
							<span>Düzenli alım kâr/zarar ve XIRR getirisi</span>
						</a>
						<a href="/araclar/kar-zarar-hesaplama" class="group-link">
							<strong>Kâr/Zarar & Ortalama Maliyet</strong>
							<span>Çoklu alım, gerçekleşen/gerçekleşmeyen getiri</span>
						</a>
						<a href="/araclar/kaldirac-likidasyon" class="group-link">
							<strong>Kaldıraç & Likidasyon Hesabı</strong>
							<span>İzole vadeli işlemler için tahmini likidasyon</span>
						</a>
					</div>
				</div>

				<!-- Grup 3: Takip Et -->
				<div class="group-card card">
					<div class="group-header">
						<span class="group-icon">⚡</span>
						<div>
							<h3 class="group-title">Takip Et</h3>
							<p class="group-sub">Gas, stablecoin peg sağlığı ve piyasa duygusu</p>
						</div>
					</div>
					<div class="group-items">
						<a href="/araclar/gas-ucret-takip" class="group-link">
							<strong>Gas ve Ağ Ücreti Takipçisi</strong>
							<span>EVM, Bitcoin ve TRON en ucuz saatler</span>
						</a>
						<a href="/araclar/depeg-monitoru" class="group-link">
							<strong>Stablecoin Depeg Monitörü</strong>
							<span>USDT, USDC ve DAI 1$ çıpa sapmaları</span>
						</a>
						<a href="/araclar/korku-acgozluluk-endeksi" class="group-link">
							<strong>Korku ve Açgözlülük Endeksi</strong>
							<span>Piyasa duyarlılık endeksi ve geçmiş trend</span>
						</a>
						<a href="/araclar/bitcoin-halving" class="group-link">
							<strong>Bitcoin Halving Sayacı</strong>
							<span>Sonraki blok yarılanması canlı geri sayımı</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. Neden Kriptonik? (Section 0.7 Dürüstlük Kuralı) -->
	<section class="why-section">
		<div class="container">
			<div class="why-card card">
				<div class="why-left">
					<span class="badge badge-info">GÜVENİLİR & ŞEFFAF</span>
					<h3 class="why-title">Neden Kriptonik?</h3>
					<p class="why-sub">Kripto ekosisteminde kullanıcı haklarını ve tarafsızlığı koruyan 3 temel kuralımız:</p>

					<div class="why-features">
						<div class="wf-item">
							<span class="wf-icon">🚫</span>
							<div>
								<strong>Hesap Yok</strong>
								<p>Araçları kullanmak için üye olmak, e-posta vermek veya giriş yapmak gerekmez. Hemen çalışır.</p>
							</div>
						</div>

						<div class="wf-item">
							<span class="wf-icon">🔒</span>
							<div>
								<strong>Girdiğiniz Bilgiler Kaydedilmez</strong>
								<p>{tr.brand.privacy_promise}</p>
							</div>
						</div>

						<div class="wf-item">
							<span class="wf-icon">📖</span>
							<div>
								<strong>Sade Dil & Açık Kaynak</strong>
								<p>Anlaşılmaz jargonlar yerine günlük Türkçe ile rehberlik sunulur; hesaplama formülleri şeffafça açıklanır.</p>
							</div>
						</div>
					</div>
				</div>

				<div class="why-right">
					<div class="edge-tech-box">
						<div class="et-head">
							<span class="et-dot"></span>
							<span>CLOUDFLARE EDGE STACK</span>
						</div>
						<ul class="et-list mono-text">
							<li>✓ Pages (Ultra Hızlı Statik Render)</li>
							<li>✓ Workers (Hono Edge API)</li>
							<li>✓ KV (Toplu Veri & TTL Önbelleği)</li>
							<li>✓ D1 (SQLite Şeffaf Veri Tabanı)</li>
							<li>✓ Rate Limiting (Kötüye Kullanım Koruması)</li>
							<li>✓ Web Analytics (Çerezsiz Gizlilik)</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 5. Son Rehberler ve Sözlük Önizlemesi -->
	<section class="preview-content-section">
		<div class="container">
			<div class="preview-grid">
				<div class="preview-col">
					<div class="p-head">
						<h3>📖 Son Eklenen Rehberler</h3>
						<a href="/rehber" class="p-see-all">Tümünü Gör →</a>
					</div>
					<div class="p-list">
						<a href="/araclar/yanlis-aga-gonderdim" class="p-item card">
							<strong>Yanlış Ağa Gönderilen Kripto Para Nasıl Kurtarılır?</strong>
							<span class="text-muted">MetaMask ve Borsa kurtarma adımları • 4 dk</span>
						</a>
						<a href="/araclar/takilan-islem" class="p-item card">
							<strong>MetaMask'ta Takılan İşlem Nasıl İptal Edilir?</strong>
							<span class="text-muted">Aynı Nonce ile hızlandırma ve sıfır değerli işlem • 3 dk</span>
						</a>
						<a href="/araclar/maliyet-karsilastirici" class="p-item card">
							<strong>Borsalar Arasında En Ucuz Kripto Transfer Rotaları</strong>
							<span class="text-muted">TRC20, Arbitrum ve BEP20 komisyon kıyaslaması • 4 dk</span>
						</a>
					</div>
				</div>

				<div class="preview-col">
					<div class="p-head">
						<h3>📚 Sözlükten Terimler</h3>
						<a href="/sozluk" class="p-see-all">Sözlüğü Aç →</a>
					</div>
					<div class="p-list">
						<a href="/sozluk" class="p-item card">
							<strong>Nonce Nedir? Neden İşlemleri Kilitler?</strong>
							<span class="text-muted">EVM işlem sayacı ve sırayla çalışma mantığı</span>
						</a>
						<a href="/sozluk" class="p-item card">
							<strong>Seed Phrase (Kurtarma Kelimeleri) Güvenliği</strong>
							<span class="text-muted">12 kelimelik anahtarın hayati önemi</span>
						</a>
						<a href="/sozluk" class="p-item card">
							<strong>RBF (Replace-by-Fee) ve CPFP Nedir?</strong>
							<span class="text-muted">Bitcoin mempool hızlandırma protokolleri</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. SSS (FAQ Schema Uyumlu) -->
	<section class="faq-section">
		<div class="container container-narrow">
			<div class="section-header">
				<span class="badge badge-info">MERAK EDİLENLER</span>
				<h2 class="section-title">Sıkça Sorulan Sorular</h2>
			</div>

			<div class="faq-accordion">
				<details class="faq-item card" open>
					<summary class="faq-question">
						<span>Kriptonik'i kullanmak ücretli mi?</span>
						<span class="faq-arrow">▾</span>
					</summary>
					<div class="faq-answer">
						<p>Hayır, Kriptonik'teki tüm temel problem çözme araçları, hesaplayıcılar ve teşhis motorları tamamen ücretsizdir ve herhangi bir üyelik gerektirmez.</p>
					</div>
				</details>

				<details class="faq-item card">
					<summary class="faq-question">
						<span>Girdiğim adresler veya işlem kodları saklanıyor mu?</span>
						<span class="faq-arrow">▾</span>
					</summary>
					<div class="faq-answer">
						<p>{tr.brand.privacy_promise}</p>
					</div>
				</details>

				<details class="faq-item card">
					<summary class="faq-question">
						<span>Kriptonik cüzdanımın özel anahtarını (private key) ister mi?</span>
						<span class="faq-arrow">▾</span>
					</summary>
					<div class="faq-answer">
						<p>Kesinlikle hayır. Kriptonik sizden özel anahtar (private key) veya 12-24 kelimelik kurtarma ifadesini (seed phrase) asla istemez. Bunu isteyen herhangi bir site veya kişi dolandırıcıdır.</p>
					</div>
				</details>

				<details class="faq-item card">
					<summary class="faq-question">
						<span>Kriptonik yatırım tavsiyesi veriyor mu?</span>
						<span class="faq-arrow">▾</span>
					</summary>
					<div class="faq-answer">
						<p>Hayır. Sitemizdeki tüm içerikler, simülasyonlar ve veriler yalnızca teknik bilgilendirme ve eğitim amaçlıdır; hiçbir şekilde yatırım tavsiyesi (YTD) niteliği taşımaz.</p>
					</div>
				</details>
			</div>
		</div>
	</section>
</Layout>

<script>
	// Hero search filter
	const searchInput = document.getElementById('hero-problem-input') as HTMLInputElement;
	const suggestions = document.getElementById('search-suggestions');

	searchInput?.addEventListener('focus', () => {
		if (suggestions) suggestions.style.display = 'block';
	});

	searchInput?.addEventListener('input', () => {
		const val = searchInput.value.toLowerCase().trim();
		if (!suggestions) return;

		suggestions.style.display = 'block';
		const items = suggestions.querySelectorAll('.sugg-item');

		items.forEach(item => {
			const text = (item as HTMLElement).innerText.toLowerCase();
			if (val === '' || text.includes(val)) {
				(item as HTMLElement).style.display = 'flex';
			} else {
				(item as HTMLElement).style.display = 'none';
			}
		});
	});

	document.addEventListener('click', (e) => {
		if (!searchInput?.contains(e.target as Node) && !suggestions?.contains(e.target as Node)) {
			if (suggestions) suggestions.style.display = 'none';
		}
	});

	// Live ticker
	async function updateLiveTicker() {
		try {
			const res = await fetch('/api/v1/market/ticker');
			if (!res.ok) return;
			const json = await res.json() as { data: { btc: { usd: number }; eth: { usd: number }; usdt: { try: number } } };

			const btcEl = document.getElementById('live-btc');
			const ethEl = document.getElementById('live-eth');
			const usdtEl = document.getElementById('live-usdt');

			if (btcEl && json.data.btc) btcEl.innerText = `$${json.data.btc.usd.toLocaleString()}`;
			if (ethEl && json.data.eth) ethEl.innerText = `$${json.data.eth.usd.toLocaleString()}`;
			if (usdtEl && json.data.usdt) usdtEl.innerText = `₺${json.data.usdt.try.toFixed(2)}`;
		} catch {
			// graceful fallback
		}
	}

	updateLiveTicker();
</script>

<style>
	.hero-section {
		padding: 72px 0 48px;
		text-align: center;
	}

	.hero-container {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-main-title {
		font-size: 52px;
		font-weight: 800;
		line-height: 1.15;
		margin: 20px 0 16px;
		letter-spacing: -1px;
	}

	.hero-subtext {
		font-size: 18px;
		color: var(--text-muted);
		max-width: 680px;
		margin: 0 auto 36px;
		line-height: 1.6;
	}

	.hero-search-box {
		width: 100%;
		max-width: 680px;
		position: relative;
	}

	.search-input-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: 18px;
		color: var(--text-faint);
	}

	.problem-search-input {
		width: 100%;
		background: var(--bg-elev);
		border: 1px solid var(--border-strong);
		color: var(--text);
		padding: 16px 20px 16px 52px;
		border-radius: 12px;
		font-size: 16px;
		outline: none;
		box-shadow: var(--shadow-sm);
		transition: border-color 150ms ease, box-shadow 150ms ease;
	}

	.problem-search-input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px var(--primary-soft);
	}

	.search-suggestions {
		display: none;
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		right: 0;
		background: var(--bg-elev);
		border: 1px solid var(--border-strong);
		border-radius: 12px;
		box-shadow: var(--shadow-md);
		z-index: 50;
		overflow: hidden;
		text-align: left;
	}

	.sugg-item {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--border);
		text-decoration: none;
		transition: background 150ms ease;
	}

	.sugg-item:hover {
		background: var(--bg-sunken);
	}

	.sugg-item:last-child {
		border-bottom: none;
	}

	.s-icon {
		font-size: 20px;
	}

	.sugg-item strong {
		display: block;
		font-size: 14px;
		color: var(--text);
	}

	.sugg-item span {
		font-size: 12px;
		color: var(--text-muted);
	}

	.quick-pills {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 18px;
	}

	.quick-title {
		font-size: 12px;
		color: var(--text-faint);
	}

	.pill-btn {
		font-size: 12px;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		color: var(--text-muted);
		padding: 6px 12px;
		border-radius: 999px;
		text-decoration: none;
		transition: all 150ms ease;
	}

	.pill-btn:hover {
		background: var(--bg-elev);
		border-color: var(--primary);
		color: var(--primary);
	}

	/* Ticker Strip */
	.ticker-strip {
		background: var(--bg-sunken);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding: 12px 0;
		margin-bottom: 64px;
	}

	.strip-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 14px;
		font-size: 13px;
	}

	.ticker-item {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.t-name {
		color: var(--text-muted);
		font-weight: 600;
	}

	.t-val {
		color: var(--text);
