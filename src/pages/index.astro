<script>
	// Hero search filter
	const searchInput = document.getElementById('hero-problem-input') as HTMLInputElement;
	const suggestions = document.getElementById('search-suggestions');

	searchInput?.addEventListener('focus', () => {
		if (suggestions) suggestions.style.display = 'block';
	});

	searchInput?.addEventListener('input', () => {
		const val = searchInput.value.toLowerCase().trim();
		if (!suggestions) return;

		suggestions.style.display = 'block';
		const items = suggestions.querySelectorAll('.sugg-item');

		items.forEach(item => {
			const text = (item as HTMLElement).innerText.toLowerCase();
			if (val === '' || text.includes(val)) {
				(item as HTMLElement).style.display = 'flex';
			} else {
				(item as HTMLElement).style.display = 'none';
			}
		});
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && suggestions) {
			suggestions.style.display = 'none';
			searchInput?.blur();
		}
	});

	document.addEventListener('click', (e) => {
		if (!searchInput?.contains(e.target as Node) && !suggestions?.contains(e.target as Node)) {
			if (suggestions) suggestions.style.display = 'none';
		}
	});

	// Live ticker updater
	async function updateLiveTicker() {
		try {
			const res = await fetch('/api/v1/market/ticker');
			if (!res.ok) return;
			const json = await res.json() as { data: { btc: { usd: number }; eth: { usd: number }; usdt: { try: number } } };

			const btcEl = document.getElementById('live-btc');
			const ethEl = document.getElementById('live-eth');
			const usdtEl = document.getElementById('live-usdt');

			if (btcEl && json.data.btc) btcEl.innerText = `$${json.data.btc.usd.toLocaleString()}`;
			if (ethEl && json.data.eth) ethEl.innerText = `$${json.data.eth.usd.toLocaleString()}`;
			if (usdtEl && json.data.usdt) usdtEl.innerText = `₺${json.data.usdt.try.toFixed(2)}`;
		} catch {
			// graceful fallback
		}
	}

	updateLiveTicker();
</script>

