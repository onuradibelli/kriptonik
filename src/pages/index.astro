---
import Layout from '../layouts/Layout.astro';
import tr from '../i18n/tr.json';
---

<Layout title={`${tr.brand.name} | ${tr.brand.slogan}`} description={tr.brand.subtext}>
	<!-- 1. Hero Section -->
	<section class="hero-section">
		<div class="container hero-container">
			<div class="hero-badge">
				<span class="live-pulse-dot"></span>
				<span class="badge-text">SIFIR KAYIT • ANINDA TEŞHİS & ÇÖZÜM</span>
			</div>

			<h1 class="hero-title">
				Kripto'da takıldığın an,<br />
				<span class="gradient-text">çözüm burada.</span>
			</h1>

			<p class="hero-desc">
				Yanlış ağa gönderilen transferler, saatlerdir bekleyen onaylar, en ucuz takas rotaları ve anlık risk teşhisi. Üyelik gerektirmez, verilerinizi asla kaydetmez.
			</p>

			<!-- Hero Problem Resolver Search Box -->
			<div class="hero-command-bar">
				<div class="search-input-shell">
					<svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input 
						type="text" 
						id="hero-problem-input" 
						class="command-input" 
						placeholder="Sorununuzu yazın... Örn: USDT yanlış ağa gitti, pending kaldı, en ucuz transfer..." 
						autocomplete="off"
					/>
					<div class="search-hint">
						<kbd class="kbd-badge">ESC</kbd>
					</div>
				</div>

				<!-- Quick Problem Suggestions Dropdown -->
				<div class="search-suggestions" id="search-suggestions">
					<div class="sugg-header">ÖNERİLEN ÇÖZÜM ARAÇLARI</div>
					<a href="/araclar/yanlis-aga-gonderdim" class="sugg-item">
						<div class="sugg-icon-box">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
						</div>
						<div class="sugg-info">
							<strong>Yanlış Ağa Gönderdim</strong>
							<span>BEP-20, ERC-20 veya TRC-20 kurtarma kılavuzu ve kurtarılabilirlik teşhisi</span>
						</div>
						<span class="sugg-arrow">→</span>
					</a>
					<a href="/araclar/takilan-islem" class="sugg-item">
						<div class="sugg-icon-box">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
						</div>
						<div class="sugg-info">
							<strong>İşlemim Onaylanmıyor (Pending)</strong>
							<span>Mempool kuyruğu analizi, RBF ve Nonce hızlandırma</span>
						</div>
						<span class="sugg-arrow">→</span>
					</a>
					<a href="/araclar/adres-ag-eslestirici" class="sugg-item">
						<div class="sugg-icon-box">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
						</div>
						<div class="sugg-info">
							<strong>Adres Ağ Eşleştirici & Format Kontrolü</strong>
							<span>Cüzdan adresinin hangi ağları desteklediğini doğrulama</span>
						</div>
						<span class="sugg-arrow">→</span>
					</a>
					<a href="/araclar/maliyet-karsilastirici" class="sugg-item">
						<div class="sugg-icon-box">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
						</div>
						<div class="sugg-info">
							<strong>Gerçek Maliyet Karşılaştırıcı</strong>
							<span>Komisyon, spread ve ağ çekim ücreti dahil net transfer rotaları</span>
						</div>
						<span class="sugg-arrow">→</span>
					</a>
					<a href="/araclar/guvenlik-kontrolu" class="sugg-item">
						<div class="sugg-icon-box">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
						</div>
						<div class="sugg-info">
							<strong>Cüzdan & URL Güvenlik Kontrolü</strong>
							<span>Phishing, rug-pull ve sahte token risk taraması</span>
						</div>
						<span class="sugg-arrow">→</span>
					</a>
				</div>

				<!-- Quick Action Pills -->
				<div class="quick-pill-strip">
					<span class="pill-label">Hızlı Araçlar:</span>
					<a href="/kac-tl" class="quick-pill">
						<span class="pill-dot"></span> Kaç TL? (Dolar & Kripto)
					</a>
					<a href="/araclar/yanlis-aga-gonderdim" class="quick-pill">
						<span class="pill-dot"></span> Yanlış Ağ
					</a>
					<a href="/araclar/takilan-islem" class="quick-pill">
						<span class="pill-dot"></span> Takılan İşlem
					</a>
					<a href="/araclar/adres-ag-eslestirici" class="quick-pill">
						<span class="pill-dot"></span> Adres Kontrolü
					</a>
					<a href="/araclar/maliyet-karsilastirici" class="quick-pill">
						<span class="pill-dot"></span> En Ucuz Rota
					</a>
					<a href="/araclar/islem-cevirmeni" class="quick-pill">
						<span class="pill-dot"></span> İşlem Çevirmeni
					</a>
					<a href="/araclar/guvenlik-kontrolu" class="quick-pill">
						<span class="pill-dot"></span> Güvenlik Testi
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Precision Live Ticker Strip -->
	<section class="ticker-strip">
		<div class="container strip-flex">
			<div class="ticker-live-status">
				<span class="ticker-beacon"></span>
				<span class="ticker-tag">CANLI PİYASA</span>
			</div>

			<div class="ticker-track">
				<div class="ticker-metric">
					<span class="metric-sym">BTC</span>
					<span class="metric-val mono-text" id="live-btc">$91,850</span>
				</div>
				<div class="ticker-sep"></div>
				<div class="ticker-metric">
					<span class="metric-sym">ETH</span>
					<span class="metric-val mono-text" id="live-eth">$3,420</span>
				</div>
				<div class="ticker-sep"></div>
				<div class="ticker-metric">
					<span class="metric-sym">USDT/TRY</span>
					<span class="metric-val mono-text val-up" id="live-usdt">₺38.52</span>
				</div>
				<div class="ticker-sep"></div>
				<div class="ticker-metric">
					<span class="metric-sym">ETH Gas</span>
					<span class="metric-val mono-text">16 Gwei</span>
				</div>
				<div class="ticker-sep"></div>
				<div class="ticker-metric">
					<span class="metric-sym">Korku Endeksi</span>
					<span class="metric-val metric-badge mono-text">74 (Açgözlülük)</span>
				</div>
			</div>

			<a href="/piyasa" class="ticker-all-link">
				<span>Piyasa Paneli</span>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
			</a>
		</div>
	</section>

	<!-- 2.5 Kriptonik Veri Merkezi & Öne Çıkan Göstergeler (Spec v3) -->
	<section class="data-hub-preview-section">
		<div class="container">
			<div class="section-heading-center">
				<div class="section-eyebrow">CANLI VERİ & ANALİZ MERKEZİ</div>
				<h2 class="section-headline">Türkiye ve Küresel Veri Platformu</h2>
				<p class="section-subtext">Yerel borsa derinlikleri, USDT/TL primi, kurumsal spot ETF akışları ve şeffaf Kriptonik endeksleri.</p>
			</div>

			<div class="data-preview-grid">
				<a href="/turkiye/usdt-tl-primi" class="data-preview-card">
					<div class="dp-header">
						<span class="dp-badge tr-badge">TÜRKİYE VERİSİ</span>
						<span class="dp-stat pos font-mono">+%1.14 Prim</span>
					</div>
					<h3 class="dp-title">USDT/TL Tether Primi</h3>
					<p class="dp-desc">BtcTurk, Paribu ve Binance TR serbest kurunun TCMB resmi gösterge kuruna göre anlık makas sapması.</p>
					<span class="dp-link-text">Tarihsel Grafik & Borsa Dağılımı →</span>
				</a>

				<a href="/etf" class="data-preview-card">
					<div class="dp-header">
						<span class="dp-badge etf-badge">SPOT ETF</span>
						<span class="dp-stat pos font-mono">+$428.5M Net</span>
					</div>
					<h3 class="dp-title">ABD Spot Bitcoin ETF</h3>
					<p class="dp-desc">BlackRock (IBIT), Fidelity (FBTC) dahil 11 fonun resmi ihraççı günlük net nakit giriş ve çıkışları.</p>
					<span class="dp-link-text">Fon Kırılımı & Kümülatif AUM →</span>
				</a>

				<a href="/turev" class="data-preview-card">
					<div class="dp-header">
						<span class="dp-badge deriv-badge">TÜREV</span>
						<span class="dp-stat font-mono">$38.4B OI</span>
					</div>
					<h3 class="dp-title">Fonlama Oranları & OI</h3>
					<p class="dp-desc">Bybit, OKX ve Binance sürekli swap (perpetual) fonlama oranları, açık pozisyon ve Kriptonik Fonlama Isısı.</p>
					<span class="dp-link-text">Canlı Isı Haritası →</span>
				</a>

				<a href="/kac-tl" class="data-preview-card highlight-kac-tl">
					<div class="dp-header">
						<span class="dp-badge calc-badge">CANLI ÇEVİRİCİ</span>
						<span class="dp-stat font-mono">55+ Arama Rotası</span>
					</div>
					<h3 class="dp-title">Kaç TL? Fiyat Arama Motoru</h3>
					<p class="dp-desc">1 Dolar, 100 Dolar, 1 BTC, 1000 USDT kaç TL? Canlı serbest piyasa ve borsa kurlarıyla anında hesaplama.</p>
					<span class="dp-link-text">Çevirici & Arama Rotaları →</span>
				</a>

				<a href="/endeksler" class="data-preview-card">
					<div class="dp-header">
						<span class="dp-badge idx-badge">ÖZGÜN ENDEKSLER</span>
						<span class="dp-stat font-mono">6 Referans Seri</span>
					</div>
					<h3 class="dp-title">Kriptonik Endeksleri</h3>
					<p class="dp-desc">Metodolojisi ve formülü kamuya açık TTP, TLS, EAM, FI, KAS ve SNB referans piyasa göstergeleri.</p>
					<span class="dp-link-text">Metodolojiyi İncele & CSV İndir →</span>
				</a>

				<a href="/veri" class="data-preview-card">
					<div class="dp-header">
						<span class="dp-badge open-badge">AÇIK VERİ PORTALI</span>
						<span class="dp-stat font-mono">CC BY 4.0</span>
					</div>
					<h3 class="dp-title">Açık Veri & İndirme</h3>
					<p class="dp-desc">Araştırmacılar, analistler ve gazeteciler için tüm özgün serileri CSV ve JSON olarak ücretsiz indirin.</p>
					<span class="dp-link-text">Veri Setlerini İndir →</span>
				</a>
			</div>
		</div>
	</section>

	<!-- 3. "Şimdi ne yapmak istiyorsun?" Bento Grid Section -->
	<section class="action-bento-section">
		<div class="container">
			<div class="section-heading-center">
				<div class="section-eyebrow">ÇÖZÜM REHBERİ</div>
				<h2 class="section-headline">Şimdi Ne Yapmak İstiyorsun?</h2>
				<p class="section-subtext">İhtiyacınıza göre tasarlanmış üç temel araç kategorisi ile anında sonuca ulaşın.</p>
			</div>

			<div class="bento-grid">
				<!-- Bento 1: Sorun Çöz -->
				<div class="bento-card">
					<div class="bento-header">
						<div class="bento-icon-wrapper bento-icon-alert">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
						</div>
						<div>
							<div class="bento-tag">ACİL MÜDAHALE</div>
							<h3 class="bento-title">Sorun Çöz</h3>
							<p class="bento-desc">Para takıldı, yanlış ağa gitti veya saatlerdir onaylanmıyor</p>
						</div>
					</div>

					<div class="bento-links">
						<a href="/araclar/yanlis-aga-gonderdim" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Yanlış Ağa Gönderdim</span>
								<span class="link-desc">Kurtarılabilirlik tespiti ve borsa mesaj şablonu</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/takilan-islem" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Takılan İşlem Teşhisi</span>
								<span class="link-desc">Mempool analizi, RBF ve Nonce ile hızlandırma</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/adres-ag-eslestirici" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Adres Doğrulayıcı & Ağ Eşleştirici</span>
								<span class="link-desc">Format tespiti ve çapraz ağ risk uyarısı</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/islem-cevirmeni" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">İşlem Çevirmeni</span>
								<span class="link-desc">Hash kodlarını sade Türkçe işlem özetine dönüştürür</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
					</div>
				</div>

				<!-- Bento 2: Hesapla -->
				<div class="bento-card">
					<div class="bento-header">
						<div class="bento-icon-wrapper bento-icon-calc">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
						</div>
						<div>
							<div class="bento-tag">FİNANSAL TEŞHİS</div>
							<h3 class="bento-title">Hesapla</h3>
							<p class="bento-desc">Gerçek transfer maliyeti, DCA simülasyonu ve kâr/zarar</p>
						</div>
					</div>

					<div class="bento-links">
						<a href="/kac-tl" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Canlı Kaç TL? Çevirici</span>
								<span class="link-desc">1 Dolar, 100 Dolar, 1 BTC kaç TL? Serbest piyasa ve borsa kurları</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/maliyet-karsilastirici" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Gerçek Maliyet Karşılaştırıcı</span>
								<span class="link-desc">Komisyon, spread ve ağ çekim ücreti dahil net rota</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/dca-simulator" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">DCA Geri Test Simülatörü</span>
								<span class="link-desc">Düzenli alım getirisi, XIRR ve kâr/zarar eğrisi</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/kar-zarar-hesaplama" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Kâr / Zarar & Maliyet</span>
								<span class="link-desc">Kademeli alımlar için ağırlıklı ortalama ve net getiri</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/kaldirac-likidasyon" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Kaldıraç & Likidasyon Hesabı</span>
								<span class="link-desc">İzole pozisyonlar için likidasyon ve teminat analizi</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
					</div>
				</div>

				<!-- Bento 3: Takip Et -->
				<div class="bento-card">
					<div class="bento-header">
						<div class="bento-icon-wrapper bento-icon-track">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
						</div>
						<div>
							<div class="bento-tag">CANLI İZLEME</div>
							<h3 class="bento-title">Takip Et</h3>
							<p class="bento-desc">Gas fiyatları, stablecoin çıpa sağlığı ve piyasa duygusu</p>
						</div>
					</div>

					<div class="bento-links">
						<a href="/araclar/gas-ucret-takip" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Gas & Ağ Ücreti Takipçisi</span>
								<span class="link-desc">EVM, Bitcoin ve TRON için en ucuz transfer saatleri</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/depeg-monitoru" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Stablecoin Depeg Monitörü</span>
								<span class="link-desc">USDT, USDC ve DAI için 1$ çıpa sapma takibi</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/korku-acgozluluk-endeksi" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Korku ve Açgözlülük Endeksi</span>
								<span class="link-desc">Anlık duyarlılık endeksi ve tarihsel grafik</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
						<a href="/araclar/bitcoin-halving" class="bento-link-item">
							<div class="link-meta">
								<span class="link-title">Bitcoin Halving Sayacı</span>
								<span class="link-desc">Sonraki blok yarılanması için hassas geri sayım</span>
							</div>
							<span class="link-arrow">→</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. Neden Kriptonik? (Section 0.7 Dürüstlük Kuralı & Gizlilik Taahhüdü) -->
	<section class="trust-section">
		<div class="container">
			<div class="trust-card">
				<div class="trust-content">
					<div class="section-eyebrow">GÜVENİLİR & ŞEFFAF</div>
					<h3 class="trust-headline">Neden Kriptonik?</h3>
					<p class="trust-desc">
						Kripto dünyasında bağımsızlığımızı, kullanıcı gizliliğini ve matematiksel tarafsızlığı koruyan temel ilkelerimiz:
					</p>

					<div class="trust-principles">
						<div class="principle-item">
							<div class="principle-icon-wrap">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="18" y1="8" x2="23" y2="13"></line><line x1="23" y1="8" x2="18" y2="13"></line></svg>
							</div>
							<div>
								<h4 class="principle-title">Üyelik veya Hesap Yok</h4>
								<p class="principle-text">Hiçbir aracı kullanmak için kayıt olmak, e-posta adresi bırakmak veya parola belirlemek gerekmez. Doğrudan çalışır.</p>
							</div>
						</div>

						<div class="principle-item">
							<div class="principle-icon-wrap">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
							</div>
							<div>
