---
import Layout from '../../layouts/Layout.astro';
import { guidesData, type Guide } from '../../data/guides';

export function getStaticPaths() {
	return guidesData.map((guide: Guide) => ({
		params: { slug: guide.slug },
		props: { guide }
	}));
}

const { guide } = Astro.props as { guide: Guide };
const pageTitle = `${guide.title} | Kriptonik Rehber`;
const pageDesc = guide.summary;
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container guide-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/rehber">Rehberler</a>
			<span>/</span>
			<span class="current">{guide.title}</span>
		</nav>

		<article class="guide-article">
			<header class="guide-header">
				<div class="badge-pill">
					<span>📖</span>
					<span>{guide.category}</span>
				</div>
				<h1 class="guide-title">{guide.title}</h1>
				<div class="guide-meta-row">
					<span>Okuma Süresi: <strong>{guide.readTime}</strong></span>
					<span>•</span>
					<span>Son Gözden Geçirme: <time>{guide.reviewedAt}</time></span>
				</div>
				<p class="guide-summary-lead">{guide.summary}</p>
			</header>

			{guide.relatedToolSlug && (
				<div class="related-tool-callout">
					<div class="callout-text">
						<strong>Bu Konuyla İlgili Kriptonik Aracı Mevcuttur:</strong>
						<span>Hesaplama veya teşhis yapmak için ilgili sayfamızı ziyaret edebilirsiniz.</span>
					</div>
					<a href={`/araclar/${guide.relatedToolSlug}`} class="btn btn-primary btn-sm">Aracı Aç ➔</a>
				</div>
			)}

			<div class="guide-content-body">
				<div class="markdown-body" set:html={guide.content.replace(/\n/g, '<br/>')} />
			</div>

			<div class="guide-footer-note">
				<strong>⚖️ Yasal Uyarı:</strong> Bu rehberdeki bilgiler yalnızca teknik eğitim ve bilgilendirme amaçlıdır. Hiçbir şekilde yatırım veya finansal danışmanlık niteliği taşımaz.
			</div>
		</article>

		<div class="back-link-box">
			<a href="/rehber" class="btn btn-secondary">← Tüm Rehberlere Dön</a>
		</div>
	</div>
</Layout>

<style>
.guide-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
	max-width: 800px;
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}

.guide-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.guide-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-3);
	line-height: 1.25;
}
.guide-meta-row {
	display: flex;
	gap: var(--space-3);
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	margin-bottom: var(--space-4);
}
.guide-summary-lead {
	font-size: var(--text-lg);
	color: var(--color-text-secondary);
	line-height: 1.6;
	border-left: 3px solid var(--color-primary-500);
	padding-left: var(--space-4);
}

.related-tool-callout {
	background: rgba(59, 130, 246, 0.08);
	border: 1px solid rgba(59, 130, 246, 0.25);
	border-radius: var(--radius-lg);
	padding: var(--space-4) var(--space-5);
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: var(--space-8);
	flex-wrap: wrap;
	gap: var(--space-3);
}
.callout-text {
	display: flex;
	flex-direction: column;
	gap: 2px;
}
.callout-text strong {
	font-size: var(--text-sm);
	color: var(--color-text-primary);
}
.callout-text span {
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
}

.guide-content-body {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-8);
	margin-bottom: var(--space-8);
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	line-height: 1.8;
}

.guide-footer-note {
	background: var(--color-surface-hover);
	padding: var(--space-4);
	border-radius: var(--radius-md);
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}

.back-link-box {
	margin-top: var(--space-6);
}
</style>
