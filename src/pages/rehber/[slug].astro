---
// src/pages/rehber/[slug].astro - Cockpit Editorial Guide Page
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import StatusPill from '../../components/ui/StatusPill.astro';
import { guidesData, type Guide } from '../../data/guides';

export function getStaticPaths() {
	return guidesData.map((guide: Guide) => ({
		params: { slug: guide.slug },
		props: { guide }
	}));
}

const { guide } = Astro.props as { guide: Guide };
const pageTitle = `${guide.title} | Kriptonik Saha Rehberi`;
const pageDesc = guide.summary;
const pageUrl = `https://kriptonik.com/rehber/${guide.slug}`;

// Schema.org Article & Breadcrumbs
const articleSchema = {
	"@context": "https://schema.org",
	"@type": "TechArticle",
	"headline": guide.title,
	"description": guide.summary,
	"author": {
		"@type": "Organization",
		"name": guide.author || "Kriptonik Teknik Saha Ekibi",
		"url": "https://kriptonik.com"
	},
	"publisher": {
		"@type": "Organization",
		"name": "Kriptonik",
		"url": "https://kriptonik.com"
	},
	"datePublished": guide.publishedAt,
	"dateModified": guide.reviewedAt,
	"mainEntityOfPage": pageUrl
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Ana Sayfa",
			"item": "https://kriptonik.com"
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Rehberler",
			"item": "https://kriptonik.com/rehber"
		},
		{
			"@type": "ListItem",
			"position": 3,
			"name": guide.title,
			"item": pageUrl
		}
	]
};
---

<Layout title={pageTitle} description={pageDesc}>
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<div class="cockpit-guide-page">
		<!-- Breadcrumbs -->
		<nav class="guide-breadcrumb" aria-label="Gezinti">
			<a href="/">Ana Sayfa</a>
			<Icon name="chevron-right" size={12} class="crumb-sep" />
			<a href="/rehber">Rehberler</a>
			<Icon name="chevron-right" size={12} class="crumb-sep" />
			<span class="crumb-current">{guide.title}</span>
		</nav>

		<!-- Main Article -->
		<article class="cockpit-article">
			<header class="article-header">
				<div class="article-meta-tags">
					<span class="guide-category-badge">{guide.category}</span>
					<span class="reading-time">
						<Icon name="clock" size={12} />
						<span>{guide.readTime}</span>
					</span>
				</div>

				<h1 class="article-headline">{guide.title}</h1>
				<p class="article-lead">{guide.summary}</p>

				<div class="article-byline">
					<div class="byline-item">
						<span class="byline-lbl">YAZAR:</span>
						<strong class="byline-val">{guide.author}</strong>
					</div>
					<div class="byline-sep">•</div>
					<div class="byline-item">
						<span class="byline-lbl">YAYIN:</span>
						<time datetime={guide.publishedAt} class="byline-val">{guide.publishedAt}</time>
					</div>
					<div class="byline-sep">•</div>
					<div class="byline-item">
						<span class="byline-lbl">SON GÜNCELLEME:</span>
						<time datetime={guide.reviewedAt} class="byline-val highlight">{guide.reviewedAt}</time>
					</div>
				</div>
			</header>

			<!-- Related Tool Callout CTA -->
			{guide.relatedToolSlug && (
				<div class="related-tool-panel">
					<div class="panel-left">
						<div class="panel-icon">
							<Icon name="alert-triangle" size={20} />
						</div>
						<div class="panel-copy">
							<strong>Bu Durum İçin Canlı Saha Aracı Mevcut:</strong>
							<span>Saniyeler içinde durumunu teşhis etmek ve kurtarılabilirlik raporu almak için aracı çalıştırabilirsin.</span>
						</div>
					</div>
					<a href={`/araclar/${guide.relatedToolSlug}`} class="panel-cta-btn">
						<span>Aracı Aç</span>
						<Icon name="arrow-right" size={14} />
					</a>
				</div>
			)}

			<!-- Article Body -->
			<div class="article-body">
				<div class="guide-markdown-content" set:html={guide.content.replace(/\n/g, '<br/>')} />
			</div>

			<!-- Mandatory Verified Sources Section -->
			{guide.sources && guide.sources.length > 0 && (
				<section class="sources-cockpit-section" aria-label="Doğrulanmış Kaynaklar">
					<div class="sources-head">
						<Icon name="shield-check" size={16} />
						<h3>Teknik Referanslar & Doğrulanmış Kaynaklar</h3>
					</div>
					<ul class="sources-list">
						{guide.sources.map(source => (
							<li class="source-item">
								<Icon name="external-link" size={12} class="source-icon" />
								<span>{source}</span>
							</li>
						))}
					</ul>
				</section>
			)}

			<!-- Legal Disclaimer -->
			<div class="article-disclaimer">
				<p>
					<strong>Sorumluluk Beyanı:</strong> Bu kılavuzdaki teknik bilgiler eğitim ve hata önleme amaçlı hazırlanmıştır. Yatırım, alım-satım veya kurtarma garantisi teşkil etmez. Blokzincir işlemleri geri alınamaz. Kriptonik hiçbir zaman özel anahtar (private key) istemez.
				</p>
			</div>
		</article>

		<div class="guide-footer-nav">
			<a href="/rehber" class="back-to-guides">
				<Icon name="arrow-left" size={14} />
				<span>Tüm Saha Rehberlerine Dön</span>
			</a>
		</div>
	</div>
</Layout>

<style>
	.cockpit-guide-page {
		max-width: 820px;
		margin: 0 auto;
		padding: 32px 24px 64px;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.guide-breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
		flex-wrap: wrap;
	}

	.guide-breadcrumb a {
		color: var(--text-subtle);
		text-decoration: none;
	}

	.guide-breadcrumb a:hover {
		color: var(--text);
	}

	.crumb-sep {
		color: var(--line);
	}

	.crumb-current {
		color: var(--text);
		font-weight: 600;
	}

	/* Article Header */
	.cockpit-article {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.article-header {
		display: flex;
		flex-direction: column;
		gap: 16px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 24px;
	}

	.article-meta-tags {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.guide-category-badge {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 3px 8px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--signal);
	}

	.reading-time {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.article-headline {
		font-family: var(--font-display);
		font-size: clamp(26px, 4vw, 38px);
		font-weight: 700;
		color: var(--text);
		line-height: 1.15;
		margin: 0;
	}

	.article-lead {
		font-size: 16px;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0;
	}

	.article-byline {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
		flex-wrap: wrap;
		padding-top: 8px;
	}

	.byline-lbl {
		color: var(--text-subtle);
	}

	.byline-val {
		color: var(--text);
	}

	.byline-val.highlight {
		color: var(--signal);
	}

	.byline-sep {
		color: var(--line);
	}

	/* Related Tool CTA Panel */
	.related-tool-panel {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: 16px 20px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.panel-left {
		display: flex;
		align-items: center;
		gap: 12px;
		flex: 1;
		min-width: 260px;
	}

	.panel-icon {
		width: 36px;
		height: 36px;
		border-radius: var(--radius-sm);
		background: var(--bg);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--signal);
		flex-shrink: 0;
	}

	.panel-copy {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.panel-copy strong {
		font-size: 13px;
		color: var(--text);
	}

	.panel-copy span {
		font-size: 12px;
		color: var(--text-muted);
	}

	.panel-cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 14px;
		background: var(--signal);
		color: #14110F;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		border-radius: var(--radius-sm);
		text-decoration: none;
		white-space: nowrap;
	}

	/* Article Content */
	.article-body {
		font-size: 15px;
		line-height: 1.7;
		color: var(--text);
	}

	:global(.guide-markdown-content h2) {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 700;
		color: var(--text);
		margin: 28px 0 12px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 8px;
	}

	:global(.guide-markdown-content h3) {
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 700;
		color: var(--text);
		margin: 20px 0 8px;
	}

	:global(.guide-markdown-content p) {
		margin: 0 0 16px;
	}

	:global(.guide-markdown-content strong) {
		color: var(--text);
		font-weight: 600;
	}

	:global(.guide-markdown-content ul, .guide-markdown-content ol) {
		padding-left: 24px;
		margin: 0 0 16px;
	}

	:global(.guide-markdown-content li) {
		margin-bottom: 8px;
	}

	/* Sources Section */
	.sources-cockpit-section {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.sources-head {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--signal);
	}

	.sources-head h3 {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.sources-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.source-item {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-muted);
	}

	.source-icon {
		color: var(--text-subtle);
		flex-shrink: 0;
	}

	/* Disclaimer */
	.article-disclaimer {
		padding: 16px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		font-size: 11px;
		line-height: 1.5;
		color: var(--text-subtle);
	}

	.article-disclaimer p {
		margin: 0;
	}

	.guide-footer-nav {
		padding-top: 16px;
		border-top: 1px solid var(--line);
	}

	.back-to-guides {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		color: var(--signal);
		text-decoration: none;
	}
</style>
