---
import Layout from '../../layouts/Layout.astro';
import { guidesData } from '../../data/guides';

const pageTitle = "Kripto Para Rehberleri & Sorun Çözüm Kılavuzları | Kriptonik";
const pageDesc = "Yanlış ağ transferleri, takılan işlemler, gas ücreti düşürme, cüzdan güvenliği ve borsa komisyonları üzerine 15 kapsamlı rehber.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container guides-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<span class="current">Rehberler</span>
		</nav>

		<div class="page-header">
			<div class="badge-pill">
				<span>🧭</span>
				<span>15 Kapsamlı Çözüm Kılavuzu</span>
			</div>
			<h1 class="page-title">Kripto Para & Blokzincir Rehberleri</h1>
			<p class="page-subtitle">
				Kripto transferlerinizde yaşadığınız sorunları adım adım çözen, cüzdan hijyenini ve maliyet optimizasyonunu öğreten tarafsız eğitim kütüphanesi.
			</p>
		</div>

		<!-- Guides Grid -->
		<div class="guides-grid">
			{guidesData.map(guide => (
				<article class="guide-card">
					<div class="card-head">
						<span class="guide-cat">{guide.category}</span>
						<span class="guide-time">⏱️ {guide.readTime}</span>
					</div>
					<h2 class="card-title">
						<a href={`/rehber/${guide.slug}`}>{guide.title}</a>
					</h2>
					<p class="card-summary">{guide.summary}</p>
					<div class="card-footer">
						<a href={`/rehber/${guide.slug}`} class="read-link">Rehberi Oku ➔</a>
						<span class="review-date">Son inceleme: {guide.reviewedAt}</span>
					</div>
				</article>
			))}
		</div>
	</div>
</Layout>

<style>
.guides-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}

.page-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.page-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-2);
	letter-spacing: -0.02em;
}
.page-subtitle {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	max-width: 700px;
	line-height: 1.6;
}

.guides-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
	gap: var(--space-6);
}
.guide-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-6);
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	transition: all var(--transition-fast);
}
.guide-card:hover {
	transform: translateY(-2px);
	border-color: var(--color-primary-500);
}
.card-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: var(--space-3);
}
.guide-cat {
	font-size: 11px;
	font-weight: 700;
	background: var(--color-surface-hover);
	padding: 2px 8px;
	border-radius: var(--radius-sm);
	color: var(--color-primary-400);
}
.guide-time {
	font-size: var(--text-xs);
	color: var(--color-text-muted);
}
.card-title {
	font-size: var(--text-lg);
	font-weight: 800;
	margin-bottom: var(--space-3);
	line-height: 1.35;
}
.card-title a {
	color: var(--color-text-primary);
	text-decoration: none;
}
.card-title a:hover {
	color: var(--color-primary-400);
}
.card-summary {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
	line-height: 1.6;
	margin-bottom: var(--space-6);
}
.card-footer {
	border-top: 1px solid var(--color-border);
	padding-top: var(--space-3);
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.read-link {
	font-size: var(--text-sm);
	font-weight: 700;
	color: var(--color-primary-400);
	text-decoration: none;
}
.read-link:hover {
	text-decoration: underline;
}
.review-date {
	font-size: 11px;
	color: var(--color-text-muted);
}
</style>
