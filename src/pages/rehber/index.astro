---
// src/pages/rehber/index.astro - Cockpit Saha Rehberleri Dizini
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import { guidesData } from '../../data/guides';

const pageTitle = "Kripto Saha Çözüm Rehberleri | Kriptonik";
const pageDesc = "Yanlış ağ transferleri, takılan işlemler, cüzdan hijyeni ve borsa transfer komisyonları üzerine adım adım doğrulanmış teknik kılavuzlar.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="cockpit-guides-container">
		<!-- Header -->
		<header class="guides-header">
			<nav class="cockpit-breadcrumb" aria-label="Gezinti">
				<a href="/">Ana Sayfa</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<span class="crumb-current">Rehberler</span>
			</nav>

			<div class="badge-chip">
				<Icon name="shield-check" size={13} />
				<span>DOĞRULANMIŞ TEKNİK SAHA KILAVUZLARI</span>
			</div>

			<h1 class="guides-title">Kripto Saha Çözüm Rehberleri</h1>
			<p class="guides-desc">
				Kripto transferlerinde karşılaştığın sorunları adım adım çözen, cüzdan güvenliğini artıran ve maliyetleri düşüren doğrulanmış teknik kılavuzlar.
			</p>
		</header>

		<!-- Guides Grid -->
		<div class="guides-grid">
			{guidesData.map(guide => (
				<article class="guide-cockpit-card">
					<div class="card-meta-top">
						<span class="guide-cat-tag">{guide.category}</span>
						<span class="guide-time-tag">
							<Icon name="clock" size={11} />
							<span>{guide.readTime}</span>
						</span>
					</div>

					<h2 class="card-heading">
						<a href={`/rehber/${guide.slug}`}>{guide.title}</a>
					</h2>

					<p class="card-summary">{guide.summary}</p>

					<div class="card-footer-meta">
						<a href={`/rehber/${guide.slug}`} class="read-action">
							<span>Rehberi Oku</span>
							<Icon name="arrow-right" size={13} />
						</a>
						<span class="review-date">Son güncelleme: {guide.reviewedAt}</span>
					</div>
				</article>
			))}
		</div>
	</div>
</Layout>

<style>
	.cockpit-guides-container {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 32px 24px 64px;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.guides-header {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.cockpit-breadcrumb {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.cockpit-breadcrumb a {
		color: var(--text-subtle);
		text-decoration: none;
	}

	.cockpit-breadcrumb a:hover {
		color: var(--text);
	}

	.crumb-sep {
		color: var(--line);
	}

	.crumb-current {
		color: var(--text);
		font-weight: 600;
	}

	.badge-chip {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		color: var(--signal);
		width: max-content;
	}

	.guides-title {
		font-family: var(--font-display);
		font-size: clamp(26px, 4vw, 36px);
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.guides-desc {
		font-size: 15px;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0;
		max-width: 680px;
	}

	/* Grid */
	.guides-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}

	.guide-cockpit-card {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		transition: all var(--duration-fast) var(--ease-standard);
	}

	.guide-cockpit-card:hover {
		background: var(--surface-hover);
		border-color: var(--line-strong);
		transform: translateY(-2px);
		box-shadow: var(--shadow-sm);
	}

	.card-meta-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.guide-cat-tag {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 2px 6px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--signal);
	}

	.guide-time-tag {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.card-heading {
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
		line-height: 1.3;
	}

	.card-heading a {
		color: var(--text);
		text-decoration: none;
	}

	.card-heading a:hover {
		color: var(--signal);
	}

	.card-summary {
		font-size: 13px;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0;
		flex: 1;
	}

	.card-footer-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 14px;
		border-top: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 11px;
	}

	.read-action {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: 600;
		color: var(--signal);
		text-decoration: none;
	}

	.read-action:hover {
		text-decoration: underline;
	}

	.review-date {
		color: var(--text-subtle);
	}

	@media (max-width: 768px) {
		.guides-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
