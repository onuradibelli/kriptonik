---
import Layout from '../layouts/Layout.astro';

const services = [
	{ name: "Cloudflare Edge Ağı (Pages & Workers)", status: "operational", uptime: "100.0%" },
	{ name: "Piyasa Fiyat Servisleri (CoinGecko / CoinPaprika)", status: "operational", uptime: "99.9%" },
	{ name: "Bitcoin Mempool & Blok Gezgini", status: "operational", uptime: "99.8%" },
	{ name: "EVM RPC Ağları (Ethereum, BSC, Arbitrum, Polygon)", status: "operational", uptime: "99.9%" },
	{ name: "TRON Ağ Parametre Servisi", status: "operational", uptime: "100.0%" },
	{ name: "Stablecoin Depeg Monitörü", status: "operational", uptime: "100.0%" },
	{ name: "Korku ve Açgözlülük Endeks Servisi", status: "operational", uptime: "100.0%" }
];
---

<Layout title="Sistem Durumu (Service Status) | Kriptonik" description="Kriptonik altyapısı, blokzincir RPC bağlantıları ve veri sağlayıcılarının anlık çalışma durumları.">
	<div class="container container-narrow status-page">
		<div class="section-header">
			<div class="badge-pill badge-live">
				<span class="live-indicator"></span>
				<span>Tüm Sistemler Çalışıyor</span>
			</div>
			<h1 class="section-title">Sistem & Sağlayıcı Durumu</h1>
			<p class="section-desc">
				Kriptonik'in bağlı olduğu açık blokzincir servisleri, RPC düğümleri ve API sağlayıcılarının canlı durum raporu.
			</p>
		</div>

		<div class="status-list card">
			{services.map(srv => (
				<div class="status-row">
					<div class="s-left">
						<span class="status-dot"></span>
						<strong>{srv.name}</strong>
					</div>
					<div class="s-right">
						<span class="uptime mono-text">Son 30 gün: {srv.uptime}</span>
						<span class="status-tag">Çalışıyor</span>
					</div>
				</div>
			))}
		</div>

		<div class="status-footer text-faint">
			<span>Son Kontrol: 6 Kasım 2026 • Otomatik 5 dakikalık denetim</span>
		</div>
	</div>
</Layout>

<style>
	.status-page {
		padding: 48px 20px 80px;
	}

	.live-indicator {
		width: 7px;
		height: 7px;
		background: var(--success);
		border-radius: 50%;
	}

	.status-list {
		padding: 8px 16px;
		display: flex;
		flex-direction: column;
	}

	.status-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px 8px;
		border-bottom: 1px solid var(--border);
		gap: 12px;
		flex-wrap: wrap;
	}

	.status-row:last-child {
		border-bottom: none;
	}

	.s-left {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.status-dot {
		width: 9px;
		height: 9px;
		background: var(--success);
		border-radius: 50%;
		flex-shrink: 0;
	}

	.s-right {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.uptime {
		font-size: 12px;
		color: var(--text-muted);
	}

	.status-tag {
		font-size: 11px;
		font-weight: 700;
		color: var(--success);
		background: var(--success-soft);
		padding: 3px 8px;
		border-radius: 4px;
	}

	.status-footer {
		text-align: center;
		margin-top: 24px;
		font-size: 12px;
	}
</style>
