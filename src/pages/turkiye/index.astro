---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Türkiye Kripto Veri Merkezi | Kriptonik";
const pageDesc = "Türkiye'ye özgü şeffaf kripto verileri: Canlı USDT/TL Tether Primi, borsa arbitraj makası, TL emir defteri derinliği ve borsa pazar payları.";

const turkiyeModules = [
	{
		id: "usdt-tl-primi",
		code: "A1",
		title: "USDT/TL Primi (Tether Primi)",
		slug: "/turkiye/usdt-tl-primi",
		badge: "En Çok Takip Edilen",
		val: "+%0.44",
		sub: "Borsa: ₺38.65 | TCMB: ₺38.48",
		desc: "Yerel borsalardaki USDT/TRY fiyatının resmi TCMB USD/TRY kuruna göre yüzdesel sapması ve 30 günlük tarihsel prim trendi."
	},
	{
		id: "borsa-fiyat-farki",
		code: "A2",
		title: "Borsa Fiyat Farkı (Arbitraj Makası)",
		slug: "/turkiye/borsa-fiyat-farki",
		badge: "Canlı Makas",
		val: "₺180 (BTC)",
		sub: "BtcTurk ↔ Paribu ↔ Binance TR",
		desc: "Aynı işlem çiftinin (BTC/TRY, USDT/TRY, ETH/TRY) Türk kripto borsaları arasındaki anlık alış-satış farkı ve arbitraj fırsatları."
	},
	{
		id: "likidite-ve-derinlik",
		code: "A3",
		title: "TL Likidite Skoru & Kayma Maliyeti",
		slug: "/turkiye/likidite-ve-derinlik",
		badge: "Derinlik Analizi",
		val: "78 / 100",
		sub: "100.000 TL alımda %0.08 kayma",
		desc: "10 bin, 100 bin ve 1 milyon TL'lik piyasa alımlarında tahtada oluşan ortalama fiyat sapması ve kümülatif emir defteri derinliği."
	},
	{
		id: "borsalar",
		code: "A4",
		title: "Türk Borsaları Hacim & Pazar Payı",
		slug: "/turkiye/borsalar",
		badge: "Hacim Dağılımı",
		val: "₺4.82 Milyar",
		sub: "Son 24 saatlik toplam TL hacmi",
		desc: "BtcTurk, Paribu ve Binance TR 24 saatlik işlem hacimleri, pazar payı yüzdeleri ve listelenen aktif TL çiftleri sayısı."
	},
	{
		id: "borsa-ucretleri",
		code: "A5",
		title: "Borsa Ücret & Limit Karşılaştırması",
		slug: "/turkiye/borsa-ucretleri",
		badge: "Tasarruf Rehberi",
		val: "15+ Borsa",
		sub: "30 günde bir doğrulanır",
		desc: "Maker/taker komisyonları, Türk Lirası yatırma/çekme masrafları ve kripto ağ transfer kesintilerinin şeffaf ve kaynaklı tablosu."
	},
	{
		id: "tl-bazinda-getiri",
		code: "A6",
		title: "TL Bazında Reel Getiri Isı Haritası",
		slug: "/turkiye/tl-bazinda-getiri",
		badge: "Reel Getiri",
		val: "+%68.4",
		sub: "Dolar/TL enflasyonu arındırılmış",
		desc: "Bitcoin ve ilk 20 kripto paranın Türk Lirası ve Dolar bazındaki getirisi; kur artışından arındırılmış net getiri analizi."
	}
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container turkiye-hub-page">
		<!-- Breadcrumb -->
		<nav class="hub-nav" aria-label="Gezinti">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<span class="current">Türkiye Veri Merkezi</span>
		</nav>

		<!-- Hero Section -->
		<div class="turkiye-hero">
			<div class="tr-badge">
				<span class="tr-dot"></span>
				<span>TÜRKİYE'YE ÖZGÜ ŞEFFAF VERİ MERKEZİ</span>
			</div>
			<h1 class="tr-title">Türkiye Kripto Veri Merkezi</h1>
			<p class="tr-desc">
				Türk Lirası işlem çiftleri, Tether primi, borsa arbitraj makasları ve yerel tahta likidite derinliği: Rakamlar, açık formülü ve kaynağıyla birlikte.
			</p>
		</div>

		<!-- Key Metrics Bar -->
		<div class="tr-summary-grid">
			<div class="tr-stat-card">
				<span class="stat-k">USDT/TL Tether Primi</span>
				<div class="stat-v-wrap">
					<span class="stat-v text-success">+%0.44</span>
					<span class="stat-status">Normal Aralık</span>
				</div>
				<span class="stat-sub">Borsa Ort: ₺38.65 | TCMB: ₺38.48</span>
			</div>

			<div class="tr-stat-card">
				<span class="stat-k">TL Likidite Skoru (TLS)</span>
				<div class="stat-v-wrap">
					<span class="stat-v text-primary">78 / 100</span>
					<span class="stat-status">Yüksek Likidite</span>
				</div>
				<span class="stat-sub">100k TL Alımda Ortalama %0.08 Kayma</span>
			</div>

			<div class="tr-stat-card">
				<span class="stat-k">24s Yerel Borsa Hacmi</span>
				<div class="stat-v-wrap">
					<span class="stat-v">₺4.82 Mr</span>
					<span class="stat-status">≈ $125M</span>
				</div>
				<span class="stat-sub">BtcTurk • Paribu • Binance TR</span>
			</div>

			<div class="tr-stat-card">
				<span class="stat-k">En Yüksek Arbitraj Makası</span>
				<div class="stat-v-wrap">
					<span class="stat-v text-warning">%0.18</span>
					<span class="stat-status">BTC / TRY</span>
				</div>
				<span class="stat-sub">Borsalar arası anlık net makas</span>
			</div>
		</div>

		<!-- Modules Grid -->
		<div class="modules-section">
			<div class="mod-header">
				<div class="mod-eyebrow">VERİ SETLERİ & ANALİZLER</div>
				<h2 class="mod-title">Türkiye Veri Setleri Kataloğu</h2>
				<p class="mod-sub">Yerel piyasa koşullarını ve maliyetlerini anlık olarak ölçen 6 temel veri modülü.</p>
			</div>

			<div class="modules-grid">
				{turkiyeModules.map(mod => (
					<a href={mod.slug} class="module-card">
						<div class="card-top">
							<span class="mod-code-pill">{mod.code}</span>
							<span class="mod-badge-pill">{mod.badge}</span>
						</div>

						<h3 class="mod-card-title">{mod.title}</h3>
						<p class="mod-card-desc">{mod.desc}</p>

						<div class="card-val-box">
							<span class="cv-label">Canlı Gösterge:</span>
							<div class="cv-row">
								<span class="cv-val font-mono">{mod.val}</span>
								<span class="cv-sub">{mod.sub}</span>
							</div>
						</div>

						<div class="card-foot">
							<span class="foot-action">Veri Sayfasını İncele</span>
							<span class="foot-arrow">→</span>
						</div>
					</a>
				))}
			</div>
		</div>

		<!-- Transparency & Methodology Box -->
		<div class="transparency-box">
			<div class="tb-left">
				<div class="tb-icon">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
				</div>
				<div>
					<h3>Şeffaflık & Veri Metodolojisi Taahhüdü</h3>
					<p>
						Türkiye veri setlerinde gösterilen tüm fiyatlar; BtcTurk, Paribu ve Binance TR'nin herkese açık resmi piyasa uçlarından çekilerek hacim ağırlıklı medyan formülüyle hesaplanır. Hiçbir sayı tahmini değildir, her veri bileşeninde güncelleme yaşı açıkça gösterilir.
					</p>
				</div>
			</div>
			<div class="tb-right">
				<a href="/metodoloji" class="btn btn-secondary">Metodoloji Dokümanını Oku →</a>
			</div>
		</div>
	</div>
</Layout>

<style>
	.turkiye-hub-page {
		padding: 48px 20px 88px;
	}

	.hub-nav {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-faint);
		margin-bottom: 28px;
	}

	.hub-nav a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.hub-nav a:hover {
		color: var(--primary);
	}

	.hub-nav .current {
		color: var(--text);
		font-weight: 500;
	}

	.turkiye-hero {
		text-align: center;
		max-width: 820px;
		margin: 0 auto 40px;
	}

	.tr-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.25);
		color: var(--primary);
		padding: 6px 14px;
		border-radius: 9999px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		margin-bottom: 20px;
	}

	.tr-dot {
		width: 6px;
		height: 6px;
		background: var(--primary);
		border-radius: 50%;
	}

	.tr-title {
		font-size: 44px;
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text);
		margin: 0 0 16px;
	}

	.tr-desc {
		font-size: 16px;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0;
	}

	/* Summary Grid */
	.tr-summary-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 18px;
		margin-bottom: 64px;
	}

	.tr-stat-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.stat-k {
		font-size: 12px;
		font-weight: 600;
		color: var(--text-faint);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.stat-v-wrap {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}

	.stat-v {
		font-size: 26px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text);
		font-family: var(--font-mono);
	}

	.stat-status {
		font-size: 10px;
		font-weight: 700;
		color: var(--text-muted);
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		padding: 2px 6px;
		border-radius: 4px;
	}

	.stat-sub {
		font-size: 11.5px;
		color: var(--text-muted);
		line-height: 1.4;
	}

	/* Modules Grid */
	.modules-section {
		margin-bottom: 72px;
	}

	.mod-header {
		text-align: center;
		margin-bottom: 36px;
	}

	.mod-eyebrow {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--primary);
		text-transform: uppercase;
		margin-bottom: 8px;
	}

	.mod-title {
		font-size: 32px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0 0 10px;
	}

	.mod-sub {
		font-size: 15px;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto;
	}

	.modules-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.module-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 24px;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 16px;
		transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
	}

	.module-card:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow-card-hover), 0 0 28px rgba(16, 185, 129, 0.05);
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.mod-code-pill {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 2px 7px;
		border-radius: 4px;
	}

	.mod-badge-pill {
		font-size: 11px;
		font-weight: 600;
		color: var(--text-faint);
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		padding: 2px 8px;
		border-radius: 4px;
	}

	.mod-card-title {
		font-size: 17px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
		letter-spacing: -0.01em;
		transition: color var(--transition-fast);
	}

	.module-card:hover .mod-card-title {
		color: var(--primary);
	}

	.mod-card-desc {
		font-size: 13px;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0;
		flex: 1;
	}

	.card-val-box {
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		border-radius: 10px;
		padding: 12px 14px;
	}

	.cv-label {
		font-size: 11px;
		color: var(--text-faint);
		display: block;
		margin-bottom: 4px;
	}

	.cv-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
	}

	.cv-val {
		font-size: 18px;
		font-weight: 800;
		color: var(--primary);
	}

	.cv-sub {
		font-size: 11.5px;
		color: var(--text-muted);
	}

	.card-foot {
		padding-top: 14px;
		border-top: 1px solid var(--border-subtle);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.foot-action {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--primary);
	}

	.foot-arrow {
		font-size: 13px;
		color: var(--text-faint);
		transition: transform var(--transition-fast), color var(--transition-fast);
	}

	.module-card:hover .foot-arrow {
		transform: translateX(3px);
		color: var(--primary);
	}

	/* Transparency Box */
	.transparency-box {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 18px;
		padding: 32px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 28px;
	}

	.tb-left {
		display: flex;
		gap: 16px;
		align-items: flex-start;
	}

	.tb-icon {
		width: 44px;
		height: 44px;
		border-radius: 10px;
		background: rgba(16, 185, 129, 0.1);
		color: var(--primary);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.tb-left h3 {
		font-size: 17px;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 6px;
	}

	.tb-left p {
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0;
	}

	.tb-right {
		flex-shrink: 0;
	}

	@media (max-width: 960px) {
		.tr-summary-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.modules-grid {
			grid-template-columns: 1fr;
		}
		.transparency-box {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (max-width: 640px) {
		.tr-summary-grid {
			grid-template-columns: 1fr;
		}
		.tr-title {
			font-size: 32px;
		}
	}
</style>
