---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Türk Kripto Borsaları Hacim & Pazar Payı Sıralaması | Kriptonik";
const pageDesc = "BtcTurk, Paribu, Binance TR ve Türkiye'de faaliyet gösteren kripto borsalarının 24 saatlik TL işlem hacimleri, pazar payı ve çift sayıları.";

const exchanges = [
	{
		rank: 1,
		name: "Binance TR",
		legalName: "BN Teknoloji A.Ş.",
		volume24hTry: "₺2.41 Mr",
		volume24hUsd: "$62.4M",
		marketShare: "%50.1",
		activePairs: "164 Çift",
		status: "KVHS Başvurusu Mevcut (SPK)"
	},
	{
		rank: 2,
		name: "BtcTurk | Kripto",
		legalName: "Eliptik Yazılım ve Ticaret A.Ş.",
		volume24hTry: "₺1.32 Mr",
		volume24hUsd: "$34.2M",
		marketShare: "%27.4",
		activePairs: "112 Çift",
		status: "KVHS Başvurusu Mevcut (SPK)"
	},
	{
		rank: 3,
		name: "Paribu",
		legalName: "Paribu Teknoloji A.Ş.",
		volume24hTry: "₺1.09 Mr",
		volume24hUsd: "$28.3M",
		marketShare: "%22.5",
		activePairs: "128 Çift",
		status: "KVHS Başvurusu Mevcut (SPK)"
	}
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container data-page-container">
		<nav class="page-breadcrumb" aria-label="Gezinti">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/turkiye">Türkiye Verisi</a>
			<span>/</span>
			<span class="current">Borsa Hacimleri & Pazar Payı (A4)</span>
		</nav>

		<div class="dp-header">
			<div class="dp-badges">
				<span class="badge-live"><span class="b-dot"></span> Canlı Veri</span>
				<span class="badge-tag">24 Saatlik Hacim</span>
				<span class="badge-tag">Pazar Payı Dağılımı</span>
			</div>
			<h1 class="dp-title">Türk Kripto Para Borsaları Hacim ve Pazar Payı</h1>
			<p class="dp-summary">
				Türkiye'de Türk Lirası işlem çifti sunan kripto varlık hizmet sağlayıcılarının (KVHS) anlık 24 saatlik işlem hacimleri ve pazar payı oranları.
			</p>
		</div>

		<div class="section-card">
			<div class="sc-head">
				<h3>Borsa Sıralaması (24 Saatlik TL Hacmine Göre)</h3>
				<span class="sc-status">Toplam Hacim: ₺4.82 Milyar ($125M)</span>
			</div>

			<div class="table-shell">
				<table class="data-table">
					<thead>
						<tr>
							<th>Sıra</th>
							<th>Borsa Adı</th>
							<th>24s TL Hacmi</th>
							<th>USD Karşılığı</th>
							<th>Pazar Payı</th>
							<th>TL Çift Sayısı</th>
							<th>Yasal Statü (SPK)</th>
						</tr>
					</thead>
					<tbody>
						{exchanges.map(ex => (
							<tr>
								<td><span class="rank-badge font-mono">{ex.rank}</span></td>
								<td>
									<strong>{ex.name}</strong>
									<span class="sub-corp text-muted">{ex.legalName}</span>
								</td>
								<td class="font-mono font-bold">{ex.volume24hTry}</td>
								<td class="font-mono text-muted">{ex.volume24hUsd}</td>
								<td class="font-mono text-success font-bold">{ex.marketShare}</td>
								<td class="font-mono">{ex.activePairs}</td>
								<td><span class="status-spk">{ex.status}</span></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

		<div class="editorial-guide-box">
			<h2>Hacim Verileri Nasıl Derlenir?</h2>
			<p>
				Gösterilen işlem hacimleri borsaların doğrudan herkese açık ticker uçlarından toplanır. Türkiye'deki yeni Sermaye Piyasası Kurulu (SPK) kripto varlık yasa düzenlemeleri kapsamında faaliyet gösteren ve SPK'ya 'Faaliyette Bulunanlar Listesi' beyanında bulunmuş resmi şirketlerin verileri esas alınır.
			</p>
		</div>
	</div>
</Layout>

<style>
	.data-page-container {
		padding: 48px 20px 88px;
		max-width: 1040px;
	}
	.page-breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-faint);
		margin-bottom: 24px;
	}
	.page-breadcrumb a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.page-breadcrumb .current {
		color: var(--text);
		font-weight: 500;
	}
	.dp-header {
		margin-bottom: 32px;
	}
	.dp-badges {
		display: flex;
		gap: 8px;
		align-items: center;
		margin-bottom: 14px;
	}
	.badge-live {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		font-weight: 700;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 3px 8px;
		border-radius: 4px;
	}
	.b-dot {
		width: 6px;
		height: 6px;
		background: var(--primary);
		border-radius: 50%;
	}
	.badge-tag {
		font-size: 11px;
		color: var(--text-faint);
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		padding: 3px 8px;
		border-radius: 4px;
	}
	.dp-title {
		font-size: 38px;
		font-weight: 800;
		letter-spacing: -0.025em;
		color: var(--text);
		margin: 0 0 12px;
	}
	.dp-summary {
		font-size: 16px;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0;
	}
	.section-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 24px;
		margin-bottom: 36px;
	}
	.sc-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 18px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--border-subtle);
		flex-wrap: wrap;
		gap: 8px;
	}
	.sc-head h3 {
		font-size: 17px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}
	.sc-status {
		font-size: 12px;
		font-weight: 600;
		color: var(--primary);
	}
	.table-shell {
		overflow-x: auto;
	}
	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13.5px;
	}
	.data-table th {
		text-align: left;
		padding: 12px 14px;
		color: var(--text-faint);
		font-size: 11.5px;
		border-bottom: 1px solid var(--border);
		text-transform: uppercase;
	}
	.data-table td {
		padding: 14px 14px;
		border-bottom: 1px solid var(--border-subtle);
		color: var(--text);
	}
	.rank-badge {
		font-weight: 700;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.1);
		padding: 2px 8px;
		border-radius: 4px;
		font-size: 12px;
	}
	.sub-corp {
		display: block;
		font-size: 11.5px;
		margin-top: 2px;
	}
	.status-spk {
		font-size: 11px;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.2);
		padding: 3px 8px;
		border-radius: 4px;
	}
	.editorial-guide-box {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 32px;
	}
	.editorial-guide-box h2 {
		font-size: 20px;
		font-weight: 800;
		color: var(--text);
		margin: 0 0 12px;
	}
	.editorial-guide-box p {
		font-size: 14px;
		line-height: 1.65;
		color: var(--text-muted);
		margin: 0;
	}
</style>
