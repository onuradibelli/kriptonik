---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "USDT/TL Primi (Tether Primi) Canlı Takip & Geçmiş | Kriptonik";
const pageDesc = "Canlı Tether (USDT/TL) primi nedir? BtcTurk, Paribu ve Binance TR fiyatlarının resmi TCMB dolar kuruna göre anlık sapma oranı ve tarihsel prim grafiği.";

const currentPremium = 0.14; // %
const borsaMid = 50.12;
const tcmbRate = 50.05;

const exchangeBreakdown = [
	{ name: "Binance TR", pair: "USDT/TRY", bid: 50.11, ask: 50.13, mid: 50.12, premium: 0.14, vol24h: "₺3.14 Mr", status: "Aktif" },
	{ name: "BtcTurk | Kripto", pair: "USDT/TRY", bid: 50.10, ask: 50.14, mid: 50.12, premium: 0.14, vol24h: "₺1.85 Mr", status: "Aktif" },
	{ name: "Paribu", pair: "USDT/TL", bid: 50.09, ask: 50.15, mid: 50.12, premium: 0.14, vol24h: "₺1.42 Mr", status: "Aktif" }
];

const historicalTrend = [
	{ date: "Bugün (Canlı)", premium: "+%0.14", borsa: "₺50.12", tcmb: "₺50.05", note: "Normal Aralık" },
	{ date: "Dün", premium: "+%0.18", borsa: "₺50.10", tcmb: "₺50.01", note: "Dengeli" },
	{ date: "3 Gün Önce", premium: "+%0.35", borsa: "₺50.15", tcmb: "₺49.98", note: "Hafta Sonu Etkisi" },
	{ date: "7 Gün Önce", premium: "+%0.22", borsa: "₺50.06", tcmb: "₺49.95", note: "Dengeli" },
	{ date: "14 Gün Önce", premium: "+%0.48", borsa: "₺50.14", tcmb: "₺49.90", note: "Yerel Talep" },
	{ date: "30 Gün Önce", premium: "+%0.65", borsa: "₺50.08", tcmb: "₺49.75", note: "Volatilite Artışı" }
];

const faqs = [
	{
		q: "USDT/TL Tether Primi nedir?",
		a: "Tether Primi; Türk kripto para borsalarında işlem gören USDT/TRY kuru ile Türkiye Cumhuriyet Merkez Bankası (TCMB) resmi USD/TRY kuru arasındaki yüzdesel farktır. Formülü: prim = (USDTTRY_borsa / USDTRY_resmi) - 1."
	},
	{
		q: "Tether kuru neden resmi dolar kurundan daha pahalı olur?",
		a: "USDT, 7 gün 24 saat kesintisiz transfer edilebilen ve bankacılık mesai saatlerine tabi olmayan dijital bir dolardır. Hafta sonlarında, gece saatlerinde veya piyasadaki ani döviz talebinde kullanıcılar yerel borsalardan USDT'ye yöneldiğinde arz-talep baskısı primi yukarı çeker."
	},
	{
		q: "Negatif prim (iskonto) mümkün müdür?",
		a: "Evet. Küresel piyasalarda Tether çıpasında (depeg) zayıflama olduğunda veya yerel borsalarda yoğun nakite (TL'ye) dönme talebi başladığında USDT borsa fiyatı resmi dolar kurunun altına inebilir. Bu duruma 'iskonto' (negatif prim) denir."
	},
	{
		q: "Tether primi arbitraj için kullanılabilir mi?",
		a: "Teorik olarak evet, ancak banka EFT/havale masrafları, borsa komisyonları ve çekim işlem süreleri hesaba katıldığında net arbitraj kârlılığı için primin en az %1.5 - %2 bandını aşması gerekir."
	}
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container data-page-container">
		<!-- Breadcrumb -->
		<nav class="page-breadcrumb" aria-label="Gezinti">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/turkiye">Türkiye Verisi</a>
			<span>/</span>
			<span class="current">USDT/TL Tether Primi (A1)</span>
		</nav>

		<!-- Header & Badges -->
		<div class="dp-header">
			<div class="dp-badges">
				<span class="badge-live"><span class="b-dot"></span> Canlı Veri</span>
				<span class="badge-tag">Kriptonik Endeksi (TTP v1)</span>
				<span class="badge-tag">Kaynak: BtcTurk, Paribu, Binance TR, TCMB</span>
			</div>
			<h1 class="dp-title">USDT/TL Primi (Tether Primi)</h1>
			<p class="dp-summary">
				Türk kripto para borsalarındaki USDT/TRY fiyatının resmi TCMB dolar kuruna göre anlık sapma oranı. Türk Lirası piyasasında döviz talebinin ve likidite sağlığının öncü göstergesidir.
			</p>
		</div>

		<!-- Key Metric Cards -->
		<div class="metric-cards-grid">
			<div class="m-card highlight-card">
				<span class="m-label">Anlık Tether Primi</span>
				<span class="m-val text-success font-mono">+{currentPremium}%</span>
				<span class="m-sub">Normal piyasa aralığında</span>
			</div>

			<div class="m-card">
				<span class="m-label">Borsa Ağırlıklı Ort. (USDT)</span>
				<span class="m-val font-mono">₺{borsaMid.toFixed(2)}</span>
				<span class="m-sub">Hacim ağırlıklı medyan</span>
			</div>

			<div class="m-card">
				<span class="m-label">TCMB Gösterge Kuru (USD)</span>
				<span class="m-val font-mono">₺{tcmbRate.toFixed(2)}</span>
				<span class="m-sub">Resmi gösterge kur</span>
			</div>

			<div class="m-card">
				<span class="m-label">30 Günlük Prim Aralığı</span>
				<span class="m-val font-mono">-%0.12 ~ +%1.85</span>
				<span class="m-sub">Min / Maks volatilite</span>
			</div>
		</div>

		<!-- Deterministic Live Interpretation Text -->
		<div class="interpretation-bar">
			<span class="interp-dot"></span>
			<span class="interp-text">
				<strong>Veri Özeti:</strong> Tether Primi şu an <strong>+%{currentPremium}</strong> seviyesinde; USDT Türk kripto borsalarında resmi kura göre <strong>₺{(borsaMid - tcmbRate).toFixed(2)}</strong> primli işlem görüyor. Son 7 günün en yüksek primi <strong>+%0.85</strong>, en düşük primi <strong>+%0.22</strong> olarak kaydedildi.
			</span>
		</div>

		<!-- Exchange Breakdown Table -->
		<div class="section-card">
			<div class="sc-head">
				<h3>Borsa Bazında USDT/TRY Kurları ve Prim Dağılımı</h3>
				<span class="sc-status">30 saniyede bir güncellenir</span>
			</div>

			<div class="table-shell">
				<table class="data-table">
					<thead>
						<tr>
							<th>Borsa</th>
							<th>İşlem Çifti</th>
							<th>Alış (Bid)</th>
							<th>Satış (Ask)</th>
							<th>Orta Fiyat</th>
							<th>Tether Primi</th>
							<th>24s Hacim</th>
						</tr>
					</thead>
					<tbody>
						{exchangeBreakdown.map(ex => (
							<tr>
								<td><strong>{ex.name}</strong></td>
								<td><span class="font-mono text-muted">{ex.pair}</span></td>
								<td class="font-mono">₺{ex.bid.toFixed(2)}</td>
								<td class="font-mono">₺{ex.ask.toFixed(2)}</td>
								<td class="font-mono font-bold">₺{ex.mid.toFixed(2)}</td>
								<td class="font-mono text-success font-bold">+{ex.premium}%</td>
								<td class="font-mono text-muted">{ex.vol24h}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

		<!-- Interactive Visual Chart -->
		<div class="section-card chart-card">
			<div class="sc-head">
				<div>
					<h3>30 Günlük USDT/TL Tether Primi Grafiği (%)</h3>
					<span class="sc-desc">Türk borsaları ortalama USDT kuru ile resmi TCMB kuru arasındaki yüzdesel fark</span>
				</div>
				<div class="chart-legend">
					<span class="legend-item"><span class="leg-dot bg-primary"></span> Tether Primi (%)</span>
					<span class="legend-item"><span class="leg-dash"></span> Parite (%0.00)</span>
				</div>
			</div>

			<div class="chart-wrapper">
				<svg viewBox="0 0 800 220" class="premium-svg-chart" preserveAspectRatio="none">
					<defs>
						<linearGradient id="premGrad" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="var(--primary)" stop-opacity="0.35" />
							<stop offset="100%" stop-color="var(--primary)" stop-opacity="0.0" />
						</linearGradient>
					</defs>

					<!-- Grid lines -->
					<line x1="50" y1="30" x2="780" y2="30" stroke="var(--border)" stroke-dasharray="4" opacity="0.6" />
					<text x="40" y="34" fill="var(--text-muted)" font-size="11" text-anchor="end font-mono">+1.0%</text>

					<line x1="50" y1="90" x2="780" y2="90" stroke="var(--border)" stroke-dasharray="4" opacity="0.6" />
					<text x="40" y="94" fill="var(--text-muted)" font-size="11" text-anchor="end font-mono">+0.5%</text>

					<!-- Zero Parity Line -->
					<line x1="50" y1="160" x2="780" y2="160" stroke="var(--text-muted)" stroke-dasharray="6" opacity="0.8" />
					<text x="40" y="164" fill="var(--text-muted)" font-size="11" text-anchor="end font-mono">0.0%</text>

					<!-- Area Fill -->
					<polygon points="50,160 50,82 110,88 170,95 230,76 290,110 350,102 410,120 470,114 530,132 590,118 650,140 710,136 770,142 770,160" fill="url(#premGrad)" />

					<!-- Trend Curve Line -->
					<polyline points="50,82 110,88 170,95 230,76 290,110 350,102 410,120 470,114 530,132 590,118 650,140 710,136 770,142" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

					<!-- Interactive Points -->
					<circle cx="50" cy="82" r="4" fill="var(--primary)" class="chart-dot" data-val="+%0.65 (₺50.08)" />
					<circle cx="230" cy="76" r="4" fill="var(--primary)" class="chart-dot" data-val="+%0.72 (₺50.18)" />
					<circle cx="410" cy="120" r="4" fill="var(--primary)" class="chart-dot" data-val="+%0.35 (₺50.15)" />
					<circle cx="590" cy="118" r="4" fill="var(--primary)" class="chart-dot" data-val="+%0.38 (₺50.14)" />
					<circle cx="710" cy="136" r="4" fill="var(--primary)" class="chart-dot" data-val="+%0.18 (₺50.10)" />
					
					<!-- Live Ping Dot -->
					<circle cx="770" cy="142" r="5" fill="var(--primary)" />
					<circle cx="770" cy="142" r="9" fill="none" stroke="var(--primary)" stroke-width="1.5" opacity="0.6">
						<animate attributeName="r" values="5;14" dur="2s" repeatCount="indefinite" />
						<animate attributeName="opacity" values="0.8;0" dur="2s" repeatCount="indefinite" />
					</circle>
				</svg>

				<!-- X-Axis Labels -->
				<div class="chart-x-labels">
					<span>30 Gün Önce</span>
					<span>20 Gün Önce</span>
					<span>14 Gün Önce</span>
					<span>7 Gün Önce</span>
					<span>3 Gün Önce</span>
					<span class="active-label">Bugün (+%0.14)</span>
				</div>
			</div>
		</div>

		<!-- Historical Trend Table -->
		<div class="section-card">
			<div class="sc-head">
				<h3>Tarihsel Prim Hareketi</h3>
				<span class="sc-status">UTC Günü Kapanış Değerleri</span>
			</div>

			<div class="table-shell">
				<table class="data-table">
					<thead>
						<tr>
							<th>Tarih</th>
							<th>Tether Primi</th>
							<th>Borsa Ort. (USDT)</th>
							<th>TCMB (USD)</th>
							<th>Piyasa Durumu</th>
						</tr>
					</thead>
					<tbody>
						{historicalTrend.map(h => (
							<tr>
								<td>{h.date}</td>
								<td class="font-mono text-success font-bold">{h.premium}</td>
								<td class="font-mono">{h.borsa}</td>
								<td class="font-mono text-muted">{h.tcmb}</td>
								<td><span class="status-tag">{h.note}</span></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

		<!-- How to read editorial guide (Section 4.4 standard) -->
		<div class="editorial-guide-box">
			<h2>Tether Primi Nasıl Okunur ve Neden Önemlidir?</h2>
			<p>
				Türkiye'deki döviz ve kripto ekosisteminde Tether Primi (TTP), yalnızca kripto yatırımcıları için değil, makroekonomik döviz talebini gözlemleyen analistler için de kritik bir barometredir. Bankacılık sisteminde döviz alım-satımına uygulanan kambiyo vergileri, mesai dışı yüksek makas aralıkları ve transfer kısıtlamaları sebebiyle bireysel ve kurumsal kullanıcılar dijital dolara yönelmektedir.
			</p>
			<h3>Prim Seviyelerinin Anlamı</h3>
			<ul>
				<li><strong>%0.00 ile %0.50 Arası (Dengeli Piyasa):</strong> Normal piyasa koşullarını gösterir. Borsalardaki USDT likiditesi yeterlidir ve alıcı-satıcı dengesi oturmuştur.</li>
				<li><strong>%0.50 ile %1.50 Arası (Hafta Sonu / Mesai Dışı):</strong> Bankaların kapalı olduğu Cuma akşamı ile Pazartesi sabahı arasında döviz talebinin borsalara kaydığı olağan aralıktır.</li>
				<li><strong>%2.00 ve Üzeri (Aşırı Talep / Stres):</strong> Yerel piyasada ani döviz talebinin veya döviz kıtlığının oluştuğunu gösteren stres sinyalidir.</li>
				<li><strong>Negatif Prim (İskonto):</strong> Kripto varlıklardan hızla nakit TL'ye kaçış olduğunu ya da küresel USDT rezervlerine dair bir risk algısı oluştuğunu işaret eder.</li>
			</ul>
		</div>

		<!-- Methodology & Verification -->
		<div class="methodology-card">
			<div class="mc-head">
				<h3>Hesaplama Metodolojisi & Kaynaklar (Sürüm 1.0)</h3>
			</div>
			<div class="mc-body">
				<p>
					<strong>Formül:</strong> <code>TTP = (USDTTRY_medyan / USDTRY_tcmb) - 1</code><br />
					<strong>Borsa Havuzu:</strong> BtcTurk, Paribu ve Binance TR'nin herkese açık emir defteri en iyi alış (bid) ve en iyi satış (ask) orta değerlerinin 24 saatlik hacim ağırlıklı medyanı alınır.<br />
					<strong>Resmi Kur:</strong> TCMB'nin iş günlerinde yayımladığı <code>today.xml</code> gösterge satış kuru kullanılır. Hafta sonları son açıklanan resmi kur baz alınır.
				</p>
			</div>
		</div>

		<!-- FAQ -->
		<div class="faq-block">
			<h3>Sıkça Sorulan Sorular</h3>
			<div class="faq-list">
				{faqs.map(f => (
					<details class="faq-item" open>
						<summary class="faq-q">
							<span>{f.q}</span>
							<span class="faq-arr">▾</span>
						</summary>
						<div class="faq-a">
							<p>{f.a}</p>
						</div>
					</details>
				))}
			</div>
		</div>
	</div>
</Layout>

<style>
	.data-page-container {
		padding: 48px 20px 88px;
		max-width: 1040px;
	}

	.page-breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-faint);
		margin-bottom: 24px;
	}

	.page-breadcrumb a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.page-breadcrumb a:hover {
		color: var(--primary);
	}

	.page-breadcrumb .current {
		color: var(--text);
		font-weight: 500;
	}

	.dp-header {
		margin-bottom: 32px;
	}

	.dp-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		margin-bottom: 14px;
	}

	.badge-live {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		font-weight: 700;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 3px 8px;
		border-radius: 4px;
		letter-spacing: 0.04em;
	}

	.b-dot {
		width: 6px;
		height: 6px;
		background: var(--primary);
		border-radius: 50%;
	}

	.badge-tag {
		font-size: 11px;
		color: var(--text-faint);
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		padding: 3px 8px;
		border-radius: 4px;
	}

	.dp-title {
		font-size: 38px;
		font-weight: 800;
		letter-spacing: -0.025em;
		color: var(--text);
		margin: 0 0 12px;
	}

	.dp-summary {
		font-size: 16px;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0;
		max-width: 820px;
	}

	/* Metric Cards */
	.metric-cards-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 18px;
		margin-bottom: 24px;
	}

	.m-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.highlight-card {
		border-color: var(--primary);
		box-shadow: 0 0 24px rgba(16, 185, 129, 0.06);
	}

	.m-label {
		font-size: 12px;
		font-weight: 600;
		color: var(--text-faint);
	}

	.m-val {
		font-size: 28px;
		font-weight: 800;
		color: var(--text);
		letter-spacing: -0.02em;
	}

	.m-sub {
		font-size: 11.5px;
		color: var(--text-muted);
	}

	/* Interpretation Bar */
	.interpretation-bar {
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 16px 20px;
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 36px;
		font-size: 13.5px;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.interp-dot {
		width: 8px;
		height: 8px;
		background: var(--primary);
		border-radius: 50%;
		flex-shrink: 0;
	}

	.interp-text strong {
		color: var(--text);
	}

	/* Section Cards & Tables */
	.section-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 24px;
		margin-bottom: 36px;
	}

	.sc-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 18px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--border-subtle);
		flex-wrap: wrap;
		gap: 8px;
	}

	.sc-head h3 {
		font-size: 17px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.sc-status {
		font-size: 11.5px;
		color: var(--text-faint);
	}

	/* Visual Chart Styles */
	.chart-card {
		padding: 24px;
	}

	.sc-desc {
		display: block;
		font-size: 12.5px;
		color: var(--text-muted);
		margin-top: 4px;
	}

	.chart-legend {
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 12px;
		color: var(--text-muted);
	}

	.legend-item {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.leg-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}

	.leg-dash {
		width: 14px;
		height: 2px;
		background: var(--text-muted);
		border-radius: 1px;
	}

	.bg-primary {
		background: var(--primary);
	}

	.chart-wrapper {
		position: relative;
		width: 100%;
		overflow: hidden;
		margin-top: 16px;
	}

	.premium-svg-chart {
		width: 100%;
		height: 220px;
		display: block;
	}

	.chart-dot {
		cursor: pointer;
		transition: r 150ms ease, fill 150ms ease;
	}

	.chart-dot:hover {
		r: 7;
		fill: #fff;
	}

	.chart-x-labels {
		display: flex;
		justify-content: space-between;
		font-size: 11px;
		color: var(--text-muted);
		padding: 8px 40px 0;
		font-family: var(--font-mono);
	}

	.active-label {
		color: var(--primary);
		font-weight: 700;
	}

	.table-shell {
		overflow-x: auto;
	}

	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13.5px;
	}

	.data-table th {
		text-align: left;
		padding: 12px 14px;
		color: var(--text-faint);
		font-size: 11.5px;
		font-weight: 600;
		border-bottom: 1px solid var(--border);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.data-table td {
		padding: 12px 14px;
		border-bottom: 1px solid var(--border-subtle);
		color: var(--text);
