---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Borsa Fiyat Farkı & Arbitraj Makası (BTC, ETH, USDT) | Kriptonik";
const pageDesc = "BtcTurk, Paribu ve Binance TR arasındaki anlık fiyat farkları, BTC/TRY ve USDT/TRY arbitraj marjı ve net transfer komisyonu hesabı.";

const pairs = [
	{
		symbol: "BTC / TRY",
		maxExchange: "BtcTurk (₺3.539.100)",
		minExchange: "Binance TR (₺3.536.800)",
		diffTry: "₺2.300",
		diffPct: "%0.065",
		status: "Normal",
		lastUpdate: "Anlık"
	},
	{
		symbol: "ETH / TRY",
		maxExchange: "Paribu (₺131.950)",
		minExchange: "Binance TR (₺131.620)",
		diffTry: "₺330",
		diffPct: "%0.25",
		status: "Dar Makas",
		lastUpdate: "Anlık"
	},
	{
		symbol: "USDT / TRY",
		maxExchange: "Paribu (₺38.68)",
		minExchange: "Binance TR (₺38.64)",
		diffTry: "₺0.04",
		diffPct: "%0.10",
		status: "Normal",
		lastUpdate: "Anlık"
	},
	{
		symbol: "SOL / TRY",
		maxExchange: "BtcTurk (₺7.660)",
		minExchange: "Paribu (₺7.635)",
		diffTry: "₺25",
		diffPct: "%0.32",
		status: "Orta Makas",
		lastUpdate: "Anlık"
	}
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container data-page-container">
		<nav class="page-breadcrumb" aria-label="Gezinti">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/turkiye">Türkiye Verisi</a>
			<span>/</span>
			<span class="current">Borsa Fiyat Farkı (A2)</span>
		</nav>

		<div class="dp-header">
			<div class="dp-badges">
				<span class="badge-live"><span class="b-dot"></span> Canlı Veri</span>
				<span class="badge-tag">Arbitraj & Fiyat Makası</span>
				<span class="badge-tag">BtcTurk • Paribu • Binance TR</span>
			</div>
			<h1 class="dp-title">Borsalar Arası Fiyat Farkı & Arbitraj Makası</h1>
			<p class="dp-summary">
				Aynı kripto paranın Türk borsalarındaki anlık alış ve satış fiyatları arasındaki farkı takip edin. Komisyon ve çekim masrafları sonrası net arbitraj kârlılığını analiz edin.
			</p>
		</div>

		<div class="section-card">
			<div class="sc-head">
				<h3>Canlı Fiyat Farkı & Makas Tablosu</h3>
				<span class="sc-status">30 saniyede bir güncellenir</span>
			</div>

			<div class="table-shell">
				<table class="data-table">
					<thead>
						<tr>
							<th>İşlem Çifti</th>
							<th>En Yüksek Fiyat</th>
							<th>En Düşük Fiyat</th>
							<th>Fark (TL)</th>
							<th>Fark (%)</th>
							<th>Durum</th>
						</tr>
					</thead>
					<tbody>
						{pairs.map(p => (
							<tr>
								<td><strong>{p.symbol}</strong></td>
								<td class="font-mono">{p.maxExchange}</td>
								<td class="font-mono text-muted">{p.minExchange}</td>
								<td class="font-mono text-warning font-bold">{p.diffTry}</td>
								<td class="font-mono text-success font-bold">{p.diffPct}</td>
								<td><span class="status-tag">{p.status}</span></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

		<div class="editorial-guide-box">
			<h2>Borsalar Arası Fiyat Farkı Neden Oluşur?</h2>
			<p>
				Kripto para borsaları merkezi bir fiyattan emir eşleştirmez; her borsanın emir tahtası kendi kullanıcılarının alım ve satım teklifleriyle (order book) oluşur. Bir borsada yoğun TL girişi olduğunda alıcılar fiyatı yukarı iterken, başka bir borsada satıcı ağırlığı fiyatı aşağı çekebilir.
			</p>
			<h3>Gerçek Arbitraj Maliyetleri</h3>
			<p>
				İki borsa arasında %0.50'lik bir fiyat farkı gördüğünüzde doğrudan %0.50 net kâr elde edemezsiniz. Hesaba katılması gereken 3 temel gider kalemi vardır:
			</p>
			<ul>
				<li><strong>Borsa Alım Komisyonu:</strong> Ucuz olan borsada alış yaparken kesilen %0.05 - %0.20 borsa komisyonu.</li>
				<li><strong>Kripto Ağ Çekim Masrafı:</strong> Satın alınan kripto parayı pahalı borsaya taşırken ödenen blokzincir transfer ücreti.</li>
				<li><strong>Borsa Satış Komisyonu:</strong> Pahalı olan borsada Türk Lirası'na dönerken ödenen satış komisyonu.</li>
			</ul>
		</div>
	</div>
</Layout>

<style>
	.data-page-container {
		padding: 48px 20px 88px;
		max-width: 1040px;
	}
	.page-breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-faint);
		margin-bottom: 24px;
	}
	.page-breadcrumb a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.page-breadcrumb .current {
		color: var(--text);
		font-weight: 500;
	}
	.dp-header {
		margin-bottom: 32px;
	}
	.dp-badges {
		display: flex;
		gap: 8px;
		align-items: center;
		margin-bottom: 14px;
	}
	.badge-live {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		font-weight: 700;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 3px 8px;
		border-radius: 4px;
	}
	.b-dot {
		width: 6px;
		height: 6px;
		background: var(--primary);
		border-radius: 50%;
	}
	.badge-tag {
		font-size: 11px;
		color: var(--text-faint);
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		padding: 3px 8px;
		border-radius: 4px;
	}
	.dp-title {
		font-size: 38px;
		font-weight: 800;
		letter-spacing: -0.025em;
		color: var(--text);
		margin: 0 0 12px;
	}
	.dp-summary {
		font-size: 16px;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0;
	}
	.section-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 24px;
		margin-bottom: 36px;
	}
	.sc-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 18px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--border-subtle);
	}
	.sc-head h3 {
		font-size: 17px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}
	.sc-status {
		font-size: 11.5px;
		color: var(--text-faint);
	}
	.table-shell {
		overflow-x: auto;
	}
	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13.5px;
	}
	.data-table th {
		text-align: left;
		padding: 12px 14px;
		color: var(--text-faint);
		font-size: 11.5px;
		border-bottom: 1px solid var(--border);
		text-transform: uppercase;
	}
	.data-table td {
		padding: 12px 14px;
		border-bottom: 1px solid var(--border-subtle);
		color: var(--text);
	}
	.status-tag {
		font-size: 11px;
		color: var(--text-muted);
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		padding: 2px 7px;
		border-radius: 4px;
	}
	.editorial-guide-box {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 32px;
	}
	.editorial-guide-box h2 {
		font-size: 22px;
		font-weight: 800;
		color: var(--text);
		margin: 0 0 16px;
	}
	.editorial-guide-box h3 {
		font-size: 17px;
		font-weight: 700;
		color: var(--text);
		margin: 20px 0 10px;
	}
	.editorial-guide-box p {
		font-size: 14.5px;
		line-height: 1.65;
		color: var(--text-muted);
		margin: 0 0 14px;
	}
	.editorial-guide-box ul {
		margin: 0;
		padding-left: 20px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-muted);
	}
</style>
