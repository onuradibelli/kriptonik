---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Kripto Dönüştürücü & Canlı Fiyat Hesaplayıcı | Kriptonik";
const pageDesc = "Bitcoin, Ethereum, Solana, USDT ve diğer kripto paraları canlı piyasa kurları ile anında Türk Lirası, Dolar veya Euro'ya dönüştürün.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container tool-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/araclar">Araçlar</a>
			<span>/</span>
			<span class="current">Kripto Dönüştürücü</span>
		</nav>

		<div class="tool-header">
			<div class="badge-pill">
				<span>💱</span>
				<span>Canlı Piyasa Fiyatları</span>
			</div>
			<h1 class="tool-title">Kripto Para Dönüştürücü</h1>
			<p class="tool-subtitle">
				Kripto paralar ve itibari para birimleri (TRY, USD, EUR) arasında anlık piyasa fiyatlarıyla kesintisiz ve hassas çeviri yapın.
			</p>
		</div>

		<div class="converter-card">
			<div class="converter-inputs-grid">
				<!-- Source -->
				<div class="currency-panel">
					<label class="panel-label" for="amount-input">Miktar & Kaynak Birim</label>
					<div class="input-row">
						<input 
							type="text" 
							id="amount-input" 
							class="amount-field" 
							value="1" 
							placeholder="1,00"
							autocomplete="off"
						/>
						<select id="source-select" class="currency-select">
							<optgroup label="Popüler Kripto">
								<option value="BTC" selected>BTC - Bitcoin</option>
								<option value="ETH">ETH - Ethereum</option>
								<option value="SOL">SOL - Solana</option>
								<option value="USDT">USDT - Tether</option>
								<option value="USDC">USDC - USD Coin</option>
								<option value="BNB">BNB - Build & Build</option>
								<option value="XRP">XRP - Ripple</option>
								<option value="AVAX">AVAX - Avalanche</option>
								<option value="TRX">TRX - Tron</option>
							</optgroup>
							<optgroup label="İtibari Para">
								<option value="TRY">TRY - Türk Lirası</option>
								<option value="USD">USD - ABD Doları</option>
								<option value="EUR">EUR - Euro</option>
							</optgroup>
						</select>
					</div>
				</div>

				<!-- Swap Button -->
				<div class="swap-action-col">
					<button class="swap-btn" id="swap-currencies-btn" title="Para Birimlerini Değiştir (⇄)">
						⇄
					</button>
				</div>

				<!-- Target -->
				<div class="currency-panel">
					<label class="panel-label" for="target-select">Hedef Para Birimi</label>
					<div class="input-row">
						<div class="result-display" id="main-result">Yükleniyor...</div>
						<select id="target-select" class="currency-select">
							<optgroup label="İtibari Para">
								<option value="TRY" selected>TRY - Türk Lirası</option>
								<option value="USD">USD - ABD Doları</option>
								<option value="EUR">EUR - Euro</option>
							</optgroup>
							<optgroup label="Kripto Para">
								<option value="BTC">BTC - Bitcoin</option>
								<option value="ETH">ETH - Ethereum</option>
								<option value="SOL">SOL - Solana</option>
								<option value="USDT">USDT - Tether</option>
							</optgroup>
						</select>
					</div>
				</div>
			</div>

			<!-- Meta bar: Unit Price & 24h change & Last Update -->
			<div class="converter-meta">
				<div class="meta-item">
					<span class="meta-label">Birim Fiyat:</span>
					<span class="meta-val mono" id="unit-price-display">--</span>
				</div>
				<div class="meta-item">
					<span class="meta-label">24s Değişim:</span>
					<span class="meta-val badge" id="change-24h-display">--</span>
				</div>
				<div class="meta-item">
					<span class="meta-label">Son Güncelleme:</span>
					<span class="meta-val" id="last-update-display">Canlı</span>
				</div>
			</div>

			<!-- Multi-currency quick conversion table -->
			<div class="multi-target-box">
				<h4 class="multi-title">Çoklu Hedef Görünümü</h4>
				<div class="multi-grid" id="multi-grid">
					<div class="multi-col">
						<span class="multi-lbl">Türk Lirası (TRY)</span>
						<span class="multi-val" id="multi-try">--</span>
					</div>
					<div class="multi-col">
						<span class="multi-lbl">Amerikan Doları (USD)</span>
						<span class="multi-val" id="multi-usd">--</span>
					</div>
					<div class="multi-col">
						<span class="multi-lbl">Euro (EUR)</span>
						<span class="multi-val" id="multi-eur">--</span>
					</div>
					<div class="multi-col">
						<span class="multi-lbl">Bitcoin (BTC)</span>
						<span class="multi-val" id="multi-btc">--</span>
					</div>
				</div>
			</div>

			<!-- Common amounts reference table -->
			<div class="common-amounts-section">
				<h4 class="table-title" id="common-amounts-title">Yaygın Miktarlar Tablosu</h4>
				<div class="table-wrap">
					<table class="common-table">
						<thead>
							<tr>
								<th id="th-source">Kaynak Miktar</th>
								<th id="th-target">Hedef Değer</th>
							</tr>
						</thead>
						<tbody id="common-table-body">
							<!-- Filled dynamically -->
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- Explanatory Context Section -->
		<div class="info-content">
			<h3>Kriptonik Fiyat Hesaplama Metodolojisi</h3>
			<p>
				Kriptonik dönüştürücüsünde kullanılan fiyat verileri, global ve yerel likidite havuzlarının ağırlıklı medyanı alınarak Cloudflare Edge üzerinde önbelleklenir. Girdiğiniz tutarlar için IEEE-754 kayan nokta hatalarını engelleyen hassas ondalık aritmetiği uygulanır.
			</p>
			<p>
				Borsalarda gerçekleştireceğiniz fiili işlemlerde piyasa derinliği, alış-satış spreadi (makas farkı) ve borsa komisyonları nedeniyle elinize geçecek net tutar küçük farklılıklar gösterebilir. Alım-satım öncesinde gerçek maliyeti görmek için <a href="/araclar/maliyet-karsilastirici">USDT/TRY Borsa Maliyet Kıyaslama</a> aracımızı kullanabilirsiniz.
			</p>
		</div>
	</div>
</Layout>

<style>
.tool-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
	max-width: 900px;
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}
.tool-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.tool-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-2);
	letter-spacing: -0.02em;
}
.tool-subtitle {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	line-height: 1.6;
}

.converter-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-6);
	margin-bottom: var(--space-8);
}
.converter-inputs-grid {
	display: flex;
	align-items: center;
	gap: var(--space-4);
	margin-bottom: var(--space-6);
}
.currency-panel {
	flex: 1;
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-4);
}
.panel-label {
	display: block;
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	font-weight: 600;
	margin-bottom: var(--space-2);
}
.input-row {
	display: flex;
	gap: var(--space-3);
	align-items: center;
}
.amount-field {
	flex: 1;
	font-size: var(--text-2xl);
	font-weight: 700;
	font-family: var(--font-mono);
	background: transparent;
	border: none;
	color: var(--color-text-primary);
	outline: none;
	min-width: 100px;
}
.result-display {
	flex: 1;
	font-size: var(--text-2xl);
	font-weight: 700;
	font-family: var(--font-mono);
	color: var(--color-primary-400);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.currency-select {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	color: var(--color-text-primary);
	border-radius: var(--radius-md);
	padding: var(--space-2) var(--space-3);
	font-size: var(--text-sm);
	font-weight: 600;
	cursor: pointer;
	outline: none;
}
.swap-action-col {
	display: flex;
	align-items: center;
	justify-content: center;
}
.swap-btn {
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	color: var(--color-text-primary);
	width: 44px;
	height: 44px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: var(--text-xl);
	cursor: pointer;
	transition: all var(--transition-fast);
}
.swap-btn:hover {
	background: var(--color-primary-500);
	color: white;
	border-color: var(--color-primary-500);
	transform: rotate(180deg);
}

.converter-meta {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: var(--space-3) var(--space-4);
	background: var(--color-surface-hover);
	border-radius: var(--radius-md);
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
	margin-bottom: var(--space-6);
	flex-wrap: wrap;
	gap: var(--space-2);
}
.meta-val.mono {
	font-family: var(--font-mono);
	font-weight: 700;
	color: var(--color-text-primary);
}
.meta-val.badge {
	font-weight: 700;
	padding: 2px 6px;
	border-radius: var(--radius-sm);
}

.multi-target-box {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-4);
	margin-bottom: var(--space-6);
}
.multi-title {
	font-size: var(--text-xs);
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: var(--color-text-muted);
	margin-bottom: var(--space-3);
}
.multi-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: var(--space-3);
}
.multi-col {
	display: flex;
	flex-direction: column;
	gap: 4px;
}
.multi-lbl {
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
}
.multi-val {
	font-family: var(--font-mono);
	font-size: var(--text-sm);
	font-weight: 700;
	color: var(--color-text-primary);
}

.common-amounts-section {
	margin-top: var(--space-6);
}
.table-title {
	font-size: var(--text-sm);
	font-weight: 700;
	margin-bottom: var(--space-3);
}
.table-wrap {
	overflow-x: auto;
}
.common-table {
	width: 100%;
	border-collapse: collapse;
	font-size: var(--text-sm);
}
.common-table th, .common-table td {
	padding: var(--space-3) var(--space-4);
	border-bottom: 1px solid var(--color-border);
	text-align: left;
}
.common-table th {
	background: var(--color-surface-hover);
	color: var(--color-text-secondary);
	font-weight: 600;
	font-size: var(--text-xs);
}
.common-table td {
	font-family: var(--font-mono);
}

.info-content {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-6);
}
.info-content h3 {
	font-size: var(--text-lg);
	font-weight: 700;
	margin-bottom: var(--space-3);
}
.info-content p {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
	line-height: 1.6;
	margin-bottom: var(--space-3);
}
.info-content a {
	color: var(--color-primary-400);
}

@media (max-width: 768px) {
	.converter-inputs-grid {
		flex-direction: column;
	}
	.currency-panel {
		width: 100%;
	}
	.multi-grid {
		grid-template-columns: repeat(2, 1fr);
	}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const amountInput = document.getElementById('amount-input') as HTMLInputElement;
	const sourceSelect = document.getElementById('source-select') as HTMLSelectElement;
	const targetSelect = document.getElementById('target-select') as HTMLSelectElement;
	const swapBtn = document.getElementById('swap-currencies-btn');
	const mainResult = document.getElementById('main-result');
	const unitPriceEl = document.getElementById('unit-price-display');
	const change24hEl = document.getElementById('change-24h-display');
	const multiTry = document.getElementById('multi-try');
	const multiUsd = document.getElementById('multi-usd');
	const multiEur = document.getElementById('multi-eur');
	const multiBtc = document.getElementById('multi-btc');
	const tableBody = document.getElementById('common-table-body');
	const thSource = document.getElementById('th-source');
	const thTarget = document.getElementById('th-target');

	// Prices map (USD based reference)
	let prices: Record<string, { usd: number; change24h: number }> = {
		BTC: { usd: 88500, change24h: 2.4 },
		ETH: { usd: 3150, change24h: 1.8 },
		SOL: { usd: 195, change24h: 4.5 },
		USDT: { usd: 1.0, change24h: 0.01 },
		USDC: { usd: 1.0, change24h: -0.01 },
		BNB: { usd: 620, change24h: 0.9 },
		XRP: { usd: 1.45, change24h: 3.2 },
		AVAX: { usd: 34.5, change24h: -1.2 },
		TRX: { usd: 0.20, change24h: 0.5 },
		USD: { usd: 1.0, change24h: 0.0 },
		TRY: { usd: 1 / 36.80, change24h: -0.05 },
		EUR: { usd: 1.05, change24h: 0.1 }
	};

	async function fetchLiveRates() {
		try {
			const res = await fetch('/api/v1/market/ticker');
			if (res.ok) {
				const data = await res.json();
				if (data.rates) {
					if (data.rates.BTC) prices.BTC.usd = data.rates.BTC.usd;
					if (data.rates.ETH) prices.ETH.usd = data.rates.ETH.usd;
					if (data.rates.SOL) prices.SOL.usd = data.rates.SOL.usd;
					if (data.rates.USDT_TRY) prices.TRY.usd = 1 / data.rates.USDT_TRY.price;
				}
				recalc();
			}
		} catch (e) {
			// fallback stays active
		}
	}

	function parseNumber(str: string): number {
		if (!str) return 0;
		const clean = str.replace(/\s+/g, '').replace(',', '.');
		const n = parseFloat(clean);
		return isNaN(n) ? 0 : n;
	}

	function formatOutput(num: number, currency: string): string {
		const isFiat = ['TRY', 'USD', 'EUR'].includes(currency);
		if (num >= 1000) {
			return num.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
		} else if (num >= 1) {
			return num.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
		} else {
			return num.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: isFiat ? 2 : 8 });
		}
	}

	function recalc() {
		const amount = parseNumber(amountInput.value);
		const source = sourceSelect.value;
		const target = targetSelect.value;

		const sourceUsd = prices[source]?.usd || 1;
		const targetUsd = prices[target]?.usd || 1;

		const singleSourceInTarget = sourceUsd / targetUsd;
		const totalConverted = amount * singleSourceInTarget;

		if (mainResult) {
			mainResult.textContent = `${formatOutput(totalConverted, target)} ${target}`;
		}

		if (unitPriceEl) {
			unitPriceEl.textContent = `1 ${source} = ${formatOutput(singleSourceInTarget, target)} ${target}`;
		}

		if (change24hEl) {
			const chg = prices[source]?.change24h || 0;
			change24hEl.textContent = `${chg >= 0 ? '+' : ''}${chg.toFixed(2)}%`;
			change24hEl.style.background = chg >= 0 ? 'rgba(16, 185, 129, 0.15)' : 'rgba(239, 68, 68, 0.15)';
			change24hEl.style.color = chg >= 0 ? 'var(--color-success)' : 'var(--color-error)';
		}

		// Multi targets
		const totalUsdVal = amount * sourceUsd;
		if (multiTry) multiTry.textContent = `${formatOutput(totalUsdVal / (prices.TRY?.usd || 1), 'TRY')} ₺`;
		if (multiUsd) multiUsd.textContent = `$${formatOutput(totalUsdVal, 'USD')}`;
		if (multiEur) multiEur.textContent = `€${formatOutput(totalUsdVal / (prices.EUR?.usd || 1), 'EUR')}`;
		if (multiBtc) multiBtc.textContent = `₿${formatOutput(totalUsdVal / (prices.BTC?.usd || 1), 'BTC')}`;

		// Common amounts
		if (thSource) thSource.textContent = `${source} Miktarı`;
		if (thTarget) thTarget.textContent = `${target} Karşılığı`;

		const steps = [1, 5, 10, 50, 100, 1000];
		if (tableBody) {
			tableBody.innerHTML = steps.map(s => {
				const res = s * singleSourceInTarget;
				return `
					<tr>
						<td>${s.toLocaleString('tr-TR')} ${source}</td>
						<td><strong>${formatOutput(res, target)} ${target}</strong></td>
					</tr>
				`;
			}).join('');
		}
	}

	amountInput?.addEventListener('input', recalc);
	sourceSelect?.addEventListener('change', recalc);
	targetSelect?.addEventListener('change', recalc);

	swapBtn?.addEventListener('click', () => {
		const temp = sourceSelect.value;
		sourceSelect.value = targetSelect.value;
		targetSelect.value = temp;
		recalc();
	});

	fetchLiveRates();
	recalc();
});
</script>
