---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Kaldıraç ve Likidasyon Hesaplayıcı | Kriptonik";
const pageDesc = "Kripto vadeli işlemlerde (Futures) tahmini likidasyon fiyatınızı, marjin gereksiniminizi ve risk/kazanç oranınızı hesaplayın.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container tool-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/araclar">Araçlar</a>
			<span>/</span>
			<span class="current">Kaldıraç & Likidasyon</span>
		</nav>

		<div class="tool-header">
			<div class="badge badge-warning">
				<span>⚡</span>
				<span>Vadeli İşlem Risk Analizi</span>
			</div>
			<h1 class="tool-title">Kaldıraç ve Likidasyon Fiyatı Hesaplayıcı</h1>
			<p class="tool-subtitle">
				İzole vadeli işlemler için giriş fiyatı, teminat ve kaldıraç oranına göre tahmini likidasyon seviyenizi ve pozisyon büyüklüğünüzü belirleyin.
			</p>
		</div>

		<!-- Kalıcı Yasal Uyarı Kutusu (Section 6.10) -->
		<div class="disclaimer-banner" style="margin-bottom: 24px;">
			<strong>Önemli Risk Bildirimi:</strong> Gerçek borsa formülleri kademeli bakım teminatı (tiered MMR), fonlama oranı (funding rate) ve anlık endeks/mark fiyat kullanır. Buradaki sonuç yaklaşık bir matematiksel simülasyondur. Kaldıraçlı işlemler yatırdığınız tüm sermayeyi saniyeler içinde kaybetme riski taşır.
		</div>

		<div class="tool-card card">
			<div class="form-grid">
				<div class="form-group">
					<label class="form-label" for="pos-side">Pozisyon Yönü:</label>
					<div class="side-toggle">
						<button type="button" class="side-btn active-long" id="side-long" data-side="LONG">Long (Yükseliş)</button>
						<button type="button" class="side-btn" id="side-short" data-side="SHORT">Short (Düşüş)</button>
					</div>
				</div>

				<div class="form-group">
					<label class="form-label" for="entry-price">Giriş Fiyatı ($):</label>
					<input type="number" id="entry-price" class="form-input mono-text" value="100" step="any" />
				</div>

				<div class="form-group">
					<label class="form-label" for="leverage-input">Kaldıraç Çarpanı (1x - 125x):</label>
					<div class="range-wrap">
						<input type="number" id="leverage-input" class="form-input mono-text" value="10" min="1" max="125" />
						<input type="range" id="leverage-range" min="1" max="100" value="10" class="form-range" />
					</div>
				</div>

				<div class="form-group">
					<label class="form-label" for="margin-input">Yatırılan Teminat (Margin - $):</label>
					<input type="number" id="margin-input" class="form-input mono-text" value="1000" step="any" />
				</div>

				<div class="form-group">
					<label class="form-label" for="mmr-input">Bakım Teminatı Oranı (MMR %):</label>
					<input type="number" id="mmr-input" class="form-input mono-text" value="0.5" step="0.1" />
					<span class="text-faint" style="font-size: 11px;">Çoğu borsa için varsayılan %0.5'tir.</span>
				</div>
			</div>

			<!-- Dynamic Verdict / Result -->
			<div class="results-dashboard card" style="margin-top: 24px; background: var(--bg-sunken);">
				<div class="res-highlight">
					<span class="rh-label">Tahmini Likidasyon Fiyatı:</span>
					<span class="rh-val mono-text text-danger" id="liq-price">$90.50</span>
					<span class="rh-sub" id="liq-distance">Giriş fiyatına %9.50 mesafede</span>
				</div>

				<div class="metrics-row">
					<div class="m-item">
						<span class="m-lbl">Toplam Pozisyon Büyüklüğü:</span>
						<span class="m-v mono-text" id="notional-val">$10,000.00</span>
					</div>
					<div class="m-item">
						<span class="m-lbl">Alınan Varlık Miktarı:</span>
						<span class="m-v mono-text" id="qty-val">100.00 Adet</span>
					</div>
					<div class="m-item">
						<span class="m-lbl">Maksimum Zarar:</span>
						<span class="m-v mono-text text-danger" id="max-loss">-$1,000.00 (%100 Teminat)</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script>
	let side: 'LONG' | 'SHORT' = 'LONG';
	const sideLong = document.getElementById('side-long');
	const sideShort = document.getElementById('side-short');
	const entryInput = document.getElementById('entry-price') as HTMLInputElement;
	const levInput = document.getElementById('leverage-input') as HTMLInputElement;
	const levRange = document.getElementById('leverage-range') as HTMLInputElement;
	const marginInput = document.getElementById('margin-input') as HTMLInputElement;
	const mmrInput = document.getElementById('mmr-input') as HTMLInputElement;

	const liqPriceEl = document.getElementById('liq-price');
	const liqDistEl = document.getElementById('liq-distance');
	const notionalEl = document.getElementById('notional-val');
	const qtyEl = document.getElementById('qty-val');
	const maxLossEl = document.getElementById('max-loss');

	function calculateLiquidation() {
		if (!entryInput || !levInput || !marginInput || !mmrInput) return;

		const entry = parseFloat(entryInput.value) || 0;
		const lev = parseFloat(levInput.value) || 1;
		const margin = parseFloat(marginInput.value) || 0;
		const mmr = (parseFloat(mmrInput.value) || 0.5) / 100;

		const notional = margin * lev;
		const qty = entry > 0 ? (notional / entry) : 0;

		// Section 6.10 exact formulas
		let liq = 0;
		if (side === 'LONG') {
			liq = entry * (1 - (1 / lev) + mmr);
		} else {
			liq = entry * (1 + (1 / lev) - mmr);
		}

		if (liq < 0) liq = 0;

		const distancePct = entry > 0 ? Math.abs(((liq - entry) / entry) * 100) : 0;

		if (liqPriceEl) liqPriceEl.innerText = `$${liq.toFixed(2)}`;
		if (liqDistEl) {
			if (lev === 1 && side === 'LONG') {
				liqDistEl.innerText = "Kaldıraçsız pozisyonda likidasyon riski pratikte yoktur.";
			} else {
				liqDistEl.innerText = `Giriş fiyatına %${distancePct.toFixed(2)} mesafede`;
			}
		}
		if (notionalEl) notionalEl.innerText = `$${notional.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		if (qtyEl) qtyEl.innerText = `${qty.toFixed(4)} Adet`;
		if (maxLossEl) maxLossEl.innerText = `-$${margin.toFixed(2)} (%100 Teminat)`;
	}

	sideLong?.addEventListener('click', () => {
		side = 'LONG';
		sideLong.className = 'side-btn active-long';
		if (sideShort) sideShort.className = 'side-btn';
		calculateLiquidation();
	});

	sideShort?.addEventListener('click', () => {
		side = 'SHORT';
		sideShort.className = 'side-btn active-short';
		if (sideLong) sideLong.className = 'side-btn';
		calculateLiquidation();
	});

	levInput?.addEventListener('input', () => {
		if (levRange) levRange.value = levInput.value;
		calculateLiquidation();
	});

	levRange?.addEventListener('input', () => {
		if (levInput) levInput.value = levRange.value;
		calculateLiquidation();
	});

	entryInput?.addEventListener('input', calculateLiquidation);
	marginInput?.addEventListener('input', calculateLiquidation);
	mmrInput?.addEventListener('input', calculateLiquidation);

	calculateLiquidation();
</script>

<style>
	.tool-page {
		padding: 32px 20px 80px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-faint);
		margin-bottom: 20px;
	}

	.tool-header {
		margin-bottom: 24px;
	}

	.tool-title {
		font-size: 34px;
		font-weight: 700;
		margin: 8px 0;
	}

	.tool-subtitle {
		font-size: 16px;
		color: var(--text-muted);
		max-width: 700px;
	}

	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.side-toggle {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
	}

	.side-btn {
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		color: var(--text-muted);
		padding: 10px;
		border-radius: 8px;
		font-weight: 700;
		cursor: pointer;
		transition: all 150ms ease;
	}

	.active-long {
		background: var(--success);
		color: #fff;
		border-color: var(--success);
	}

	.active-short {
		background: var(--danger);
		color: #fff;
		border-color: var(--danger);
	}

	.range-wrap {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.form-range {
		width: 100%;
		accent-color: var(--primary);
	}

	.res-highlight {
		text-align: center;
		padding: 20px;
		border-bottom: 1px solid var(--border);
	}

	.rh-label {
		display: block;
		font-size: 13px;
		color: var(--text-muted);
		margin-bottom: 4px;
	}

	.rh-val {
		font-size: 38px;
		font-weight: 800;
		line-height: 1.1;
	}

	.rh-sub {
		display: block;
		font-size: 13px;
		color: var(--text-muted);
		margin-top: 4px;
	}

	.metrics-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 16px;
		padding: 20px;
	}

	.m-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.m-lbl {
		font-size: 12px;
		color: var(--text-muted);
	}

	.m-v {
		font-size: 16px;
		font-weight: 600;
	}

	@media (max-width: 600px) {
		.form-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
