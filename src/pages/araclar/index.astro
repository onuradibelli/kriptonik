---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Kripto Araçları Dizini (18 Problem Çözücü & Hesaplayıcı) | Kriptonik";
const pageDesc = "Üyelik istemeyen, verilerinizi kaydetmeyen ve sade Türkçe ile çalışan kripto problem çözücü ve teşhis araçları.";

const tools = [
	{
		id: "yanlis-ag",
		title: "Yanlış Ağa Gönderdim Sihirbazı",
		category: "urgent",
		categoryName: "Acil Sorun",
		slug: "/araclar/yanlis-aga-gonderdim",
		desc: "Para yanlış ağa transfer edildiğinde kurtarılabilirlik durumunu anında öğrenin, adım adım çözüm ve hazır borsa destek metnini alın.",
		icon: "alert"
	},
	{
		id: "takilan-islem",
		title: "Takılan İşlem Teşhisi (Pending)",
		category: "urgent",
		categoryName: "Acil Sorun",
		slug: "/araclar/takilan-islem",
		desc: "İşleminiz saatlerdir onaylanmıyor mu? Mempool durumunu analiz edin, RBF, CPFP veya Nonce sıfırlama ile işlemi hızlandırın.",
		icon: "clock"
	},
	{
		id: "islem-cevirmen",
		title: "İşlem Çevirmeni (Tx Translator)",
		category: "urgent",
		categoryName: "Acil Sorun",
		slug: "/araclar/islem-cevirmeni",
		desc: "Karmaşık transfer hash kodlarını ve akıllı kontrat çağrılarını sade Türkçe ile açıklar: kimden kime, ne kadar, ne yaptı?",
		icon: "file-text"
	},
	{
		id: "adres-ag",
		title: "Adres Ağ Eşleştirici & Doğrulayıcı",
		category: "security",
		categoryName: "Güvenlik",
		slug: "/araclar/adres-ag-eslestirici",
		desc: "Cüzdan adresinin formatından hangi blokzincir ağlarını desteklediğini doğrulayın, çapraz ağ kaybı riskini sıfırlayın.",
		icon: "shield"
	},
	{
		id: "guvenlik-kontrol",
		title: "Güvenlik Kontrolü (Adres / URL / Token)",
		category: "security",
		categoryName: "Güvenlik",
		slug: "/araclar/guvenlik-kontrolu",
		desc: "Şüpheli web siteleri, cüzdan adresleri ve rug-pull token kontratları için bilinen kara liste ve risk sinyalleri taraması.",
		icon: "shield-alert"
	},
	{
		id: "cuzdan-guvenlik",
		title: "Cüzdan Güvenlik Check-up'ı",
		category: "security",
		categoryName: "Güvenlik",
		slug: "/araclar/cuzdan-guvenlik-kontrolu",
		desc: "Tarayıcı üzerinde çalışan interaktif denetim listesiyle cüzdanınızın güvenlik açıklarını ve risk skorunu belirleyin.",
		icon: "lock"
	},
	{
		id: "maliyet-kiyas",
		title: "Gerçek Maliyet Karşılaştırıcı",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/maliyet-karsilastirici",
		desc: "TL ile kripto alırken veya satarken borsa komisyonu, spread ve ağ çekim ücreti dahil gerçek net maliyeti hesaplayın.",
		icon: "scale"
	},
	{
		id: "dca-sim",
		title: "DCA Geri Test Simülatörü",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/dca-simulator",
		desc: "Geçmişten bugüne düzenli Bitcoin veya Ethereum alsaydınız bugünkü portföy büyüklüğünüz, maliyetiniz ve kârınız ne olurdu?",
		icon: "trending-up"
	},
	{
		id: "kar-zarar",
		title: "Kâr / Zarar & Ortalama Maliyet",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/kar-zarar-hesaplama",
		desc: "Kademeli alımlar için ağırlıklı ortalama maliyet, kâr/zarar yüzdesi ve hedef satış fiyatı projeksiyonu.",
		icon: "calculator"
	},
	{
		id: "kaldirac",
		title: "Kaldıraç & Likidasyon Hesabı",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/kaldirac-likidasyon",
		desc: "İzole vadeli işlem pozisyonları için tahmini likidasyon fiyatı, teminat yeterliliği ve risk simülasyonu.",
		icon: "activity"
	},
	{
		id: "staking",
		title: "Staking Getiri Hesaplayıcı",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/staking-getiri",
		desc: "ETH, SOL, ATOM ve popüler proof-of-stake varlıkları için bileşik faiz ve net reel getiri hesaplayıcı.",
		icon: "percent"
	},
	{
		id: "madencilik",
		title: "Madencilik Kârlılık Hesabı",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/madencilik-karlilik",
		desc: "Hashrate, elektrik maliyeti (kWh) ve donanım tüketimi üzerinden net madencilik kârlılığını hesaplayın.",
		icon: "cpu"
	},
	{
		id: "csv-portfoy",
		title: "CSV Portföy Analizi (İstemci Taraflı)",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/csv-portfoy-analizi",
		desc: "Borsa işlem geçmişi CSV dosyanızı tarayıcınızda yerel olarak ayrıştırın; toplam hacim ve kâr/zarar özetinizi görün.",
		icon: "table"
	},
	{
		id: "donusturucu",
		title: "Kripto Para Dönüştürücü",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/kripto-donusturucu",
		desc: "Canlı piyasa kurları üzerinden 50+ kripto para ve Türk Lirası / Dolar / Euro arasında anlık dönüştürme.",
		icon: "repeat"
	},
	{
		id: "birim-cevirici",
		title: "Birim Çevirici (Wei / Gwei / Sat)",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/birim-cevirici",
		desc: "Ethereum (Wei, Gwei, Ether) ve Bitcoin (Satoshi, BTC) alt birimleri arasında hatasız ondalık çevirisi.",
		icon: "hash"
	},
	{
		id: "gas-ucret",
		title: "Gas & Ağ Ücreti Takipçisi",
		category: "market",
		categoryName: "Piyasa & Takip",
		slug: "/araclar/gas-ucret-takip",
		desc: "Ethereum, Bitcoin, Tron ve L2 ağlarındaki canlı transfer ücretleri ve haftalık en ucuz saatler ısı haritası.",
		icon: "zap"
	},
	{
		id: "depeg-monitor",
		title: "Stablecoin Depeg Monitörü",
		category: "market",
		categoryName: "Piyasa & Takip",
		slug: "/araclar/depeg-monitoru",
		desc: "USDT, USDC, DAI ve popüler sabit coinlerin 1$ çıpasından sapma oranlarını ve risk seviyelerini izleyin.",
		icon: "anchor"
	},
	{
		id: "fng-index",
		title: "Korku ve Açgözlülük Endeksi",
		category: "market",
		categoryName: "Piyasa & Takip",
		slug: "/araclar/korku-acgozluluk-endeksi",
		desc: "Kripto piyasasının anlık duyarlılık endeksi, tarihsel ortalamalar ve geçmiş döngü karşılaştırmaları.",
		icon: "bar-chart"
	},
	{
		id: "halving",
		title: "Bitcoin Halving Sayacı",
		category: "market",
		categoryName: "Piyasa & Takip",
		slug: "/araclar/bitcoin-halving",
		desc: "Sonraki Bitcoin blok yarılanması için blok yüksekliği bazlı hassas geri sayım ve blok ödülü geçmişi.",
		icon: "calendar"
	}
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container directory-page">
		<div class="dir-header">
			<div class="dir-badge">
				<span class="badge-dot"></span>
				<span>18 TAM FONKSİYONEL ARAÇ • SIFIR KAYIT</span>
			</div>
			<h1 class="dir-title">Kripto Araçları Dizini</h1>
			<p class="dir-desc">
				Üyelik istemeyen, verilerinizi sunucuya kaydetmeyen ve sade Türkçe ile çalışan kripto problem çözücü ve teşhis araç seti.
			</p>
		</div>

		<!-- Live Filter & Search Bar -->
		<div class="filter-panel">
			<div class="search-wrap">
				<svg class="s-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input type="text" id="tool-search" class="search-input" placeholder="Araç adı veya problem ara (Örn: yanlış ağ, gas, dca, maliyet, güvenlik...)" />
			</div>

			<div class="category-tabs">
				<button class="cat-tab active" data-cat="all">Tümü (18)</button>
				<button class="cat-tab" data-cat="urgent">Acil Sorunlar</button>
				<button class="cat-tab" data-cat="calc">Hesaplayıcılar</button>
				<button class="cat-tab" data-cat="security">Güvenlik</button>
				<button class="cat-tab" data-cat="market">Piyasa & Takip</button>
			</div>
		</div>

		<!-- Tools Grid -->
		<div class="tools-grid" id="tools-container">
			{tools.map(tool => (
				<a href={tool.slug} class="tool-card" data-category={tool.category} data-title={tool.title.toLowerCase()} data-desc={tool.desc.toLowerCase()}>
					<div class="tool-card-top">
						<div class="tool-icon-box">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								{tool.category === 'urgent' && <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>}
								{tool.category === 'calc' && <rect x="4" y="2" width="16" height="20" rx="2"/>}
								{tool.category === 'security' && <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>}
								{tool.category === 'market' && <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>}
							</svg>
						</div>
						<div class="tool-badges">
							<span class="category-tag">{tool.categoryName}</span>
							<span class="live-status-pill">Canlı</span>
						</div>
					</div>

					<div class="tool-card-body">
						<h3 class="tool-title">{tool.title}</h3>
						<p class="tool-desc">{tool.desc}</p>
					</div>

					<div class="tool-card-footer">
						<span class="open-action">Aracı Başlat</span>
						<span class="open-arrow">→</span>
					</div>
				</a>
			))}
		</div>
	</div>
</Layout>

<script>
	const searchInput = document.getElementById('tool-search') as HTMLInputElement;
	const catTabs = document.querySelectorAll('.cat-tab');
	const toolCards = document.querySelectorAll('.tool-card');

	let activeCategory = 'all';

	function filterTools() {
		const query = searchInput?.value.toLowerCase().trim() || '';

		toolCards.forEach(card => {
			const cardEl = card as HTMLElement;
			const cardCat = cardEl.getAttribute('data-category');
			const title = cardEl.getAttribute('data-title') || '';
			const desc = cardEl.getAttribute('data-desc') || '';

			const matchesCategory = activeCategory === 'all' || cardCat === activeCategory;
			const matchesQuery = query === '' || title.includes(query) || desc.includes(query);

			if (matchesCategory && matchesQuery) {
				cardEl.style.display = 'flex';
			} else {
				cardEl.style.display = 'none';
			}
		});
	}

	searchInput?.addEventListener('input', filterTools);

	catTabs.forEach(tab => {
		tab.addEventListener('click', () => {
			catTabs.forEach(t => t.classList.remove('active'));
			tab.classList.add('active');
			activeCategory = tab.getAttribute('data-cat') || 'all';
			filterTools();
		});
	});
</script>

<style>
	.directory-page {
		padding: 56px 20px 88px;
	}

	.dir-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 40px;
	}

	.dir-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.25);
		color: var(--primary);
		padding: 5px 14px;
		border-radius: 9999px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		margin-bottom: 20px;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		background: var(--primary);
		border-radius: 50%;
	}

	.dir-title {
		font-size: 40px;
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text);
		margin: 0 0 14px;
	}

	.dir-desc {
		font-size: 16px;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	/* Filter Panel */
	.filter-panel {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 20px;
		margin-bottom: 36px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.search-wrap {
		position: relative;
		display: flex;
		align-items: center;
	}

	.s-icon {
		position: absolute;
		left: 16px;
		color: var(--text-faint);
		pointer-events: none;
	}

	.search-input {
		width: 100%;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		color: var(--text);
		padding: 14px 18px 14px 46px;
		border-radius: 10px;
		font-size: 14.5px;
		outline: none;
		transition: border-color var(--transition-base), box-shadow var(--transition-base);
	}

	.search-input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px var(--primary-glow);
	}

	.category-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.cat-tab {
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		color: var(--text-muted);
		padding: 7px 16px;
		border-radius: 9999px;
		font-size: 13px;
		font-weight: 500;
		cursor: pointer;
		transition: all var(--transition-fast);
	}

	.cat-tab:hover {
		color: var(--text);
		border-color: var(--border-strong);
	}

	.cat-tab.active {
		background: rgba(16, 185, 129, 0.12);
		border-color: var(--primary);
		color: var(--primary);
		font-weight: 600;
	}

	/* Tools Grid */
	.tools-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 20px;
	}

	.tool-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 22px;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 16px;
		transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
	}

	.tool-card:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow-card-hover), 0 0 24px rgba(16, 185, 129, 0.04);
	}

	.tool-card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.tool-icon-box {
		width: 38px;
		height: 38px;
		border-radius: 9px;
		background: var(--bg-sunken);
		border: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--primary);
	}

	.tool-badges {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.category-tag {
		font-size: 11px;
		font-weight: 600;
		color: var(--text-faint);
		background: var(--bg-sunken);
		border: 1px solid var(--border-subtle);
		padding: 3px 8px;
		border-radius: 4px;
	}

	.live-status-pill {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		color: var(--primary);
		background: rgba(16, 185, 129, 0.12);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 2px 7px;
		border-radius: 4px;
	}

	.tool-card-body {
		flex: 1;
	}

	.tool-title {
		font-size: 16px;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 8px;
		letter-spacing: -0.01em;
		transition: color var(--transition-fast);
	}

	.tool-card:hover .tool-title {
		color: var(--primary);
	}

	.tool-desc {
		font-size: 13px;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0;
	}

	.tool-card-footer {
		padding-top: 14px;
		border-top: 1px solid var(--border-subtle);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.open-action {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--primary);
	}

	.open-arrow {
		font-size: 13px;
		color: var(--text-faint);
		transition: transform var(--transition-fast), color var(--transition-fast);
	}

	.tool-card:hover .open-arrow {
		transform: translateX(3px);
		color: var(--primary);
	}

	@media (max-width: 640px) {
		.dir-title {
			font-size: 30px;
		}
		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
