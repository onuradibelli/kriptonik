---
// src/pages/araclar/index.astro - Cockpit Saha Araçları Dizini
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import StatusPill from '../../components/ui/StatusPill.astro';

const pageTitle = "Kripto Saha Araçları Dizini | Kriptonik";
const pageDesc = "Üyelik istemeyen, verilerini kaydetmeyen ve adım adım Türkçe çalışan kripto problem çözücü ve teşhis araçları.";

// Active, fully working tools
const activeTools = [
	{
		id: "yanlis-ag",
		title: "Yanlış Ağa Gönderdim Teşhisi",
		category: "urgent",
		categoryName: "Acil Sorun",
		slug: "/araclar/yanlis-aga-gonderdim",
		desc: "Farklı ağa gönderilen token'ların kurtarılabilirlik teşhisi, cüzdan adımları ve borsa destek mesaj şablonu.",
		icon: "alert-triangle",
		status: "live" as const,
		dataFlow: "client" as const
	},
	{
		id: "takilan-islem",
		title: "Takılan İşlem Teşhisi (Pending)",
		category: "urgent",
		categoryName: "Acil Sorun",
		slug: "/araclar/takilan-islem",
		desc: "Mempool kuyruğundaki bekleyen işlemleri sorgula, RBF ve Nonce hızlandırma çözümlerini gör.",
		icon: "activity",
		status: "live" as const,
		dataFlow: "server" as const
	},
	{
		id: "islem-cevirmen",
		title: "İşlem Çevirmeni (Tx Translator)",
		category: "urgent",
		categoryName: "Acil Sorun",
		slug: "/araclar/islem-cevirmeni",
		desc: "Karmaşık transfer hash kodlarını ve akıllı sözleşme çağrılarını sade Türkçe ile açıklar.",
		icon: "file-text",
		status: "beta" as const,
		dataFlow: "server" as const
	},
	{
		id: "adres-ag",
		title: "Adres ve Ağ Format Denetimi",
		category: "security",
		categoryName: "Güvenlik",
		slug: "/araclar/adres-ag-eslestirici",
		desc: "Gönderim öncesi EVM, Tron, Bitcoin, Solana adres checksum ve ağ uyumluluk kontrolü.",
		icon: "shield-check",
		status: "live" as const,
		dataFlow: "client" as const
	},
	{
		id: "cuzdan-guvenlik",
		title: "Cüzdan Güvenlik Denetimi",
		category: "security",
		categoryName: "Güvenlik",
		slug: "/araclar/cuzdan-guvenlik-kontrolu",
		desc: "Allowance akıllı sözleşme izinleri, seed saklama alışkanlıkları ve phishing açıklarını tara.",
		icon: "lock",
		status: "live" as const,
		dataFlow: "client" as const
	},
	{
		id: "maliyet-kiyas",
		title: "Gerçek Maliyet Karşılaştırıcı",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/maliyet-karsilastirici",
		desc: "Komisyon, kur makası ve ağ çekim ücretini toplayarak en düşük maliyetli borsa rotasını belirle.",
		icon: "layers",
		status: "live" as const,
		dataFlow: "client" as const
	},
	{
		id: "dca-sim",
		title: "DCA Simülatörü",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/dca-simulator",
		desc: "Belirli aralıklarla yapılan düzenli kripto alımlarının geçmiş kâr/zarar ve maliyet performansını test et.",
		icon: "refresh",
		status: "live" as const,
		dataFlow: "client" as const
	},
	{
		id: "kar-zarar",
		title: "Kâr / Zarar & Ortalama Maliyet",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/kar-zarar-hesaplama",
		desc: "Kademeli alımlar için ağırlıklı ortalama maliyet, kâr/zarar yüzdesi ve hedef satış fiyatı projeksiyonu.",
		icon: "calculator",
		status: "live" as const,
		dataFlow: "client" as const
	},
	{
		id: "kaldirac",
		title: "Kaldıraç & Likidasyon Hesabı",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/kaldirac-likidasyon",
		desc: "İzole vadeli işlem pozisyonları için tahmini likidasyon fiyatı, teminat yeterliliği ve risk simülasyonu.",
		icon: "activity",
		status: "live" as const,
		dataFlow: "client" as const
	},
	{
		id: "kripto-donusturucu",
		title: "Kripto & Döviz Dönüştürücü",
		category: "calc",
		categoryName: "Hesaplayıcı",
		slug: "/araclar/kripto-donusturucu",
		desc: "250+ kripto para ve Türk Lirası arasında anlık piyasa fiyatlarıyla çift yönlü çeviri yap.",
		icon: "refresh",
		status: "live" as const,
		dataFlow: "server" as const
	},
	{
		id: "gas-ucret-takip",
		title: "Gas & Ağ Ücreti Takipçisi",
		category: "market",
		categoryName: "Piyasa",
		slug: "/araclar/gas-ucret-takip",
		desc: "Ethereum, Arbitrum, Polygon ve BNB Chain için anlık gwei ve transfer maliyeti izleme.",
		icon: "activity",
		status: "live" as const,
		dataFlow: "server" as const
	},
	{
		id: "depeg-monitoru",
		title: "Stablecoin Depeg Monitörü",
		category: "market",
		categoryName: "Piyasa",
		slug: "/araclar/depeg-monitoru",
		desc: "USDT, USDC, DAI ve diğer stablecoin'lerin 1.00$ paritesinden sapmalarını anlık takip et.",
		icon: "alert-triangle",
		status: "live" as const,
		dataFlow: "server" as const
	}
];

// Inactive / Coming soon tools (kept honest, separate)
const upcomingTools = [
	{
		title: "Madencilik Kârlılık Hesabı",
		desc: "Elektrik maliyeti, hashrate ve zorluk derecesine göre ASIC/GPU kârlılık simülatörü.",
		slug: "/araclar/madencilik-karlilik",
		icon: "cpu"
	},
	{
		title: "CSV Portföy & Vergi Analizi",
		desc: "Borsa işlem geçmişi CSV dosyalarını yerel olarak ayrıştırarak FIFO kâr/zarar dökümü çıkarma.",
		slug: "/araclar/csv-portfoy-analizi",
		icon: "file-text"
	},
	{
		title: "Birim Çevirici (Satoshi, Gwei, Wei)",
		desc: "Blokzincir hassas matematik birimleri arasında sıfır yuvarlama hatasıyla çevrim.",
		slug: "/araclar/birim-cevirici",
		icon: "layers"
	},
	{
		title: "Bitcoin Halving Geri Sayımı",
		desc: "Blok yüksekliği ve ortalama blok süresine dayalı teknik halving takvimi.",
		slug: "/araclar/bitcoin-halving",
		icon: "clock"
	}
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="cockpit-tools-page">
		<!-- Page Header -->
		<header class="tools-directory-head">
			<div class="dir-badge">
				<Icon name="shield-check" size={13} />
				<span>SIFIR KAYIT • AÇIK KAYNAK • 12 CANLI MODÜL</span>
			</div>
			<h1 class="dir-title">Saha Araçları Dizini</h1>
			<p class="dir-desc">
				Kripto işlemlerinde hata payını azaltan bağımsız araçlar. İhtiyacına uygun modülü filtrele veya doğrudan aramaya başla.
			</p>
		</header>

		<!-- Filter Chips & Search Bar -->
		<div class="directory-toolbar">
			<div class="filter-chips" role="tablist" aria-label="Araç Kategorileri">
				<button type="button" class="chip active" data-filter="all">Tümü ({activeTools.length})</button>
				<button type="button" class="chip" data-filter="urgent">Acil Sorunlar</button>
				<button type="button" class="chip" data-filter="security">Güvenlik & Denetim</button>
				<button type="button" class="chip" data-filter="calc">Hesaplayıcılar</button>
				<button type="button" class="chip" data-filter="market">Piyasa & İzleme</button>
			</div>

			<div class="filter-search-wrap">
				<Icon name="search" size={15} class="search-ico" />
				<input
					type="text"
					id="tools-filter-input"
					placeholder="Araç adı veya sorun ara..."
					autocomplete="off"
				/>
			</div>
		</div>

		<!-- Active Tools Grid -->
		<section class="active-tools-section" aria-label="Canlı Saha Araçları">
			<div class="tools-grid" id="tools-grid">
				{activeTools.map(tool => (
					<a href={tool.slug} class="tool-card" data-category={tool.category} data-name={tool.title.toLowerCase()} data-desc={tool.desc.toLowerCase()}>
						<div class="card-head">
							<div class="tool-icon-box">
								<Icon name={tool.icon} size={18} />
							</div>
							<div class="card-pills">
								<StatusPill status={tool.status} label={tool.status === 'live' ? 'Canlı' : 'Beta'} />
								<StatusPill dataFlow={tool.dataFlow} />
							</div>
						</div>
						<div class="card-content">
							<strong class="tool-card-title">{tool.title}</strong>
							<p class="tool-card-desc">{tool.desc}</p>
						</div>
						<div class="card-footer">
							<span class="open-label">Aracı Başlat</span>
							<Icon name="chevron-right" size={14} />
						</div>
					</a>
				))}
			</div>
			<div id="no-tools-found" class="no-results-box" style="display: none;">
				<Icon name="help" size={24} />
				<p>Aramana uygun bir araç bulunamadı.</p>
				<button type="button" class="reset-filter-btn" id="reset-filter-btn">Tüm Araçları Göster</button>
			</div>
		</section>

		<!-- Upcoming Tools Section (Transparent & Honest) -->
		<section class="upcoming-tools-section" aria-label="Geliştirme Aşamasındaki Araçlar">
			<div class="upcoming-head">
				<div>
					<span class="upcoming-tag">YAKINDA</span>
					<h2 class="upcoming-title">Geliştirilmekte Olan Modüller</h2>
					<p class="upcoming-desc">Henüz canlı veriye bağlanmamış veya doğrulama testleri devam eden araçlar.</p>
				</div>
			</div>

			<div class="upcoming-grid">
				{upcomingTools.map(tool => (
					<div class="upcoming-card">
						<div class="card-head">
							<div class="tool-icon-box muted">
								<Icon name={tool.icon} size={18} />
							</div>
							<StatusPill type="soon" label="Yakında" />
						</div>
						<div class="card-content">
							<strong class="tool-card-title">{tool.title}</strong>
							<p class="tool-card-desc">{tool.desc}</p>
						</div>
						<div class="upcoming-footer">
							<span class="dev-note">Test Sürecinde</span>
						</div>
					</div>
				))}
			</div>
		</section>
	</div>
</Layout>

<script>
	function setupToolsDirectory() {
		const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
		const input = document.getElementById('tools-filter-input') as HTMLInputElement | null;
		const cards = document.querySelectorAll<HTMLAnchorElement>('#tools-grid .tool-card');
		const noResults = document.getElementById('no-tools-found');
		const resetBtn = document.getElementById('reset-filter-btn');

		let activeCat = 'all';

		function filterTools() {
			const query = (input?.value || '').trim().toLowerCase();
			let visibleCount = 0;

			cards.forEach(card => {
				const cat = card.getAttribute('data-category');
				const name = card.getAttribute('data-name') || '';
				const desc = card.getAttribute('data-desc') || '';

				const matchesCat = activeCat === 'all' || cat === activeCat;
				const matchesQuery = !query || name.includes(query) || desc.includes(query);

				if (matchesCat && matchesQuery) {
					card.style.display = 'flex';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			if (noResults) {
				noResults.style.display = visibleCount === 0 ? 'flex' : 'none';
			}
		}

		chips.forEach(chip => {
			chip.addEventListener('click', () => {
				chips.forEach(c => c.classList.remove('active'));
				chip.classList.add('active');
				activeCat = chip.getAttribute('data-filter') || 'all';
				filterTools();
			});
		});

		input?.addEventListener('input', filterTools);

		resetBtn?.addEventListener('click', () => {
			if (input) input.value = '';
			chips.forEach(c => c.classList.remove('active'));
			chips[0]?.classList.add('active');
			activeCat = 'all';
			filterTools();
		});
	}

	setupToolsDirectory();
	document.addEventListener('astro:after-swap', setupToolsDirectory);
</script>

<style>
	.cockpit-tools-page {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 32px 24px 60px;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.tools-directory-head {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.dir-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		color: var(--signal);
		width: max-content;
	}

	.dir-title {
		font-family: var(--font-display);
		font-size: clamp(26px, 4vw, 36px);
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.dir-desc {
		font-size: 15px;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0;
		max-width: 680px;
	}

	/* Toolbar */
	.directory-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.filter-chips {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
	}

	.chip {
		height: 34px;
		padding: 0 14px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--text-subtle);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		cursor: pointer;
		transition: all var(--duration-fast) var(--ease-standard);
	}

	.chip:hover {
		background: var(--surface-hover);
		color: var(--text);
	}

	.chip.active {
		background: var(--signal);
		color: #14110F;
		border-color: var(--signal);
		font-weight: 700;
	}

	.filter-search-wrap {
		position: relative;
		min-width: 260px;
		flex: 1;
		max-width: 360px;
	}

	.search-ico {
		position: absolute;
		left: 12px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-subtle);
		pointer-events: none;
	}

	.filter-search-wrap input {
		width: 100%;
		height: 34px;
		padding: 0 12px 0 36px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 13px;
		outline: none;
		transition: border-color var(--duration-fast) var(--ease-standard);
	}

	.filter-search-wrap input:focus {
		border-color: var(--signal);
	}

	/* Tools Grid */
	.tools-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.tool-card {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		text-decoration: none;
		color: var(--text);
		transition: all var(--duration-fast) var(--ease-standard);
	}

	.tool-card:hover {
		background: var(--surface-hover);
		border-color: var(--line-strong);
		transform: translateY(-2px);
		box-shadow: var(--shadow-sm);
	}

	.card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.tool-icon-box {
		width: 34px;
		height: 34px;
		border-radius: var(--radius-sm);
		background: var(--bg);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--signal);
	}

	.tool-icon-box.muted {
		color: var(--text-subtle);
	}

	.card-pills {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
	}

	.card-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.tool-card-title {
		font-size: 15px;
		font-weight: 700;
		color: var(--text);
	}

	.tool-card-desc {
		font-size: 13px;
		line-height: 1.45;
		color: var(--text-muted);
		margin: 0;
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 12px;
		border-top: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		color: var(--signal);
	}

	.no-results-box {
		padding: 48px 24px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		color: var(--text-subtle);
	}

	.reset-filter-btn {
		height: 32px;
		padding: 0 14px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--signal);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		cursor: pointer;
	}

	/* Upcoming Section */
	.upcoming-tools-section {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}

	.upcoming-tag {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--text-subtle);
		display: block;
		margin-bottom: 4px;
	}

	.upcoming-title {
		font-family: var(--font-display);
		font-size: 20px;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 4px 0;
	}

	.upcoming-desc {
		font-size: 13px;
		color: var(--text-muted);
		margin: 0;
	}

	.upcoming-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
	}

	.upcoming-card {
		background: var(--surface);
		border: 1px dashed var(--line);
		border-radius: var(--radius-md);
		padding: 18px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		opacity: 0.8;
	}

	.upcoming-footer {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding-top: 10px;
		border-top: 1px solid var(--line);
	}

	.dev-note {
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--text-subtle);
	}

	@media (max-width: 1024px) {
		.tools-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.upcoming-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.tools-grid {
			grid-template-columns: 1fr;
		}
		.upcoming-grid {
			grid-template-columns: 1fr;
		}
		.directory-toolbar {
			flex-direction: column;
			align-items: stretch;
		}
		.filter-search-wrap {
			max-width: 100%;
		}
	}
</style>
