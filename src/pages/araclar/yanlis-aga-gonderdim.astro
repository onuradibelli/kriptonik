---
// src/pages/araclar/yanlis-aga-gonderdim.astro - Yanlış Ağa Gönderdim Cockpit Teşhis Aracı
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import StatusPill from '../../components/ui/StatusPill.astro';
import Callout from '../../components/ui/Callout.astro';

const pageTitle = "Yanlış Ağa Gönderdim Teşhisi | Kriptonik";
const pageDesc = "Kripto paran yanlış ağa mı gitti? Kurtarılabilirlik durumunu saniyeler içinde öğren, adım adım çözüm yönergelerini ve borsa destek mesaj şablonunu al.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="cockpit-tool-container">
		<!-- Breadcrumb & Telemetry Header -->
		<div class="tool-meta-bar">
			<nav class="cockpit-breadcrumb" aria-label="Gezinti">
				<a href="/">Ana Sayfa</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<a href="/araclar">Araçlar</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<span class="crumb-current">Yanlış Ağa Gönderdim</span>
			</nav>

			<div class="tool-badges-row">
				<StatusPill status="live" label="Canlı" />
				<StatusPill dataFlow="client" />
			</div>
		</div>

		<!-- Tool Header -->
		<div class="tool-intro-box">
			<div class="tool-title-row">
				<div class="tool-icon-square">
					<Icon name="alert-triangle" size={24} />
				</div>
				<div>
					<h1 class="tool-heading">Yanlış Ağa Gönderdim Teşhisi</h1>
					<p class="tool-subheading">
						Para farklı bir ağa transfer edildiğinde panik yapma. Varlıklarının nerede beklediğini, kurtarılabilirlik ihtimalini ve atman gereken adımları teşhis et.
					</p>
				</div>
			</div>

			<!-- Mandatory Permanent Scam Alert Callout -->
			<div class="scam-mandatory-callout" role="alert">
				<div class="scam-callout-icon">
					<Icon name="alert-triangle" size={20} />
				</div>
				<div class="scam-callout-content">
					<strong>DİKKAT: KURTARMA DOLANDIRICILARINA KARŞI UYANIK OL</strong>
					<p>
						Sana "kayıp kriptonu kurtarırım" diyen herkes dolandırıcıdır. Kriptonik hiçbir zaman ücret, private key veya seed phrase (gizli kelime) istemez. Özel anahtarını kimseyle paylaşma.
					</p>
				</div>
			</div>
		</div>

		<!-- Cockpit 2-Column Grid -->
		<div class="cockpit-tool-grid">
			<!-- Left / Main Column: Diagnostic Form & Output -->
			<div class="tool-main-col">
				<div class="cockpit-panel">
					<div class="panel-header">
						<div class="panel-title-wrap">
							<span class="panel-step-num">01</span>
							<h2 class="panel-title">Transfer Detaylarını Seç</h2>
						</div>
						<span class="panel-privacy-badge">
							<Icon name="shield-check" size={13} />
							<span>Tarayıcında hesaplanır</span>
						</span>
					</div>

					<div class="form-cockpit-grid">
						<div class="input-block">
							<label class="cockpit-label" for="coin">Gönderdiğin Kripto Para:</label>
							<select id="coin" class="cockpit-select">
								<option value="USDT" selected>USDT (Tether USD)</option>
								<option value="USDC">USDC (USD Coin)</option>
								<option value="ETH">ETH (Ethereum)</option>
								<option value="BNB">BNB (Binance Coin)</option>
								<option value="BTC">BTC (Bitcoin)</option>
								<option value="MATIC">POL / MATIC (Polygon)</option>
								<option value="AVAX">AVAX (Avalanche)</option>
								<option value="SOL">SOL (Solana)</option>
							</select>
						</div>

						<div class="input-block">
							<label class="cockpit-label" for="network">Gönderim Yapılan Ağ (Kaynak / Çıkış Ağı):</label>
							<select id="network" class="cockpit-select">
								<option value="BEP20" selected>BNB Smart Chain (BEP-20 / BSC)</option>
								<option value="ERC20">Ethereum Mainnet (ERC-20)</option>
								<option value="TRC20">Tron Ağı (TRC-20)</option>
								<option value="ARBITRUM">Arbitrum One</option>
								<option value="POLYGON">Polygon PoS</option>
								<option value="OPTIMISM">Optimism (OP Mainnet)</option>
								<option value="AVAXC">Avalanche C-Chain</option>
								<option value="SOLANA">Solana Ağı</option>
								<option value="BTC_LEGACY">Bitcoin Ağı</option>
							</select>
						</div>

						<div class="input-block">
							<label class="cockpit-label" for="destination">Alıcı Cüzdan Türü (Nereye Gönderdin?):</label>
							<select id="destination" class="cockpit-select">
								<option value="PERSONAL" selected>Kişisel Cüzdanın (MetaMask, Trust Wallet, Rabby, Phantom vb.)</option>
								<option value="EXCHANGE_GLOBAL">Küresel Borsa (Binance, Gate.io, MEXC, OKX, KuCoin vb.)</option>
								<option value="EXCHANGE_LOCAL">Türk Borsası (BtcTurk, Paribu, Binance TR vb.)</option>
								<option value="UNKNOWN">Emin Değilim</option>
							</select>
						</div>

						<div class="input-block">
							<label class="cockpit-label" for="exchange-name">Alıcı Borsa Adı (Borsa ise):</label>
							<input type="text" id="exchange-name" class="cockpit-input" placeholder="Örn: BtcTurk, Paribu, Binance" value="BtcTurk" />
						</div>

						<div class="input-block full-width">
							<label class="cockpit-label" for="txhash">İşlem Kodu (TXID / Hash) — İsteğe Bağlı:</label>
							<input type="text" id="txhash" class="cockpit-input font-mono" placeholder="0x... veya işlem hash kodu" />
							<span class="field-hint">İşlem hash'i destek talebi oluştururken şablona otomatik eklenir; sunucuya iletilmez.</span>
						</div>
					</div>
				</div>

				<!-- Teşhis Sonuç Kartı -->
				<div class="result-cockpit-panel" id="verdict-container">
					<div class="result-header">
						<div class="result-status-wrap">
							<div class="result-status-badge" id="verdict-badge">
								<span id="verdict-status-title">TEŞHİS YAPILIYOR...</span>
							</div>
							<span class="score-badge" id="score-pill">Kurtarılabilirlik: Yüksek</span>
						</div>
					</div>

					<div class="result-body">
						<div class="result-summary" id="verdict-summary"></div>

						<!-- Step by Step Checklist -->
						<div class="checklist-box" id="action-steps">
							<h3 class="checklist-title">
								<Icon name="check" size={16} />
								<span>Adım Adım Çözüm Kontrol Listesi:</span>
							</h3>
							<ol class="checklist-items" id="steps-list"></ol>
						</div>

						<!-- Support Ticket Generator -->
						<div class="support-ticket-box" id="support-ticket-box">
							<div class="ticket-top">
								<span class="ticket-heading">Borsaya İletebileceğin Hazır Destek Metni:</span>
								<button type="button" class="cockpit-copy-btn" id="copy-ticket-btn">
									<Icon name="copy" size={13} />
									<span id="copy-btn-text">Kopyala</span>
								</button>
							</div>
							<pre class="ticket-pre font-mono" id="ticket-text"></pre>
						</div>
					</div>
				</div>
			</div>

			<!-- Right / Side Column: Specs & Transparency -->
			<aside class="tool-side-col">
				<!-- How it works card -->
				<div class="cockpit-side-card">
					<div class="side-card-head">
						<Icon name="help" size={16} />
						<h3>Bu Teşhis Nasıl Çalışır?</h3>
					</div>
					<p class="side-text">
						EVM (Ethereum Virtual Machine) uyumlu ağlar (Ethereum, BNB Chain, Polygon, Arbitrum) aynı özel anahtar ve adres matematiksel algoritmasını kullanır. MetaMask veya kişisel cüzdana gönderdiğin fonlar kaybolmaz; aynı adresin diğer ağdaki kopyasında bekler.
					</p>
					<p class="side-text">
						Merkezi borsalarda ise özel anahtarlar borsadadır. Borsa o token'ı o ağda listelemiyorsa, teknik ekibin fonları manuel iade prosedürüyle kurtarması gerekir.
					</p>
				</div>

				<!-- Sınırları & Uyarılar -->
				<div class="cockpit-side-card">
					<div class="side-card-head">
						<Icon name="alert-triangle" size={16} />
						<h3>Teşhisin Sınırları</h3>
					</div>
					<ul class="side-checklist">
						<li>Bitcoin adresine gönderilen Ethereum gibi farklı mimariler çapraz kurtarılamaz.</li>
						<li>Kriptonik paranı doğrudan geri alamaz; blokzincirde merkezi geri alma tuşu yoktur.</li>
						<li>Borsaların hatalı yatırma iade politikaları ve işlem ücretleri borsa inisiyatifindedir.</li>
					</ul>
				</div>

				<!-- Veri Akışı Şeffaflığı -->
				<div class="cockpit-side-card">
					<div class="side-card-head">
						<Icon name="shield-check" size={16} />
						<h3>Veri Akışı Taahhüdü</h3>
					</div>
					<p class="side-text">
						Bu sayfada seçtiğin seçenekler ve girdiğin TXID kodu hiçbir sunucuya iletilmez. Tüm teşhis tamamen tarayıcının belleğinde gerçekleşir.
					</p>
					<a href="/rehber/usdt-yanlis-ag" class="side-link">
						<span>İlgili Rehber: USDT Yanlış Ağ Kurtarma →</span>
					</a>
				</div>
			</aside>
		</div>
	</div>
</Layout>

<script>
	const coinInput = document.getElementById('coin') as HTMLSelectElement | null;
	const netInput = document.getElementById('network') as HTMLSelectElement | null;
	const destInput = document.getElementById('destination') as HTMLSelectElement | null;
	const exchInput = document.getElementById('exchange-name') as HTMLInputElement | null;
	const txInput = document.getElementById('txhash') as HTMLInputElement | null;

	const verdictBadge = document.getElementById('verdict-badge');
	const scorePill = document.getElementById('score-pill');
	const verdictSummary = document.getElementById('verdict-summary');
	const stepsList = document.getElementById('steps-list');
	const supportTicketBox = document.getElementById('support-ticket-box');
	const ticketText = document.getElementById('ticket-text');
	const copyTicketBtn = document.getElementById('copy-ticket-btn');
	const copyBtnText = document.getElementById('copy-btn-text');

	function calculateVerdict() {
		if (!coinInput || !netInput || !destInput || !verdictBadge || !scorePill || !verdictSummary || !stepsList || !supportTicketBox || !ticketText) return;

		const coin = coinInput.value;
		const net = netInput.value;
		const dest = destInput.value;
		const exchName = (exchInput?.value || '').trim() || 'İlgili Borsa';
		const txHash = (txInput?.value || '').trim() || '[BURAYA_TXID_KODUNU_YAZ]';

		const isEVMNetwork = ['ERC20', 'BEP20', 'ARBITRUM', 'POLYGON', 'OPTIMISM', 'AVAXC'].includes(net);

		if (dest === 'PERSONAL') {
			supportTicketBox.style.display = 'none';

			if (isEVMNetwork) {
				verdictBadge.className = 'result-status-badge badge-ok';
				verdictBadge.innerHTML = `<span>YÜKSEK KURTARILABİLİRLİK (ÖZEL ANAHTAR SENDE)</span>`;
				scorePill.className = 'score-badge score-ok';
				scorePill.innerText = 'Kontrol Sende';

				verdictSummary.innerHTML = `
					<p><strong>İyi Haber:</strong> Gönderdiğin adres kişisel cüzdanına ait olduğu için özel anahtar (Private Key / Seed Phrase) kontrolü tamamen sendedir. EVM uyumlu ağlarda adresler ortaktır, dolayısıyla <strong>paran kaybolmadı</strong>; aynı adresin <strong>${net}</strong> ağındaki katmanında bekliyor.</p>
				`;

				stepsList.innerHTML = `
					<li><strong>Ağı Cüzdanına Ekle:</strong> MetaMask, Trust Wallet veya Rabby cüzdanını aç. Ağ seçici listesinden <strong>${net}</strong> ağını seç veya Chainlist.org üzerinden ağı ekle.</li>
					<li><strong>Doğru Hesapta Olduğunu Doğrula:</strong> Transferi yaptığın cüzdan adresinin seçili olduğundan emin ol.</li>
					<li><strong>Token'ı Cüzdana Tanıt:</strong> Cüzdanda <em>"Tokenleri İçe Aktar (Import Tokens)"</em> butonuna tıkla ve resmi <strong>${coin}</strong> (${net}) akıllı sözleşme adresini yapıştır.</li>
					<li><strong>Sonuç:</strong> Bakiyen cüzdanında görünecektir. Artık fonlarını istediğin doğru ağa transfer edebilirsin.</li>
				`;
			} else {
				verdictBadge.className = 'result-status-badge badge-warn';
				verdictBadge.innerHTML = `<span>ÖZEL YÖNTEM GEREKTİRİR (${net})</span>`;
				scorePill.className = 'score-badge score-warn';
				scorePill.innerText = 'Teknik Adım Gerekli';

				verdictSummary.innerHTML = `
					<p>Gönderim yaptığın ağ (<strong>${net}</strong>), standart EVM adreslerinden farklı bir kriptografik altyapı kullanır. Cüzdanının bu ağı destekleyen bir yazılıma aktarılması gerekebilir.</p>
				`;

				stepsList.innerHTML = `
					<li>Kişisel cüzdanının 12 kelimelik gizli kurtarma ifadesini (Seed Phrase) güvenli ve resmi bir çoklu zincir cüzdanına (örneğin Trust Wallet veya SafePal) gir.</li>
					<li>Cüzdan içinde <strong>${net}</strong> ağını aktif hale getir ve <strong>${coin}</strong> bakiyesini kontrol et.</li>
					<li><strong>UYARI:</strong> Seed phrase kelimelerini asla internet sitelerine veya Telegram'daki şahıslara girme.</li>
				`;
			}
		} else if (dest === 'EXCHANGE_LOCAL' || dest === 'EXCHANGE_GLOBAL') {
			supportTicketBox.style.display = 'block';

			verdictBadge.className = 'result-status-badge badge-warn';
			verdictBadge.innerHTML = `<span>BORSA MÜDAHALESİ GEREKİYOR (${exchName})</span>`;
			scorePill.className = 'score-badge score-warn';
			scorePill.innerText = 'Borsa Destekli Kurtarma';

			verdictSummary.innerHTML = `
				<p>Transfer bir borsaya (<strong>${exchName}</strong>) yapıldığı için adresin özel anahtarı borsa yönetimindedir. Borsa bu coini bu ağda listelemiyorsa işlem otomatik tamamlanmaz; ancak borsa teknik ekibi fonları iade etme yetkisine sahiptir.</p>
			`;

			stepsList.innerHTML = `
				<li><strong>${exchName} Destek Merkezine Git:</strong> Borsanın resmi mobil uygulamasından veya web sitesinden Canlı Destek / Destek Talebi bölümünü aç.</li>
				<li><strong>"Hatalı Yatırma İadesi" Başvurusu Yap:</strong> Aşağıdaki hazır şablonu kopyalayarak destek personeline ilet.</li>
				<li><strong>İşlem Ücretini Kabul Et:</strong> Çoğu borsa hatalı ağ iadeleri için 30-50 USDT arası teknik işlem ücreti talep edebilir. Bu ücret resmi borsa arayüzünden ödenir, asla harici cüzdana para gönderme.</li>
			`;

			ticketText.textContent = `Sayın ${exchName} Destek Ekibi,

Hesabıma yapmış olduğum kripto para transferinde sehven hatalı ağ seçimi gerçekleştirdim. Detaylar aşağıdadır:

- Gönderilen Kripto Para: ${coin}
- Kullanılan Ağ: ${net}
- Alıcı Yatırma Adresim: [HESABINIZDAKİ_YATIRMA_ADRESİNİZİ_YAZIN]
- İşlem TXID / Hash: ${txHash}
- Tarih / Saat: ${new Date().toLocaleDateString('tr-TR')}

Fonların borsa cüzdanınıza ulaştığı blokzincir gezgininde doğrulanmaktadır. Gerekli teknik incelemenin yapılarak, borsanızın Hatalı Yatırma / İade prosedürü kapsamında işlemin kaynak cüzdanıma iade edilmesini saygılarımla arz ederim.`;
		} else {
			supportTicketBox.style.display = 'none';
			verdictBadge.className = 'result-status-badge badge-info';
			verdictBadge.innerHTML = `<span>HEDEF TÜRÜNÜ SEÇİNİZ</span>`;
			scorePill.className = 'score-badge score-info';
			scorePill.innerText = 'Seçim Bekleniyor';
			verdictSummary.innerHTML = `<p>Lütfen alıcı cüzdan türünü yukarıdaki formdan belirle.</p>`;
			stepsList.innerHTML = ``;
		}
	}

	[coinInput, netInput, destInput, exchInput, txInput].forEach(el => {
		el?.addEventListener('change', calculateVerdict);
		el?.addEventListener('input', calculateVerdict);
	});

	copyTicketBtn?.addEventListener('click', async () => {
		if (!ticketText || !copyBtnText) return;
		try {
			await navigator.clipboard.writeText(ticketText.textContent || '');
			copyBtnText.textContent = 'Kopyalandı!';
			setTimeout(() => {
				copyBtnText.textContent = 'Kopyala';
			}, 2000);
		} catch {
			// fallback
		}
	});

	calculateVerdict();
	document.addEventListener('astro:after-swap', calculateVerdict);
</script>

<style>
	.cockpit-tool-container {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 24px 24px 60px;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	/* Meta bar */
	.tool-meta-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.cockpit-breadcrumb {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.cockpit-breadcrumb a {
		color: var(--text-subtle);
		text-decoration: none;
	}

	.cockpit-breadcrumb a:hover {
		color: var(--text);
	}

	.crumb-sep {
		color: var(--line);
	}

	.crumb-current {
		color: var(--text);
		font-weight: 600;
	}

	.tool-badges-row {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	/* Header Intro */
	.tool-intro-box {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.tool-title-row {
		display: flex;
		align-items: flex-start;
		gap: 16px;
	}

	.tool-icon-square {
		width: 48px;
		height: 48px;
		border-radius: var(--radius-sm);
		background: var(--surface);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--signal);
		flex-shrink: 0;
	}

	.tool-heading {
		font-family: var(--font-display);
		font-size: clamp(24px, 3.5vw, 32px);
		font-weight: 700;
		color: var(--text);
		margin: 0 0 6px 0;
		line-height: 1.15;
	}

	.tool-subheading {
		font-size: 14px;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0;
		max-width: 760px;
	}

	/* Mandatory Scam Alert Callout */
	.scam-mandatory-callout {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding: 16px 20px;
		background: rgba(255, 77, 94, 0.08);
		border: 1px solid rgba(255, 77, 94, 0.35);
		border-radius: var(--radius-md);
		color: var(--danger);
	}

	.scam-callout-icon {
		margin-top: 2px;
		flex-shrink: 0;
	}

	.scam-callout-content {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.scam-callout-content strong {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.05em;
	}

	.scam-callout-content p {
		font-size: 13px;
		line-height: 1.45;
		color: var(--text-muted);
		margin: 0;
	}

	/* Cockpit 2-col Grid */
	.cockpit-tool-grid {
		display: grid;
		grid-template-columns: 1.7fr 1fr;
		gap: 28px;
		align-items: start;
	}

	.tool-main-col {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.cockpit-panel {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.panel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--line);
		padding-bottom: 14px;
	}

	.panel-title-wrap {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.panel-step-num {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		color: var(--signal);
		background: var(--bg);
		border: 1px solid var(--line);
		padding: 2px 6px;
		border-radius: var(--radius-sm);
	}

	.panel-title {
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.panel-privacy-badge {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.form-cockpit-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.input-block {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.input-block.full-width {
		grid-column: 1 / -1;
	}

	.cockpit-label {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		color: var(--text-subtle);
	}

	.cockpit-select,
