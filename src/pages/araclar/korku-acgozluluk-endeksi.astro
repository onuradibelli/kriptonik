---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Kripto Korku ve Açgözlülük Endeksi (Fear & Greed Index) | Kriptonik";
const pageDesc = "Kripto para piyasasının güncel duygu durumunu ve Korku/Açgözlülük endeksini canlı takip edin. Dün, geçen hafta ve geçen ay karşılaştırmalarıyla piyasa psikolojisini analiz edin.";

// Fallback initial data (will update client-side via /api/v1/fng)
const fngData = {
	value: 72,
	classification: 'Açgözlülük',
	yesterday: 68,
	lastWeek: 64,
	lastMonth: 48
};
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container tool-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/araclar">Araçlar</a>
			<span>/</span>
			<span class="current">Korku ve Açgözlülük Endeksi</span>
		</nav>

		<div class="tool-header">
			<div class="badge-pill">
				<span>📊</span>
				<span>Piyasa Duyarlılığı & Psikoloji</span>
			</div>
			<h1 class="tool-title">Kripto Korku ve Açgözlülük Endeksi</h1>
			<p class="tool-subtitle">
				Piyasa duyarlılığını 0 ile 100 arasında ölçen popüler duygu göstergesi. Aşırı korku alım fırsatlarını, aşırı açgözlülük ise düzeltme risklerini işaret edebilir.
			</p>
		</div>

		<div class="fng-main-card">
			<!-- Visual Gauge Section -->
			<div class="gauge-section">
				<div class="gauge-box">
					<div class="gauge-arc-wrap">
						<svg class="gauge-svg" viewBox="0 0 200 110">
							<!-- Background arc -->
							<path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="var(--color-border)" stroke-width="16" stroke-linecap="round" />
							<!-- Colored dynamic arc -->
							<path id="gauge-fill" d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="var(--color-primary-500)" stroke-width="16" stroke-linecap="round" stroke-dasharray="251.2" stroke-dashoffset="70" />
						</svg>
						<div class="gauge-center-text">
							<span class="gauge-num" id="fng-value">{fngData.value}</span>
							<span class="gauge-out-of">/ 100</span>
						</div>
					</div>
					<div class="gauge-label-badge" id="fng-label">{fngData.classification}</div>
				</div>

				<div class="scale-legend">
					<span class="scale-item c-ext-fear">0-24 Aşırı Korku</span>
					<span class="scale-item c-fear">25-49 Korku</span>
					<span class="scale-item c-neutral">50-54 Nötr</span>
					<span class="scale-item c-greed">55-74 Açgözlülük</span>
					<span class="scale-item c-ext-greed">75-100 Aşırı Açgözlülük</span>
				</div>
			</div>

			<!-- Historical Comparison Column -->
			<div class="history-section">
				<h3 class="history-title">Tarihsel Karşılaştırma</h3>
				<div class="history-list">
					<div class="history-row">
						<span class="hist-label">Şu An:</span>
						<span class="hist-val font-mono" id="hist-now">{fngData.value} ({fngData.classification})</span>
					</div>
					<div class="history-row">
						<span class="hist-label">Dün:</span>
						<span class="hist-val font-mono" id="hist-yesterday">{fngData.yesterday} (Açgözlülük)</span>
					</div>
					<div class="history-row">
						<span class="hist-label">Geçen Hafta:</span>
						<span class="hist-val font-mono" id="hist-last-week">{fngData.lastWeek} (Açgözlülük)</span>
					</div>
					<div class="history-row">
						<span class="hist-label">Geçen Ay:</span>
						<span class="hist-val font-mono" id="hist-last-month">{fngData.lastMonth} (Nötr)</span>
					</div>
				</div>

				<div class="attribution-note">
					<span>Kaynak: <strong>alternative.me</strong> verileriyle Cloudflare Edge üzerinde önbelleklenmektedir.</span>
				</div>
			</div>
		</div>

		<!-- Methodology Section -->
		<div class="methodology-card">
			<h3>🧠 Bu Endeks Nasıl Hesaplanır?</h3>
			<p>
				Korku ve Açgözlülük Endeksi, piyasadaki duygusal sapmaları ölçmek amacıyla çeşitli bağımsız veri kaynaklarını ağırlıklandırarak analiz eder:
			</p>
			<div class="method-factors-grid">
				<div class="factor-item">
					<div class="factor-header">
						<span class="factor-name">Volatilite (Oynaklık)</span>
						<span class="factor-pct">%25</span>
					</div>
					<p class="factor-desc">Mevcut oynaklık ve maksimum düşüşler son 30 ve 90 günlük ortalamalarla kıyaslanır. Olağandışı oynaklık artışı korku işaretidir.</p>
				</div>

				<div class="factor-item">
					<div class="factor-header">
						<span class="factor-name">Piyasa Momentumu & Hacim</span>
						<span class="factor-pct">%25</span>
					</div>
					<p class="factor-desc">İşlem hacmi ve yukarı yönlü alım momentumu yüksek olduğunda piyasanın aşırı açgözlü davrandığı kabul edilir.</p>
				</div>

				<div class="factor-item">
					<div class="factor-header">
						<span class="factor-name">Sosyal Medya Duyarlılığı</span>
						<span class="factor-pct">%15</span>
					</div>
					<p class="factor-desc">Twitter/X ve sosyal mecralarda kripto etiketleriyle yapılan paylaşımların etkileşim hızı ve duyarlılığı taranır.</p>
				</div>

				<div class="factor-item">
					<div class="factor-header">
						<span class="factor-name">Bitcoin Piyasa Hakimiyeti (Dominance)</span>
						<span class="factor-pct">%10</span>
					</div>
					<p class="factor-desc">Bitcoin dominansındaki artış genellikle yatırımcıların daha riskli altcoin'lerden kaçıp güvenli limana sığındığını (korku) gösterir.</p>
				</div>

				<div class="factor-item">
					<div class="factor-header">
						<span class="factor-name">Google Arama Trendleri</span>
						<span class="factor-pct">%10</span>
					</div>
					<p class="factor-desc">Google Arama hacimlerindeki "Bitcoin manipülasyonu", "Kripto çöküşü" veya "Bitcoin nasıl alınır" sorgularının eğilimi incelenir.</p>
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
.tool-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
	max-width: 900px;
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}
.tool-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.tool-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-2);
	letter-spacing: -0.02em;
}
.tool-subtitle {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	line-height: 1.6;
}

.fng-main-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-8);
	display: grid;
	grid-template-columns: 1.2fr 1fr;
	gap: var(--space-8);
	margin-bottom: var(--space-8);
}
.gauge-section {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}
.gauge-box {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-bottom: var(--space-4);
}
.gauge-arc-wrap {
	position: relative;
	width: 240px;
	height: 140px;
	display: flex;
	align-items: center;
	justify-content: center;
}
.gauge-svg {
	width: 100%;
	height: 100%;
}
.gauge-center-text {
	position: absolute;
	bottom: 10px;
	display: flex;
	align-items: baseline;
	gap: 4px;
}
.gauge-num {
	font-size: var(--text-4xl);
	font-weight: 900;
	font-family: var(--font-mono);
	line-height: 1;
}
.gauge-out-of {
	font-size: var(--text-sm);
	color: var(--color-text-muted);
}
.gauge-label-badge {
	font-size: var(--text-base);
	font-weight: 800;
	padding: var(--space-1) var(--space-4);
	border-radius: var(--radius-full);
	background: rgba(16, 185, 129, 0.15);
	color: var(--color-success);
}

.scale-legend {
	display: flex;
	flex-wrap: wrap;
	gap: var(--space-2);
	justify-content: center;
	font-size: 11px;
	font-weight: 600;
}
.scale-item {
	padding: 2px 6px;
	border-radius: var(--radius-sm);
	background: var(--color-surface-hover);
}
.c-ext-fear { color: var(--color-error); }
.c-fear { color: #f97316; }
.c-neutral { color: var(--color-warning); }
.c-greed { color: var(--color-primary-400); }
.c-ext-greed { color: var(--color-success); }

.history-section {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}
.history-title {
	font-size: var(--text-base);
	font-weight: 700;
	margin-bottom: var(--space-4);
}
.history-list {
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
}
.history-row {
	display: flex;
	justify-content: space-between;
	padding: var(--space-3);
	background: var(--color-bg);
	border-radius: var(--radius-md);
	font-size: var(--text-sm);
}
.hist-label {
	color: var(--color-text-secondary);
}
.hist-val {
	font-weight: 700;
	color: var(--color-text-primary);
}
.attribution-note {
	margin-top: var(--space-6);
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	border-top: 1px solid var(--color-border);
	padding-top: var(--space-3);
}

.methodology-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-6);
}
.methodology-card h3 {
	font-size: var(--text-lg);
	font-weight: 700;
	margin-bottom: var(--space-2);
}
.methodology-card p {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
	line-height: 1.6;
	margin-bottom: var(--space-4);
}
.method-factors-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	gap: var(--space-3);
}
.factor-item {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: var(--space-3);
}
.factor-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: var(--space-1);
}
.factor-name {
	font-size: var(--text-xs);
	font-weight: 700;
	color: var(--color-text-primary);
}
.factor-pct {
	font-size: var(--text-xs);
	font-weight: 800;
	font-family: var(--font-mono);
	color: var(--color-primary-400);
}
.factor-desc {
	font-size: 11px;
	color: var(--color-text-muted);
	line-height: 1.5;
	margin: 0;
}

@media (max-width: 768px) {
	.fng-main-card {
		grid-template-columns: 1fr;
	}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', async () => {
	const valEl = document.getElementById('fng-value');
	const lblEl = document.getElementById('fng-label');
	const arcEl = document.getElementById('gauge-fill');
	const histNow = document.getElementById('hist-now');

	try {
		const res = await fetch('/api/v1/fng');
		if (res.ok) {
			const data = await res.json();
			if (data && data.value !== undefined) {
				const val = parseInt(data.value, 10);
				const classification = data.classification_tr || 'Belirsiz';

				if (valEl) valEl.textContent = val.toString();
				if (lblEl) lblEl.textContent = classification;
				if (histNow) histNow.textContent = `${val} (${classification})`;

				// Arc dash calculation: arc length is approx 251.2
				// offset range from 251.2 (0%) to 0 (100%)
				if (arcEl) {
					const offset = 251.2 - (val / 100) * 251.2;
					arcEl.style.strokeDashoffset = offset.toString();

					if (val <= 24) arcEl.style.stroke = 'var(--color-error)';
					else if (val <= 49) arcEl.style.stroke = '#f97316';
					else if (val <= 54) arcEl.style.stroke = 'var(--color-warning)';
					else if (val <= 74) arcEl.style.stroke = 'var(--color-primary-500)';
					else arcEl.style.stroke = 'var(--color-success)';
				}
			}
		}
	} catch (e) {
		// keep fallback display
	}
});
</script>
