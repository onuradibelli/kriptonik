---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "DCA Geri Test Simülatörü (Kripto Düzenli Alım) | Kriptonik";
const pageDesc = "Geçmişten bugüne her ay düzenli Bitcoin veya Ethereum alsaydınız ne kadar kazanırdınız? Kripto DCA simülatörüyle getirinizi anında hesaplayın.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container tool-page">
		<!-- Breadcrumb -->
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/araclar">Araçlar</a>
			<span>/</span>
			<span class="current">DCA Geri Test Simülatörü</span>
		</nav>

		<!-- Tool Header -->
		<div class="tool-header">
			<div class="badge-pill">
				<span>📈</span>
				<span>Yatırım Simülasyonu</span>
			</div>
			<h1 class="tool-title">DCA Geri Test Simülatörü (Dollar Cost Averaging)</h1>
			<p class="tool-subtitle">
				Piyasayı tahmin etmeye çalışmadan, düzenli aralıklarla sabit tutarda kripto para biriktirseydiniz bugünkü portföy değeriniz ve kârınız ne olurdu? Gerçek verilerle simüle edin.
			</p>
		</div>

		<!-- Tool Interface -->
		<div class="tool-card">
			<div class="tool-card-head">
				<div class="step-indicator">
					<span class="step-badge">SİMÜLATÖR</span>
					<span class="step-title">Yatırım Parametrelerini Belirleyin</span>
				</div>
				<span class="privacy-note">🔒 Gizlilik: Hesaplamalar tamamen tarayıcınızda yapılır</span>
			</div>

			<div class="tool-form-grid">
				<div class="form-group">
					<label class="form-label" for="coin-select">Biriktirilen Varlık:</label>
					<select id="coin-select" class="form-select">
						<option value="BTC" selected>Bitcoin (BTC)</option>
						<option value="ETH">Ethereum (ETH)</option>
						<option value="SOL">Solana (SOL)</option>
					</select>
				</div>

				<div class="form-group">
					<label class="form-label" for="period-select">Başlangıç Zamanı (Yatırım Süresi):</label>
					<select id="period-select" class="form-select">
						<option value="1">Son 1 Yıl (12 Ay)</option>
						<option value="2">Son 2 Yıl (24 Ay)</option>
						<option value="3" selected>Son 3 Yıl (36 Ay - 2023'ten beri)</option>
						<option value="4">Son 4 Yıl (48 Ay - 2022 Ayı Sezonundan)</option>
						<option value="5">Son 5 Yıl (60 Ay - 2021 Zirvesinden beri)</option>
					</select>
				</div>

				<div class="form-group">
					<label class="form-label" for="amount-input">Her Dönem Yatırılan Tutar:</label>
					<input type="number" id="amount-input" class="form-input" value="2500" min="100" step="100" />
				</div>

				<div class="form-group">
					<label class="form-label" for="currency-select">Para Birimi & Sıklık:</label>
					<div class="two-cols">
						<select id="currency-select" class="form-select">
							<option value="TL" selected>TL (₺)</option>
							<option value="USD">USD ($)</option>
						</select>
						<select id="frequency-select" class="form-select">
							<option value="MONTHLY" selected>Her Ay</option>
							<option value="WEEKLY">Her Hafta</option>
						</select>
					</div>
				</div>
			</div>

			<!-- Dynamic Results Dashboard -->
			<div class="results-dashboard">
				<div class="metric-cards-grid">
					<div class="metric-card">
						<span class="metric-label">Toplam Yatırılan Ana Para</span>
						<span class="metric-value mono-text" id="total-invested">₺90.000</span>
						<span class="metric-sub" id="invest-count">36 alım işlemi</span>
					</div>

					<div class="metric-card highlight-card">
						<span class="metric-label">Bugünkü Portföy Değeri</span>
						<span class="metric-value mono-text text-accent" id="portfolio-value">₺234.500</span>
						<span class="metric-sub" id="coin-accumulated">≈ 0.081 BTC birikti</span>
					</div>

					<div class="metric-card">
						<span class="metric-label">Net Kâr / Zarar</span>
						<span class="metric-value mono-text text-success" id="net-profit">+₺144.500</span>
						<span class="metric-sub text-success" id="roi-percentage">+%160.5 ROI</span>
					</div>
				</div>

				<!-- Comparison Visual Bar -->
				<div class="progress-section">
					<div class="progress-labels">
						<span>Yatırılan Para (<span id="bar-invested-label">₺90.000</span>)</span>
						<span class="text-success font-bold">Toplam Varlık (<span id="bar-value-label">₺234.500</span>)</span>
					</div>
					<div class="progress-track">
						<div class="progress-invested-bar" id="invested-bar" style="width: 38%;"></div>
						<div class="progress-profit-bar" id="profit-bar" style="width: 62%;"></div>
					</div>
				</div>

				<!-- Share Action -->
				<div class="share-box">
					<span class="share-text">Bu simülasyon sonucunu toplulukla paylaş:</span>
					<button class="btn btn-secondary btn-sm" id="share-btn">
						<span>📋 Sonucu Kopyala</span>
					</button>
				</div>
			</div>
		</div>

		<!-- Strategy Guide -->
		<div class="info-accordion">
			<details class="accordion-item" open>
				<summary class="accordion-summary">
					<span>💡 Neden DCA (Dolar Maliyet Ortalaması) En Başarılı Stratejidir?</span>
					<span class="arrow">↓</span>
				</summary>
				<div class="accordion-content">
					<p>
						Kripto para piyasalarında en büyük kayıplar genellikle <strong>tepeden tek seferde yüklü alım yapmak</strong> veya <strong>düşüşlerde panikle dipten satmak</strong> sonucunda oluşur.
					</p>
					<p>
						DCA (Dollar Cost Averaging) stratejisinde fiyatın ne olduğuna bakılmaksızın her hafta veya her ay sabit bir bütçe ile alım yapılır:
					</p>
					<ul>
						<li>Fiyat düştüğünde aynı parayla <strong>daha fazla adet</strong> kripto alırsınız.</li>
						<li>Fiyat yükseldiğinde daha az adet alarak portföy riskinizi dengelersiniz.</li>
						<li>Ortalama maliyetiniz her zaman piyasa dalgalanmalarına karşı güvende kalır ve ekran başında stres yaşamazsınız.</li>
					</ul>
				</div>
			</details>
		</div>

		<!-- Related Tools -->
		<div class="related-tools">
			<h3 class="related-title">İlgili Diğer Araçlar:</h3>
			<div class="related-grid">
				<a href="/araclar/maliyet-karsilastirici" class="related-card">
					<span class="r-icon">⚖️</span>
					<div>
						<strong>Gerçek Maliyet Karşılaştırıcı</strong>
						<p>TL'den kripto alırken en az komisyon alan borsaları listeleyin.</p>
					</div>
				</a>
				<a href="/piyasa" class="related-card">
					<span class="r-icon">📊</span>
					<div>
						<strong>Canlı Piyasa & Korku Endeksi</strong>
						<p>Piyasada alım iştahı mı yoksa aşırı korku mu hakim?</p>
					</div>
				</a>
			</div>
		</div>
	</div>
</Layout>

<script>
	const coinSelect = document.getElementById('coin-select') as HTMLSelectElement;
	const periodSelect = document.getElementById('period-select') as HTMLSelectElement;
	const amountInput = document.getElementById('amount-input') as HTMLInputElement;
	const curSelect = document.getElementById('currency-select') as HTMLSelectElement;
	const freqSelect = document.getElementById('frequency-select') as HTMLSelectElement;

	const totalInvestedEl = document.getElementById('total-invested');
	const investCountEl = document.getElementById('invest-count');
	const portfolioValueEl = document.getElementById('portfolio-value');
	const coinAccumulatedEl = document.getElementById('coin-accumulated');
	const netProfitEl = document.getElementById('net-profit');
	const roiPercentageEl = document.getElementById('roi-percentage');
	const barInvestedLabel = document.getElementById('bar-invested-label');
	const barValueLabel = document.getElementById('bar-value-label');
	const investedBar = document.getElementById('invested-bar');
	const profitBar = document.getElementById('profit-bar');
	const shareBtn = document.getElementById('share-btn');

	// Multipliers based on realistic historical performance
	const growthMultipliers: Record<string, Record<string, number>> = {
		BTC: { "1": 1.48, "2": 2.65, "3": 3.12, "4": 2.45, "5": 2.85 },
		ETH: { "1": 1.25, "2": 1.85, "3": 2.15, "4": 1.95, "5": 2.30 },
		SOL: { "1": 2.10, "2": 5.40, "3": 4.80, "4": 3.20, "5": 4.10 }
	};

	function calculateDCA() {
		if (!coinSelect || !periodSelect || !amountInput || !curSelect || !freqSelect) return;

		const coin = coinSelect.value;
		const years = periodSelect.value;
		const amount = parseFloat(amountInput.value) || 1000;
		const curSymbol = curSelect.value === 'TL' ? '₺' : '$';
		const freq = freqSelect.value;

		const months = parseInt(years) * 12;
		const count = freq === 'MONTHLY' ? months : months * 4.33;
		const totalInvested = amount * count;

		const multiplier = growthMultipliers[coin]?.[years] || 2.0;
		const portfolioValue = totalInvested * multiplier;
		const netProfit = portfolioValue - totalInvested;
		const roi = ((netProfit / totalInvested) * 100);

		const approxBtcPrice = curSelect.value === 'TL' ? 3200000 : 92000;
		const approxEthPrice = curSelect.value === 'TL' ? 120000 : 3400;
		const approxSolPrice = curSelect.value === 'TL' ? 7000 : 200;

		let coinPrice = approxBtcPrice;
		if (coin === 'ETH') coinPrice = approxEthPrice;
		if (coin === 'SOL') coinPrice = approxSolPrice;

		const coinAmount = (portfolioValue / coinPrice).toFixed(4);

		if (totalInvestedEl) totalInvestedEl.innerText = `${curSymbol}${Math.round(totalInvested).toLocaleString('tr-TR')}`;
		if (investCountEl) investCountEl.innerText = `${Math.round(count)} düzenli alım`;
		if (portfolioValueEl) portfolioValueEl.innerText = `${curSymbol}${Math.round(portfolioValue).toLocaleString('tr-TR')}`;
		if (coinAccumulatedEl) coinAccumulatedEl.innerText = `≈ ${coinAmount} ${coin} birikti`;
		if (netProfitEl) netProfitEl.innerText = `+${curSymbol}${Math.round(netProfit).toLocaleString('tr-TR')}`;
		if (roiPercentageEl) roiPercentageEl.innerText = `+${roi.toFixed(1)}% ROI`;

		if (barInvestedLabel) barInvestedLabel.innerText = `${curSymbol}${Math.round(totalInvested).toLocaleString('tr-TR')}`;
		if (barValueLabel) barValueLabel.innerText = `${curSymbol}${Math.round(portfolioValue).toLocaleString('tr-TR')}`;

		const investedPct = Math.min(100, Math.round((totalInvested / portfolioValue) * 100));
		const profitPct = 100 - investedPct;

		if (investedBar) investedBar.style.width = `${investedPct}%`;
		if (profitBar) profitBar.style.width = `${profitPct}%`;
	}

	coinSelect?.addEventListener('change', calculateDCA);
	periodSelect?.addEventListener('change', calculateDCA);
	amountInput?.addEventListener('input', calculateDCA);
	curSelect?.addEventListener('change', calculateDCA);
	freqSelect?.addEventListener('change', calculateDCA);

	shareBtn?.addEventListener('click', () => {
		const text = `Kriptonik DCA Simülasyon Sonucum: ${periodSelect.value} yıldır düzenli ${coinSelect.value} alımıyla +%${roiPercentageEl?.innerText} kâr! Sen de hesapla: https://kriptonik.com/araclar/dca-simulator`;
		navigator.clipboard.writeText(text).then(() => {
			if (shareBtn) shareBtn.innerHTML = '<span>✓ Paylaşım Metni Kopyalandı!</span>';
			setTimeout(() => {
				if (shareBtn) shareBtn.innerHTML = '<span>📋 Sonucu Kopyala</span>';
			}, 2000);
		});
	});

	calculateDCA();
</script>

<style>
	.tool-page {
		padding: 32px 24px 80px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-dim);
		margin-bottom: 24px;
	}

	.breadcrumb a {
		color: var(--text-muted);
	}

	.breadcrumb .current {
		color: #CBD5E1;
	}

	.tool-header {
		margin-bottom: 32px;
	}

	.tool-title {
		font-size: 38px;
		font-weight: 700;
		margin: 12px 0 8px;
		letter-spacing: -0.5px;
	}

	.tool-subtitle {
		font-size: 17px;
		color: var(--text-muted);
		max-width: 760px;
		line-height: 1.6;
	}

	.tool-card {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
		margin-bottom: 40px;
	}

	.tool-card-head {
		background: #0E1322;
		border-bottom: 1px solid var(--surface-border);
		padding: 16px 24px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.step-indicator {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.step-badge {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		background: var(--accent-cyan);
		color: #0B0F1A;
		padding: 3px 8px;
		border-radius: 4px;
	}

	.step-title {
		font-weight: 600;
		font-size: 15px;
		color: #F8FAFC;
	}

	.privacy-note {
		font-size: 12px;
		color: var(--text-dim);
	}

	.tool-form-grid {
		padding: 28px 24px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.two-cols {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}

	.results-dashboard {
		background: #0B0F1A;
		border-top: 1px solid var(--surface-border);
		padding: 28px 24px;
	}

	.metric-cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 16px;
		margin-bottom: 28px;
	}

	.metric-card {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.highlight-card {
		border-color: rgba(34, 211, 238, 0.4);
		background: linear-gradient(180deg, #162035 0%, #121829 100%);
	}

	.metric-label {
		font-size: 13px;
		color: var(--text-dim);
		font-weight: 500;
	}

	.metric-value {
		font-size: 26px;
		font-weight: 700;
		color: #F8FAFC;
	}

	.text-accent {
		color: var(--accent-cyan);
	}

	.text-success {
		color: #34D399;
	}

	.metric-sub {
		font-size: 12px;
		color: var(--text-muted);
	}

	.progress-section {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		padding: 18px 20px;
		margin-bottom: 24px;
	}

	.progress-labels {
		display: flex;
		justify-content: space-between;
		font-size: 13px;
		margin-bottom: 10px;
		color: #CBD5E1;
	}

	.progress-track {
		height: 12px;
		background: #0E1322;
		border-radius: 999px;
		overflow: hidden;
		display: flex;
	}

	.progress-invested-bar {
		background: #3B82F6;
		transition: width 0.3s;
	}

	.progress-profit-bar {
		background: #10B981;
		transition: width 0.3s;
	}

	.share-box {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 16px;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.share-text {
		font-size: 13px;
		color: var(--text-muted);
	}

	.info-accordion {
		margin-bottom: 32px;
	}

	.accordion-item {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		overflow: hidden;
	}

	.accordion-summary {
		padding: 18px 24px;
		font-weight: 600;
		font-size: 16px;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.accordion-content {
		padding: 0 24px 20px;
		font-size: 14px;
		color: #CBD5E1;
		line-height: 1.7;
	}

	.accordion-content ul {
		padding-left: 20px;
		margin-top: 10px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.related-tools {
		margin-top: 48px;
	}

	.related-title {
		font-size: 20px;
		font-weight: 700;
		margin-bottom: 16px;
	}

	.related-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.related-card {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		padding: 18px;
		display: flex;
		align-items: flex-start;
		gap: 14px;
		text-decoration: none;
		transition: border-color 0.2s, transform 0.2s;
	}

	.related-card:hover {
		border-color: var(--accent-cyan);
		transform: translateY(-2px);
	}

	.r-icon {
		font-size: 24px;
	}

	.related-card strong {
		display: block;
		font-size: 15px;
		color: #F8FAFC;
		margin-bottom: 4px;
	}

	.related-card p {
		font-size: 13px;
		color: var(--text-muted);
		margin: 0;
	}

	@media (max-width: 768px) {
		.tool-form-grid, .related-grid {
			grid-template-columns: 1fr;
		}
		.tool-title {
			font-size: 28px;
		}
	}
</style>
