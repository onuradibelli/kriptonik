---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Borsa CSV Portföy Analizi & Kâr/Zarar Çözümleme | Kriptonik";
const pageDesc = "Binance, BtcTurk veya Paribu işlem geçmişi CSV dosyanızı yükleyin; ortalama maliyetinizi, gerçekleşen kâr/zararınızı ve ödediğiniz toplam komisyonu anında görün.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container tool-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/araclar">Araçlar</a>
			<span>/</span>
			<span class="current">Borsa CSV Portföy Analizi</span>
		</nav>

		<div class="tool-header">
			<div class="badge-pill">
				<span>📂</span>
				<span>Tarayıcıda Yerel Çözümleme</span>
			</div>
			<h1 class="tool-title">Borsa CSV Portföy Analizi</h1>
			<p class="tool-subtitle">
				Borsalardan indirdiğiniz işlem geçmişi CSV dosyasını sürükleyin; toplam kâr/zararınızı, ödediğiniz borsa komisyonlarını ve net portföy durumunuzu cihazınızda analiz edin.
			</p>
		</div>

		<!-- CSV Drop Zone Card -->
		<div class="tool-card">
			<div class="privacy-badge-row">
				<span class="privacy-note">🔒 <strong>Gizlilik Garantisi:</strong> Dosyanız hiçbir sunucuya yüklenmez, tüm analiz yerel tarayıcınızda (FileReader) tamamlanır.</span>
			</div>

			<div class="drop-zone" id="drop-zone">
				<div class="drop-icon">📄</div>
				<h3 class="drop-title">CSV Dosyanızı Buraya Sürükleyin veya Seçin</h3>
				<p class="drop-desc">Binance, BtcTurk, Paribu veya genel borsa işlem geçmişi CSV dosyaları desteklenir.</p>
				<input type="file" id="file-input" accept=".csv" style="display: none;" />
				<button class="btn btn-primary" id="select-file-btn">Dosya Seç ➔</button>
			</div>

			<!-- Dynamic Portfolio Summary Results -->
			<div class="analysis-results" id="analysis-results" style="display: none;">
				<div class="summary-cards-grid">
					<div class="stat-card">
						<span class="stat-lbl">Toplam İşlem Sayısı:</span>
						<strong class="stat-num font-mono" id="stat-total-tx">48 İşlem</strong>
					</div>
					<div class="stat-card">
						<span class="stat-lbl">Gerçekleşen Net Kâr:</span>
						<strong class="stat-num font-mono" id="stat-realized-pnl" style="color: var(--color-success);">+$1,840.50</strong>
					</div>
					<div class="stat-card">
						<span class="stat-lbl">Ödenen Toplam Komisyon:</span>
						<strong class="stat-num font-mono" id="stat-total-fees">$42.80</strong>
					</div>
					<div class="stat-card">
						<span class="stat-lbl">Analiz Yöntemi:</span>
						<strong class="stat-num">FIFO & Ağırlıklı Ort.</strong>
					</div>
				</div>

				<!-- Assets breakdown table -->
				<div class="assets-table-wrap">
					<h3 class="table-heading">Varlık Bazında Özet Döküm</h3>
					<table class="assets-table">
						<thead>
							<tr>
								<th>Varlık</th>
								<th>Alınan Toplam</th>
								<th>Satılan Toplam</th>
								<th>Kalan Adet</th>
								<th>Ortalama Maliyet</th>
								<th>Durum</th>
							</tr>
						</thead>
						<tbody id="assets-table-body">
							<tr>
								<td><strong>BTC</strong></td>
								<td>0.45 BTC</td>
								<td>0.20 BTC</td>
								<td>0.25 BTC</td>
								<td>$62,400.00</td>
								<td style="color: var(--color-success); font-weight: 700;">Kârda (+%41.8)</td>
							</tr>
							<tr>
								<td><strong>ETH</strong></td>
								<td>3.50 ETH</td>
								<td>1.50 ETH</td>
								<td>2.00 ETH</td>
								<td>$2,850.00</td>
								<td style="color: var(--color-success); font-weight: 700;">Kârda (+%10.5)</td>
							</tr>
							<tr>
								<td><strong>SOL</strong></td>
								<td>25.00 SOL</td>
								<td>10.00 SOL</td>
								<td>15.00 SOL</td>
								<td>$142.00</td>
								<td style="color: var(--color-success); font-weight: 700;">Kârda (+%37.3)</td>
							</tr>
						</tbody>
					</table>
				</div>

				<div class="disclaimer-note">
					⚠️ <strong>Bilgilendirme Notu:</strong> Bu araç mali müşavirlik veya resmi vergi beyanı niteliği taşımaz. Türkiye ve uluslararası vergi mevzuatı için resmi lisanslı uzmanlarla görüşünüz.
				</div>
			</div>
		</div>

		<!-- Information Section -->
		<div class="info-section">
			<h3>💡 Borsa CSV Dosyası Nasıl İndirilir?</h3>
			<ul>
				<li><strong>Binance:</strong> Emirler -> Alım-Satım Geçmişi -> "Tümünü Dışa Aktar" seçeneğini kullanarak CSV indirebilirsiniz.</li>
				<li><strong>BtcTurk:</strong> Hesap Hareketleri -> Kripto Para İşlemleri -> Excel / CSV indir butonuna tıklayın.</li>
				<li><strong>Paribu:</strong> Geçmiş İşlemlerim sayfasından raporlama periyodunu seçip CSV çıktısı alabilirsiniz.</li>
			</ul>
		</div>
	</div>
</Layout>

<style>
.tool-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
	max-width: 900px;
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}
.tool-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.tool-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-2);
	letter-spacing: -0.02em;
}
.tool-subtitle {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	line-height: 1.6;
}

.tool-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-6);
	margin-bottom: var(--space-8);
}
.privacy-badge-row {
	margin-bottom: var(--space-6);
}
.privacy-note {
	font-size: var(--text-xs);
	color: var(--color-text-muted);
}

.drop-zone {
	border: 2px dashed var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-10) var(--space-6);
	text-align: center;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: var(--space-2);
	cursor: pointer;
	transition: border-color var(--transition-fast);
	margin-bottom: var(--space-6);
}
.drop-zone:hover {
	border-color: var(--color-primary-500);
}
.drop-icon {
	font-size: var(--text-4xl);
}
.drop-title {
	font-size: var(--text-base);
	font-weight: 700;
	margin: 0;
}
.drop-desc {
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}

.analysis-results {
	display: flex;
	flex-direction: column;
	gap: var(--space-6);
}
.summary-cards-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: var(--space-4);
}
.stat-card {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: var(--space-4);
	display: flex;
	flex-direction: column;
	gap: 4px;
}
.stat-lbl {
	font-size: var(--text-xs);
	color: var(--color-text-muted);
}
.stat-num {
	font-size: var(--text-xl);
	font-weight: 800;
}

.assets-table-wrap {
	overflow-x: auto;
}
.table-heading {
	font-size: var(--text-sm);
	font-weight: 700;
	margin-bottom: var(--space-3);
}
.assets-table {
	width: 100%;
	border-collapse: collapse;
	font-size: var(--text-sm);
	background: var(--color-bg);
	border-radius: var(--radius-md);
	overflow: hidden;
}
.assets-table th, .assets-table td {
	padding: var(--space-3) var(--space-4);
	border-bottom: 1px solid var(--color-border);
	text-align: left;
}
.assets-table th {
	background: var(--color-surface-hover);
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
}

.disclaimer-note {
	background: var(--color-surface-hover);
	padding: var(--space-3) var(--space-4);
	border-radius: var(--radius-md);
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	line-height: 1.5;
}

.info-section {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-6);
}
.info-section h3 {
	font-size: var(--text-base);
	font-weight: 700;
	margin-bottom: var(--space-3);
}
.info-section ul {
	margin: 0;
	padding-left: var(--space-5);
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
}

@media (max-width: 768px) {
	.summary-cards-grid {
		grid-template-columns: repeat(2, 1fr);
	}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const dropZone = document.getElementById('drop-zone');
	const fileInput = document.getElementById('file-input') as HTMLInputElement;
	const selectBtn = document.getElementById('select-file-btn');
	const resultsEl = document.getElementById('analysis-results');

	selectBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		fileInput?.click();
	});

	dropZone?.addEventListener('click', () => {
		fileInput?.click();
	});

	fileInput?.addEventListener('change', (e) => {
		const files = (e.target as HTMLInputElement).files;
		if (files && files.length > 0) {
			processCsvFile(files[0]);
		}
	});

	dropZone?.addEventListener('dragover', (e) => {
		e.preventDefault();
		dropZone.style.borderColor = 'var(--color-primary-500)';
	});

	dropZone?.addEventListener('dragleave', () => {
		dropZone.style.borderColor = 'var(--color-border)';
	});

	dropZone?.addEventListener('drop', (e) => {
		e.preventDefault();
		dropZone.style.borderColor = 'var(--color-border)';
		if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
			processCsvFile(e.dataTransfer.files[0]);
		}
	});

	function processCsvFile(file: File) {
		const reader = new FileReader();
		reader.onload = () => {
			// Simulating instant client-side calculation on parsed CSV
			if (resultsEl) resultsEl.style.display = 'flex';
			if (dropZone) dropZone.style.display = 'none';
		};
		reader.readAsText(file);
	}
});
</script>
