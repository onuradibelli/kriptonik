---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import StatusPill from '../../components/ui/StatusPill.astro';

const pageTitle = "Adres Ağ Eşleştirici & Format Doğrulayıcı | Kriptonik";
const pageDesc = "Kripto para cüzdan adresinin hangi ağlara ait olduğunu anında tespit et. Yanlış ağ transferi riskini gönderim öncesinde azalt.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="cockpit-tool-container">
		<!-- Breadcrumb & Badges -->
		<div class="tool-meta-bar">
			<nav class="cockpit-breadcrumb" aria-label="Gezinti">
				<a href="/">Ana Sayfa</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<a href="/araclar">Araçlar</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<span class="crumb-current">Adres Ağ Eşleştirici</span>
			</nav>

			<div class="tool-badges-row">
				<StatusPill status="live" label="Canlı" />
				<StatusPill dataFlow="client" />
			</div>
		</div>

		<!-- Tool Header -->
		<div class="tool-intro-box">
			<div class="tool-title-row">
				<div class="tool-icon-square">
					<Icon name="shield-check" size={24} />
				</div>
				<div>
					<h1 class="tool-heading">Adres ve Ağ Format Denetimi</h1>
					<p class="tool-subheading">
						Para transfer etmeden önce alıcı adresin hangi ağlara ait olduğunu doğrula. Çapraz ağ uyuşmazlığı ve hatalı gönderim risklerini önceden gör.
					</p>
				</div>
			</div>
		</div>

		<!-- Tool Interface -->
		<div class="cockpit-panel">
			<div class="panel-header">
				<div class="panel-title-wrap">
					<span class="panel-step-num">01</span>
					<h2 class="panel-title">Kripto Adresini Yapıştır</h2>
				</div>
				<span class="panel-privacy-badge">
					<Icon name="shield-check" size={13} />
					<span>Adres hiçbir sunucuya iletilmez</span>
				</span>
			</div>

			<div class="tool-form-grid">
				<div class="form-group full-width">
					<label class="form-label" for="address-input">Hedef Cüzdan / Yatırma Adresi:</label>
					<div class="input-with-clear">
						<input 
							type="text" 
							id="address-input" 
							class="form-input mono-text" 
							placeholder="Örn: 0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045 veya TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t" 
							autocomplete="off"
						/>
						<button id="clear-btn" class="clear-btn" title="Temizle">✕</button>
					</div>

					<div class="sample-pills">
						<span class="sample-label">Hızlı Örnekler:</span>
						<button class="sample-btn" data-addr="0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045">EVM (0x...)</button>
						<button class="sample-btn" data-addr="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t">Tron (TRC20)</button>
						<button class="sample-btn" data-addr="bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq">Bitcoin SegWit</button>
						<button class="sample-btn" data-addr="7EYnhQoR9YM3N7UoaKRoA44Uy8Jeaavu3qKsY2jHDE24">Solana</button>
					</div>
				</div>
			</div>

			<!-- Dynamic Result Container -->
			<div class="verdict-container" id="address-result">
				<div class="verdict-header">
					<div class="verdict-status" id="detected-format-badge">
						<span class="status-icon">✓</span>
						<span class="status-title" id="detected-format-title">ADRES TESPİT EDİLDİ</span>
					</div>
					<div class="score-pill" id="security-pill">Format Geçerli</div>
				</div>

				<div class="verdict-body">
					<!-- Compatible Networks Badges -->
					<div class="compat-networks">
						<h4 class="compat-title">✓ Bu Adresin Uyumlu Olduğu ve Desteklediği Ağlar:</h4>
						<div class="network-tags" id="network-tags"></div>
					</div>

					<!-- Critical Cross-Chain Warning -->
					<div class="risk-alert-box" id="risk-alert-box"></div>

					<!-- Technical Details Breakdown -->
					<div class="address-details" id="address-details"></div>
				</div>
			</div>
		</div>

		<!-- Explanatory Content -->
		<div class="info-accordion">
			<details class="accordion-item" open>
				<summary class="accordion-summary">
					<span>💡 Adres Formatları Neden Birbirinden Farklıdır?</span>
					<span class="arrow">↓</span>
				</summary>
				<div class="accordion-content">
					<p>
						Her blokzincir mimarisi kendine özgü bir şifreleme ve adres türetme standardı kullanır:
					</p>
					<ul>
						<li><strong>0x ile başlayan 42 karakterlik adresler (EVM):</strong> Ethereum, BNB Chain, Polygon, Arbitrum gibi tüm EVM zincirlerinde aynı adres kullanılır.</li>
						<li><strong>T ile başlayan 34 karakterlik adresler (TRON):</strong> Base58Check kodlamalı Tron ağı adresleridir (TRC-20 USDT için çok yaygındır).</li>
						<li><strong>bc1q ile başlayan adresler (Bitcoin Native SegWit):</strong> Bech32 kodlamalı düşük transfer ücretli modern Bitcoin adresleridir.</li>
						<li><strong>Base58 32-44 karakterlik adresler (Solana):</strong> Ed25519 kriptografik anahtar çiftinden türetilen Solana cüzdanlarıdır.</li>
					</ul>
				</div>
			</details>
		</div>

		<!-- Related Tools -->
		<div class="related-tools">
			<h3 class="related-title">İlgili Diğer Araçlar:</h3>
			<div class="related-grid">
				<a href="/araclar/yanlis-aga-gonderdim" class="related-card">
					<span class="r-icon">🧭</span>
					<div>
						<strong>Yanlış Ağa Gönderdim Sihirbazı</strong>
						<p>Yanlış ağa giden fonların kurtarılabilirlik durumunu inceleyin.</p>
					</div>
				</a>
				<a href="/araclar/maliyet-karsilastirici" class="related-card">
					<span class="r-icon">⚖️</span>
					<div>
						<strong>Gerçek Maliyet Karşılaştırıcı</strong>
						<p>Ağlar arası en ucuz transfer rotalarını karşılaştırın.</p>
					</div>
				</a>
			</div>
		</div>
	</div>
</Layout>

<script>
	const addrInput = document.getElementById('address-input') as HTMLInputElement;
	const clearBtn = document.getElementById('clear-btn');
	const sampleBtns = document.querySelectorAll('.sample-btn');

	const formatBadge = document.getElementById('detected-format-badge');
	const formatTitle = document.getElementById('detected-format-title');
	const secPill = document.getElementById('security-pill');
	const netTags = document.getElementById('network-tags');
	const riskBox = document.getElementById('risk-alert-box');
	const detailsBox = document.getElementById('address-details');

	function analyzeAddress(addr: string) {
		addr = addr.trim();
		if (!addrInput || !formatBadge || !formatTitle || !secPill || !netTags || !riskBox || !detailsBox) return;

		if (!addr) {
			formatBadge.className = 'verdict-status badge-warning';
			formatTitle.innerText = 'BİR ADRES GİRİNİZ';
			secPill.innerText = 'Bekleniyor';
			netTags.innerHTML = '<span class="empty-hint">Analiz için lütfen yukarıdaki kutuya bir adres yapıştırın.</span>';
			riskBox.style.display = 'none';
			detailsBox.innerHTML = '';
			return;
		}

		// Regex Patterns
		const isEVM = /^0x[a-fA-F0-9]{40}$/.test(addr);
		const isTron = /^T[a-km-zA-HJ-NP-Z1-9]{33}$/.test(addr);
		const isBtcSegwit = /^bc1[a-z0-9]{39,59}$/i.test(addr);
		const isBtcLegacy = /^[13][a-km-zA-HJ-NP-Z1-9]{25,34}$/.test(addr);
		const isSolana = /^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(addr) && !isTron && !isBtcLegacy;
		const isRipple = /^r[0-9a-zA-Z]{24,34}$/.test(addr);

		if (isEVM) {
			formatBadge.className = 'verdict-status badge-success';
			formatTitle.innerText = 'EVM (ETHEREUM VIRTUAL MACHINE) ADRESİ';
			secPill.className = 'score-pill score-success';
			secPill.innerText = 'Standart EIP-55 Hex';

			netTags.innerHTML = `
				<span class="net-pill pill-evm">Ethereum (ERC-20)</span>
				<span class="net-pill pill-evm">BNB Smart Chain (BEP-20)</span>
				<span class="net-pill pill-evm">Arbitrum One</span>
				<span class="net-pill pill-evm">Polygon (PoS)</span>
				<span class="net-pill pill-evm">Optimism (OP)</span>
				<span class="net-pill pill-evm">Avalanche C-Chain</span>
				<span class="net-pill pill-evm">Base</span>
			`;

			riskBox.style.display = 'block';
			riskBox.className = 'risk-alert-box alert-danger';
			riskBox.innerHTML = `
				<strong>⚠️ ÇOK ÖNEMLİ ÇAPRAZ AĞ UYARISI:</strong>
				<p>Bu adrese <strong>TRON (TRC-20)</strong> veya <strong>Solana</strong> ağından transfer YAPMAYINIZ! Bu bir EVM adresidir; yalnızca yukarıda listelenen EVM zincirleri üzerinden token kabul eder.</p>
			`;

			detailsBox.innerHTML = `
				<div class="detail-row">
					<span class="d-label">Biçim:</span>
					<span class="d-val">42 Karakter Hexadecimal (0x ile başlar)</span>
				</div>
				<div class="detail-row">
					<span class="d-label">Borsaya Yatırırken:</span>
					<span class="d-val">Borsanın size verdiği yatırma ağını (ERC-20 / BEP-20 / Arbitrum vb.) tam eşleştirdiğinizden emin olun.</span>
				</div>
			`;
		} else if (isTron) {
			formatBadge.className = 'verdict-status badge-success';
			formatTitle.innerText = 'TRON (TRC-20) ADRESİ';
			secPill.className = 'score-pill score-success';
			secPill.innerText = 'Tron Base58Check';

			netTags.innerHTML = `
				<span class="net-pill pill-tron">TRON Ağı (TRC-20)</span>
				<span class="net-pill pill-tron">TRC-10 Tokenler</span>
				<span class="net-pill pill-tron">TRX (Tron Yerel)</span>
			`;

			riskBox.style.display = 'block';
			riskBox.className = 'risk-alert-box alert-danger';
			riskBox.innerHTML = `
				<strong>⚠️ KRİTİK GÜVENLİK UYARISI:</strong>
				<p>Bu adrese <strong>ERC-20 (Ethereum)</strong> veya <strong>BEP-20 (Binance Smart Chain)</strong> ağından kesinlikle gönderim yapmayınız. Yalnızca <strong>TRC-20 (TRON)</strong> ağını seçtiğinizden emin olun.</p>
			`;

			detailsBox.innerHTML = `
				<div class="detail-row">
					<span class="d-label">Biçim:</span>
					<span class="d-val">34 Karakter (Büyük T harfi ile başlar)</span>
				</div>
				<div class="detail-row">
					<span class="d-label">USDT Kullanımı:</span>
					<span class="d-val">Türkiye'de en çok tercih edilen ucuz ve hızlı USDT transfer ağıdır.</span>
				</div>
			`;
		} else if (isBtcSegwit || isBtcLegacy) {
			formatBadge.className = 'verdict-status badge-success';
			formatTitle.innerText = isBtcSegwit ? 'BITCOIN NATIVE SEGWIT (BECH32)' : 'BITCOIN (LEGACY / P2SH)';
			secPill.className = 'score-pill score-success';
			secPill.innerText = 'Doğal Bitcoin Ağı';

			netTags.innerHTML = `
				<span class="net-pill pill-btc">Bitcoin Ana Ağı (BTC)</span>
				<span class="net-pill pill-btc">Lightning Network (On-chain kanalı)</span>
			`;

			riskBox.style.display = 'block';
			riskBox.className = 'risk-alert-box alert-warning';
			riskBox.innerHTML = `
				<strong>⚠️ DİKKAT:</strong> Bu saf bir Bitcoin adresidir. Bu adrese USDT, Ethereum veya başka bir altcoin gönderilemez! Sadece Bitcoin (BTC) ağı üzerinden BTC gönderiniz.
			`;

			detailsBox.innerHTML = `
				<div class="detail-row">
					<span class="d-label">Adres Türü:</span>
					<span class="d-val">${isBtcSegwit ? 'bc1 ile başlayan en düşük ücretli SegWit formatı' : '1 veya 3 ile başlayan klasik Bitcoin formatı'}</span>
				</div>
			`;
		} else if (isSolana) {
			formatBadge.className = 'verdict-status badge-success';
			formatTitle.innerText = 'SOLANA (SOL) ADRESİ';
			secPill.className = 'score-pill score-success';
			secPill.innerText = 'Solana Base58';

			netTags.innerHTML = `
				<span class="net-pill pill-sol">Solana Ağı (SPL Tokenler)</span>
				<span class="net-pill pill-sol">SOL (Solana Yerel)</span>
			`;

			riskBox.style.display = 'block';
			riskBox.className = 'risk-alert-box alert-danger';
			riskBox.innerHTML = `
				<strong>⚠️ UYARI:</strong> Bu bir Solana SPL adresidir. Sadece Solana ağı üzerinden SOL veya SPL token (USDT-SPL vb.) gönderilmelidir.
			`;

			detailsBox.innerHTML = `
				<div class="detail-row">
					<span class="d-label">Biçim:</span>
					<span class="d-val">Base58 Kodlu 32-44 Karakter</span>
				</div>
			`;
		} else if (isRipple) {
			formatBadge.className = 'verdict-status badge-success';
			formatTitle.innerText = 'RIPPLE (XRP LEDGER) ADRESİ';
			secPill.className = 'score-pill score-warning';
			secPill.innerText = 'Tag / Memo Gerekebilir';

			netTags.innerHTML = `
				<span class="net-pill pill-xrp">XRP Ledger (XRPL)</span>
			`;

			riskBox.style.display = 'block';
			riskBox.className = 'risk-alert-box alert-warning';
			riskBox.innerHTML = `
				<strong>⚠️ MEMO / DESTINATION TAG ZORUNLU OLABİLİR:</strong> Eğer bir borsaya yatırıyorsanız, sadece bu adres yetmez; borsanın verdiği sayısal <strong>Destination Tag</strong> numarasını da girmek zorundasınız, aksi takdirde paranız hesaba geçmez!
			`;
		} else {
			formatBadge.className = 'verdict-status badge-danger';
			formatTitle.innerText = 'BİLİNMEYEN VEYA GEÇERSİZ FORMAT';
			secPill.className = 'score-pill score-danger';
			secPill.innerText = 'Geçersiz';

			netTags.innerHTML = '<span class="empty-hint">Bu adres bilinen standart blokzincir formatlarına uymuyor. Lütfen kopyaladığınız adresi kontrol ediniz.</span>';
			riskBox.style.display = 'none';
			detailsBox.innerHTML = '';
		}
	}

	addrInput?.addEventListener('input', (e) => {
		analyzeAddress((e.target as HTMLInputElement).value);
	});

	clearBtn?.addEventListener('click', () => {
		if (addrInput) {
			addrInput.value = '';
			analyzeAddress('');
			addrInput.focus();
		}
	});

	sampleBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const addr = btn.getAttribute('data-addr') || '';
			if (addrInput) {
				addrInput.value = addr;
				analyzeAddress(addr);
			}
		});
	});

	// Initial
	analyzeAddress(addrInput?.value || '');
</script>

<style>
	.tool-page {
		padding: 32px 24px 80px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-dim);
		margin-bottom: 24px;
	}

	.breadcrumb a {
		color: var(--text-muted);
	}

	.breadcrumb .current {
		color: #CBD5E1;
	}

	.tool-header {
		margin-bottom: 32px;
	}

	.tool-title {
		font-size: 38px;
		font-weight: 700;
		margin: 12px 0 8px;
		letter-spacing: -0.5px;
	}

	.tool-subtitle {
		font-size: 17px;
		color: var(--text-muted);
		max-width: 760px;
		line-height: 1.6;
	}

	.tool-card {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
		margin-bottom: 40px;
	}

	.tool-card-head {
		background: #0E1322;
		border-bottom: 1px solid var(--surface-border);
		padding: 16px 24px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.step-indicator {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.step-badge {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		background: var(--accent-cyan);
		color: #0B0F1A;
		padding: 3px 8px;
		border-radius: 4px;
	}

	.step-title {
		font-weight: 600;
		font-size: 15px;
		color: #F8FAFC;
	}

	.privacy-note {
		font-size: 12px;
		color: var(--text-dim);
	}

	.tool-form-grid {
		padding: 28px 24px;
	}

	.input-with-clear {
		position: relative;
		display: flex;
		align-items: center;
	}

	.clear-btn {
		position: absolute;
		right: 12px;
		background: none;
		border: none;
		color: var(--text-dim);
		cursor: pointer;
		font-size: 16px;
		padding: 4px;
	}

	.clear-btn:hover {
		color: var(--text-main);
	}

	.sample-pills {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 12px;
	}

	.sample-label {
		font-size: 12px;
		color: var(--text-dim);
	}

	.sample-btn {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #94A3B8;
		padding: 4px 10px;
		border-radius: 6px;
		font-size: 12px;
		cursor: pointer;
		transition: all 0.2s;
	}

	.sample-btn:hover {
		background: rgba(34, 211, 238, 0.15);
		color: var(--accent-cyan);
		border-color: var(--accent-cyan);
	}

	.verdict-container {
		background: #0B0F1A;
		border-top: 1px solid var(--surface-border);
		padding: 28px 24px;
	}

	.verdict-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 20px;
		flex-wrap: wrap;
		gap: 12px;
	}

	.verdict-status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		border-radius: 8px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
	}

	.score-pill {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
		padding: 6px 14px;
		border-radius: 999px;
	}

	.compat-networks {
		margin-bottom: 20px;
	}

	.compat-title {
		font-size: 14px;
		font-weight: 600;
		color: #CBD5E1;
		margin-bottom: 12px;
	}

	.network-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.empty-hint {
		font-size: 14px;
		color: var(--text-dim);
	}

	.net-pill {
		font-size: 12px;
		font-weight: 600;
		padding: 6px 12px;
		border-radius: 6px;
	}

	.pill-evm {
		background: rgba(59, 130, 246, 0.15);
		border: 1px solid rgba(59, 130, 246, 0.35);
		color: #93C5FD;
	}

	.pill-tron {
		background: rgba(239, 68, 68, 0.15);
		border: 1px solid rgba(239, 68, 68, 0.35);
		color: #FCA5A5;
	}

	.pill-btc {
		background: rgba(245, 158, 11, 0.15);
		border: 1px solid rgba(245, 158, 11, 0.35);
		color: #FCD34D;
	}

	.pill-sol {
		background: rgba(168, 85, 247, 0.15);
		border: 1px solid rgba(168, 85, 247, 0.35);
		color: #D8B4FE;
	}

	.pill-xrp {
		background: rgba(14, 165, 233, 0.15);
		border: 1px solid rgba(14, 165, 233, 0.35);
		color: #7DD3FC;
	}

	.risk-alert-box {
		border-radius: 10px;
		padding: 16px 18px;
		margin-bottom: 20px;
		font-size: 14px;
		line-height: 1.6;
	}

	.alert-danger {
		background: rgba(239, 68, 68, 0.1);
		border: 1px solid rgba(239, 68, 68, 0.35);
		color: #FECACA;
	}

	.alert-warning {
		background: rgba(245, 158, 11, 0.1);
		border: 1px solid rgba(245, 158, 11, 0.35);
		color: #FEF08A;
	}

	.address-details {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 10px;
		padding: 16px 20px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.detail-row {
		display: flex;
		justify-content: space-between;
		font-size: 13px;
		padding-bottom: 8px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.detail-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.d-label {
		color: var(--text-dim);
