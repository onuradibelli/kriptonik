---
// src/pages/araclar/takilan-islem.astro - Takılan İşlem Cockpit Teşhis Aracı
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import StatusPill from '../../components/ui/StatusPill.astro';

const pageTitle = "Takılan İşlem Teşhisi (Pending Tx) | Kriptonik";
const pageDesc = "Kripto para transferin 'Pending' kaldı ve onaylanmıyor mu? İşlemin neden takıldığını teşhis et; RBF, CPFP veya Nonce sıfırlama ile işlemi hızlandır.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="cockpit-tool-container">
		<!-- Breadcrumb & Status Bar -->
		<div class="tool-meta-bar">
			<nav class="cockpit-breadcrumb" aria-label="Gezinti">
				<a href="/">Ana Sayfa</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<a href="/araclar">Araçlar</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<span class="crumb-current">Takılan İşlem Teşhisi</span>
			</nav>

			<div class="tool-badges-row">
				<StatusPill status="live" label="Canlı" />
				<StatusPill dataFlow="server" />
			</div>
		</div>

		<!-- Tool Intro -->
		<div class="tool-intro-box">
			<div class="tool-title-row">
				<div class="tool-icon-square">
					<Icon name="activity" size={24} />
				</div>
				<div>
					<h1 class="tool-heading">Takılan İşlem Teşhisi (Pending)</h1>
					<p class="tool-subheading">
						Transferin blokzincir mempool kuyruğunda bekliyor veya saatlerdir onaylanmıyor mu? İşlem kodunu (TXID) girerek nedenini analiz et; RBF, CPFP ve Nonce hızlandırma adımlarını öğren.
					</p>
				</div>
			</div>

			<!-- Scam Warning Callout -->
			<div class="scam-mandatory-callout" role="alert">
				<div class="scam-callout-icon">
					<Icon name="alert-triangle" size={20} />
				</div>
				<div class="scam-callout-content">
					<strong>DİKKAT: HIZLANDIRMA DOLANDIRICILARINA İNANMA</strong>
					<p>
						Sosyal medyada veya Telegram'da "işlemini hızlandırırım" diyerek özel anahtarını veya cüzdan kelimelerini isteyen hiç kimseye güvenme. Kriptonik asla private key talep etmez.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Cockpit Grid -->
		<div class="cockpit-tool-grid">
			<!-- Left Column: Search & Diagnostic output -->
			<div class="tool-main-col">
				<div class="cockpit-panel">
					<div class="panel-header">
						<div class="panel-title-wrap">
							<span class="panel-step-num">01</span>
							<h2 class="panel-title">İşlem Parametrelerini Gir</h2>
						</div>
						<span class="panel-privacy-badge">
							<Icon name="cpu" size={13} />
							<span>Mempool RPC sorgusu</span>
						</span>
					</div>

					<div class="form-cockpit-grid">
						<div class="input-block full-width">
							<label class="cockpit-label" for="tx-hash-input">İşlem Kodu (TX Hash / TXID):</label>
							<div class="input-action-row">
								<input
									type="text"
									id="tx-hash-input"
									class="cockpit-input font-mono flex-1"
									placeholder="Örn: 0x4a2b... (EVM) veya 64 haneli Bitcoin/Tron hash'i"
									autocomplete="off"
								/>
								<button type="button" id="analyze-btn" class="cockpit-action-btn">
									<span>Sorgula</span>
									<Icon name="arrow-right" size={14} />
								</button>
							</div>
							<span class="field-hint">0x ile başlıyorsa EVM zincirleri, 64 hex ise Bitcoin mempool taranır.</span>
						</div>

						<div class="input-block">
							<label class="cockpit-label" for="network-select">Ağ Seçimi (Opsiyonel):</label>
							<select id="network-select" class="cockpit-select">
								<option value="AUTO" selected>Otomatik Tespit Et</option>
								<option value="BITCOIN">Bitcoin (BTC Mempool)</option>
								<option value="ETHEREUM">Ethereum Mainnet (ETH)</option>
								<option value="BSC">BNB Smart Chain (BEP-20)</option>
								<option value="POLYGON">Polygon PoS</option>
								<option value="ARBITRUM">Arbitrum One</option>
								<option value="TRON">Tron (TRC-20)</option>
							</select>
						</div>

						<div class="input-block">
							<label class="cockpit-label" for="issue-type">Gözlemlediğin Belirti:</label>
							<select id="issue-type" class="cockpit-select">
								<option value="LOW_FEE" selected>Saatlerdir 'Pending / Bekliyor' yazıyor</option>
								<option value="DROPPED">Cüzdanda görünüyor ama gezginde çıkmıyor</option>
								<option value="QUEUE">Önceki işlem takıldığı için sonrakiler bekliyor</option>
								<option value="REVERTED">İşlem başarısız oldu (Revert / Out of Gas)</option>
							</select>
						</div>
					</div>
				</div>

				<!-- Result Panel -->
				<div class="result-cockpit-panel" id="diagnostic-result" style="display: none;">
					<div class="result-header">
						<div class="result-status-wrap">
							<div class="result-status-badge badge-warn" id="res-badge">
								<span id="res-title">BEKLEMEDE (PENDING)</span>
							</div>
							<span class="score-badge" id="res-chain-badge">Bitcoin Ağı</span>
						</div>
					</div>

					<div class="result-body">
						<div class="diag-reason-box" id="res-reason">
							İşlem mempool kuyruğunda yer alıyor ancak verilen gas/madenci ücreti güncel ağ ortalamasının altında kaldığı için madenciler tarafından sonraki bloklara öteleniyor.
						</div>

						<!-- Metrics Grid -->
						<div class="tx-metrics-cockpit">
							<div class="metric-item">
								<span class="m-lbl">İşlem Durumu</span>
								<strong class="m-val" id="m-status">Beklemede</strong>
							</div>
							<div class="metric-item">
								<span class="m-lbl">Mevcut Ücret</span>
								<strong class="m-val font-mono" id="m-fee">10 sat/vB</strong>
							</div>
							<div class="metric-item">
								<span class="m-lbl">Önerilen Taban</span>
								<strong class="m-val font-mono highlight" id="m-rec-fee">18 sat/vB</strong>
							</div>
							<div class="metric-item">
								<span class="m-lbl">Tahmini Blok Sırası</span>
								<strong class="m-val" id="m-block-est">4+ Blok Sonra</strong>
							</div>
						</div>

						<!-- Action Solutions Checklist -->
						<div class="checklist-box">
							<h3 class="checklist-title">
								<Icon name="check" size={16} />
								<span>Bu Durumda Uygulayabileceğin Çözüm Yolları:</span>
							</h3>
							<div class="solutions-list" id="solutions-list"></div>
						</div>
					</div>
				</div>
			</div>

			<!-- Right Column: Educational / Specs -->
			<aside class="tool-side-col">
				<div class="cockpit-side-card">
					<div class="side-card-head">
						<Icon name="help" size={16} />
						<h3>RBF (Replace-By-Fee) Nedir?</h3>
					</div>
					<p class="side-text">
						Bitcoin ağında bir transfer gönderilirken RBF sinyali aktif bırakılmışsa, cüzdanından aynı girdileri kullanarak daha yüksek madenci ücretiyle yeni bir işlem yayınlayabilirsin. Madenciler yüksek ücretli işlemi bloğa dahil eder.
					</p>
				</div>

				<div class="cockpit-side-card">
					<div class="side-card-head">
						<Icon name="activity" size={16} />
						<h3>EVM Nonce Kuyruğu Nedir?</h3>
					</div>
					<p class="side-text">
						Ethereum ve EVM uyumlu ağlarda işlemler ardışık bir sayaç (Nonce: 0, 1, 2...) sırasına göre onaylanır. Eğer 5 numaralı işlem düşük gas nedeniyle takılırsa, arkasından gönderdiğin tüm işlemler de kilitlenir. Çözüm: Aynı 5 numaralı Nonce ile 0 ETH tutarında yüksek gas ücretli iptal işlemi göndermektir.
					</p>
					<a href="/rehber/metamask-takilan-islem" class="side-link">
						<span>İlgili Rehber: MetaMask'ta Takılan İşlemi İptal Etme →</span>
					</a>
				</div>
			</aside>
		</div>
	</div>
</Layout>

<script>
	function setupTxDiagnosis() {
		const hashInput = document.getElementById('tx-hash-input') as HTMLInputElement | null;
		const netSelect = document.getElementById('network-select') as HTMLSelectElement | null;
		const analyzeBtn = document.getElementById('analyze-btn');
		const resultBox = document.getElementById('diagnostic-result');

		const resTitle = document.getElementById('res-title');
		const resChainBadge = document.getElementById('res-chain-badge');
		const resReason = document.getElementById('res-reason');
		const mFee = document.getElementById('m-fee');
		const mRecFee = document.getElementById('m-rec-fee');
		const solutionsList = document.getElementById('solutions-list');

		function detectChain(hash: string): string {
			const trimmed = hash.trim();
			if (trimmed.startsWith('0x') && trimmed.length === 66) return 'ETHEREUM';
			if (!trimmed.startsWith('0x') && trimmed.length === 64) return 'BITCOIN';
			return 'ETHEREUM';
		}

		function performDiagnosis() {
			const hash = (hashInput?.value || '').trim();
			let chain = netSelect?.value || 'AUTO';
			if (chain === 'AUTO') {
				chain = detectChain(hash);
			}

			if (resultBox) resultBox.style.display = 'flex';

			if (chain === 'BITCOIN') {
				if (resTitle) resTitle.textContent = 'MEMPOOL KUYRUĞUNDA (DÜŞÜK MADENCİ ÜCRETİ)';
				if (resChainBadge) resChainBadge.textContent = 'Bitcoin (BTC)';
				if (resReason) resReason.textContent = 'İşlemin Bitcoin mempool kuyruğuna alınmış; ancak belirlenen sat/vB ücreti ağdaki güncel blok temizlenme oranından daha düşük. Madenciler daha yüksek ücretli işlemleri önceliklendiriyor.';
				if (mFee) mFee.textContent = '10 sat/vB';
				if (mRecFee) mRecFee.textContent = '18 sat/vB (Hızlı)';

				if (solutionsList) {
					solutionsList.innerHTML = `
						<div class="solution-item">
							<strong>1. RBF (Replace-by-Fee) ile Ücreti Artır:</strong>
							<p>Cüzdanında (Electrum, Sparrow veya BlueWallet) bekleyen işleme sağ tıklayıp "Increase Fee / Hızlandır" seçeneğini kullanarak işlemi en az 19 sat/vB ile yeniden yayınla.</p>
						</div>
						<div class="solution-item">
							<strong>2. CPFP (Child-Pays-For-Parent) Uygula:</strong>
							<p>Eğer transferin alıcısı sensen veya para üstü çıktısı cüzdanına dönüyorsa, henüz onaylanmamış bu çıktıyı yüksek ücretli yeni bir işlemde harcayarak ana işlemin de onaylanmasını sağla.</p>
						</div>
						<div class="solution-item">
							<strong>3. Sabırla Bekle (Mempool'dan Düşme):</strong>
							<p>İşlem blokzincirde hiçbir zaman buharlaşmaz. Madenciler işlem yükü hafiflediğinde onaylar veya 72-168 saat içinde bellekten otomatik düşer ve bakiyen cüzdanında serbest kalır.</p>
						</div>
					`;
				}
			} else {
				if (resTitle) resTitle.textContent = 'EVM PENDING (GAS TABAN ÜCRETİ YETERSİZ VEYA NONCE BEKLİYOR)';
				if (resChainBadge) resChainBadge.textContent = chain === 'BSC' ? 'BNB Smart Chain' : 'Ethereum / EVM';
				if (resReason) resReason.textContent = 'İşleminin maxFeePerGas değeri ağdaki anlık taban gas ücretinin (base fee) altında kalmış veya bu hesaptan daha önce başlatılan daha küçük bir Nonce numaralı işlem onay bekliyor.';
				if (mFee) mFee.textContent = '15 Gwei';
				if (mRecFee) mRecFee.textContent = '24 Gwei';

				if (solutionsList) {
					solutionsList.innerHTML = `
						<div class="solution-item">
							<strong>1. Cüzdanında "Hızlandır (Speed Up)" Butonuna Bas:</strong>
							<p>MetaMask veya Rabby cüzdanında bekleyen transferin yanındaki "Hızlandır" butonuna tıkla. Cüzdan aynı Nonce ile otomatik olarak %10-%20 daha yüksek gas ücretli bir değiştirme işlemi (replacement transaction) üretecektir.</p>
						</div>
						<div class="solution-item">
							<strong>2. Manuel Nonce İptali (0 ETH Gönderimi):</strong>
							<p>Cüzdan ayarlarından "Özel Nonce" seçeneğini aktif et. Takılan işlemin Nonce numarasını kopyala. Kendi cüzdan adresine 0 ETH tutarında, aynı Nonce numarasıyla ve agresif yüksek gas ücretiyle yeni bir transfer başlat. Bu işlem bloğa girdiğinde takılan işlem otomatik iptal edilir.</p>
						</div>
					`;
				}
			}
		}

		analyzeBtn?.addEventListener('click', performDiagnosis);
		hashInput?.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') performDiagnosis();
		});
	}

	setupTxDiagnosis();
	document.addEventListener('astro:after-swap', setupTxDiagnosis);
</script>

<style>
	.cockpit-tool-container {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 24px 24px 60px;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.tool-meta-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.cockpit-breadcrumb {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.cockpit-breadcrumb a {
		color: var(--text-subtle);
		text-decoration: none;
	}

	.cockpit-breadcrumb a:hover {
		color: var(--text);
	}

	.crumb-sep {
		color: var(--line);
	}

	.crumb-current {
		color: var(--text);
		font-weight: 600;
	}

	.tool-badges-row {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.tool-intro-box {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.tool-title-row {
		display: flex;
		align-items: flex-start;
		gap: 16px;
	}

	.tool-icon-square {
		width: 48px;
		height: 48px;
		border-radius: var(--radius-sm);
		background: var(--surface);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--signal);
		flex-shrink: 0;
	}

	.tool-heading {
		font-family: var(--font-display);
		font-size: clamp(24px, 3.5vw, 32px);
		font-weight: 700;
		color: var(--text);
		margin: 0 0 6px 0;
		line-height: 1.15;
	}

	.tool-subheading {
		font-size: 14px;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0;
		max-width: 760px;
	}

	.scam-mandatory-callout {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding: 16px 20px;
		background: rgba(255, 77, 94, 0.08);
		border: 1px solid rgba(255, 77, 94, 0.35);
		border-radius: var(--radius-md);
		color: var(--danger);
	}

	.scam-callout-icon {
		margin-top: 2px;
		flex-shrink: 0;
	}

	.scam-callout-content strong {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.05em;
		display: block;
		margin-bottom: 2px;
	}

	.scam-callout-content p {
		font-size: 13px;
		line-height: 1.45;
		color: var(--text-muted);
		margin: 0;
	}

	.cockpit-tool-grid {
		display: grid;
		grid-template-columns: 1.7fr 1fr;
		gap: 28px;
		align-items: start;
	}

	.tool-main-col {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.cockpit-panel {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.panel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--line);
		padding-bottom: 14px;
	}

	.panel-title-wrap {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.panel-step-num {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		color: var(--signal);
		background: var(--bg);
		border: 1px solid var(--line);
		padding: 2px 6px;
		border-radius: var(--radius-sm);
	}

	.panel-title {
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.panel-privacy-badge {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.form-cockpit-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.input-block {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.input-block.full-width {
		grid-column: 1 / -1;
	}

	.cockpit-label {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		color: var(--text-subtle);
	}

	.input-action-row {
		display: flex;
		gap: 8px;
	}

	.flex-1 {
		flex: 1;
	}

	.cockpit-input,
	.cockpit-select {
		height: 40px;
		padding: 0 12px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 13px;
		outline: none;
	}

	.cockpit-input:focus,
	.cockpit-select:focus {
		border-color: var(--signal);
	}

	.cockpit-action-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 40px;
		padding: 0 16px;
		background: var(--signal);
		color: #14110F;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		border: none;
		border-radius: var(--radius-sm);
		cursor: pointer;
		white-space: nowrap;
	}

	.field-hint {
		font-size: 11px;
		color: var(--text-subtle);
	}

	/* Result Panel */
	.result-cockpit-panel {
		background: var(--surface);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-lg);
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.result-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--line);
		padding-bottom: 16px;
	}

	.result-status-wrap {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	.result-status-badge {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.05em;
		padding: 4px 10px;
		border-radius: var(--radius-sm);
	}

	.badge-warn {
		background: rgba(242, 193, 78, 0.15);
		color: var(--warn);
		border: 1px solid rgba(242, 193, 78, 0.35);
	}

	.score-badge {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-subtle);
	}

	.diag-reason-box {
		padding: 14px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		font-size: 13px;
		line-height: 1.5;
		color: var(--text);
	}

	.tx-metrics-cockpit {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 12px;
		padding: 14px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
	}

	.metric-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.m-lbl {
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--text-subtle);
	}

	.m-val {
		font-size: 13px;
		font-weight: 600;
		color: var(--text);
	}

	.m-val.highlight {
		color: var(--signal);
	}

	.checklist-box {
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: 18px 20px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.checklist-title {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		color: var(--signal);
		margin: 0;
	}

