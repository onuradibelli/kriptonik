---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import StatusPill from '../../components/ui/StatusPill.astro';

const pageTitle = "Gerçek Transfer Maliyeti Karşılaştırıcı | Kriptonik";
const pageDesc = "TL ile kripto alırken veya satarken en ucuz yol hangisi? Komisyon, spread ve ağ çekim ücreti dahil net rota analizi.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="cockpit-tool-container">
		<!-- Breadcrumb & Badges -->
		<div class="tool-meta-bar">
			<nav class="cockpit-breadcrumb" aria-label="Gezinti">
				<a href="/">Ana Sayfa</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<a href="/araclar">Araçlar</a>
				<Icon name="chevron-right" size={12} class="crumb-sep" />
				<span class="crumb-current">Gerçek Maliyet Karşılaştırıcı</span>
			</nav>

			<div class="tool-badges-row">
				<StatusPill status="live" label="Canlı" />
				<StatusPill dataFlow="client" />
			</div>
		</div>

		<!-- Tool Header -->
		<div class="tool-intro-box">
			<div class="tool-title-row">
				<div class="tool-icon-square">
					<Icon name="layers" size={24} />
				</div>
				<div>
					<h1 class="tool-heading">Gerçek Maliyet Karşılaştırıcı</h1>
					<p class="tool-subheading">
						Borsaların "sıfır komisyon" reklamlarına aldanma. Gerçek maliyet komisyon, alış/satış spread farkı ve blokzincir transfer çekim ücretinin toplamıdır.
					</p>
				</div>
			</div>

			<!-- Mandatory Affiliate / Independence Notice -->
			<div class="disclosure-mandatory-box">
				<Icon name="shield-check" size={16} />
				<span><strong>Bağımsız Sıralama Taahhüdü:</strong> Bu araçtaki borsa sıralamaları ve hesaplama formülleri reklam veya affiliate gelirlerinden kesinlikle etkilenmez; tamamen matematiksel maliyete göre listelenir.</span>
			</div>
		</div>

		<!-- Tool Interface -->
		<div class="cockpit-panel">
			<div class="panel-header">
				<div class="panel-title-wrap">
					<span class="panel-step-num">01</span>
					<h2 class="panel-title">İşlem Hacmini ve Yönünü Seç</h2>
				</div>
				<span class="panel-privacy-badge">
					<Icon name="shield-check" size={13} />
					<span>Tarayıcında hesaplanır</span>
				</span>
			</div>

			<div class="tool-form-grid">
				<div class="form-group">
					<label class="form-label" for="direction-select">İşlem Yönü:</label>
					<select id="direction-select" class="form-select">
						<option value="BUY" selected>TL ile Kripto Satın Alma (Banka → Kripto)</option>
						<option value="SELL">Kriptoyu TL'ye Dönüştürüp Bankaya Çekme</option>
					</select>
				</div>

				<div class="form-group">
					<label class="form-label" for="amount-input">İşlem Tutarı (TL):</label>
					<input type="number" id="amount-input" class="form-input" value="10000" min="500" step="500" />
				</div>

				<div class="form-group">
					<label class="form-label" for="target-coin">Hedef Varlık:</label>
					<select id="target-coin" class="form-select">
						<option value="USDT" selected>USDT (Tether USD)</option>
						<option value="BTC">Bitcoin (BTC)</option>
						<option value="ETH">Ethereum (ETH)</option>
					</select>
				</div>

				<div class="form-group">
					<label class="form-label" for="withdraw-net">Çekim / Transfer Ağı:</label>
					<select id="withdraw-net" class="form-select">
						<option value="TRC20" selected>TRON (TRC-20) - Popüler & Ucuz</option>
						<option value="BEP20">BNB Chain (BEP-20) - Çok Düşük Ücret</option>
						<option value="ARBITRUM">Arbitrum One - Ultra Düşük Ücret</option>
						<option value="ERC20">Ethereum (ERC-20) - Yüksek Ağ Ücreti</option>
					</select>
				</div>
			</div>

			<!-- Comparison Results Table -->
			<div class="results-dashboard">
				<div class="table-header-row">
					<span class="res-title">📊 Rota Karşılaştırma Sıralaması (En Ucuzdan En Pahalıya):</span>
					<span class="affiliate-notice">Sıralama komisyona göre değil, gerçek maliyete göre yapılır.</span>
				</div>

				<div class="comparison-cards" id="comparison-cards"></div>
			</div>
		</div>

		<!-- Explanatory Content -->
		<div class="info-accordion">
			<details class="accordion-item" open>
				<summary class="accordion-summary">
					<span>💡 Kripto Alırken Karşılaştığınız 3 Gizli Maliyet Nedir?</span>
					<span class="arrow">↓</span>
				</summary>
				<div class="accordion-content">
					<p>Çoğu kullanıcı sadece borsa alım-satım komisyonuna bakar, ancak toplam maliyeti belirleyen 3 ana unsur vardır:</p>
					<ul>
						<li><strong>1. Piyasa Komisyonu (Maker/Taker):</strong> İşlem başına borsanın kestiği %0.05 ile %0.25 arasındaki açık ücret.</li>
						<li><strong>2. Spread (Makas Farkı):</strong> Küresel kur ile borsadaki tahta derinliği arasındaki alış-satış farkı. Düşük likiditeli borsalarda %0.5'e kadar gizli maliyet yaratabilir.</li>
						<li><strong>3. Ağ Çekim Ücreti (Withdrawal Fee):</strong> Aldığınız kriptoyu kişisel cüzdanınıza veya başka borsaya aktarırken ödenen ücret. Örneğin Arbitrum ile 10 TL öderken, ERC-20 ile 200 TL ödeyebilirsiniz.</li>
					</ul>
				</div>
			</details>
		</div>

		<!-- Related Tools -->
		<div class="related-tools">
			<h3 class="related-title">İlgili Diğer Araçlar:</h3>
			<div class="related-grid">
				<a href="/araclar/dca-simulator" class="related-card">
					<span class="r-icon">📈</span>
					<div>
						<strong>DCA Geri Test Simülatörü</strong>
						<p>Düzenli alım simülasyonuyla kârınızı hesaplayın.</p>
					</div>
				</a>
				<a href="/araclar/adres-ag-eslestirici" class="related-card">
					<span class="r-icon">🔍</span>
					<div>
						<strong>Adres Ağ Eşleştirici</strong>
						<p>Seçtiğiniz çekim ağının cüzdanınızla uyumlu olduğunu teyit edin.</p>
					</div>
				</a>
			</div>
		</div>
	</div>
</Layout>

<script>
	const dirSelect = document.getElementById('direction-select') as HTMLSelectElement;
	const amtInput = document.getElementById('amount-input') as HTMLInputElement;
	const coinSelect = document.getElementById('target-coin') as HTMLSelectElement;
	const netSelect = document.getElementById('withdraw-net') as HTMLSelectElement;
	const cardsContainer = document.getElementById('comparison-cards');

	interface ExchangeProfile {
		name: string;
		makerFeePct: number;
		spreadPct: number;
		withdrawFeeUsd: Record<string, number>;
		badge?: string;
	}

	const exchanges: ExchangeProfile[] = [
		{
			name: "Binance TR",
			makerFeePct: 0.10,
			spreadPct: 0.08,
			withdrawFeeUsd: { TRC20: 1.0, BEP20: 0.3, ARBITRUM: 0.2, ERC20: 3.5 },
			badge: "Yüksek Likidite"
		},
		{
			name: "BtcTurk | Kripto",
			makerFeePct: 0.12,
			spreadPct: 0.12,
			withdrawFeeUsd: { TRC20: 1.2, BEP20: 0.5, ARBITRUM: 0.4, ERC20: 4.0 },
			badge: "Kolay Banka Transferi"
		},
		{
			name: "Paribu",
			makerFeePct: 0.25,
			spreadPct: 0.20,
			withdrawFeeUsd: { TRC20: 1.5, BEP20: 0.6, ARBITRUM: 0.5, ERC20: 5.0 },
			badge: "Hızlı Arayüz"
		}
	];

	function calculateComparison() {
		if (!dirSelect || !amtInput || !coinSelect || !netSelect || !cardsContainer) return;

		const amount = parseFloat(amtInput.value) || 10000;
		const net = netSelect.value;
		const coin = coinSelect.value;
		const usdTry = 38.5; // realistic benchmark rate

		const results = exchanges.map(ex => {
			const feeCost = amount * (ex.makerFeePct / 100);
			const spreadCost = amount * (ex.spreadPct / 100);
			const withdrawCostUsd = ex.withdrawFeeUsd[net] || 1.0;
			const withdrawCostTry = withdrawCostUsd * usdTry;

			const totalCostTry = feeCost + spreadCost + withdrawCostTry;
			const effectivePct = (totalCostTry / amount) * 100;
			const netAvailableTry = amount - totalCostTry;

			let receivedCoin = '';
			if (coin === 'USDT') {
				receivedCoin = (netAvailableTry / usdTry).toFixed(2) + ' USDT';
			} else if (coin === 'BTC') {
				receivedCoin = (netAvailableTry / (92000 * usdTry)).toFixed(6) + ' BTC';
			} else {
				receivedCoin = (netAvailableTry / (3400 * usdTry)).toFixed(4) + ' ETH';
			}

			return {
				name: ex.name,
				badge: ex.badge,
				feeCost,
				spreadCost,
				withdrawCostTry,
				totalCostTry,
				effectivePct,
				netAvailableTry,
				receivedCoin
			};
		});

		// Sort cheapest first
		results.sort((a, b) => a.totalCostTry - b.totalCostTry);

		let html = '';
		results.forEach((item, index) => {
			const isBest = index === 0;
			html += `
				<div class="compare-card ${isBest ? 'best-choice' : ''}">
					<div class="card-top">
						<div class="exchange-info">
							${isBest ? '<span class="best-badge">🏆 EN UCUZ ROTA</span>' : ''}
							<h3 class="ex-name">${item.name}</h3>
							<span class="ex-badge">${item.badge}</span>
						</div>
						<div class="final-result">
							<span class="res-label">Net Elinize Geçecek:</span>
							<span class="res-val mono-text ${isBest ? 'text-accent' : ''}">${item.receivedCoin}</span>
						</div>
					</div>

					<div class="cost-breakdown">
						<div class="cost-item">
							<span class="c-label">Borsa Komisyonu:</span>
							<span class="c-val mono-text">₺${item.feeCost.toFixed(1)}</span>
						</div>
						<div class="cost-item">
							<span class="c-label">Tahmini Spread (Makas):</span>
							<span class="c-val mono-text">₺${item.spreadCost.toFixed(1)}</span>
						</div>
						<div class="cost-item">
							<span class="c-label">Ağ Çekim Ücreti:</span>
							<span class="c-val mono-text">₺${item.withdrawCostTry.toFixed(1)}</span>
						</div>
						<div class="cost-item total-cost-item">
							<span class="c-label">Toplam Maliyet:</span>
							<span class="c-val mono-text font-bold ${isBest ? 'text-success' : ''}">₺${item.totalCostTry.toFixed(1)} (%${item.effectivePct.toFixed(2)})</span>
						</div>
					</div>
				</div>
			`;
		});

		cardsContainer.innerHTML = html;
	}

	dirSelect?.addEventListener('change', calculateComparison);
	amtInput?.addEventListener('input', calculateComparison);
	coinSelect?.addEventListener('change', calculateComparison);
	netSelect?.addEventListener('change', calculateComparison);

	calculateComparison();
</script>

<style>
	.tool-page {
		padding: 32px 24px 80px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: var(--text-dim);
		margin-bottom: 24px;
	}

	.breadcrumb a {
		color: var(--text-muted);
	}

	.breadcrumb .current {
		color: #CBD5E1;
	}

	.tool-header {
		margin-bottom: 32px;
	}

	.tool-title {
		font-size: 38px;
		font-weight: 700;
		margin: 12px 0 8px;
		letter-spacing: -0.5px;
	}

	.tool-subtitle {
		font-size: 17px;
		color: var(--text-muted);
		max-width: 760px;
		line-height: 1.6;
	}

	.tool-card {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
		margin-bottom: 40px;
	}

	.tool-card-head {
		background: #0E1322;
		border-bottom: 1px solid var(--surface-border);
		padding: 16px 24px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.step-indicator {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.step-badge {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		background: var(--accent-cyan);
		color: #0B0F1A;
		padding: 3px 8px;
		border-radius: 4px;
	}

	.step-title {
		font-weight: 600;
		font-size: 15px;
		color: #F8FAFC;
	}

	.privacy-note {
		font-size: 12px;
		color: var(--text-dim);
	}

	.tool-form-grid {
		padding: 28px 24px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.results-dashboard {
		background: #0B0F1A;
		border-top: 1px solid var(--surface-border);
		padding: 28px 24px;
	}

	.table-header-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 20px;
		flex-wrap: wrap;
		gap: 10px;
	}

	.res-title {
		font-size: 15px;
		font-weight: 700;
		color: #F8FAFC;
	}

	.affiliate-notice {
		font-size: 12px;
		color: var(--text-dim);
	}

	.comparison-cards {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.compare-card {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		padding: 20px;
		transition: border-color 0.2s, transform 0.2s;
	}

	.best-choice {
		border-color: rgba(34, 211, 238, 0.5);
		background: linear-gradient(180deg, #162035 0%, #121829 100%);
		box-shadow: 0 4px 20px rgba(34, 211, 238, 0.15);
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 16px;
		flex-wrap: wrap;
		gap: 12px;
	}

	.exchange-info {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
	}

	.best-badge {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		background: rgba(34, 211, 238, 0.2);
		border: 1px solid var(--accent-cyan);
		color: var(--accent-cyan);
		padding: 3px 8px;
		border-radius: 4px;
	}

	.ex-name {
		font-size: 18px;
		font-weight: 700;
		color: #F8FAFC;
	}

	.ex-badge {
		font-size: 11px;
		background: rgba(255, 255, 255, 0.06);
		color: #94A3B8;
		padding: 2px 8px;
		border-radius: 4px;
	}

	.final-result {
		text-align: right;
	}

	.res-label {
		display: block;
		font-size: 11px;
		color: var(--text-dim);
		margin-bottom: 2px;
	}

	.res-val {
		font-size: 20px;
		font-weight: 700;
		color: #F8FAFC;
	}

	.text-accent {
		color: var(--accent-cyan);
	}

	.text-success {
		color: #34D399;
	}

	.cost-breakdown {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 12px;
		padding-top: 14px;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.cost-item {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.c-label {
		font-size: 11px;
		color: var(--text-dim);
	}

	.c-val {
		font-size: 13px;
		color: #CBD5E1;
	}

	.total-cost-item .c-label {
		color: #94A3B8;
		font-weight: 600;
	}

	.info-accordion {
		margin-bottom: 32px;
	}

	.accordion-item {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		overflow: hidden;
	}

	.accordion-summary {
		padding: 18px 24px;
		font-weight: 600;
		font-size: 16px;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.accordion-content {
		padding: 0 24px 20px;
		font-size: 14px;
		color: #CBD5E1;
		line-height: 1.7;
	}

	.accordion-content ul {
		padding-left: 20px;
		margin-top: 10px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.related-tools {
		margin-top: 48px;
	}

	.related-title {
		font-size: 20px;
		font-weight: 700;
		margin-bottom: 16px;
	}

	.related-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.related-card {
		background: var(--surface-dark);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		padding: 18px;
		display: flex;
		align-items: flex-start;
		gap: 14px;
		text-decoration: none;
		transition: border-color 0.2s, transform 0.2s;
	}

	.related-card:hover {
		border-color: var(--accent-cyan);
		transform: translateY(-2px);
	}

	.r-icon {
		font-size: 24px;
	}

	.related-card strong {
		display: block;
		font-size: 15px;
		color: #F8FAFC;
		margin-bottom: 4px;
	}

	.related-card p {
		font-size: 13px;
		color: var(--text-muted);
		margin: 0;
	}

	@media (max-width: 768px) {
		.tool-form-grid, .related-grid {
			grid-template-columns: 1fr;
		}
		.final-result {
			text-align: left;
		}
		.tool-title {
			font-size: 28px;
		}
	}
</style>
