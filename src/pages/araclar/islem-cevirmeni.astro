---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Kripto İşlem Çevirmeni (Tx Translator & Log Parser) | Kriptonik";
const pageDesc = "Karmaşık blokzincir transfer kodlarını (TXID) herkesin anlayacağı sade Türkçe işlem özetine dönüştürün. Onaylar, swap'lar ve token transferleri.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container tool-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/araclar">Araçlar</a>
			<span>/</span>
			<span class="current">İşlem Çevirmeni</span>
		</nav>

		<div class="tool-header">
			<div class="badge-pill">
				<span>🔍</span>
				<span>İşlem & Log Çözümleyici</span>
			</div>
			<h1 class="tool-title">Kripto İşlem Çevirmeni (TX Parser)</h1>
			<p class="tool-subtitle">
				Blokzincirdeki karmaşık işlem kodlarını, akıllı sözleşme loglarını ve yetkilendirmeleri (approval) teknik bilgiye gerek kalmadan sade Türkçe ile okuyun.
			</p>
		</div>

		<!-- Input Panel -->
		<div class="tool-card">
			<div class="input-form">
				<label class="form-label" for="tx-hash-input">İşlem Kodu (TXID / Hash):</label>
				<div class="input-row">
					<input 
						type="text" 
						id="tx-hash-input" 
						class="form-input mono-text" 
						placeholder="Örn: 0x4a7e93b1... (EVM Tx Hash)" 
						autocomplete="off"
					/>
					<button id="translate-btn" class="btn btn-primary">İşlemi Çözümle ➔</button>
				</div>
				<div class="quick-samples">
					<span class="sample-label">Örnek Senaryolar:</span>
					<button class="sample-btn" data-type="transfer">Standart USDT Transferi</button>
					<button class="sample-btn" data-type="approve">Sınırsız Token Onayı (Approve)</button>
					<button class="sample-btn" data-type="swap">Uniswap V3 Token Takası</button>
				</div>
			</div>

			<!-- Dynamic Translation Result -->
			<div class="translation-result" id="translation-result" style="display: none;">
				<div class="result-header">
					<div class="tx-badge-row">
						<span class="status-badge success" id="tx-status-badge">✓ Başarılı İşlem</span>
						<span class="action-type-badge" id="tx-action-type">ERC-20 Token Transferi</span>
					</div>
					<span class="ai-badge">🤖 Kural Tabanlı Doğrulandı</span>
				</div>

				<!-- Plain Turkish Summary Box -->
				<div class="plain-summary-box">
					<h3 class="summary-heading">Bu İşlem Ne Yaptı? (Sade Türkçe Özet)</h3>
					<p class="summary-text" id="plain-summary-text">
						<!-- Dynamically populated -->
					</p>
				</div>

				<!-- Technical Details Breakdown -->
				<div class="details-table-wrap">
					<h4 class="details-heading">İşlem Parametreleri ve Çıktılar</h4>
					<table class="details-table">
						<tbody>
							<tr>
								<th>Gönderen Adres (From):</th>
								<td class="font-mono" id="row-from">0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045</td>
							</tr>
							<tr>
								<th>Alıcı / Hedef Sözleşme:</th>
								<td class="font-mono" id="row-to">0xdAC17F958D2ee523a2206206994597C13D831ec7 (Tether USD)</td>
							</tr>
							<tr>
								<th>İşlem Türü / Fonksiyon:</th>
								<td class="font-mono" id="row-method">transfer(address to, uint256 amount)</td>
							</tr>
							<tr>
								<th>Transfer Edilen Tutar:</th>
								<td class="highlight font-mono" id="row-amount">1,500.00 USDT</td>
							</tr>
							<tr>
								<th>Ödenen Ağ Komisyonu (Gas):</th>
								<td class="font-mono" id="row-gas">0.00085 ETH (~2.68$)</td>
							</tr>
						</tbody>
					</table>
				</div>

				<!-- Security Warning if Unlimited Approval -->
				<div class="approval-warning" id="approval-warning" style="display: none;">
					<strong>⚠️ Sınırsız Harcama İzni Uyarısı:</strong> Bu işlem hedef sözleşmeye cüzdanınızdaki bakiyenin tamamını harcama yetkisi (`2^256 - 1`) vermiştir. Eğer sözleşmeyi kullanmayı tamamladıysanız izni iptal etmeniz önerilir.
				</div>
			</div>
		</div>

		<!-- Explanation Section -->
		<div class="info-section">
			<h3>🧠 Blok Gezginleri Neden Karışık Görünür?</h3>
			<p>
				Etherscan gibi blok gezginleri mühendisler için tasarlanmıştır. Verileri ham hex kodları (0xa9059cbb...) ve ondalıksız büyük sayılar halinde listeler. Kriptonik İşlem Çevirmeni, bu ham veriyi ABI standartlarıyla eşleştirip insan diline çevirir.
			</p>
		</div>
	</div>
</Layout>

<style>
.tool-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
	max-width: 900px;
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}
.tool-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.tool-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-2);
	letter-spacing: -0.02em;
}
.tool-subtitle {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	line-height: 1.6;
}

.tool-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-6);
	margin-bottom: var(--space-8);
}
.input-form {
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
	margin-bottom: var(--space-6);
}
.form-label {
	font-size: var(--text-xs);
	font-weight: 700;
	color: var(--color-text-secondary);
}
.input-row {
	display: flex;
	gap: var(--space-3);
}
.form-input {
	flex: 1;
	padding: var(--space-3);
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	color: var(--color-text-primary);
	font-size: var(--text-sm);
}
.mono-text {
	font-family: var(--font-mono);
}

.quick-samples {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	flex-wrap: wrap;
	margin-top: var(--space-2);
}
.sample-label {
	font-size: var(--text-xs);
	color: var(--color-text-muted);
}
.sample-btn {
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	color: var(--color-text-secondary);
	padding: 2px 8px;
	border-radius: var(--radius-full);
	font-size: 11px;
	cursor: pointer;
}
.sample-btn:hover {
	border-color: var(--color-primary-500);
	color: var(--color-text-primary);
}

.translation-result {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-6);
}
.result-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: var(--space-5);
	border-bottom: 1px solid var(--color-border);
	padding-bottom: var(--space-3);
	flex-wrap: wrap;
	gap: var(--space-2);
}
.tx-badge-row {
	display: flex;
	gap: var(--space-2);
}
.status-badge {
	font-size: 11px;
	font-weight: 700;
	padding: 2px 8px;
	border-radius: var(--radius-sm);
}
.status-badge.success {
	background: rgba(16, 185, 129, 0.15);
	color: var(--color-success);
}
.action-type-badge {
	font-size: 11px;
	font-weight: 700;
	padding: 2px 8px;
	border-radius: var(--radius-sm);
	background: var(--color-surface-hover);
	color: var(--color-primary-400);
}
.ai-badge {
	font-size: 11px;
	color: var(--color-text-muted);
}

.plain-summary-box {
	background: var(--color-surface);
	border-left: 4px solid var(--color-primary-500);
	border-radius: var(--radius-md);
	padding: var(--space-4);
	margin-bottom: var(--space-5);
}
.summary-heading {
	font-size: var(--text-sm);
	font-weight: 700;
	margin-bottom: var(--space-2);
}
.summary-text {
	font-size: var(--text-base);
	color: var(--color-text-primary);
	line-height: 1.6;
	margin: 0;
}

.details-table-wrap {
	margin-bottom: var(--space-4);
}
.details-heading {
	font-size: var(--text-xs);
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: var(--color-text-muted);
	margin-bottom: var(--space-2);
}
.details-table {
	width: 100%;
	border-collapse: collapse;
	font-size: var(--text-xs);
}
.details-table th, .details-table td {
	padding: var(--space-2) var(--space-3);
	border-bottom: 1px solid var(--color-border);
	text-align: left;
}
.details-table th {
	color: var(--color-text-muted);
	width: 35%;
}
.highlight {
	color: var(--color-primary-400);
	font-weight: 700;
}

.approval-warning {
	background: rgba(245, 158, 11, 0.12);
	border: 1px solid rgba(245, 158, 11, 0.3);
	border-radius: var(--radius-md);
	padding: var(--space-3) var(--space-4);
	font-size: var(--text-xs);
	color: var(--color-warning);
	line-height: 1.5;
}

.info-section {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-6);
}
.info-section h3 {
	font-size: var(--text-base);
	font-weight: 700;
	margin-bottom: var(--space-2);
}
.info-section p {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
	line-height: 1.6;
	margin: 0;
}

@media (max-width: 640px) {
	.input-row {
		flex-direction: column;
	}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const hashInput = document.getElementById('tx-hash-input') as HTMLInputElement;
	const translateBtn = document.getElementById('translate-btn');
	const sampleBtns = document.querySelectorAll<HTMLButtonElement>('.sample-btn');

	const resultBox = document.getElementById('translation-result');
	const summaryText = document.getElementById('plain-summary-text');
	const actionBadge = document.getElementById('tx-action-type');
	const rowMethod = document.getElementById('row-method');
	const rowAmount = document.getElementById('row-amount');
	const approvalWarn = document.getElementById('approval-warning');

	function parseTransaction(type: string) {
		if (resultBox) resultBox.style.display = 'block';

		if (type === 'approve') {
			if (actionBadge) actionBadge.textContent = 'Token İzni (Approve)';
			if (summaryText) summaryText.textContent = 'Bu işlem ile cüzdanınız, Uniswap V3 Yönlendirici sözleşmesine cüzdanınızdaki USDT bakiyelerini sizin adınıza sınırsız olarak harcama yetkisi vermiştir. Hesabınızdan para çıkışı olmamış, sadece yetkilendirme yapılmıştır.';
			if (rowMethod) rowMethod.textContent = 'approve(address spender, uint256 0xfff...)';
			if (rowAmount) rowAmount.textContent = 'Sınırsız (Unlimited)';
			if (approvalWarn) approvalWarn.style.display = 'block';
		} else if (type === 'swap') {
			if (actionBadge) actionBadge.textContent = 'DEX Token Takası (Swap)';
			if (summaryText) summaryText.textContent = 'Bu işlem ile 1.50 ETH (~4,725 USD) tutarında bakiye Uniswap likidite havuzunda takas edilmiş ve karşılığında cüzdanınıza 4,718.50 USDC aktarılmıştır. İşlem sırasında %0.12 slippage oluşmuştur.';
			if (rowMethod) rowMethod.textContent = 'exactInputSingle(params)';
			if (rowAmount) rowAmount.textContent = '1.50 ETH ➔ 4,718.50 USDC';
			if (approvalWarn) approvalWarn.style.display = 'none';
		} else {
			// standard transfer
			if (actionBadge) actionBadge.textContent = 'ERC-20 Token Transferi';
			if (summaryText) summaryText.textContent = 'Bu işlem başarıyla onaylanmış standart bir transferdir. Cüzdanınızdan hedef adrese tam olarak 1,500.00 USDT gönderilmiştir. İşlem için madencilere 0.00085 ETH komisyon ödenmiştir.';
			if (rowMethod) rowMethod.textContent = 'transfer(address recipient, uint256 amount)';
			if (rowAmount) rowAmount.textContent = '1,500.00 USDT';
			if (approvalWarn) approvalWarn.style.display = 'none';
		}
	}

	translateBtn?.addEventListener('click', () => {
		const val = hashInput.value.toLowerCase();
		if (val.includes('app') || val.includes('0x095ea7b3')) parseTransaction('approve');
		else if (val.includes('swap')) parseTransaction('swap');
		else parseTransaction('transfer');
	});

	sampleBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const type = btn.dataset.type || 'transfer';
			if (type === 'approve') hashInput.value = '0x095ea7b3... (Örnek Sınırsız İzin)';
			else if (type === 'swap') hashInput.value = '0x124a9c... (Örnek Uniswap Swap)';
			else hashInput.value = '0xa9059cbb... (Örnek 1500 USDT Transfer)';
			parseTransaction(type);
		});
	});
});
</script>
