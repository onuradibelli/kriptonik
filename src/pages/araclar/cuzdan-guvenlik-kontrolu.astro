	font-size: var(--text-xs);
	color: var(--color-text-muted);
	margin: 0;
	line-height: 1.5;
}

.security-info-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: var(--space-4);
}
.info-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-5);
}
.info-card h3 {
	font-size: var(--text-base);
	font-weight: 700;
	margin-bottom: var(--space-2);
}
.info-card p {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
	line-height: 1.6;
	margin: 0;
}

@media (max-width: 640px) {
	.score-card {
		flex-direction: column;
		align-items: flex-start;
	}
	.score-main {
		flex-direction: column;
		align-items: flex-start;
	}
	.security-info-grid {
		grid-template-columns: 1fr;
	}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const STORAGE_KEY = 'kriptonik_sec_checklist';
	const checkboxes = document.querySelectorAll<HTMLInputElement>('.check-box');
	const scoreVal = document.getElementById('score-val');
	const scoreCircle = document.getElementById('score-circle');
	const levelBadge = document.getElementById('score-level-badge');
	const summaryEl = document.getElementById('score-summary');
	const checkedCountEl = document.getElementById('checked-count');
	const critCountEl = document.getElementById('crit-count');
	const actionPlanBox = document.getElementById('action-plan-box');
	const actionPlanList = document.getElementById('action-plan-list');
	const resetBtn = document.getElementById('reset-btn');

	function calculateScore() {
		let totalScore = 0;
		let checkedCount = 0;
		let missingCriticals: Array<{ text: string; tip: string }> = [];

		const savedState: Record<string, boolean> = {};

		checkboxes.forEach(chk => {
			const label = chk.closest('.check-item') as HTMLElement;
			const weight = parseFloat(label?.dataset.weight || '0');
			const isCrit = label?.dataset.critical === 'true';
			const text = label?.querySelector('.item-text')?.textContent || '';
			const tip = label?.querySelector('.item-tip')?.textContent || '';
			const id = chk.id;

			savedState[id] = chk.checked;

			if (chk.checked) {
				totalScore += weight;
				checkedCount++;
			} else if (isCrit) {
				missingCriticals.push({ text, tip });
			}
		});

		// Persist state in localStorage
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(savedState));
		} catch (e) {}

		// Normalize score to max 100
		const finalScore = Math.min(100, Math.round(totalScore));
		if (scoreVal) scoreVal.textContent = finalScore.toString();

		if (checkedCountEl) checkedCountEl.textContent = `${checkedCount} / ${checkboxes.length} Tamamlandı`;
		if (critCountEl) critCountEl.textContent = `${missingCriticals.length} Kritik Risk`;

		// Status level & colors
		if (scoreCircle && levelBadge && summaryEl) {
			if (finalScore >= 90 && missingCriticals.length === 0) {
				scoreCircle.style.borderColor = 'var(--color-success)';
				levelBadge.style.background = 'rgba(16, 185, 129, 0.15)';
				levelBadge.style.color = 'var(--color-success)';
				levelBadge.textContent = 'MÜKEMMEL DÜZEYDE GÜVENLİ';
				summaryEl.textContent = 'Tüm temel ve operasyonel güvenlik standartlarını eksiksiz uyguluyorsunuz.';
			} else if (finalScore >= 75 && missingCriticals.length <= 1) {
				scoreCircle.style.borderColor = 'var(--color-primary-500)';
				levelBadge.style.background = 'rgba(59, 130, 246, 0.15)';
				levelBadge.style.color = 'var(--color-primary-400)';
				levelBadge.textContent = 'İYİ DÜZEYDE (BİRKAÇ EKSİK VAR)';
				summaryEl.textContent = 'Genel olarak güvendesiniz, ancak kalan birkaç önlemi tamamlamanız tavsiye edilir.';
			} else if (finalScore >= 50) {
				scoreCircle.style.borderColor = 'var(--color-warning)';
				levelBadge.style.background = 'rgba(245, 158, 11, 0.15)';
				levelBadge.style.color = 'var(--color-warning)';
				levelBadge.textContent = 'ORTA SEVİYE RİSK';
				summaryEl.textContent = 'Cüzdanınız temel saldırılara karşı kısmen savunmasız. Aşağıdaki acil aksiyonları uygulayın.';
			} else {
				scoreCircle.style.borderColor = 'var(--color-error)';
				levelBadge.style.background = 'rgba(239, 68, 68, 0.15)';
				levelBadge.style.color = 'var(--color-error)';
				levelBadge.textContent = 'KRİTİK GÜVENLİK RİSKİ';
				summaryEl.textContent = 'Tohum kelimeleriniz veya işlem hijyeniniz yüksek risk altında. Varlık kaybı yaşamadan önce derhal düzeltin.';
			}
		}

		// Action plan rendering
		if (actionPlanBox && actionPlanList) {
			if (missingCriticals.length > 0) {
				actionPlanBox.style.display = 'block';
				actionPlanList.innerHTML = missingCriticals.map(c => `
					<li>
						<strong>${c.text}</strong>
						<div style="font-size: 12px; color: var(--color-text-secondary); margin-top: 2px;">Aksiyon: ${c.tip}</div>
					</li>
				`).join('');
			} else {
				actionPlanBox.style.display = 'none';
			}
		}
	}

	// Restore from storage
	try {
		const raw = localStorage.getItem(STORAGE_KEY);
		if (raw) {
			const saved = JSON.parse(raw);
			checkboxes.forEach(chk => {
				if (saved[chk.id] !== undefined) {
					chk.checked = !!saved[chk.id];
				}
			});
		}
	} catch (e) {}

	// Listeners
	checkboxes.forEach(chk => chk.addEventListener('change', calculateScore));

	resetBtn?.addEventListener('click', () => {
		if (confirm('Tüm işaretleri sıfırlamak istediğinize emin misiniz?')) {
			checkboxes.forEach(chk => chk.checked = false);
			localStorage.removeItem(STORAGE_KEY);
			calculateScore();
		}
	});

	// Initial score calc
	calculateScore();
});
</script>
