---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Cüzdan Güvenlik Kontrolü & Risk Analizi (24 Madde) | Kriptonik";
const pageDesc = "24 maddelik kapsamlı cüzdan güvenlik denetimi ile kripto varlıklarınızı koruyun. 100 üzerinden güvenlik skoru ve kişiselleştirilmiş acil eylem planı oluşturun.";

const checklistCategories = [
	{
		id: 'temel',
		title: '1. Temel Güvenlik & Tohum Kelimeler (Seed Phrase)',
		weight: 35,
		items: [
			{ id: 't1', text: '12 veya 24 kelimelik kurtarma ifadem (seed phrase) ASLA telefon fotoğrafında, bulutta veya bilgisayar notlarında bulunmuyor.', weight: 10, critical: true, tip: 'Kurtarma cümlenizin dijital kopyası varsa cüzdanınız ele geçirilebilir. Sadece fiziksel kağıt veya metal plakalarda saklayın.' },
			{ id: 't2', text: 'Tohum kelimelerimi fiziksel kağıt veya paslanmaz çelik/titanyum plaka üzerine elle yazarak güvenceye aldım.', weight: 7, critical: true, tip: 'Yangın ve su baskını gibi felaketlere karşı metal plakalar en yüksek korumayı sağlar.' },
			{ id: 't3', text: 'Yedekleme plakasını su, yangın ve fiziksel hırsızlık risklerine karşı korunaklı, kilitli ve sadece benim bildiğim bir yerde tutuyorum.', weight: 6, critical: false, tip: 'Yedeklerinizi evinizdeki veya kasanızdaki güvenli bölmelerde saklayın.' },
			{ id: 't4', text: 'Cüzdanımı veya tohum kelimelerimi ASLA bir web sitesi formuna, Google Form\'a veya destek yetkilisi olduğunu iddia eden birine yazmadım.', weight: 8, critical: true, tip: 'Hiçbir resmi destek çalışanı, borsa veya protokol sizden tohum kelimelerinizi istemez. İsteyen herkes dolandırıcıdır.' },
			{ id: 't5', text: 'Cüzdan uygulamalarımı sadece resmi web sitelerinden veya doğrulanmış mağaza linklerinden indirdim.', weight: 4, critical: false, tip: 'Google arama sponsorlu reklamlarındaki sahte cüzdan klonlarına tıklamadığınızdan emin olun.' }
		]
	},
	{
		id: 'islem',
		title: '2. İşlem Hijyeni & Akıllı Sözleşme İzinleri',
		weight: 25,
		items: [
			{ id: 'i1', text: 'Düzenli aralıklarla (ayda en az bir kez) cüzdanımdaki sınırsız token onaylarını (token approvals) denetleyip gereksizleri iptal ediyorum.', weight: 6, critical: false, tip: 'DEX veya NFT platformlarına verdiğiniz sınırsız harcama izinleri gelecekteki bir hack durumunda risk yaratır.' },
			{ id: 'i2', text: 'İmza atmadan önce (özellikle `eth_sign` veya belirsiz izin talepleri) işlem detaylarını ve hedef sözleşmeyi mutlaka inceliyorum.', weight: 6, critical: true, tip: 'Körlemesine atılan permit/imzalar tüm bakiyenizin tek tıkla boşaltılmasına neden olabilir.' },
			{ id: 'i3', text: 'Büyük tutarlı transferler yapmadan önce her zaman sembolik bir küçük test transferi gönderiyorum.', weight: 4, critical: false, tip: 'Ağ ve adres hatasını 1 dolarlık test işlemiyle doğrulamak büyük felaketleri önler.' },
			{ id: 'i4', text: 'Cüzdanıma nereden geldiği belirsiz olan spam airdrop token veya NFT\'lerle ASLA etkileşime girmiyor ve linklerine tıklamıyorum.', weight: 5, critical: true, tip: 'Adres zehirleme (address poisoning) ve zararlı airdrop sözleşmeleri bakiyenizi hedef alır.' },
			{ id: 'i5', text: 'Adres kopyala-yapıştır yaparken adresin sadece başını ve sonunu değil, ortasındaki karakterleri de teyit ediyorum.', weight: 4, critical: false, tip: 'Kötü amaçlı panoya sızma yazılımları (clipper trojan) adresinizi benzer karakterli saldırgan adresiyle değiştirebilir.' }
		]
	},
	{
		id: 'donanim',
		title: '3. Donanım & Cihaz Güvenliği',
		weight: 25,
		items: [
			{ id: 'd1', text: 'Yüksek değerli ana portföyümü internete bağlı olmayan soğuk donanım cüzdanda (Hardware Wallet: Ledger, Trezor vb.) tutuyorum.', weight: 8, critical: false, tip: 'Donanım cüzdanlar özel anahtarınızı bilgisayarınıza sızan virüslerden izole eder.' },
			{ id: 'd2', text: 'Günlük dApp etkileşimleri ve airdrop avcılığı için ana birikim cüzdanımdan tamamen izole bir "harcama/yakıcı" (burner) cüzdan kullanıyorum.', weight: 5, critical: false, tip: 'Riskli Web3 sitelerine ana birikiminizin bulunduğu cüzdanı asla bağlamayın.' },
			{ id: 'd3', text: 'Kripto işlemlerimi yaptığım bilgisayarımda korsan yazılım, crackli oyun veya torrent uygulamaları çalıştırmıyorum.', weight: 5, critical: true, tip: 'Bilgisayar korsanlarının en yaygın cüzdan çalma yöntemi oyun/yazılım cracklerine gizlenen bilgi hırsızlarıdır (infostealer).' },
			{ id: 'd4', text: 'Cüzdanımın kurulu olduğu cihazda güçlü bir ekran kilidi ve biyometrik koruma (TouchID, FaceID vb.) aktif.', weight: 3, critical: false, tip: 'Fiziksel cihaz hırsızlığında cüzdan erişimini engeller.' },
			{ id: 'd5', text: 'İşletim sistemim ve web tarayıcım en son güvenlik güncellemelerine sahip.', weight: 4, critical: false, tip: 'Sıfırıncı gün (0-day) tarayıcı açıklarına karşı güncellemeleri ertelemeyin.' }
		]
	},
	{
		id: 'sosyal',
		title: '4. Hesap, İki Faktörlü Doğrulama (2FA) & Sosyal Hijyen',
		weight: 15,
		items: [
			{ id: 's1', text: 'Kripto borsalarımda SMS 2FA yerine donanım anahtarı (YubiKey) veya Authenticator uygulaması kullanıyorum.', weight: 4, critical: true, tip: 'SMS 2FA, SIM kart kopyalama (SIM swap) saldırılarına karşı tamamen savunmasızdır.' },
			{ id: 's2', text: 'Kripto hesaplarım için kullandığım birincil e-posta adresimde çok güçlü ve benzersiz bir parola var.', weight: 3, critical: false, tip: 'E-postanız ele geçirilirse borsa şifre sıfırlama talepleri onaylanabilir.' },
			{ id: 's3', text: 'Telegram, Discord veya Twitter üzerinden gelen özel mesajları (DM) kapattım veya gelen yardım tekliflerine şüpheyle yaklaşıyorum.', weight: 3, critical: false, tip: 'Discord ve Telegram topluluklarında yöneticilerin adını taklit eden yüzlerce sahte bot dolaşmaktadır.' },
			{ id: 's4', text: 'Halka açık ortak Wi-Fi ağlarında (kafe, havalimanı) kripto işlemi yapmıyorum veya güvenilir bir VPN kullanıyorum.', weight: 2, critical: false, tip: 'Açık Wi-Fi ağlarında DNS zehirleme ile sahte klon sitelere yönlendirilebilirsiniz.' },
			{ id: 's5', text: 'Kripto varlıklarımın miktarını ve cüzdan bakiyelerimi sosyal medyada veya halka açık mecralarda asla paylaşmıyorum.', weight: 3, critical: false, tip: 'Büyük bakiyeler sizi hedefli kimlik avı ve fiziksel tehditlerin doğrudan hedefi haline getirir.' }
		]
	}
];
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container tool-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/araclar">Araçlar</a>
			<span>/</span>
			<span class="current">Cüzdan Güvenlik Kontrolü</span>
		</nav>

		<div class="tool-header">
			<div class="badge-pill">
				<span>🛡️</span>
				<span>Önleyici Güvenlik</span>
			</div>
			<h1 class="tool-title">Cüzdan Güvenlik Kontrolü & Risk Analizi</h1>
			<p class="tool-subtitle">
				24 maddelik interaktif güvenlik checklist'i ile cüzdanınızı ve kripto hesaplarınızı denetleyin. Zayıf noktalarınızı tespit edin ve acil aksiyon planınızı alın.
			</p>
		</div>

		<div class="security-dashboard">
			<!-- Overall Score Display Card -->
			<div class="score-card">
				<div class="score-main">
					<div class="score-circle" id="score-circle">
						<span class="score-val" id="score-val">0</span>
						<span class="score-max">/ 100</span>
					</div>
					<div class="score-meta">
						<div class="score-status-badge" id="score-level-badge">Değerlendiriliyor...</div>
						<p class="score-summary" id="score-summary">Kutuları işaretleyerek cüzdanınızın mevcut güvenlik durumunu ölçün.</p>
						<div class="score-counts">
							<span class="count-pill ok" id="checked-count">0 / 20 Tamamlandı</span>
							<span class="count-pill crit" id="crit-count">0 Kritik Güvenlik Açığı</span>
						</div>
					</div>
				</div>
				<div class="score-actions">
					<button class="btn btn-secondary btn-sm" id="reset-btn">Tümünü Sıfırla</button>
				</div>
			</div>

			<!-- Dynamic Action Plan Box -->
			<div class="action-plan-box" id="action-plan-box">
				<h3 class="action-plan-title">⚡ Kişiselleştirilmiş Öncelikli Eylem Planınız</h3>
				<p class="action-plan-desc">Aşağıdaki kritik adımlar tamamlanmadıkça cüzdanınız ele geçirilme riski taşımaktadır:</p>
				<ul class="action-plan-list" id="action-plan-list">
					<!-- Filled dynamically -->
				</ul>
			</div>

			<!-- Checklist Groups -->
			<div class="checklist-container">
				{checklistCategories.map(cat => (
					<div class="checklist-group" data-group={cat.id}>
						<div class="group-header">
							<h3 class="group-title">{cat.title}</h3>
							<span class="group-weight">Ağırlık: %{cat.weight}</span>
						</div>
						<div class="items-list">
							{cat.items.map(item => (
								<label class="check-item" data-id={item.id} data-weight={item.weight} data-critical={item.critical ? 'true' : 'false'}>
									<input type="checkbox" class="check-box" id={`chk-${item.id}`} />
									<div class="item-content">
										<div class="item-text-row">
											<span class="item-text">{item.text}</span>
											{item.critical && <span class="crit-badge" title="Bu maddenin ihmal edilmesi varlık kaybına yol açabilir">KRİTİK</span>}
										</div>
										<p class="item-tip">💡 {item.tip}</p>
									</div>
								</label>
							))}
						</div>
					</div>
				))}
			</div>
		</div>

		<!-- Explanatory Guide Section -->
		<div class="security-info-grid">
			<div class="info-card">
				<h3>🔑 Kriptoda Geri Dönüş Yoktur</h3>
				<p>Blokzincir transferleri geri alınamaz ve hiçbir müşteri hizmetleri çalınan bakiyeyi tek taraflı olarak geri getiremez. Kriptoda en büyük güvenlik kalkanı hata yapmadan önceki önlemlerinizdir.</p>
			</div>
			<div class="info-card">
				<h3>💻 Gizlilik Taahhüdü</h3>
				<p>Kriptonik, bu kontrol listesinde işaretlediğiniz seçenekleri sunucularında saklamaz. İlerlemeniz sadece kendi tarayıcınızın yerel hafızasında (localStorage) saklanır.</p>
			</div>
		</div>
	</div>
</Layout>

<style>
.tool-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
	max-width: 900px;
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}
.tool-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.tool-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-2);
	letter-spacing: -0.02em;
}
.tool-subtitle {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	line-height: 1.6;
}

.score-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-6);
	margin-bottom: var(--space-6);
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: var(--space-6);
	flex-wrap: wrap;
}
.score-main {
	display: flex;
	align-items: center;
	gap: var(--space-6);
}
.score-circle {
	width: 100px;
	height: 100px;
	border-radius: 50%;
	border: 6px solid var(--color-border);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background: var(--color-bg);
	transition: all var(--transition-normal);
}
.score-val {
	font-size: var(--text-2xl);
	font-weight: 800;
	font-family: var(--font-mono);
	line-height: 1;
}
.score-max {
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	margin-top: 2px;
}
.score-meta {
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}
.score-status-badge {
	font-size: var(--text-sm);
	font-weight: 700;
	display: inline-block;
	width: fit-content;
	padding: var(--space-1) var(--space-3);
	border-radius: var(--radius-full);
}
.score-summary {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
}
.score-counts {
	display: flex;
	gap: var(--space-2);
	font-size: var(--text-xs);
}
.count-pill {
	padding: var(--space-1) var(--space-2);
	border-radius: var(--radius-sm);
	font-weight: 600;
}
.count-pill.ok {
	background: rgba(16, 185, 129, 0.1);
	color: var(--color-success);
}
.count-pill.crit {
	background: rgba(239, 68, 68, 0.1);
	color: var(--color-error);
}

.action-plan-box {
	background: rgba(239, 68, 68, 0.05);
	border: 1px solid rgba(239, 68, 68, 0.25);
	border-radius: var(--radius-lg);
	padding: var(--space-5);
	margin-bottom: var(--space-6);
	display: none;
}
.action-plan-title {
	font-size: var(--text-base);
	font-weight: 700;
	color: var(--color-error);
	margin-bottom: var(--space-2);
}
.action-plan-desc {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.action-plan-list {
	margin: 0;
	padding-left: var(--space-5);
	font-size: var(--text-sm);
	color: var(--color-text-primary);
	display: flex;
	flex-direction: column;
