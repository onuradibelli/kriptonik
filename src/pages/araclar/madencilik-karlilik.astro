---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Bitcoin Madencilik Kârlılık Hesaplayıcı (ASIC / Hashrate) | Kriptonik";
const pageDesc = "Bitcoin madencilik cihazınızın (ASIC) elektrik maliyeti, zorluk seviyesi ve havuz komisyonuna göre günlük, aylık ve yıllık net kârını hesaplayın.";
---

<Layout title={pageTitle} description={pageDesc}>
	<div class="container tool-page">
		<nav class="breadcrumb">
			<a href="/">Ana Sayfa</a>
			<span>/</span>
			<a href="/araclar">Araçlar</a>
			<span>/</span>
			<span class="current">Madencilik Kârlılık Hesaplayıcı</span>
		</nav>

		<div class="tool-header">
			<div class="badge-pill">
				<span>⛏️</span>
				<span>ASIC & Hashrate Verimliliği</span>
			</div>
			<h1 class="tool-title">Bitcoin Madencilik Kârlılık Hesaplayıcı</h1>
			<p class="tool-subtitle">
				Elektrik tarifesi, cihaz gücü ve ağ zorluğuna göre Bitcoin madenciliğinin başa baş fiyatını ve net getirisini matematiksel olarak hesaplayın.
			</p>
		</div>

		<div class="mining-card">
			<div class="mining-inputs-grid">
				<div class="input-group">
					<label for="hashrate-input">Hash Gücü (Hashrate):</label>
					<div class="unit-input">
						<input type="number" id="hashrate-input" class="form-input" value="120" min="1" step="1" />
						<span class="unit-tag">TH/s</span>
					</div>
				</div>

				<div class="input-group">
					<label for="power-input">Güç Tüketimi:</label>
					<div class="unit-input">
						<input type="number" id="power-input" class="form-input" value="3300" min="100" step="50" />
						<span class="unit-tag">Watt (W)</span>
					</div>
				</div>

				<div class="input-group">
					<label for="cost-kwh-input">Elektrik Birim Fiyatı (USD/kWh):</label>
					<div class="unit-input">
						<input type="number" id="cost-kwh-input" class="form-input" value="0.07" min="0.01" step="0.005" />
						<span class="unit-tag">$/kWh</span>
					</div>
				</div>

				<div class="input-group">
					<label for="pool-fee-input">Madencilik Havuz Komisyonu:</label>
					<div class="unit-input">
						<input type="number" id="pool-fee-input" class="form-input" value="1.5" min="0" max="10" step="0.1" />
						<span class="unit-tag">%</span>
					</div>
				</div>

				<div class="input-group">
					<label for="btc-price-input">BTC Fiyatı (USD):</label>
					<div class="unit-input">
						<input type="number" id="btc-price-input" class="form-input" value="88500" min="1000" />
						<span class="unit-tag">USD</span>
					</div>
				</div>

				<div class="input-group">
					<label for="hardware-cost-input">Cihaz Maliyeti (Opsiyonel ROI İçin):</label>
					<div class="unit-input">
						<input type="number" id="hardware-cost-input" class="form-input" value="2500" min="0" step="100" />
						<span class="unit-tag">USD</span>
					</div>
				</div>
			</div>

			<!-- Dynamic Summary Results -->
			<div class="results-dashboard">
				<div class="res-stat-card primary">
					<span class="res-lbl">Günlük Net Kâr / Zarar:</span>
					<div class="res-amount font-mono" id="daily-profit-val">+$1.42</div>
					<span class="res-sub font-mono" id="daily-btc-val">0.0000754 BTC / Gün</span>
				</div>

				<div class="res-stat-card">
					<span class="res-lbl">Başa Baş BTC Fiyatı:</span>
					<div class="res-amount font-mono" id="breakeven-btc-val">$73,500</div>
					<span class="res-sub">Bu fiyatın altında elektrik zararına çalışır</span>
				</div>

				<div class="res-stat-card">
					<span class="res-lbl">Tahmini Amorti Süresi (ROI):</span>
					<div class="res-amount font-mono" id="roi-days-val">~1.760 Gün</div>
					<span class="res-sub" id="roi-status-sub">Sabit zorluk varsayımı ile</span>
				</div>
			</div>

			<!-- Breakdown Table -->
			<div class="period-table-wrap">
				<h3 class="table-heading">Dönemsel Gelir ve Gider Tablosu</h3>
				<table class="mining-table">
					<thead>
						<tr>
							<th>Dönem</th>
							<th>Üretilen BTC</th>
							<th>Brüt Gelir (USD)</th>
							<th>Elektrik Gideri (USD)</th>
							<th>Net Kâr (USD)</th>
						</tr>
					</thead>
					<tbody id="period-table-body">
						<!-- Dynamically populated -->
					</tbody>
				</table>
			</div>

			<div class="honest-mining-note">
				⚠️ <strong>Metodoloji ve Dürüstlük Notu:</strong> Blok ödülleri 4. Halving sonrası <strong>3,125 BTC</strong> olarak hesaplanır. Bloklardaki değişken işlem ücreti (tx fee) gelirleri kestirilemez olduğundan analize dahil edilmemiştir. Ağ zorluğundaki (difficulty) artışlar gelecekteki BTC üretimini kademeli olarak azaltacaktır.
			</div>
		</div>

		<!-- Explanation Section -->
		<div class="info-section">
			<h3>📐 Matematiksel Formül</h3>
			<p>
				Günlük üretilen Bitcoin miktarı blokzincir protokolünün kesin formülü ile hesaplanır:
			</p>
			<pre class="formula-box"><code>Günlük BTC = (Hash_H/s × 86.400 × BlokÖdülü) / (Ağ Zorluğu × 2^32) × (1 - HavuzKomisyonu)</code></pre>
			<p>
				Elektrik tüketimi formülü:
			</p>
			<pre class="formula-box"><code>Günlük Elektrik Maliyeti = (Watt / 1000) × 24 × kWh Birim Fiyatı ($)</code></pre>
		</div>
	</div>
</Layout>

<style>
.tool-page {
	padding-top: var(--space-8);
	padding-bottom: var(--space-16);
	max-width: 900px;
}
.breadcrumb {
	display: flex;
	align-items: center;
	gap: var(--space-2);
	font-size: var(--text-sm);
	color: var(--color-text-muted);
	margin-bottom: var(--space-6);
}
.breadcrumb a {
	color: var(--color-text-muted);
	text-decoration: none;
}
.breadcrumb a:hover {
	color: var(--color-primary-400);
}
.breadcrumb .current {
	color: var(--color-text-secondary);
}
.tool-header {
	margin-bottom: var(--space-8);
}
.badge-pill {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-1) var(--space-3);
	background: var(--color-surface-hover);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-full);
	font-size: var(--text-xs);
	font-weight: 500;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-3);
}
.tool-title {
	font-size: var(--text-3xl);
	font-weight: 800;
	margin-bottom: var(--space-2);
	letter-spacing: -0.02em;
}
.tool-subtitle {
	font-size: var(--text-base);
	color: var(--color-text-secondary);
	line-height: 1.6;
}

.mining-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-xl);
	padding: var(--space-6);
	margin-bottom: var(--space-8);
}
.mining-inputs-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: var(--space-4);
	margin-bottom: var(--space-6);
}
.input-group label {
	display: block;
	font-size: var(--text-xs);
	font-weight: 700;
	color: var(--color-text-secondary);
	margin-bottom: var(--space-2);
}
.unit-input {
	display: flex;
	position: relative;
	align-items: center;
}
.form-input {
	width: 100%;
	padding: var(--space-2) var(--space-3);
	padding-right: 55px;
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	color: var(--color-text-primary);
	font-family: var(--font-mono);
	font-size: var(--text-sm);
	font-weight: 600;
}
.unit-tag {
	position: absolute;
	right: var(--space-3);
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	font-weight: 600;
	pointer-events: none;
}

.results-dashboard {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: var(--space-4);
	margin-bottom: var(--space-6);
}
.res-stat-card {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-4);
	display: flex;
	flex-direction: column;
	gap: 4px;
}
.res-stat-card.primary {
	border-color: var(--color-primary-500);
}
.res-lbl {
	font-size: var(--text-xs);
	color: var(--color-text-muted);
	font-weight: 600;
}
.res-amount {
	font-size: var(--text-2xl);
	font-weight: 900;
	line-height: 1.1;
}
.res-sub {
	font-size: 11px;
	color: var(--color-text-secondary);
}

.period-table-wrap {
	margin-bottom: var(--space-6);
	overflow-x: auto;
}
.table-heading {
	font-size: var(--text-sm);
	font-weight: 700;
	margin-bottom: var(--space-3);
}
.mining-table {
	width: 100%;
	border-collapse: collapse;
	background: var(--color-bg);
	border-radius: var(--radius-md);
	overflow: hidden;
	font-size: var(--text-sm);
}
.mining-table th, .mining-table td {
	padding: var(--space-3) var(--space-4);
	border-bottom: 1px solid var(--color-border);
	text-align: left;
}
.mining-table th {
	background: var(--color-surface-hover);
	color: var(--color-text-secondary);
	font-size: var(--text-xs);
	font-weight: 600;
}
.mining-table td {
	font-family: var(--font-mono);
}

.honest-mining-note {
	font-size: var(--text-xs);
	color: var(--color-text-secondary);
	background: var(--color-surface-hover);
	border-left: 3px solid var(--color-warning);
	padding: var(--space-3) var(--space-4);
	border-radius: var(--radius-sm);
	line-height: 1.5;
}

.info-section {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-6);
}
.info-section h3 {
	font-size: var(--text-base);
	font-weight: 700;
	margin-bottom: var(--space-3);
}
.info-section p {
	font-size: var(--text-sm);
	color: var(--color-text-secondary);
	line-height: 1.6;
}
.formula-box {
	background: var(--color-bg);
	border: 1px solid var(--color-border);
	padding: var(--space-3) var(--space-4);
	border-radius: var(--radius-md);
	font-size: var(--text-xs);
	color: var(--color-primary-400);
	overflow-x: auto;
}

@media (max-width: 768px) {
	.mining-inputs-grid {
		grid-template-columns: 1fr;
	}
	.results-dashboard {
		grid-template-columns: 1fr;
	}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const hashrateInput = document.getElementById('hashrate-input') as HTMLInputElement;
	const powerInput = document.getElementById('power-input') as HTMLInputElement;
	const costKwhInput = document.getElementById('cost-kwh-input') as HTMLInputElement;
	const poolFeeInput = document.getElementById('pool-fee-input') as HTMLInputElement;
	const btcPriceInput = document.getElementById('btc-price-input') as HTMLInputElement;
	const hardwareCostInput = document.getElementById('hardware-cost-input') as HTMLInputElement;

	const dailyProfitVal = document.getElementById('daily-profit-val');
	const dailyBtcVal = document.getElementById('daily-btc-val');
	const breakevenBtcVal = document.getElementById('breakeven-btc-val');
	const roiDaysVal = document.getElementById('roi-days-val');
	const roiStatusSub = document.getElementById('roi-status-sub');
	const tableBody = document.getElementById('period-table-body');

	// Current reference difficulty (~105 Trillion)
	const CURRENT_DIFFICULTY = 105e12;
	const BLOCK_REWARD = 3.125;
	const TWO_POW_32 = 4294967296;

	function calculate() {
		const hashrateTH = parseFloat(hashrateInput.value) || 0;
		const powerW = parseFloat(powerInput.value) || 0;
		const costKwh = parseFloat(costKwhInput.value) || 0;
		const poolFeePct = (parseFloat(poolFeeInput.value) || 0) / 100;
		const btcPrice = parseFloat(btcPriceInput.value) || 0;
		const hardwareCost = parseFloat(hardwareCostInput.value) || 0;

		const hashH = hashrateTH * 1e12;

		// Daily BTC formula: (hash_H * 86400 * blockReward) / (difficulty * 2^32) * (1 - poolFee)
		const dailyBtc = (hashH * 86400 * BLOCK_REWARD) / (CURRENT_DIFFICULTY * TWO_POW_32) * (1 - poolFeePct);
		const dailyRevenueUsd = dailyBtc * btcPrice;
		const dailyElectricityUsd = (powerW / 1000) * 24 * costKwh;
		const dailyProfitUsd = dailyRevenueUsd - dailyElectricityUsd;

		// Break-even BTC price = dailyElectricityUsd / dailyBtc
		const breakevenBtc = dailyBtc > 0 ? (dailyElectricityUsd / dailyBtc) : 0;

		// ROI
		if (dailyProfitUsd > 0 && hardwareCost > 0) {
			const days = Math.round(hardwareCost / dailyProfitUsd);
			if (roiDaysVal) roiDaysVal.textContent = `~${days} Gün`;
			if (roiStatusSub) roiStatusSub.textContent = `(${(days / 30.5).toFixed(1)} Ay)`;
		} else {
			if (roiDaysVal) roiDaysVal.textContent = 'Amorti Olmaz';
			if (roiStatusSub) roiStatusSub.textContent = 'Mevcut tarifeyle zarar üretir';
		}

		if (dailyProfitVal) {
			dailyProfitVal.textContent = `${dailyProfitUsd >= 0 ? '+' : ''}$${dailyProfitUsd.toFixed(2)}`;
			dailyProfitVal.style.color = dailyProfitUsd >= 0 ? 'var(--color-success)' : 'var(--color-error)';
		}
		if (dailyBtcVal) dailyBtcVal.textContent = `${dailyBtc.toFixed(8)} BTC / Gün`;
		if (breakevenBtcVal) breakevenBtcVal.textContent = `$${Math.round(breakevenBtc).toLocaleString('tr-TR')}`;

		// Periods table
		const periods = [
			{ name: 'Günlük', mult: 1 },
			{ name: 'Haftalık', mult: 7 },
			{ name: 'Aylık (30 Gün)', mult: 30 },
			{ name: 'Yıllık (365 Gün)', mult: 365 }
		];

		if (tableBody) {
			tableBody.innerHTML = periods.map(p => {
				const pBtc = dailyBtc * p.mult;
				const pRev = dailyRevenueUsd * p.mult;
				const pCost = dailyElectricityUsd * p.mult;
				const pProf = dailyProfitUsd * p.mult;
				return `
					<tr>
						<td><strong>${p.name}</strong></td>
						<td>${pBtc.toFixed(7)} BTC</td>
						<td>$${pRev.toFixed(2)}</td>
						<td>$${pCost.toFixed(2)}</td>
						<td style="color: ${pProf >= 0 ? 'var(--color-success)' : 'var(--color-error)'}; font-weight: 700;">
							${pProf >= 0 ? '+' : ''}$${pProf.toFixed(2)}
						</td>
					</tr>
				`;
			}).join('');
		}
	}

	[hashrateInput, powerInput, costKwhInput, poolFeeInput, btcPriceInput, hardwareCostInput].forEach(inp => {
		inp?.addEventListener('input', calculate);
	});

	calculate();
});
</script>
